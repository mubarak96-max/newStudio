import fs from 'node:fs';

import { episodeCompletionProblems } from '../../src/features/completion/types.ts';

const store = fs.readFileSync(new URL('../../src/features/completion/store.ts', import.meta.url), 'utf8');

function problems(input: Parameters<typeof episodeCompletionProblems>[0]) {
  return episodeCompletionProblems(input);
}

const live = { id: 'm1', order: 1, posted: true, validationProblems: [] };
const checks = [
  ['A fully covered, live, valid episode passes', problems({ coverageProblems: [], moments: [live] }).length === 0],
  ['Unaccounted narrative paragraphs block completion', problems({ coverageProblems: ['p000004-p000006 is not mapped.'], moments: [live] }).some((value) => value.includes('not mapped'))],
  ['An unposted moment blocks without changing an already-live moment', problems({ coverageProblems: [], moments: [live, { id: 'm2', order: 2, posted: false, validationProblems: [] }] }).length === 1 && live.posted],
  ['A revalidation failure blocks completion', problems({ coverageProblems: [], moments: [{ ...live, validationProblems: ['The image is inaccessible.'] }] }).some((value) => value.includes('inaccessible'))],
  ['Canonical promotion occurs inside a transaction', /runTransaction[\s\S]*tx\.update\(canonical,[\s\S]*activeVersionId: replacementId/.test(store)],
  ['Former active version deletion occurs after the promotion transaction', /const result = await adminDb\(\)\.runTransaction[\s\S]*if \(result\.oldVersionId[\s\S]*\.doc\(result\.oldVersionId\)\.delete\(\)/.test(store)],
  ['A failed promotion cannot reach old-version deletion', /const result = await adminDb\(\)\.runTransaction/.test(store) && store.indexOf('const result = await adminDb().runTransaction') < store.indexOf(".doc(result.oldVersionId).delete()")],
] as const;

let failed = 0;
for (const [name, pass] of checks) {
  console.log(`${pass ? 'PASS' : 'FAIL'}  ${name}`);
  if (!pass) failed += 1;
}
console.log(`\n${checks.length - failed}/${checks.length} checks passed`);
process.exit(failed ? 1 : 0);

