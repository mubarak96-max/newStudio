"use client";

// Direct Beat/Moment/Episode preview over the exact bundle contract
// (P9, plan 7, ADR-009). Scope selection immediately loads a renderable
// preview; playback obeys reduced-motion preferences and never starts paid
// work. Transitions execute deterministically in both WebGL and CSS stages;
// a lost WebGL context falls back to deterministic CSS layers with the
// same text, source order and controls. Layer/depth inspection is
// read-only; blockers expose the exact resolving action. There is no
// camera, layer or text input: AI plans, the owner previews and approves.

import dynamic from "next/dynamic";
import { useEffect, useMemo, useRef, useState } from "react";

import type { EpisodeBundle } from "../schemas/bundle.ts";
import type { WorkflowAction } from "../schemas/publishing.ts";
import { resolveFrame } from "../functions/resolveFrame.ts";
import { CssFallback } from "./CssFallback.tsx";
import { executeTransition, type PlannedTransitionType } from "./transitions.ts";

const DepthScene = dynamic(
  () => import("./DepthScene.tsx").then((mod) => mod.DepthScene),
  { ssr: false, loading: () => <p>Loading WebGL stageâ€¦</p> },
);

type Scope = "episode" | "moment" | "beat";

function momentOf(beatId: string): string {
  return beatId.split("_b")[0];
}

export function EpisodePreview({
  bundle,
  provenance,
  blockers,
  actions,
  onAction,
}: {
  bundle: EpisodeBundle;
  provenance: string;
  blockers: { code: string; message: string; targetActionId?: string }[];
  actions: WorkflowAction[];
  onAction: (actionId: string) => void;
}) {
  const [scope, setScope] = useState<Scope>("episode");
  const [beatIndex, setBeatIndex] = useState(0);
  const [progress, setProgress] = useState(0);
  const [playing, setPlaying] = useState(false);
  const [fallbackForced, setFallbackForced] = useState(false);
  const [contextLost, setContextLost] = useState(false);
  const [reducedMotion, setReducedMotion] = useState(
    () =>
      typeof window !== "undefined" &&
      typeof window.matchMedia !== "undefined" &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches,
  );
  const stageRef = useRef<HTMLDivElement | null>(null);
  const progressRef = useRef(0);

  const setProgressSync = (value: number) => {
    progressRef.current = value;
    setProgress(value);
  };

  useEffect(() => {
    const query = window.matchMedia("(prefers-reduced-motion: reduce)");
    const onChange = (event: MediaQueryListEvent) => setReducedMotion(event.matches);
    query.addEventListener("change", onChange);
    return () => query.removeEventListener("change", onChange);
  }, []);

  // Deterministic reduced capability: a lost WebGL context degrades to the
  // CSS fallback with the same text, source order and controls.
  useEffect(() => {
    const stage = stageRef.current;
    if (!stage) return;
    const onLost = (event: Event) => {
      event.preventDefault();
      setContextLost(true);
    };
    stage.addEventListener("webglcontextlost", onLost);
    return () => stage.removeEventListener("webglcontextlost", onLost);
  }, []);

  const playlist = useMemo(() => {
    if (scope === "beat") return [Math.min(beatIndex, bundle.beats.length - 1)];
    if (scope === "moment") {
      const moment = momentOf(bundle.beats[beatIndex]?.id ?? "");
      return bundle.beats
        .map((beat, index) => ({ beat, index }))
        .filter(({ beat }) => momentOf(beat.id) === moment)
        .map(({ index }) => index);
    }
    return bundle.beats.map((_, index) => index);
  }, [bundle, scope, beatIndex]);

  const current = bundle.beats[beatIndex] ?? null;
  const composition = current ? (bundle.compositions[current.compositionId] ?? null) : null;

  const frame = useMemo(() => {
    if (!current) return null;
    const resolved = resolveFrame(bundle, current.id, progress);
    if (!reducedMotion) return resolved;
    return {
      ...resolved,
      layerOffsets: resolved.layerOffsets.map((offset) => ({ ...offset, dx: 0, dy: 0 })),
    };
  }, [bundle, current, progress, reducedMotion]);

  const transition = useMemo(() => {
    if (!current) return null;
    return executeTransition(current.transitionIn.type as PlannedTransitionType, progress, {
      reducedMotion,
    });
  }, [current, progress, reducedMotion]);

  useEffect(() => {
    if (!playing || !current || reducedMotion) return;
    let last = performance.now();
