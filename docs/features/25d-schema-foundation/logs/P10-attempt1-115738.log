--- src/features/book-experience/visuals/regeneration.ts ---
// Targeted regeneration planning (P8, ADR-007/ADR-011).
// A failed layer regenerates at asset/layer/composition scope without
// discarding approved siblings: approved assets are reused by immutable
// key, and explicit regeneration is a new attempt with a distinct
// idempotency key. Published bundles keep their exact asset keys.

import { idempotencyKeyFor } from "./requests.ts";
import type { VisualTargetKind } from "./references.ts";

export type RegenerationScope = "asset" | "layer" | "composition";

export type RegenerationPlan = {
  targetId: string;
  kind: VisualTargetKind;
  scope: RegenerationScope;
  /** New billable attempt; retries of this attempt reuse the same key. */
  idempotencyKey: string;
  attempt: number;
  /** Immutable keys of approved siblings that must not change. */
  reuseKeys: string[];
  reason: string;
};

export function planRegeneration(args: {
  targetId: string;
  kind: VisualTargetKind;
  scope: RegenerationScope;
  previousAttempt: number;
  approvedSiblingKeys: string[];
  reason: string;
}): RegenerationPlan {
  if (!args.reason.trim()) throw new Error("A regeneration reason is required.");
  const attempt = args.previousAttempt + 1;
  return {
    targetId: args.targetId,
    kind: args.kind,
    scope: args.scope,
    idempotencyKey: idempotencyKeyFor(args.targetId, args.kind, attempt),
    attempt,
    reuseKeys: [...args.approvedSiblingKeys],
    reason: args.reason,
  };
}

/** Regenerating one target must never rewrite an approved sibling's key. */
export function regenerationPreservesSiblings(plan: RegenerationPlan, approvedKeys: string[]): string | null {
  const dropped = approvedKeys.filter((key) => !plan.reuseKeys.includes(key));
  if (dropped.length > 0) {
    return `Regeneration must reuse approved sibling ${dropped[0]} by immutable key.`;
  }
  return null;
}

