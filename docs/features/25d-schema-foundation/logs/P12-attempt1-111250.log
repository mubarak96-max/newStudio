// Durable jobs barrel: engine, provider boundaries, cost ledger and
// approval-driven pipeline (plan section 4, ADR-006).
export * from "./engine.ts";
export * from "./providers.ts";
export * from "./costs.ts";
export * from "./pipeline.ts";

// Durable job engine: one document per Job with transactional leases,
// heartbeats, retries, checkpoints, cancellation, idempotency and bounded
// concurrency (plan section 4, ADR-006).
//
// Pure and dependency-free: no Next.js, no Firebase, no provider imports.
// The test seam is claimJob/advancePipeline/resumeJob through the fake clock
// and FakeJobStore boundaries â€” no live worker, paid providers or budget
// authority (P4 owner checklist). Production Firestore adapters stay in
// src/services/firebase and the thin app routes; the worker's Firestore
// lease helpers live in worker/jobs/leases.mts and mirror these semantics.
//
// Field names follow the Job contract in plan section 3.3 and
// src/features/book-experience/schemas/jobs.ts verbatim; this file adds only
// the runtime bookkeeping (completedUnits, lease holder) the schema implies.

export type JobStatus =
  | "queued"
  | "running"
  | "waiting_confirmation"
  | "completed"
  | "failed"
  | "cancelled";

export type CanonicalJob = {
  jobId: string;
  bookId: string;
  sourceId: string;
  canonicalHash: string;
  type: string;
  stage: string;
  status: JobStatus;
  progress: { done: number; total: number };
  checkpoint: { storagePath: string; unit: number } | null;
  attempts: number;
  maxAttempts: number;
  error: { code: string; message: string } | null;
  estimatedCostUsd: number;
  costUsd: number;
  idempotencyKey: string;
  workerId?: string;
  leaseExpiresAt?: string;
  startedAt?: string;
  finishedAt?: string;
  // Units whose provider calls already completed and were charged. Resume
  // skips these, so a killed/retried job never repeats completed calls.
  completedUnits: number[];
};

export const DEFAULT_LEASE_MS = 180_000;
export const DEFAULT_MAX_ATTEMPTS = 3;
export const MAX_CONCURRENT_JOBS = 3;

export class JobError extends Error {
  readonly code: string;
  constructor(code: string, message: string) {
    super(message);
    this.name = "JobError";
    this.code = code;
  }
}

// Deterministic clock for the fake seam. Production passes a wall-clock
// implementation with the same shape; tests control time explicitly.
export class FakeClock {
  private at: number;
  constructor(startMs = 1_700_000_000_000) {
    this.at = startMs;
  }
  now(): number {
    return this.at;
  }
  nowIso(): string {
    return new Date(this.at).toISOString();
  }
  advance(ms: number): void {
    if (ms < 0) throw new JobError("BAD_CLOCK", "Clock cannot move backwards.");
    this.at += ms;
  }
}


