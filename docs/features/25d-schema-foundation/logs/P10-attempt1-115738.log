diff --git a/worker/publishing/publish.mts b/worker/publishing/publish.mts
new file mode 100644
index 0000000000000000000000000000000000000000..43a8a0d972fb8095ed45ded6c3c7863936e0647c
--- /dev/null
+++ b/worker/publishing/publish.mts
@@ -0,0 +1,20 @@
+import type { CompileEpisodeBundleInput } from "../../src/features/book-experience/publishing/bundle.ts";
+import { compileEpisodeBundle } from "../../src/features/book-experience/publishing/bundle.ts";
+import type { PublishingRepository } from "../../src/features/book-experience/publishing/repository.ts";
+import { publishEpisode } from "../../src/features/book-experience/publishing/service.ts";
+import type { PublishedStorage } from "../../src/features/book-experience/publishing/storage.ts";
+
+export async function runEpisodePublication(args: {
+  input: CompileEpisodeBundleInput;
+  expectedPriorVersion: number | null;
+  storage: PublishedStorage;
+  repository: PublishingRepository;
+}) {
+  const compiled = compileEpisodeBundle(args.input);
+  return publishEpisode({
+    compiled,
+    storage: args.storage,
+    repository: args.repository,
+    expectedPriorVersion: args.expectedPriorVersion,
+  });
+}
diff --git a/worker/publishing/s3.mts b/worker/publishing/s3.mts
new file mode 100644
index 0000000000000000000000000000000000000000..8349a240aa4d5085b0b40ef21f2fdf27ce744d3b
--- /dev/null
+++ b/worker/publishing/s3.mts
@@ -0,0 +1,64 @@
+import {
+  HeadObjectCommand,
+  PutObjectCommand,
+  S3Client,
+} from "@aws-sdk/client-s3";
+import { createHash } from "node:crypto";
+
+import type {
+  PublishedStorage,
+  StoredObjectMetadata,
+} from "../../src/features/book-experience/publishing/storage.ts";
+
+export class S3PublishedStorage implements PublishedStorage {
+  private readonly client: S3Client;
+  private readonly bucket: string;
+
+  constructor(
+    client: S3Client,
+    bucket: string,
+  ) {
+    this.client = client;
+    this.bucket = bucket;
+  }
+
+  async putImmutable(key: string, bytes: Buffer, contentType: string): Promise<void> {
+    const checksum = createHash("sha256").update(bytes).digest("hex");
+    const existing = await this.inspect(key);
+    if (existing) {
+      if (
+        existing.checksum !== checksum ||
+        existing.sizeBytes !== bytes.length ||
+        existing.contentType !== contentType
+      ) {
+        throw new Error(`Published object ${key} is immutable.`);
+      }
+      return;
+    }
+    await this.client.send(new PutObjectCommand({
+      Bucket: this.bucket,
+      Key: key,
+      Body: bytes,
+      ContentType: contentType,
+      Metadata: { sha256: checksum },
+      CacheControl: "public,max-age=31536000,immutable",
+      IfNoneMatch: "*",
+    }));
+  }
+
+  async inspect(key: string): Promise<StoredObjectMetadata | null> {
+    try {
+      const result = await this.client.send(new HeadObjectCommand({ Bucket: this.bucket, Key: key }));
+      return {
+        key,
+        checksum: result.Metadata?.sha256 ?? "",
+        sizeBytes: result.ContentLength ?? 0,
+        contentType: result.ContentType ?? "application/octet-stream",
+      };
+    } catch (error) {
+      const status = (error as { $metadata?: { httpStatusCode?: number } }).$metadata?.httpStatusCode;
+      if (status === 404) return null;
+      throw error;
+    }
+  }
+}

