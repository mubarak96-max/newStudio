import { createHash } from "node:crypto";

// Content hashes for canonical text and paragraph traceability (ADR-001).
// Paragraph identity is always (sourceId, id); the canonical hash pins the
// exact approved text every derived artifact must reference.

export function sha256Hex(input: string): string {
  return createHash("sha256").update(input, "utf8").digest("hex");
}

export function paragraphHash(text: string): string {
  return sha256Hex(`paragraph:${text}`);
}

export function canonicalHashOf(texts: readonly string[]): string {
  return sha256Hex(`canonical:v1:${texts.join("\n\u0000")}`);
}

// Visual generation worker pass (P8, worker side).
// Generation is owner-triggered for one or multiple selected targets and
// runs directly through the configured ImageProvider using the same
// coordinate frame and pinned reference versions. No segmentation, depth,
// inpaint or manual upload/edit services exist here. Local fakes/fixtures;
// no paid calls, no live bucket writes (ADR-012).

import {
  validateAsset,
  type AssetIssue,
  type GeneratedAssetDescriptor,
} from "../../src/features/book-experience/visuals/assets.ts";
import {
  pinReferences,
  referenceApprovalProblem,
} from "../../src/features/book-experience/visuals/references.ts";
import {
  assembleVisualRequest,
  VISUAL_CANVAS,
  type CoordinateFrame,
  type VisualRequestTarget,
} from "../../src/features/book-experience/visuals/requests.ts";
import { FakeVisualStore } from "../../src/features/book-experience/visuals/repository.ts";
import { visualAssetKeyFor, type VisualAssetRole } from "../image-api.mts";
import type { ImageProvider } from "../providers/images.mts";

export type VisualGenerationInput = {
  bookId: string;
  sourceId: string;
  canonicalHash: string;
  visualProfileVersion: number;
  artStyle: string;
  palette: string[];
  lens: string;
  lighting: string;
  negativeRules: string[];
  target: VisualRequestTarget;
  attempt?: number;
  frame?: CoordinateFrame;
  seed?: number;
};

/** Deterministic fake S3 boundary: immutable keys, in-memory bytes, no bucket. */
export class FakeS3Store {
  objects = new Map<string, { bytes: Buffer; contentType: string }>();

  put(key: string, bytes: Buffer, contentType: string): void {
    if (this.objects.has(key)) throw new Error(`S3 key ${key} is immutable and already exists.`);
    this.objects.set(key, { bytes, contentType });
  }

  get(key: string): { bytes: Buffer; contentType: string } {
    const object = this.objects.get(key);
    if (!object) throw new Error(`S3 key ${key} not found.`);
    return object;
  }
}

function roleFor(kind: VisualRequestTarget["kind"]): VisualAssetRole {
  if (kind === "scene-background") return "background";
  if (kind === "scene-foreground") return "foreground";
  if (kind === "scene-depth") return "depth";
  return "reference";
}

export async function runVisualGeneration(args: VisualGenerationInput & {
  provider: ImageProvider;
  store: FakeVisualStore;
  s3: FakeS3Store;
}): Promise<{ s3Key: string; issues: AssetIssue[]; model: string; costUsd: number }> {
  const frame = args.frame ?? VISUAL_CANVAS;
  const attempt = args.attempt ?? 1;
  const blocked = referenceApprovalProblem({
    needed: args.target.needed,
    approvals: args.store.approvals,
    versions: args.store.versions,
  });
  if (blocked) throw new Error(blocked);
  const pins = pinReferences({ needed: args.target.needed, versions: args.store.versions });
  const assembled = assembleVisualRequest({
    target: args.target,
    artStyle: args.artStyle,
    palette: args.palette,
    lens: args.lens,
    lighting: args.lighting,
    negativeRules: args.negativeRules,
    referenceVersions: pins,
    referenceKeys: pins.flatMap((pin) => pin.s3Keys),
    frame,
    attempt,
    seed: args.seed,
  });
  const image = await args.provider.generate({
    prompt: assembled.prompt,
    aspectRatio: assembled.aspectRatio,
    referenceUrls: assembled.referenceKeys,
    idempotencyKey: assembled.idempotencyKey,
    unit: assembled.unit,
  });
  const s3Key = visualAssetKeyFor({
    bookId: args.bookId,
    assetVersionId: `${args.target.targetId}-attempt-${attempt}`,
    role: roleFor(args.target.kind),
    contentType: image.contentType,
  });
  args.s3.put(s3Key, image.bytes, image.contentType);
  const descriptor: GeneratedAssetDescriptor = {
    key: s3Key,
    targetId: args.target.targetId,
    kind: args.target.kind,
    w: frame.w,
    h: frame.h,
    contentType: image.contentType,
    sizeBytes: image.bytes.length,
    checksum: `fake-${assembled.idempotencyKey}`,
    hasAlpha: args.target.kind === "scene-foreground",
    ...(args.target.kind === "scene-depth"
      ? { bitDepth: 8 as const, sourceBitDepth: 8 as const, depthConvention: "near-white" as const }
      : {}),
    ...(args.target.kind === "scene-background" ? { overscanPresent: frame.overscan } : {}),
    textDetected: false,
  };
  const issues = validateAsset(descriptor, frame);
  args.store.recordGeneration({
    targetId: args.target.targetId,
    kind: args.target.kind,
    compositionId: args.target.compositionId,
    ...(args.target.layerId ? { layerId: args.target.layerId } : {}),
    s3Key,
    checksum: descriptor.checksum,
    contentType: image.contentType,
    sourceId: args.sourceId,
    canonicalHash: args.canonicalHash,
    visualProfileVersion: args.visualProfileVersion,
    referenceVersions: pins.map((pin) => ({
      entityId: pin.entityId,
      ...(pin.stateId ? { stateId: pin.stateId } : {}),
      version: pin.version,
      checksum: pin.checksum,
    })),
    ...(args.target.kind === "scene-depth" ? { bitDepth: 8 as const, sourceBitDepth: 8 as const } : {}),
    prompt: assembled.prompt,
    negativePrompt: assembled.negativePrompt,
    model: image.model,
    costUsd: image.costUsd,
    attempt,
    idempotencyKey: assembled.idempotencyKey,
    continuity: { agreementScore: null, identityScores: {}, status: "pending" },
    status: "generated",
    createdAt: new Date(0).toISOString(),
  });
  return { s3Key, issues, model: image.model, costUsd: image.costUsd };
}

/** Approving a generated asset requires zero validation issues. */
export function approveVisualGeneration(args: {
  store: FakeVisualStore;
  targetId: string;
  attempt: number;
  frame?: CoordinateFrame;
}) {
  const record = args.store.generations.get(`${args.targetId}:attempt-${args.attempt}`);
  if (!record) throw new Error(`Generation ${args.targetId} attempt ${args.attempt} not found.`);
  const descriptor = args.store.descriptorFor(args.targetId, args.attempt, args.frame ?? VISUAL_CANVAS);
  const issues = validateAsset(descriptor, args.frame ?? VISUAL_CANVAS);
  if (issues.length > 0) throw new Error(`Asset rejected: ${issues[0].message}`);
  return args.store.approveGeneration(args.targetId, args.attempt);
}

// Fake-backed visual generation repository (P8, ADR-012).
// Firestore layout follows plan section 4:
// books/{bookId}/entities/{entityId}/visualVersions/{versionId} holds
// immutable approved reference metadata (S3 holds the assets);
// books/{bookId}/compositions/{compositionId} holds Composition metadata.
// Local tests use this fake; no live writes here. Every generation records
// its immutable S3 key, source/reference versions, actual bit depth,
// prompt, model, cost and continuity result.

import type { GeneratedAssetDescriptor } from "./assets.ts";
import type { ReferenceApproval, StoredReferenceVersion } from "./references.ts";
import { referenceKey } from "./references.ts";
import type { CoordinateFrame } from "./requests.ts";

export type VisualGenerationRecord = {
  targetId: string;
  kind: string;
  compositionId: string;
  layerId?: string;
  s3Key: string;
  checksum: string;
  contentType: string;
  sourceId: string;
  canonicalHash: string;
  visualProfileVersion: number;
  referenceVersions: { entityId: string; stateId?: string; version: number; checksum: string }[];
  bitDepth?: 8 | 16;
  sourceBitDepth?: 8 | 16;
  prompt: string;
  negativePrompt: string;
  model: string;
  costUsd: number;
  attempt: number;
  idempotencyKey: string;
  continuity: { agreementScore: number | null; identityScores: Record<string, number>; status: "pending" | "approved" | "rejected" };
  status: "generated" | "approved" | "rejected";
  createdAt: string;
};

export class FakeVisualStore {
  approvals = new Map<string, ReferenceApproval>();
  versions = new Map<string, StoredReferenceVersion>();
  generations = new Map<string, VisualGenerationRecord>();
  charges = new Map<string, number>();
  outdatedTargets = new Set<string>();

  visualVersionPath(bookId: string, entityId: string, versionId: string): string {
    return `books/${bookId}/entities/${entityId}/visualVersions/${versionId}`;
  }

  compositionPath(bookId: string, compositionId: string): string {
    return `books/${bookId}/compositions/${compositionId}`;
  }

  proposeApproval(approval: ReferenceApproval): void {
    const key = referenceKey(approval.entityId, approval.stateId);
    if (this.approvals.has(key)) throw new Error(`Reference ${key} already proposed.`);
    this.approvals.set(key, approval);
  }

  approveReference(key: string, fingerprint: string, approvedBy: string): ReferenceApproval {
    if (this.outdated(key)) throw new Error(`Reference ${key} is outdated; regenerate from the current source.`);
    const existing = this.approvals.get(key);
    if (!existing) throw new Error(`Reference ${key} not found.`);
    if (existing.status === "approved" && existing.fingerprint === fingerprint) return existing;
    const next: ReferenceApproval = { ...existing, status: "approved", fingerprint, approvedBy, approvedAt: new Date(0).toISOString() };
    this.approvals.set(key, next);
    const stored = this.versions.get(key);
    if (stored) this.versions.set(key, { ...stored, reference: { ...stored.reference, approved: true, approvedBy, approvedAt: next.approvedAt } });
    return next;
  }

  publishReferenceVersion(version: StoredReferenceVersion): void {
    const key = referenceKey(version.entityId, version.stateId);
    if (this.versions.has(key)) throw new Error(`Reference version ${key} is immutable and already exists.`);
    this.versions.set(key, version);
  }

  /** Reference changes flag dependent drafts but never mutate published assets. */
  markOutdated(entityId: string, stateId?: string): void {
    this.outdatedTargets.add(referenceKey(entityId, stateId));
  }

  outdated(key: string): boolean {
    return this.outdatedTargets.has(key);
  }

  recordGeneration(record: VisualGenerationRecord): void {
    const key = `${record.targetId}:attempt-${record.attempt}`;
    if (this.generations.has(key)) throw new Error(`Generation ${key} is immutable and already exists.`);
    this.generations.set(key, record);
    // Idempotent cost: one charge per completed unit (plan 6).
    const chargeKey = `${record.idempotencyKey}:unit:1`;
    if (!this.charges.has(chargeKey)) this.charges.set(chargeKey, record.costUsd);
  }

  approveGeneration(targetId: string, attempt: number): VisualGenerationRecord {
    const record = this.generations.get(`${targetId}:attempt-${attempt}`);
    if (!record) throw new Error(`Generation ${targetId} attempt ${attempt} not found.`);
    const next: VisualGenerationRecord = { ...record, status: "approved", continuity: { ...record.continuity, status: "approved" } };
    this.generations.set(`${targetId}:attempt-${attempt}`, next);
    return next;
  }

  rejectGeneration(targetId: string, attempt: number): VisualGenerationRecord {
    const record = this.generations.get(`${targetId}:attempt-${attempt}`);
    if (!record) throw new Error(`Generation ${targetId} attempt ${attempt} not found.`);
    const next: VisualGenerationRecord = { ...record, status: "rejected", continuity: { ...record.continuity, status: "rejected" } };
    this.generations.set(`${targetId}:attempt-${attempt}`, next);
    return next;
  }

  approvedSiblingKeys(compositionId: string, exceptTargetId: string): string[] {
    return [...this.generations.values()]
      .filter((record) => record.compositionId === compositionId && record.targetId !== exceptTargetId && record.status === "approved")
      .map((record) => record.s3Key);
  }

  descriptorFor(targetId: string, attempt: number, frame: CoordinateFrame): GeneratedAssetDescriptor {
    const record = this.generations.get(`${targetId}:attempt-${attempt}`);
    if (!record) throw new Error(`Generation ${targetId} attempt ${attempt} not found.`);
    return {
      key: record.s3Key,
      targetId: record.targetId,
      kind: record.kind as GeneratedAssetDescriptor["kind"],
      w: frame.w,
      h: frame.h,
      contentType: record.contentType,
      sizeBytes: 1024,
      checksum: record.checksum,
      hasAlpha: record.kind === "scene-foreground",
      ...(record.bitDepth !== undefined ? { bitDepth: record.bitDepth, sourceBitDepth: record.sourceBitDepth, depthConvention: "near-white" as const } : {}),
      ...(record.kind === "scene-background" ? { overscanPresent: frame.overscan } : {}),
      textDetected: false,
    };
  }
}

