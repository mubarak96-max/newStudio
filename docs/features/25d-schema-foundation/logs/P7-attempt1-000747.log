+
+// P7 sentence-level commentary verification (plan section 5).
+// Pure and local: every commentary sentence needs a mapped-paragraph
+// citation and future identities stay hidden behind seq gating. The worker
+// calls this before storing AI commentary; the owner never retypes text.
+export type CommentarySentenceInput = {
+  sentence: string;
+  groundedIn: string[];
+};
+
+export function verifyCommentary(args: {
+  commentaryId: string;
+  text: string;
+  sentences: CommentarySentenceInput[];
+  allowedParagraphIds: string[];
+  blockedTerms?: string[];
+}): string[] {
+  const allowed = new Set(args.allowedParagraphIds);
+  const problems: string[] = [];
+  if (!args.text.trim()) return [`Commentary ${args.commentaryId} is empty.`];
+  if (args.sentences.length === 0) {
+    return [`Commentary ${args.commentaryId} has no verifiable sentences.`];
+  }
+  for (const entry of args.sentences) {
+    if (!entry.sentence.trim()) {
+      problems.push(`Commentary ${args.commentaryId} contains an empty sentence.`);
+      continue;
+    }
+    if (entry.groundedIn.length === 0) {
+      problems.push(`Sentence "${entry.sentence.slice(0, 60)}" has no grounding citation.`);
+    }
+    for (const citation of entry.groundedIn) {
+      if (!allowed.has(citation)) {
+        problems.push(`${citation} is not mapped to this Moment; commentary must cite its own paragraphs.`);
+      }
+    }
+  }
+  for (const term of args.blockedTerms ?? []) {
+    if (term && args.text.includes(term)) {
+      problems.push(
+        `Commentary ${args.commentaryId} leaks a future identity ("${term}"); seq gates what can be shown.`,
+      );
+    }
+  }
+  return problems;
+}

