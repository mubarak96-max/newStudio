import { z } from "zod";

import { IdSchema, LineageSchema, SeqRangeSchema } from "./primitives.ts";

// Book-model contracts (plan 3.1, ADR-004): Entity, Event and their
// evidence. Facts/reveals/events refer to existing paragraphs from the same
// sourceId; fills are explicitly invented visual choices, never source facts.

export const VisualReferenceVersionSchema = z.object({
  version: z.number().int().min(1),
  s3Keys: z.array(z.string().min(1)),
  checksum: z.string().min(1),
  approved: z.boolean(),
  approvedBy: z.string().min(1).optional(),
  approvedAt: z.string().min(1).optional(),
});

export const ReferencePinSchema = z.object({
  entityId: IdSchema,
  stateId: IdSchema.optional(),
  version: z.number().int().min(1),
  s3Keys: z.array(z.string().min(1)),
  checksum: z.string().min(1),
});

const EvidenceSchema = z.object({
  paragraphIds: z.array(z.string().regex(/^p\d{6}$/)).min(1),
});

export const EntityAliasSchema = EvidenceSchema.extend({
  name: z.string().min(1),
  firstSeq: z.number().int().min(0),
});

export const EntityFactSchema = EvidenceSchema.extend({
  key: z.string().min(1),
  value: z.string().min(1),
  quote: z.string().min(1),
  firstSeq: z.number().int().min(0),
});

export const EntityFillSchema = z.object({
  key: z.string().min(1),
  value: z.string().min(1),
  reason: z.string().min(1),
  editedBy: z.string().min(1).optional(),
});

export const EntityStateEntrySchema = EvidenceSchema.extend({
  stateId: IdSchema,
  label: z.string().min(1),
  validFromStoryTime: z.number().refine(Number.isFinite, {
    message: "storyTime is a finite chronology ordinal",
  }),
  validToStoryTime: z.number().nullable(),
  validFromSeq: z.number().int().min(0),
  changes: z.record(z.string(), z.string()),
});

export const EntityRevealSchema = EvidenceSchema.extend({
  what: z.string().min(1),
  seq: z.number().int().min(0),
});

export const EntityRelationshipSchema = z.object({
  toEntityId: IdSchema,
  type: z.string().min(1),
  validFromSeq: z.number().int().min(0),
  validToSeq: z.number().int().min(0).nullable(),
});

export const EntitySchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  entityId: IdSchema,
  type: z.enum(["character", "location", "object", "group"]),
  canonicalName: z.string().min(1),
  aliases: z.array(EntityAliasSchema),
  importance: z.enum(["major", "supporting", "minor"]),
  firstSeq: z.number().int().min(0),
  lastSeq: z.number().int().min(0),
  facts: z.array(EntityFactSchema),
  fills: z.array(EntityFillSchema),
  states: z.array(EntityStateEntrySchema),
  reveals: z.array(EntityRevealSchema),
  relationships: z.array(EntityRelationshipSchema),
  visual: z.object({
    spec: z.string().min(1),
    referenceSheet: VisualReferenceVersionSchema.optional(),
    stateVariants: z.record(z.string(), VisualReferenceVersionSchema),
    preRevealSpec: z.string().min(1).optional(),
  }),
  status: z.enum(["draft", "reviewed", "locked"]),
}).refine((entity) => entity.lastSeq >= entity.firstSeq, {
  message: "Entity lastSeq must be >= firstSeq",
});

export const EventSchema = LineageSchema.extend(SeqRangeSchema.shape)
  .extend(EvidenceSchema.shape)
  .extend({
    schemaVersion: z.literal(1),
    eventId: IdSchema,
    order: z.number().int().min(1),
    summary: z.string().min(1),
    storyTime: z.number().refine(Number.isFinite, {
      message: "storyTime is a finite chronology ordinal",
    }),
    participants: z.array(IdSchema),
    locationId: IdSchema.optional(),
    objectIds: z.array(IdSchema),
    kind: z.string().min(1),
  });

export type VisualReferenceVersion = z.infer<typeof VisualReferenceVersionSchema>;
export type ReferencePin = z.infer<typeof ReferencePinSchema>;
export type Entity = z.infer<typeof EntitySchema>;
export type Event = z.infer<typeof EventSchema>;

