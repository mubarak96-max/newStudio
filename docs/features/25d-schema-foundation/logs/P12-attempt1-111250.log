import { ParagraphSchema, type Paragraph } from "../schemas/paragraph.ts";
import {
  CHUNK_PARAGRAPH_COUNT,
  TextChunkSchema,
  type TextChunk,
} from "../schemas/source.ts";
import { sha256Hex } from "./hash.ts";
import { chunkIdFor } from "./paths.ts";

// Canonicalization errors are actionable: they name the paragraph or chunk
// that failed validation so the owner knows what to click (plan section 7).
export class CanonicalError extends Error {}

// Staging input: one ordered chapter entry as produced by extraction review.
// kind/isStory carry the editor-visible classification; the canonical flow
// never deletes non-story paragraphs, it classifies them (ADR-002).
export type StagingChapter = {
  chapterId: string;
  title: string;
  paragraphs: {
    text: string;
    page: number | null;
    kind: Paragraph["kind"];
    isStory: boolean;
    hash?: string;
  }[];
};

export type CanonicalizedSource = {
  paragraphs: Paragraph[];
  canonicalHash: string;
  chunks: TextChunk[];
  storyParagraphCount: number;
  wordCount: number;
};

function wordCountOf(text: string): number {
  const words = text.split(/\s+/).filter((word) => word.length > 0);
  return words.length;
}

export function hashParagraphs(paragraphs: readonly { text: string; hash: string }[]): string {
  return sha256Hex(
    `canonical:v1:${paragraphs.map((p) => `${p.hash}\n${p.text}`).join("\n␀")}`,
  );
}

// Promote approved staging chapters to versioned canonical paragraphs plus
// 20-paragraph chunk projections. Paragraph IDs are p000000-based seq scoped
// to a sourceId; every paragraph remains traceable via id/hash/seq.
export function canonicalizeSource(input: {
  sourceId: string;
  chapters: StagingChapter[];
  paragraphHash: (text: string) => string;
  chunkSize?: number;
}): CanonicalizedSource {
  const { sourceId, chapters } = input;
  if (!sourceId) throw new CanonicalError("canonicalizeSource requires a sourceId.");
  if (chapters.length === 0) throw new CanonicalError("There is nothing to approve.");
  const chunkSize = input.chunkSize ?? CHUNK_PARAGRAPH_COUNT;

  const paragraphs: Paragraph[] = [];
  let seq = 0;
  for (const chapter of chapters) {
    if (!chapter.chapterId) throw new CanonicalError("Every chapter needs a chapterId.");
    for (const entry of chapter.paragraphs) {
      const text = entry.text;
      if (!text || !text.trim()) {
        throw new CanonicalError(`Paragraph at seq ${seq} has no text.`);
      }
      if (seq > 999999) {
        throw new CanonicalError(
          `seq ${seq} overflows the supported p000000â€“p999999 ID range.`,
        );
      }
      const id = `p${String(seq).padStart(6, "0")}`;
      paragraphs.push(
        ParagraphSchema.parse({
          id,
          seq,
          page: entry.page,
          chapterId: chapter.chapterId,
          text,
          hash: entry.hash ?? input.paragraphHash(text),
          kind: entry.kind,
          isStory: entry.isStory,
        }),
      );
      seq += 1;
    }
  }

  const canonicalHash = hashParagraphs(paragraphs);
  const chunks = chunkParagraphs({ sourceId, canonicalHash, paragraphs, chunkSize });
  const storyParagraphCount = paragraphs.filter((p) => p.isStory).length;
  const wordCount = paragraphs.reduce((total, p) => total + wordCountOf(p.text), 0);
  return { paragraphs, canonicalHash, chunks, storyParagraphCount, wordCount };
}

// Split canonical paragraphs into source-versioned chunk projections.
// Physical chunk keys are source-versioned so the old active source stays
// selectable while the new source stages (plan section 4).
export function chunkParagraphs(input: {
  sourceId: string;
  canonicalHash: string;
  paragraphs: Paragraph[];
  chunkSize?: number;
}): TextChunk[] {
  const chunkSize = input.chunkSize ?? CHUNK_PARAGRAPH_COUNT;
  if (chunkSize < 1) throw new CanonicalError("chunkSize must be >= 1.");
  const chunks: TextChunk[] = [];
  for (let offset = 0; offset < input.paragraphs.length; offset += chunkSize) {
    const slice = input.paragraphs.slice(offset, offset + chunkSize);
    const index = chunks.length + 1;
    const pages = slice.map((p) => p.page).filter((page): page is number => page !== null);
    chunks.push(
      TextChunkSchema.parse({
        sourceId: input.sourceId,
        canonicalHash: input.canonicalHash,
        id: chunkIdFor(index),
        index,
        startPage: pages.length > 0 ? Math.min(...pages) : null,
        endPage: pages.length > 0 ? Math.max(...pages) : null,
        seqStart: slice[0]?.seq ?? 0,
        seqEnd: slice[slice.length - 1]?.seq ?? 0,
        paragraphs: slice,
      }),
    );
  }
  return chunks;
}

