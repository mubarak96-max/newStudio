import { z } from "zod";

import { CameraPoseSchema, HotspotSchema, IdSchema } from "./primitives.ts";

// Beat text selections use UTF-16 code-unit offsets, start inclusive and
// end exclusive, compared against exactly the canonical string (plan 3.1).
export const TextSelectionSchema = z.object({
  paragraphId: z.string().regex(/^p\d{6}$/),
  start: z.number().int().min(0),
  end: z.number().int().min(0),
  text: z.string().min(1),
});

export const DialogueSchema = TextSelectionSchema.extend({
  speakerEntityId: IdSchema,
  addresseeEntityId: IdSchema.optional(),
});

export const CommentarySchema = z.object({
  id: IdSchema,
  text: z.string().min(1),
  kind: z.enum(["scene", "context", "clarify"]),
  groundedIn: z.array(z.string().regex(/^p\d{6}$/)).min(1),
  verified: z.boolean(),
});

export const RepresentationSchema = z.object({
  paragraphId: z.string().regex(/^p\d{6}$/),
  modality: z.enum(["text", "visual", "camera", "transition"]),
  description: z.string().min(1),
});

export const BeatTextSchema = z.object({
  quote: TextSelectionSchema.optional(),
  dialogue: z
    .array(DialogueSchema.extend({ speakerDisplayName: z.string().min(1) }))
    .optional(),
  commentary: z.array(CommentarySchema).optional(),
});

export const BeatSchema = z.object({
  id: z.string().min(1),
  order: z.number().int().min(1),
  seq: z.number().int().min(0),
  type: z.enum(["quote", "dialogue", "commentary", "mixed", "title", "transition"]),
  text: BeatTextSchema,
  compositionId: IdSchema,
  camera: z.object({
    from: CameraPoseSchema,
    to: CameraPoseSchema,
    durationMs: z.number().int().positive(),
    easing: z.enum(["linear", "easeInOut", "spring"]),
    focusLayerId: IdSchema.optional(),
    focusEntityId: IdSchema.optional(),
    rationale: z.string().min(1),
  }),
  transitionIn: z.object({
    type: z.enum(["cut", "fade", "slide", "zoomThrough", "parallaxShift"]),
    durationMs: z.number().int().nonnegative(),
  }),
  inspectables: z.array(z.object({ entityId: IdSchema, hotspot: HotspotSchema })),
  autoAdvanceMs: z.number().int().positive().optional(),
  representations: z.array(RepresentationSchema).min(1),
});

export type TextSelection = z.infer<typeof TextSelectionSchema>;
export type Dialogue = z.infer<typeof DialogueSchema>;
export type Commentary = z.infer<typeof CommentarySchema>;
export type Representation = z.infer<typeof RepresentationSchema>;
export type Beat = z.infer<typeof BeatSchema>;

