import { z } from "zod";

import {
  AssetRefSchema,
  DepthAssetSchema,
  IdSchema,
  LineageSchema,
  ResponsiveSchema,
  SafeCameraSchema,
  TransformSchema,
} from "./primitives.ts";
import { ReferencePinSchema } from "./model.ts";

// Layer and Composition slice needed for preview/bundle work (plan 3.2).
// depthRange is [far, near] in [0, 1]; larger zOrder/z/depth is closer.
export const LayerSchema = z.object({
  layerId: IdSchema,
  role: z.enum(["background", "midground", "foreground"]),
  entityId: IdSchema.optional(),
  image: AssetRefSchema,
  mask: AssetRefSchema.optional(),
  depth: DepthAssetSchema.optional(),
  hiddenAreaImage: AssetRefSchema.optional(),
  zOrder: z.number().int().min(0),
  depthRange: z.tuple([
    z.number().min(0).max(1),
    z.number().min(0).max(1),
  ]),
  transform: TransformSchema,
  renderMode: z.enum(["plane", "depthMesh"]),
  mesh: z
    .object({
      segmentsX: z.number().int().min(1).max(256),
      segmentsY: z.number().int().min(1).max(256),
      displacementScale: z.number().finite(),
    })
    .optional(),
}).refine(
  (layer) => {
    if (layer.renderMode !== "depthMesh") return true;
    return (
      layer.depth !== undefined &&
      layer.mesh !== undefined &&
      Number.isFinite(layer.mesh.displacementScale)
    );
  },
  { message: "depthMesh requires aligned depth plus bounded mesh subdivisions" },
);

// Bundle-safe Composition subset: exactly the fields EpisodeBundle carries
// (Pick<Composition, "master" | "depth" | "layers" | "safeCamera" |
// "responsive">, plan 3.3).
export const BundleCompositionSchema = z.object({
  master: AssetRefSchema,
  depth: DepthAssetSchema.optional(),
  layers: z.array(LayerSchema).min(1),
  safeCamera: SafeCameraSchema,
  responsive: ResponsiveSchema,
});

export type Layer = z.infer<typeof LayerSchema>;
export type BundleComposition = z.infer<typeof BundleCompositionSchema>;

// Full editorial Composition (plan 3.2, ADR-007/ADR-011): source/reference
// pinned, reusable across episodes. usedIn owns the reuse relationship;
// Moment.compositionIds is derived. Regeneration creates a new revision;
// published snapshots keep their exact asset keys.
export const CompositionSchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  compositionId: IdSchema,
  revisionId: IdSchema,
  reuseKey: z.string().min(1),
  originEpisodeId: z.string().min(1),
  usedIn: z.array(
    z.object({
      episodeId: z.string().min(1),
      momentId: z.string().min(1),
      beatId: IdSchema,
      revisionId: IdSchema,
    }),
  ),
  shotSnapshot: z.object({
    shotId: IdSchema,
    description: z.string().min(1),
    entityStates: z.array(
      z.object({ entityId: IdSchema, stateId: IdSchema }),
    ),
    framing: z.string().min(1),
    mood: z.string().min(1),
    timeOfDay: z.string().min(1),
    reuseKey: z.string().min(1),
  }),
  entityStatesUsed: z.array(z.object({ entityId: IdSchema, stateId: IdSchema })),
  continuityRefs: z.array(z.string().min(1)),
  referenceVersions: z.array(ReferencePinSchema),
  visualProfileVersion: z.number().int().min(1),
  master: AssetRefSchema,
  depth: DepthAssetSchema.optional(),
  layers: z.array(LayerSchema).min(1),
  safeCamera: SafeCameraSchema,
  responsive: ResponsiveSchema,
  qa: z.object({
    textDetected: z.boolean(),
    agreementScore: z.number().nullable(),
    identityScores: z.record(z.string(), z.number()),
    issues: z.array(z.string().min(1)),
    continuityStatus: z.enum(["pending", "approved", "rejected"]),
    approvedBy: z.string().min(1).optional(),
    approvedAt: z.string().min(1).optional(),
  }),
  generation: z.object({
    provider: z.string().min(1),
    model: z.string().min(1),
    prompt: z.string().min(1),
    negativePrompt: z.string().min(1),
    seed: z.number().int().optional(),
    referenceKeys: z.array(z.string().min(1)),
    costUsd: z.number().nonnegative(),
  }),
  status: z.enum(["generated", "approved", "rejected", "composed", "published"]),
  createdAt: z.string().min(1),
  updatedAt: z.string().min(1),
});

export type Composition = z.infer<typeof CompositionSchema>;

