 278: function EditorialSettingsForm({
 279:   bookId,
 280:   settings,
 281:   actualCostUsd,
 282: }: {
 283:   bookId: string;
 284:   settings: EditorialSettings;
 285:   actualCostUsd: number;
 286: }) {
 287:   const [budgetUsd, setBudgetUsd] = useState(settings.budgetUsd);
 288:   const [models, setModels] = useState(settings.models);
 289:   const [busy, setBusy] = useState(false);
 290:   const [message, setMessage] = useState<string | null>(null);
 291: 
 292:   async function save() {
 293:     setBusy(true);
 294:     setMessage(null);
 295:     try {
 296:       const response = await fetch(`/api/books/${bookId}/settings`, {
 297:         method: 'PATCH',
 298:         headers: { 'Content-Type': 'application/json' },
 299:         body: JSON.stringify({ budgetUsd, models }),
 300:       });
 301:       const payload = response.status === 204 ? null : await response.json();
 302:       setMessage(response.ok ? 'Settings saved.' : payload?.error ?? 'Settings could not be saved.');
 303:     } finally {
 304:       setBusy(false);
 305:     }
 306:   }
 307: 
 308:   return (
 309:     <div className="flex flex-col gap-3 rounded-lg border border-black/[.08] bg-white p-4 text-sm dark:border-white/[.145] dark:bg-zinc-950">
 310:       <label className="flex flex-wrap items-center gap-2">
 311:         Book budget (USD)
 312:         <input type="number" min={0} step={0.01} value={budgetUsd} onChange={(event) => setBudgetUsd(Number(event.target.value))} className="w-32 rounded border border-black/[.1] bg-white px-2 py-1 dark:border-white/[.145] dark:bg-black" />
 313:         <span className="text-xs text-zinc-500">Actual spend ${actualCostUsd.toFixed(3)}. Zero means no cap.</span>
 314:       </label>
 315:       <div className="grid gap-2 lg:grid-cols-2">
 316:         {MODEL_TASKS.map((task) => (
 317:           <label key={task} className="flex flex-col gap-1 text-xs text-zinc-500">
 318:             {task}
 319:             <input value={models[task] ?? ''} placeholder={task.startsWith('images.') ? 'OPENROUTER_IMAGE_MODEL fallback' : 'OPENROUTER_MODEL fallback'} onChange={(event) => setModels((current) => ({ ...current, [task]: event.target.value }))} className="rounded border border-black/[.1] bg-white px-2 py-1 text-foreground dark:border-white/[.145] dark:bg-black" />
 320:           </label>
 321:         ))}
 322:       </div>
