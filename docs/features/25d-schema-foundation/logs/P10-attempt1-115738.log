  selectResponsiveCrop(harborResponsive, { w: 390, h: 844 }).aspect === "portrait" &&
    selectResponsiveCrop(harborResponsive, { w: 1280, h: 800 }).aspect === "landscape" &&
    isCropContained(harborResponsive.portraitCrop) &&
    isCropContained(harborResponsive.landscapeCrop) &&
    focalVisible(harborResponsive, harborResponsive.portraitCrop),
);
check(
  "Preview states stay explicit (loading/empty/error/outdated/partial/ready)",
  describePreviewState({ loaded: false, scopeExists: true }).state === "loading" &&
    describePreviewState({ loaded: true, scopeExists: false }).state === "empty" &&
    describePreviewState({ loaded: true, scopeExists: true, error: "x" }).state === "error" &&
    describePreviewState({ loaded: true, scopeExists: true, outdatedReason: "x" }).state === "outdated" &&
    describePreviewState({ loaded: true, scopeExists: true, missingLayerIds: ["L1"] }).state === "partial" &&
    describePreviewState({ loaded: true, scopeExists: true, missingCompositionIds: [], missingLayerIds: [] }).state ===
