// Paragraph-to-Beat coverage review (P7, ADR-002).
// Every story paragraph appears in a report linking source -> Moment ->
// Beat -> Representation. Non-story material stays classified and available
// as source but outside story coverage. Malformed coverage blocks approval.

import type { Beat } from "../schemas/beat.ts";

export type CoverageRow = {
  paragraphId: string;
  seq: number;
  beatIds: string[];
  modalities: string[];
  covered: boolean;
  meaningful: boolean;
};

export type CoverageReview = {
  momentId: string;
  rows: CoverageRow[];
  uncovered: string[];
  meaningless: string[];
};

/**
 * Build the complete paragraph-to-Beat coverage review for one Moment.
 * Pure and deterministic; no cloud, no paid calls.
 */
export function buildCoverageReview(args: {
  momentId: string;
  paragraphs: { id: string; seq: number; isStory: boolean }[];
  beats: Beat[];
}): CoverageReview {
  const { momentId, paragraphs, beats } = args;
  const story = [...paragraphs].filter((paragraph) => paragraph.isStory).sort((a, b) => a.seq - b.seq);
  const links = new Map<string, { beatIds: string[]; modalities: string[]; meaningful: boolean }>();
  for (const beat of beats) {
    for (const representation of beat.representations) {
      const entry = links.get(representation.paragraphId) ?? { beatIds: [], modalities: [], meaningful: false };
      if (!entry.beatIds.includes(beat.id)) entry.beatIds.push(beat.id);
      if (!entry.modalities.includes(representation.modality)) entry.modalities.push(representation.modality);
      if (representation.description.trim().length >= 12) entry.meaningful = true;
      links.set(representation.paragraphId, entry);
    }
  }
  const rows: CoverageRow[] = story.map((paragraph) => {
    const entry = links.get(paragraph.id);
    return {
      paragraphId: paragraph.id,
      seq: paragraph.seq,
      beatIds: entry?.beatIds ?? [],
      modalities: entry?.modalities ?? [],
      covered: (entry?.beatIds.length ?? 0) > 0,
      meaningful: entry?.meaningful ?? false,
    };
  });
  return {
    momentId,
    rows,
    uncovered: rows.filter((row) => !row.covered).map((row) => row.paragraphId),
    meaningless: rows.filter((row) => row.covered && !row.meaningful).map((row) => row.paragraphId),
  };
}

/**
 * Approval gate: malformed coverage blocks approval with an actionable
 * message naming the missing paragraph. Returns null when approvable.
 */
export function coverageApprovalProblem(review: CoverageReview): string | null {
  if (review.uncovered.length > 0) {
    return (
      `Coverage gap blocks approval: ${review.uncovered.join(", ")} ` +
      `has no Beat representation. Request an AI revision; arbitrary tagging cannot close it.`
    );
  }
  if (review.meaningless.length > 0) {
    return (
      `Coverage quality blocks approval: ${review.meaningless.join(", ")} ` +
      `is tagged without a meaningful description. Request an AI revision.`
    );
  }
  return null;
}

===== REPRESENTATIONS =====
// Representation validation (P7, ADR-002).
// Every story paragraph needs a meaningful Representation; arbitrary ID
// tagging is insufficient. Explicit/internal meaning that visuals cannot
// preserve must remain in HTML subtitles, so internal paragraphs require a
// text-modality link (quote/dialogue/commentary are text forms, not extra
// Representation.modality values).

import type { Beat } from "../schemas/beat.ts";

export type RepresentationProblem = {
  paragraphId?: string;
  beatId?: string;
  message: string;
};

const GENERIC_DESCRIPTIONS = new Set([
  "todo",
  "placeholder",
  "tbd",
  "fixme",
  "visual",
  "image",
  "scene",
  "n/a",
]);

function isMeaningful(description: string): boolean {
  const trimmed = description.trim();
  if (trimmed.length < 12) return false;
  return !GENERIC_DESCRIPTIONS.has(trimmed.toLowerCase());
}

/**
 * Check paragraph-to-Beat representation links. storyParagraphIds are the
 * story paragraphs owned by the Moment; internalParagraphIds carry explicit
 * or internal meaning that must survive in subtitle text.
 */
export function validateRepresentations(args: {
  beats: Beat[];
  storyParagraphIds: string[];
  internalParagraphIds?: string[];
}): RepresentationProblem[] {
  const { beats, storyParagraphIds, internalParagraphIds = [] } = args;
  const problems: RepresentationProblem[] = [];

  if (beats.some((beat, index) => beat.order !== index + 1)) {
    problems.push({ message: "Beat order must run 1..N to preserve source order." });
  }
  for (let index = 1; index < beats.length; index += 1) {
    if (beats[index].seq < beats[index - 1].seq) {
      problems.push({
        beatId: beats[index].id,
        message: `Beat ${beats[index].id} breaks source order at seq ${beats[index].seq}.`,
      });
    }
  }

  const byParagraph = new Map<string, Beat[]>();
  for (const beat of beats) {
    for (const representation of beat.representations) {
      const list = byParagraph.get(representation.paragraphId) ?? [];
      list.push(beat);
      byParagraph.set(representation.paragraphId, list);
      if (!isMeaningful(representation.description)) {
        problems.push({
          paragraphId: representation.paragraphId,
          beatId: beat.id,
          message:
            `Beat ${beat.id} tags ${representation.paragraphId} without a meaningful ` +
            `description; arbitrary ID tagging cannot satisfy coverage.`,
        });
      }
    }
  }

  for (const paragraphId of storyParagraphIds) {
    if (!byParagraph.has(paragraphId)) {
      problems.push({
        paragraphId,
        message: `${paragraphId} has no Representation; every story paragraph needs one (ADR-002).`,
      });
    }
  }

  for (const paragraphId of internalParagraphIds) {
    const carriers = byParagraph.get(paragraphId) ?? [];
    const inSubtitles = carriers.some(
      (beat) =>
        beat.representations.some(
          (representation) =>
            representation.paragraphId === paragraphId && representation.modality === "text",
        ) ||
        beat.text.quote?.paragraphId === paragraphId ||
        (beat.text.dialogue ?? []).some((line) => line.paragraphId === paragraphId) ||
        (beat.text.commentary ?? []).some((note) => note.groundedIn.includes(paragraphId)),
    );
    if (!inSubtitles) {
      problems.push({
        paragraphId,
        message:
          `${paragraphId} carries internal meaning with no subtitle text; ` +
          `a camera pan alone cannot stand in for an unexpressed thought.`,
      });
    }
  }

  return problems;
}

===== RESOLVE FRAME =====
import type { EpisodeBundle } from "../schemas/bundle.ts";
import type { CameraPose } from "../schemas/primitives.ts";
import { beatSubtitleHtml, beatSubtitleText } from "./subtitles.ts";

export interface ResolvedLayerOffset {
  layerId: string;
  dx: number;
  dy: number;
}

export interface ResolvedFrame {
  beatId: string;
  progress: number;
  pose: CameraPose;
  subtitleText: string;
  subtitleHtml: string;
  layerOffsets: ResolvedLayerOffset[];
}

function clamp01(value: number): number {
  if (!Number.isFinite(value)) return 0;
  return Math.min(1, Math.max(0, value));
}

function applyEasing(easing: string, t: number): number {
  if (easing === "easeInOut") return t * t * (3 - 2 * t);
  if (easing === "spring") {
    const eased = 1 - Math.exp(-6 * t) * Math.cos(9 * t);
    return Math.min(1, Math.max(0, eased));
  }
  return t;
}

function lerp(from: number, to: number, t: number): number {
  return from + (to - from) * t;
}

// Pure preview seam (P2 test seam): resolve the camera pose, subtitle HTML
// and per-layer parallax offsets for one Beat at progress 0..1. No DOM,
// no WebGL, no cloud. Nearer layers (larger zOrder) shift more.
export function resolveFrame(
  bundle: EpisodeBundle,
  beatId: string,
  progress: number,
): ResolvedFrame {
  const beat = bundle.beats.find((candidate) => candidate.id === beatId);
  if (!beat) throw new Error(`Unknown beat ${beatId} for episode ${bundle.episodeId}.`);
  const composition = bundle.compositions[beat.compositionId];
  if (!composition) {
    throw new Error(`Beat ${beatId} references missing composition ${beat.compositionId}.`);
  }
  const t = applyEasing(beat.camera.easing, clamp01(progress));
  const pose: CameraPose = {
    x: lerp(beat.camera.from.x, beat.camera.to.x, t),
    y: lerp(beat.camera.from.y, beat.camera.to.y, t),
    zoom: lerp(beat.camera.from.zoom, beat.camera.to.zoom, t),
    rotate: lerp(beat.camera.from.rotate, beat.camera.to.rotate, t),
  };
  const ordered = [...composition.layers].sort((a, b) => a.zOrder - b.zOrder);
  const maxOrder = Math.max(...ordered.map((layer) => layer.zOrder), 0);
  const layerOffsets = ordered.map((layer) => {
    const nearness = maxOrder === 0 ? 0 : layer.zOrder / maxOrder;
    const factor = 0.35 + 0.65 * nearness;
    return { layerId: layer.layerId, dx: -pose.x * factor, dy: -pose.y * factor };
  });
  return {
    beatId,
    progress: clamp01(progress),
    pose,
    subtitleText: beatSubtitleText(beat),
    subtitleHtml: beatSubtitleHtml(beat),
    layerOffsets,
  };
}

===== SAFE CAMERA =====
// Deterministic safe-camera computation (P9, plan 3.2, ADR-008).
// safeCamera is computed from actual opaque/background coverage, crop and
// aspect, all layer movement, rotation and displacement limits. Metadata
// claims alone are not proof of hole-free motion: a background without the
// required overscan yields zero pan/zoom headroom and blocks approval.
// AI replans or regeneration resolves unsafe shots; the owner never fixes
// camera directions (ADR-003).

import type { CameraPose, SafeCamera } from "../schemas/primitives.ts";
import { SafeCameraSchema } from "../schemas/primitives.ts";

export type CameraFrame = {
  /** Explicit composition canvas all layers share (plan 3.2). */
  w: number;
  h: number;
  /** Required background overscan beyond the viewport (px). */
  overscan: number;
};

export type LayerCoverage = {
  layerId: string;
  role: "background" | "midground" | "foreground";
  /** Background overscan actually present beyond the viewport (px). */
  overscanPresentPx?: number;
  /** True when the delivered bytes carry a real alpha channel. */
  hasAlpha?: boolean;
  /** depthMesh displacement scale; planes omit it. */
  displacementScale?: number;
};

function round4(value: number): number {
  return Math.round(value * 10000) / 10000;
}

/**
 * Compute motion limits from actual layer/background coverage and depth
 * displacement. Pan headroom is the scarcest background overscan expressed
 * as a fraction of the canvas; zoom headroom scales with overscan over the
 * shorter canvas side; tilt shrinks when depth displacement grows.
 */
export function computeSafeCamera(args: {
  frame: CameraFrame;
  coverages: LayerCoverage[];
}): SafeCamera {
  const backgrounds = args.coverages.filter((coverage) => coverage.role === "background");
  const minOverscan =
    backgrounds.length === 0
      ? 0
      : Math.min(...backgrounds.map((coverage) => coverage.overscanPresentPx ?? 0));
  const holeFree = backgrounds.length > 0 && minOverscan >= args.frame.overscan;
  const displacements = args.coverages.map((coverage) => coverage.displacementScale ?? 0);
  const maxDisplacement = displacements.length === 0 ? 0 : Math.max(...displacements);
  return SafeCameraSchema.parse({
    maxPanX: holeFree ? round4(minOverscan / args.frame.w) : 0,
    maxPanY: holeFree ? round4(minOverscan / args.frame.h) : 0,
    maxZoom: holeFree
      ? round4(1 + Math.min(0.5, minOverscan / Math.min(args.frame.w, args.frame.h)))
      : 1,
    maxTilt: maxDisplacement > 0.25 ? 0.02 : 0.08,
  });
}

/** True when every planned pose component sits inside the safe bounds. */
export function isCameraSafe(pose: CameraPose, safe: SafeCamera): boolean {
  return (
    Math.abs(pose.x) <= safe.maxPanX &&
    Math.abs(pose.y) <= safe.maxPanY &&
    pose.zoom >= 1 &&
    pose.zoom <= safe.maxZoom &&
    Math.abs(pose.rotate) <= safe.maxTilt
  );
}

function clamp(value: number, min: number, max: number): number {
  return Math.min(max, Math.max(min, value));
}

/** Clamp one AI-planned pose into the computed safe bounds. */
export function clampCameraPose(pose: CameraPose, safe: SafeCamera): CameraPose {
  return {
    x: clamp(pose.x, -safe.maxPanX, safe.maxPanX),
    y: clamp(pose.y, -safe.maxPanY, safe.maxPanY),
    zoom: clamp(pose.zoom, 1, safe.maxZoom),
    rotate: clamp(pose.rotate, -safe.maxTilt, safe.maxTilt),
  };
}

/**
 * AI replan for an unsafe shot: clamp into the safe bounds and report
 * whether the plan changed. The owner never edits camera values directly.
 */
export function replanCameraToSafe(
  pose: CameraPose,
  safe: SafeCamera,
): { pose: CameraPose; replanned: boolean } {
  const clamped = clampCameraPose(pose, safe);
  const replanned =
    clamped.x !== pose.x ||
    clamped.y !== pose.y ||
    clamped.zoom !== pose.zoom ||
    clamped.rotate !== pose.rotate;
  return { pose: clamped, replanned };
}

/** Blocking camera issues for the poses planned against one composition. */
export function safeCameraApprovalProblem(args: {
  compositionId: string;
  poses: { beatId: string; from: CameraPose; to: CameraPose }[];
  safe: SafeCamera;
}): string | null {
  for (const pose of args.poses) {
    if (!isCameraSafe(pose.from, args.safe) || !isCameraSafe(pose.to, args.safe)) {
      return (
        `Composition ${args.compositionId} is unsafe for Beat ${pose.beatId}: ` +
        `the planned camera leaves the computed safe bounds. Request AI replan or regenerate the layer.`
      );
    }
  }
  return null;
}


