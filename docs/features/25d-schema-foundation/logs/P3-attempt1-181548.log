route.ts
import { FieldValue } from 'firebase-admin/firestore';
import { NextResponse } from 'next/server';

import { getSession } from '@/features/auth/session';
import { adminDb } from '@/services/firebase/admin';
import { EditError } from '@/features/sources/edit-ops';
import {
  chaptersRef,
  countParagraphs,
  MAX_CHAPTERS_PER_TRANSACTION,
  readChapters,
  sourceRef,
  uncertaintiesRef,
} from '@/features/sources/store';
import { isEditable, revisionParagraphIds, type SourceStatus } from '@/features/sources/types';

export async function POST(
  _request: Request,
  context: RouteContext<'/api/books/[bookId]/sources/[sourceId]/approve'>
) {
  const session = await getSession();
  if (!session) {
    return NextResponse.json({ error: 'Not signed in.' }, { status: 401 });
  }

  const { bookId, sourceId } = await context.params;
  const source = sourceRef(bookId, sourceId);
  const chapters = chaptersRef(bookId, sourceId);
  const book = adminDb().collection('books').doc(bookId);

  try {
    let outdatedSourceId: string | null = null;
    await adminDb().runTransaction(async (tx) => {
      const snapshot = await tx.get(source);
      if (!snapshot.exists) throw new EditError('Source not found.');

      const status = snapshot.get('status') as SourceStatus;
      if (!isEditable(status)) {
        throw new EditError(
          status === 'approved'
            ? 'This extraction is already approved.'
            : `The extraction is ${status} and cannot be approved.`
        );
      }

      const blocking = await tx.get(
        uncertaintiesRef(bookId, sourceId)
          .where('status', '==', 'open')
          .where('severity', '==', 'blocking')
      );
      if (!blocking.empty) {
        throw new EditError(
          `${blocking.size} serious uncertaint${blocking.size === 1 ? 'y' : 'ies'} must be resolved before approval.`
        );
      }

      const existing = await readChapters(tx, chapters);
      if (existing.length === 0) {
        throw new EditError('There is nothing to approve.');
      }
      if (existing.length > MAX_CHAPTERS_PER_TRANSACTION) {
        throw new EditError('This source has too many chapters to approve in one step.');
      }

      const baseSourceId = (snapshot.get('baseSourceId') ?? null) as string | null;
      const baseParagraphIds = baseSourceId
        ? (await readChapters(tx, chaptersRef(bookId, baseSourceId))).flatMap((chapter) =>
            chapter.paragraphs.map((paragraph) => paragraph.id)
          )
        : [];
      const paragraphIds = revisionParagraphIds(countParagraphs(existing), baseParagraphIds);

      let index = 0;
      for (const chapter of existing) {
        tx.set(chapters.doc(chapter.id), {
          order: chapter.order,
          title: chapter.title,
          href: chapter.href,
          paragraphs: chapter.paragraphs.map((paragraph) => ({
            ...paragraph,
            id: paragraphIds[index++],
          })),
        });
      }

      if (baseSourceId) {
        outdatedSourceId = baseSourceId;
        tx.update(sourceRef(bookId, baseSourceId), {
          dependentWorkStatus: 'outdated',
          supersededBy: sourceId,
          outdatedAt: FieldValue.serverTimestamp(),
        });
      }

      tx.update(source, {
        status: 'approved',
        dependentWorkStatus: 'current',
        idsFrozen: true,
        chapterCount: existing.length,
        paragraphCount: countParagraphs(existing),
        paragraphIds,
        approvedAt: FieldValue.serverTimestamp(),
        approvedBy: session.email,
      });
      tx.update(book, {
        status: 'approved',
        activeSourceId: sourceId,
        currentSourceId: sourceId,
        currentRevision: Number(snapshot.get('revision') ?? 1),
        updatedAt: FieldValue.serverTimestamp(),
      });
    });
    if (outdatedSourceId) {
      await markImageCandidatesOutdated(bookId, outdatedSourceId, sourceId);
    }
  } catch (error) {
    if (error instanceof EditError) {
      return NextResponse.json({ error: error.message }, { status: 409 });
    }
    throw error;
