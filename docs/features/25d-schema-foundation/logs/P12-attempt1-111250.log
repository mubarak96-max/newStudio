// Bible â†’ Book Model derived context (P5, plan 10).
// Supported terminology and chapter summaries are kept as derived context
// for the understanding pass rather than silently discarded. Generic
// character/location/object/event entries are NOT carried over: the typed
// Entity/Event model replaces them (CONTEXT.md inspected legacy vocabulary).

import type { BibleEntry } from "./types.ts";
import { toDerivedContext } from "../book-experience/book-model/derived.ts";

export function bibleToDerivedContext(entries: BibleEntry[]) {
  const terminology = entries
    .filter((entry) => entry.kind === "term")
    .map((entry) => ({
      term: entry.name,
      definition: Object.values(entry.fields)[0]?.value ?? "",
      paragraphIds: Object.values(entry.fields)[0]?.evidence ?? [],
    }))
    .filter((entry) => entry.definition.trim() !== "" && entry.paragraphIds.length > 0);
  const chapterSummaries = entries
    .filter((entry) => entry.kind === "chapter")
    .map((entry) => ({
      chapterId: entry.name,
      summary: Object.values(entry.fields)[0]?.value ?? "",
    }))
    .filter((entry) => entry.summary.trim() !== "");
  return toDerivedContext({ terminology, chapterSummaries });
}

