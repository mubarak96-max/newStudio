+++ b/src/features/book-experience/publishing/reader.ts
@@ -0,0 +1,64 @@
+import type { EpisodeBundle } from "../schemas/bundle.ts";
+import type { BookCatalog, EpisodeManifest } from "../schemas/publishing.ts";
+
+export type ReaderSessionPin = {
+  bookId: string;
+  catalogVersion: number;
+  episodeId: string;
+  episodeVersion: number;
+  bundleUrl: string;
+  manifestUrl: string;
+};
+
+export function pinReaderSession(catalog: BookCatalog, episodeId: string): ReaderSessionPin {
+  const episode = catalog.episodes.find((candidate) => candidate.episodeId === episodeId);
+  if (!episode) throw new Error(`Episode ${episodeId} is not available in BookCatalog v${catalog.version}.`);
+  return {
+    bookId: catalog.bookId,
+    catalogVersion: catalog.version,
+    episodeId,
+    episodeVersion: episode.version,
+    bundleUrl: episode.bundleUrl,
+    manifestUrl: episode.manifestUrl,
+  };
+}
+
+export function discoverCatalogNeighbor(
+  catalog: BookCatalog,
+  episodeId: string,
+  direction: "previous" | "next",
+): BookCatalog["episodes"][number] | null {
+  const ordered = [...catalog.episodes].sort((left, right) => left.order - right.order);
+  const index = ordered.findIndex((episode) => episode.episodeId === episodeId);
+  if (index < 0) return null;
+  return ordered[index + (direction === "next" ? 1 : -1)] ?? null;
+}
+
+export type ProgressResolution =
+  | { status: "stable" | "anchored" | "seq-fallback"; beatId: string; seq: number }
+  | { status: "unresolved"; reason: string };
+
+export function resolveProgressAnchor(args: {
+  from: { sourceId: string; version: number; beatId: string; seq: number };
+  targetBundle: EpisodeBundle;
+  targetManifest: EpisodeManifest;
+}): ProgressResolution {
+  if (args.from.sourceId !== args.targetBundle.sourceId) {
+    return { status: "unresolved", reason: "Cross-source progress needs an explicit source migration." };
+  }
+  const stable = args.targetBundle.beats.find((beat) => beat.id === args.from.beatId);
+  if (stable) return { status: "stable", beatId: stable.id, seq: stable.seq };
+  const anchor = args.targetManifest.progressAnchors.find(
+    (candidate) => candidate.fromVersion === args.from.version && candidate.fromBeatId === args.from.beatId,
+  );
+  if (anchor) {
+    const target = args.targetBundle.beats.find((beat) => beat.id === anchor.toBeatId);
+    if (!target) return { status: "unresolved", reason: `Progress anchor target ${anchor.toBeatId} is missing.` };
+    return { status: "anchored", beatId: target.id, seq: anchor.seq };
+  }
+  const ordered = [...args.targetBundle.beats].sort((left, right) => left.seq - right.seq || left.order - right.order);
+  const target = ordered.find((beat) => beat.seq >= args.from.seq) ?? ordered.at(-1);
+  return target
+    ? { status: "seq-fallback", beatId: target.id, seq: target.seq }
+    : { status: "unresolved", reason: "The target Episode has no Beats." };
+}
diff --git a/src/features/book-experience/publishing/repository.ts b/src/features/book-experience/publishing/repository.ts
new file mode 100644
index 0000000000000000000000000000000000000000..94f862c6984f5bab753dd277d3440a68699a6dd4
--- /dev/null
+++ b/src/features/book-experience/publishing/repository.ts
@@ -0,0 +1,184 @@
+import type { EpisodeBundle } from "../schemas/bundle.ts";
+import type { ReferencePin } from "../schemas/model.ts";
+import type { BookCatalog, EpisodeManifest, PublishedPointer } from "../schemas/publishing.ts";
+
+export type RevisionStatus = "ready" | "approved" | "published";
+
+export type PublicationRevision = {
+  bookId: string;
+  episodeId: string;
+  version: number;
+  revisionId: string;
+  sourceId: string;
+  canonicalHash: string;
+  fingerprint: string;
+  bundleKey: string;
+  manifestKey: string;
+  bundleUrl: string;
+  manifestUrl: string;
+  sizeBytes: number;
+  referencePins: ReferencePin[];
+  bundle: EpisodeBundle;
+  manifest: EpisodeManifest;
+  expectedPriorVersion: number | null;
+  status: RevisionStatus;
+  approvedBy?: string;
+  approvedAt?: string;
+};
+
+export type PublicationState = {
+  pointer: PublishedPointer | null;
+  catalog: BookCatalog | null;
+  catalogKey: string | null;
+};
+
+export type PromotionCommit = {
+  bookId: string;
+  episodeId: string;
+  revision: PublicationRevision;
+  pointer: PublishedPointer;
+  catalog: BookCatalog;
+  catalogKey: string;
+  expectedPriorVersion: number | null;
+  expectedCatalogVersion: number;
+};
+
+export interface PublishingRepository {
+  saveRevision(revision: PublicationRevision): Promise<void>;
+  revision(bookId: string, episodeId: string, version: number): Promise<PublicationRevision | null>;
+  approveRevision(args: {
+    bookId: string;
+    episodeId: string;
+    version: number;
+    fingerprint: string;
+    approvedBy: string;
+    approvedAt: string;
+  }): Promise<PublicationRevision>;
+  state(bookId: string, episodeId: string): Promise<PublicationState>;
+  promote(commit: PromotionCommit): Promise<void>;
+  withdraw(args: {
+    bookId: string;
+    episodeId: string;
+    catalog: BookCatalog;
+    catalogKey: string;
+    expectedPriorVersion: number;
+    expectedCatalogVersion: number;
+  }): Promise<void>;
+}
+
+export class PublicationConflict extends Error {}
+
+export class FakePublishingRepository implements PublishingRepository {
+  readonly revisions = new Map<string, PublicationRevision>();
+  readonly pointers = new Map<string, PublishedPointer>();
+  readonly catalogs = new Map<string, BookCatalog>();
+  readonly catalogKeys = new Map<string, string>();
+
+  async saveRevision(revision: PublicationRevision): Promise<void> {
+    const key = revisionKey(revision.bookId, revision.episodeId, revision.version);
+    const existing = this.revisions.get(key);
+    if (existing) {
+      if (existing.fingerprint !== revision.fingerprint) {
+        throw new Error(`Revision ${key} is immutable.`);
+      }
+      return;
+    }
+    this.revisions.set(key, clone(revision));
+  }
+
+  async revision(bookId: string, episodeId: string, version: number): Promise<PublicationRevision | null> {
+    return cloneOrNull(this.revisions.get(revisionKey(bookId, episodeId, version)));
+  }
+
+  async approveRevision(args: {
+    bookId: string;
+    episodeId: string;
+    version: number;
+    fingerprint: string;
+    approvedBy: string;
+    approvedAt: string;
+  }): Promise<PublicationRevision> {
+    const key = revisionKey(args.bookId, args.episodeId, args.version);
+    const revision = this.revisions.get(key);
+    if (!revision) throw new Error(`Revision ${key} was not uploaded and verified.`);
+    if (revision.fingerprint !== args.fingerprint) {
+      throw new PublicationConflict(`Revision ${key} changed after preview; compare it again.`);
+    }
+    if (revision.status === "published") return clone(revision);
+    const approved = {
+      ...revision,
+      status: "approved" as const,
+      approvedBy: args.approvedBy,
+      approvedAt: args.approvedAt,
+    };
+    this.revisions.set(key, clone(approved));
+    return clone(approved);
+  }
+
+  async state(bookId: string, episodeId: string): Promise<PublicationState> {
+    return {
+      pointer: cloneOrNull(this.pointers.get(pointerKey(bookId, episodeId))),
+      catalog: cloneOrNull(this.catalogs.get(bookId)),
+      catalogKey: this.catalogKeys.get(bookId) ?? null,
+    };
+  }
+
+  async promote(commit: PromotionCommit): Promise<void> {
+    const state = await this.state(commit.bookId, commit.episodeId);
+    const actualPrior = state.pointer?.version ?? null;
+    const actualCatalog = state.catalog?.version ?? 0;
+    if (actualPrior !== commit.expectedPriorVersion || actualCatalog !== commit.expectedCatalogVersion) {
+      throw new PublicationConflict(
+        `Publication compare-and-swap failed: expected Episode ${String(commit.expectedPriorVersion)} / catalog ${commit.expectedCatalogVersion}, ` +
+          `found Episode ${String(actualPrior)} / catalog ${actualCatalog}.`,
+      );
+    }
+    const stored = this.revisions.get(revisionKey(commit.bookId, commit.episodeId, commit.revision.version));
+    if (!stored || (stored.status !== "approved" && stored.status !== "published")) {
+      throw new Error(`Revision ${commit.revision.version} needs explicit replacement approval.`);
+    }
+    if (stored.fingerprint !== commit.revision.fingerprint) {
+      throw new PublicationConflict("The approved revision fingerprint no longer matches the promotion candidate.");
+    }
+    this.pointers.set(pointerKey(commit.bookId, commit.episodeId), clone(commit.pointer));
+    this.catalogs.set(commit.bookId, clone(commit.catalog));
+    this.catalogKeys.set(commit.bookId, commit.catalogKey);
+    this.revisions.set(
+      revisionKey(commit.bookId, commit.episodeId, commit.revision.version),
+      clone({ ...stored, status: "published" as const }),
+    );
+  }
+
+  async withdraw(args: {
+    bookId: string;
+    episodeId: string;
+    catalog: BookCatalog;
+    catalogKey: string;
+    expectedPriorVersion: number;
+    expectedCatalogVersion: number;
+  }): Promise<void> {
+    const state = await this.state(args.bookId, args.episodeId);
+    if (state.pointer?.version !== args.expectedPriorVersion || (state.catalog?.version ?? 0) !== args.expectedCatalogVersion) {
+      throw new PublicationConflict("Withdrawal compare-and-swap failed; refresh the Published revision.");
+    }
+    this.pointers.delete(pointerKey(args.bookId, args.episodeId));
+    this.catalogs.set(args.bookId, clone(args.catalog));
+    this.catalogKeys.set(args.bookId, args.catalogKey);
+  }
+}
+
+function revisionKey(bookId: string, episodeId: string, version: number): string {
+  return `${bookId}:${episodeId}:v${version}`;
+}
+
+function pointerKey(bookId: string, episodeId: string): string {
+  return `${bookId}:${episodeId}`;
+}
+
+function clone<T>(value: T): T {
+  return structuredClone(value);
+}
+
+function cloneOrNull<T>(value: T | undefined): T | null {
+  return value === undefined ? null : clone(value);
+}
diff --git a/src/features/book-experience/publishing/revisions.ts b/src/features/book-experience/publishing/revisions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c25b995b4fd4440f47211e0718d76190b103be0b
--- /dev/null
+++ b/src/features/book-experience/publishing/revisions.ts
@@ -0,0 +1,192 @@
+import type { EpisodeBundle } from "../schemas/bundle.ts";
+import type { Composition } from "../schemas/composition.ts";
+import type { ReferencePin } from "../schemas/model.ts";
+import { stableStringify } from "./bundle.ts";
+
+export type PreviewMode = "Published" | "Working revision" | "Compare";
+
+export type RevisionCandidate = {
+  bundle: EpisodeBundle;
+  referencePins: ReferencePin[];
+  invalidatedApprovals: string[];
+};
+
+export type RevisionComparison = {
+  changedBeatIds: string[];
+  changedCompositionIds: string[];
+  changedVisualKeys: string[];
+  changedReferencePins: string[];
+  invalidatedApprovals: string[];
+};
+
+export type RevisionPreviewState =
+  | { mode: "Published"; primary: EpisodeBundle; comparison: null }
+  | { mode: "Working revision"; primary: EpisodeBundle; comparison: null }
+  | { mode: "Compare"; primary: EpisodeBundle; secondary: EpisodeBundle; comparison: RevisionComparison };
+
+export function buildRevisionPreview(args: {
+  mode: PreviewMode;
+  published: RevisionCandidate | null;
+  working: RevisionCandidate;
+}): RevisionPreviewState {
+  if (args.mode === "Published") {
+    if (!args.published) throw new Error("There is no Published revision to preview.");
+    return { mode: "Published", primary: args.published.bundle, comparison: null };
+  }
+  if (args.mode === "Working revision") {
+    return { mode: "Working revision", primary: args.working.bundle, comparison: null };
+  }
+  if (!args.published) throw new Error("Compare needs both Published and Working revisions.");
+  return {
+    mode: "Compare",
+    primary: args.published.bundle,
+    secondary: args.working.bundle,
+    comparison: compareRevisions(args.published, args.working),
+  };
+}
+
+export function compareRevisions(published: RevisionCandidate, working: RevisionCandidate): RevisionComparison {
+  if (published.bundle.episodeId !== working.bundle.episodeId) {
+    throw new Error("Published and Working revisions must belong to the same Episode.");
+  }
+  const publishedBeats = new Map(published.bundle.beats.map((beat) => [beat.id, beat]));
+  const workingBeats = new Map(working.bundle.beats.map((beat) => [beat.id, beat]));
+  const changedBeatIds = unionKeys(publishedBeats, workingBeats).filter(
+    (id) => stableStringify(publishedBeats.get(id)) !== stableStringify(workingBeats.get(id)),
+  );
+  const publishedCompositions = new Map(Object.entries(published.bundle.compositions));
+  const workingCompositions = new Map(Object.entries(working.bundle.compositions));
+  const changedCompositionIds = unionKeys(publishedCompositions, workingCompositions).filter(
+    (id) => stableStringify(publishedCompositions.get(id)) !== stableStringify(workingCompositions.get(id)),
+  );
+  return {
+    changedBeatIds,
+    changedCompositionIds,
+    changedVisualKeys: symmetricDifference(assetKeys(published.bundle), assetKeys(working.bundle)),
+    changedReferencePins: symmetricDifference(
+      published.referencePins.map(referencePinValue),
+      working.referencePins.map(referencePinValue),
+    ),
+    invalidatedApprovals: [...new Set(working.invalidatedApprovals)].sort(),
+  };
+}
+
+export function localizedRegenerationInvalidation(args: {
+  workingBundle: EpisodeBundle;
+  compositions: Composition[];
+  changedAssetVersionIds?: string[];
+  changedReferencePins?: { entityId: string; stateId?: string }[];
+}): { affectedCompositionIds: string[]; affectedBeatIds: string[]; invalidatedApprovals: string[] } {
+  const changedAssets = new Set(args.changedAssetVersionIds ?? []);
+  const changedPins = new Set(
+    (args.changedReferencePins ?? []).map((pin) => `${pin.entityId}:${pin.stateId ?? "base"}`),
+  );
+  const affectedCompositionIds = args.compositions
+    .filter((composition) => {
+      const assets = compositionAssetVersionIds(composition);
+      const pins = composition.referenceVersions.map((pin) => `${pin.entityId}:${pin.stateId ?? "base"}`);
+      return assets.some((id) => changedAssets.has(id)) || pins.some((key) => changedPins.has(key));
+    })
+    .map((composition) => composition.compositionId)
+    .filter((id) => args.workingBundle.compositions[id] !== undefined)
+    .sort();
+  const affected = new Set(affectedCompositionIds);
+  const affectedBeatIds = args.workingBundle.beats
+    .filter((beat) => affected.has(beat.compositionId))
+    .map((beat) => beat.id);
+  return {
+    affectedCompositionIds,
+    affectedBeatIds,
+    invalidatedApprovals: affectedCompositionIds.map((id) => `composition:${id}`),
+  };
+}
+
+export function replaceWorkingComposition(args: {
+  publishedBundle: EpisodeBundle;
+  workingBundle: EpisodeBundle;
+  previousCompositionId: string;
+  replacement: Composition;
+  affectedBeatIds: string[];
+  nextVersion: number;
+  nextRevisionId: string;
+}): EpisodeBundle {
+  if (args.workingBundle.version === args.publishedBundle.version) {
+    throw new Error("A replacement must use a new Working revision version.");
+  }
+  if (args.nextVersion <= args.publishedBundle.version) {
+    throw new Error("A Working revision version must be newer than Published.");
+  }
+  const affected = new Set(args.affectedBeatIds);
+  const beats = args.workingBundle.beats.map((beat) => {
+    if (!affected.has(beat.id)) return beat;
+    if (beat.compositionId !== args.previousCompositionId) {
+      throw new Error(`Beat ${beat.id} is not pinned to ${args.previousCompositionId}.`);
+    }
+    return { ...beat, compositionId: args.replacement.compositionId };
+  });
+  const compositions = structuredClone(args.workingBundle.compositions);
+  compositions[args.replacement.compositionId] = {
+    master: args.replacement.master,
+    ...(args.replacement.depth ? { depth: args.replacement.depth } : {}),
+    layers: args.replacement.layers,
+    safeCamera: args.replacement.safeCamera,
+    responsive: args.replacement.responsive,
+  };
+  if (!beats.some((beat) => beat.compositionId === args.previousCompositionId)) {
+    delete compositions[args.previousCompositionId];
+  }
+  return {
+    ...args.workingBundle,
+    version: args.nextVersion,
+    revisionId: args.nextRevisionId,
+    beats,
+    compositions,
+  };
+}
+
+function assetKeys(bundle: EpisodeBundle): string[] {
+  const keys = new Set<string>();
+  const add = (asset: { key: string; variants?: { mobile: string; desktop: string } }): void => {
+    keys.add(asset.key);
+    for (const key of Object.values(asset.variants ?? {})) keys.add(key);
+  };
+  for (const composition of Object.values(bundle.compositions)) {
+    add(composition.master);
+    if (composition.depth) add(composition.depth);
+    for (const layer of composition.layers) {
+      add(layer.image);
+      if (layer.mask) add(layer.mask);
+      if (layer.depth) add(layer.depth);
+      if (layer.hiddenAreaImage) add(layer.hiddenAreaImage);
+    }
+  }
+  return [...keys].sort();
+}
+
+function compositionAssetVersionIds(composition: Composition): string[] {
+  const ids = [composition.master.assetVersionId];
+  if (composition.depth) ids.push(composition.depth.assetVersionId);
+  for (const layer of composition.layers) {
+    ids.push(layer.image.assetVersionId);
+    if (layer.mask) ids.push(layer.mask.assetVersionId);
+    if (layer.depth) ids.push(layer.depth.assetVersionId);
+    if (layer.hiddenAreaImage) ids.push(layer.hiddenAreaImage.assetVersionId);
+  }
+  return ids;
+}
+
+function referencePinValue(pin: ReferencePin): string {
+  return `${pin.entityId}:${pin.stateId ?? "base"}:v${pin.version}:${pin.checksum}`;
+}
+
+function symmetricDifference(left: string[], right: string[]): string[] {
+  const leftSet = new Set(left);
+  const rightSet = new Set(right);
+  return [...new Set([...left, ...right])]
+    .filter((value) => leftSet.has(value) !== rightSet.has(value))
+    .sort();
+}
+
+function unionKeys<T>(left: Map<string, T>, right: Map<string, T>): string[] {
+  return [...new Set([...left.keys(), ...right.keys()])].sort();
+}
diff --git a/src/features/book-experience/publishing/service.ts b/src/features/book-experience/publishing/service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f4ad5153095d741d0a93afa2da4c137ac16d6eca
--- /dev/null
+++ b/src/features/book-experience/publishing/service.ts
@@ -0,0 +1,239 @@
+import type { BookCatalog, PublishedPointer } from "../schemas/publishing.ts";
+import { BookCatalogSchema, PublishedPointerSchema } from "../schemas/publishing.ts";
+import { sha256Hex } from "../storage/hash.ts";
+import type { CompiledEpisodeBundle } from "./bundle.ts";
+import { stableStringify } from "./bundle.ts";
+import type {
+  PublicationRevision,
+  PublishingRepository,
+} from "./repository.ts";
+import type { PublishedStorage } from "./storage.ts";
+
+export async function publishEpisode(args: {
+  compiled: CompiledEpisodeBundle;
+  storage: PublishedStorage;
+  repository: PublishingRepository;
+  expectedPriorVersion: number | null;
+}): Promise<PublicationRevision> {
+  const { bundle, manifest } = args.compiled;
+  if (bundle.version !== (args.expectedPriorVersion ?? 0) + 1) {
+    throw new Error(
+      `Episode ${bundle.episodeId} version ${bundle.version} must follow ${String(args.expectedPriorVersion)}.`,
+    );
+  }
+  for (const asset of manifest.assets) await verifyObject(args.storage, asset);
+
+  await args.storage.putImmutable(manifest.bundleKey, args.compiled.bundleBytes, "application/json");
+  await verifyObject(args.storage, {
+    key: manifest.bundleKey,
+    checksum: manifest.bundleChecksum,
+    sizeBytes: manifest.sizeBytes,
+    contentType: "application/json",
+  });
+  const manifestKey = manifest.bundleKey.replace(/bundle\.json$/, "manifest.json");
+  await args.storage.putImmutable(manifestKey, args.compiled.manifestBytes, "application/json");
+  await verifyObject(args.storage, {
+    key: manifestKey,
+    checksum: sha256Hex(args.compiled.manifestBytes.toString("utf8")),
+    sizeBytes: args.compiled.manifestBytes.length,
+    contentType: "application/json",
+  });
+
+  const revision: PublicationRevision = {
+    bookId: bundle.bookId,
+    episodeId: bundle.episodeId,
+    version: bundle.version,
+    revisionId: bundle.revisionId,
+    sourceId: bundle.sourceId,
+    canonicalHash: bundle.canonicalHash,
+    fingerprint: args.compiled.fingerprint,
+    bundleKey: manifest.bundleKey,
+    manifestKey,
+    bundleUrl: publicUrl(bundle.assetsBaseUrl, manifest.bundleKey),
+    manifestUrl: publicUrl(bundle.assetsBaseUrl, manifestKey),
+    sizeBytes: manifest.sizeBytes,
+    referencePins: args.compiled.referencePins,
+    bundle,
+    manifest,
+    expectedPriorVersion: args.expectedPriorVersion,
+    status: "ready",
+  };
+  await args.repository.saveRevision(revision);
+  return revision;
+}
+
+export async function approveReplacement(args: {
+  repository: PublishingRepository;
+  bookId: string;
+  episodeId: string;
+  version: number;
+  fingerprint: string;
+  approvedBy: string;
+  approvedAt: string;
+}): Promise<PublicationRevision> {
+  return args.repository.approveRevision(args);
+}
+
+export async function promoteRevision(args: {
+  storage: PublishedStorage;
+  repository: PublishingRepository;
+  bookId: string;
+  episodeId: string;
+  version: number;
+  expectedPriorVersion: number | null;
+  expectedCatalogVersion: number;
+  publishedBy: string;
+  publishedAt: string;
+}): Promise<{ pointer: PublishedPointer; catalog: BookCatalog; catalogKey: string }> {
+  const revision = await requireRevision(args.repository, args.bookId, args.episodeId, args.version);
+  if (revision.status !== "approved" && revision.status !== "published") {
+    throw new Error(`Revision ${args.version} needs explicit replacement approval.`);
+  }
+  if (revision.expectedPriorVersion !== args.expectedPriorVersion && revision.status !== "published") {
+    throw new Error(`Revision ${args.version} was prepared against a different Published version.`);
+  }
+  await verifyRevisionObjects(args.storage, revision);
+  const state = await args.repository.state(args.bookId, args.episodeId);
+  const catalog = nextCatalog(state.catalog, revision, args.expectedCatalogVersion + 1);
+  const catalogKey = `books/${args.bookId}/catalog/v${catalog.version}.json`;
+  await uploadCatalog(args.storage, catalogKey, catalog);
+  const pointer = PublishedPointerSchema.parse({
+    version: revision.version,
+    revisionId: revision.revisionId,
+    bundleUrl: revision.bundleUrl,
+    manifestUrl: revision.manifestUrl,
+    sizeBytes: revision.sizeBytes,
+    publishedAt: args.publishedAt,
+    publishedBy: args.publishedBy,
+  });
+  await args.repository.promote({
+    bookId: args.bookId,
+    episodeId: args.episodeId,
+    revision,
+    pointer,
+    catalog,
+    catalogKey,
+    expectedPriorVersion: args.expectedPriorVersion,
+    expectedCatalogVersion: args.expectedCatalogVersion,
+  });
+  return { pointer, catalog, catalogKey };
+}
+
+export async function rollbackPublishedEpisode(args: {
+  storage: PublishedStorage;
+  repository: PublishingRepository;
+  bookId: string;
+  episodeId: string;
+  targetVersion: number;
+  expectedPriorVersion: number;
+  expectedCatalogVersion: number;
+  publishedBy: string;
+  publishedAt: string;
+}): Promise<{ pointer: PublishedPointer; catalog: BookCatalog; catalogKey: string }> {
+  if (args.targetVersion === args.expectedPriorVersion) throw new Error("Rollback target is already active.");
+  return promoteRevision({
+    ...args,
+    version: args.targetVersion,
+    expectedPriorVersion: args.expectedPriorVersion,
+  });
+}
+
+export async function withdrawPublishedEpisode(args: {
+  storage: PublishedStorage;
+  repository: PublishingRepository;
+  bookId: string;
+  episodeId: string;
+  expectedPriorVersion: number;
+  expectedCatalogVersion: number;
+}): Promise<{ catalog: BookCatalog; catalogKey: string }> {
+  const state = await args.repository.state(args.bookId, args.episodeId);
+  if (!state.catalog) throw new Error("There is no active BookCatalog to withdraw from.");
+  const catalog = BookCatalogSchema.parse({
+    ...state.catalog,
+    version: args.expectedCatalogVersion + 1,
+    episodes: state.catalog.episodes.filter((episode) => episode.episodeId !== args.episodeId),
+  });
+  const catalogKey = `books/${args.bookId}/catalog/v${catalog.version}.json`;
+  await uploadCatalog(args.storage, catalogKey, catalog);
+  await args.repository.withdraw({
+    bookId: args.bookId,
+    episodeId: args.episodeId,
+    catalog,
+    catalogKey,
+    expectedPriorVersion: args.expectedPriorVersion,
+    expectedCatalogVersion: args.expectedCatalogVersion,
+  });
+  return { catalog, catalogKey };
+}
+
+async function verifyRevisionObjects(storage: PublishedStorage, revision: PublicationRevision): Promise<void> {
+  for (const asset of revision.manifest.assets) await verifyObject(storage, asset);
+  await verifyObject(storage, {
+    key: revision.bundleKey,
+    checksum: revision.manifest.bundleChecksum,
+    sizeBytes: revision.manifest.sizeBytes,
+    contentType: "application/json",
+  });
+  const manifestBytes = Buffer.from(stableStringify(revision.manifest));
+  await verifyObject(storage, {
+    key: revision.manifestKey,
+    checksum: sha256Hex(manifestBytes.toString("utf8")),
+    sizeBytes: manifestBytes.length,
+    contentType: "application/json",
+  });
+}
+
+async function requireRevision(
+  repository: PublishingRepository,
+  bookId: string,
+  episodeId: string,
+  version: number,
+): Promise<PublicationRevision> {
+  const revision = await repository.revision(bookId, episodeId, version);
+  if (!revision) throw new Error(`Episode ${episodeId} version ${version} was not uploaded and verified.`);
+  return revision;
+}
+
+function nextCatalog(current: BookCatalog | null, revision: PublicationRevision, version: number): BookCatalog {
+  const episodes = (current?.episodes ?? []).filter((episode) => episode.episodeId !== revision.episodeId);
+  episodes.push({
+    episodeId: revision.episodeId,
+    order: revision.bundle.order,
+    title: revision.bundle.title,
+    version: revision.version,
+    bundleUrl: revision.bundleUrl,
+    manifestUrl: revision.manifestUrl,
+  });
+  episodes.sort((left, right) => left.order - right.order || left.episodeId.localeCompare(right.episodeId));
+  return BookCatalogSchema.parse({ schemaVersion: 1, bookId: revision.bookId, version, episodes });
+}
+
+async function uploadCatalog(storage: PublishedStorage, key: string, catalog: BookCatalog): Promise<void> {
+  const bytes = Buffer.from(stableStringify(catalog));
+  await storage.putImmutable(key, bytes, "application/json");
+  await verifyObject(storage, {
+    key,
+    checksum: sha256Hex(bytes.toString("utf8")),
+    sizeBytes: bytes.length,
+    contentType: "application/json",
+  });
+}
+
+async function verifyObject(
+  storage: PublishedStorage,
+  expected: { key: string; checksum: string; sizeBytes: number; contentType: string },
+): Promise<void> {
+  const actual = await storage.inspect(expected.key);
+  if (!actual) throw new Error(`Required immutable object ${expected.key} was not uploaded.`);
+  if (
+    actual.checksum !== expected.checksum ||
+    actual.sizeBytes !== expected.sizeBytes ||
+    actual.contentType !== expected.contentType
+  ) {
+    throw new Error(`Verification failed for immutable object ${expected.key}.`);
+  }
+}
+
+function publicUrl(baseUrl: string, key: string): string {
+  return `${baseUrl.replace(/\/$/, "")}/${key}`;
+}
diff --git a/src/features/book-experience/publishing/storage.ts b/src/features/book-experience/publishing/storage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4e60e689f29cc94339ce237102593126d91040bf
--- /dev/null
+++ b/src/features/book-experience/publishing/storage.ts
@@ -0,0 +1,60 @@
+import { sha256Hex } from "../storage/hash.ts";
+
+export type StoredObject = {
+  key: string;
+  bytes: Buffer;
+  contentType: string;
+  checksum: string;
+};
+
+export type StoredObjectMetadata = Omit<StoredObject, "bytes"> & { sizeBytes: number };
+
+export interface PublishedStorage {
+  putImmutable(key: string, bytes: Buffer, contentType: string): Promise<void>;
+  inspect(key: string): Promise<StoredObjectMetadata | null>;
+}
+
+export class FakePublishedStorage implements PublishedStorage {
+  readonly objects = new Map<string, StoredObject>();
+  failPutKey: string | null = null;
+  corruptInspectKey: string | null = null;
+
+  async putImmutable(key: string, bytes: Buffer, contentType: string): Promise<void> {
+    if (key === this.failPutKey) throw new Error(`Injected upload failure for ${key}.`);
+    const checksum = sha256Hex(bytes.toString("utf8"));
+    const existing = this.objects.get(key);
+    if (existing) {
+      if (existing.checksum !== checksum || existing.contentType !== contentType) {
+        throw new Error(`Published object ${key} is immutable.`);
+      }
+      return;
+    }
+    this.objects.set(key, { key, bytes: Buffer.from(bytes), contentType, checksum });
+  }
+
+  seed(object: StoredObject): void {
+    const existing = this.objects.get(object.key);
+    if (existing) {
+      if (
+        existing.checksum !== object.checksum ||
+        existing.contentType !== object.contentType ||
+        !existing.bytes.equals(object.bytes)
+      ) {
+        throw new Error(`Published object ${object.key} is immutable.`);
+      }
+      return;
+    }
+    this.objects.set(object.key, { ...object, bytes: Buffer.from(object.bytes) });
+  }
+
+  async inspect(key: string): Promise<StoredObjectMetadata | null> {
+    const object = this.objects.get(key);
+    if (!object) return null;
+    return {
+      key,
+      contentType: object.contentType,
+      checksum: key === this.corruptInspectKey ? `corrupt-${object.checksum}` : object.checksum,
+      sizeBytes: object.bytes.length,
+    };
+  }
+}
diff --git a/src/features/completion/publishing.ts b/src/features/completion/publishing.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0d0f68246a89e657324825db5dca4fb70de725d9
--- /dev/null
+++ b/src/features/completion/publishing.ts
@@ -0,0 +1,18 @@
+export function publicationReadinessProblems(input: {
+  episodeId: string;
+  stageStatus: Record<string, string | undefined>;
+  coverageProblems: string[];
+  compositionProblems: string[];
+  spoilerReviewApproved: boolean;
+}): string[] {
+  const problems = [...input.coverageProblems, ...input.compositionProblems];
+  for (const stage of ["moments", "beats", "visuals", "composed", "previewed"] as const) {
+    if (input.stageStatus[stage] !== "approved") {
+      problems.push(`Episode ${input.episodeId} stage ${stage} is not approved.`);
+    }
+  }
+  if (!input.spoilerReviewApproved) {
+    problems.push(`Episode ${input.episodeId} spoiler-safe summary and entity views are not approved.`);
+  }
+  return [...new Set(problems)];
+}
diff --git a/src/features/posting/publishing.ts b/src/features/posting/publishing.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8c0930f472cd623679ab0e6421c9227c051d2056
--- /dev/null
+++ b/src/features/posting/publishing.ts
@@ -0,0 +1,154 @@
+import { FieldValue } from "firebase-admin/firestore";
+
+import type { PublishedPointer } from "@/features/book-experience/schemas/publishing";
+import { PublishedPointerSchema } from "@/features/book-experience/schemas/publishing";
+import { EditError } from "@/features/sources/edit-ops";
+import { adminDb } from "@/services/firebase/admin";
+
+export function publishedPointerRef(bookId: string, episodeId: string) {
+  return adminDb().collection("books").doc(bookId).collection("published").doc(episodeId);
+}
+
+export function publicationRevisionRef(bookId: string, episodeId: string, revisionId: string) {
+  return adminDb()
+    .collection("books")
+    .doc(bookId)
+    .collection("episodes")
+    .doc(episodeId)
+    .collection("revisions")
+    .doc(revisionId);
+}
+
+export async function approvePublicationRevision(args: {
+  bookId: string;
+  episodeId: string;
+  revisionId: string;
+  fingerprint: string;
+  approvedBy: string;
+}): Promise<void> {
+  const revision = publicationRevisionRef(args.bookId, args.episodeId, args.revisionId);
+  await adminDb().runTransaction(async (tx) => {
+    const current = await tx.get(revision);
+    if (!current.exists || current.get("uploadStatus") !== "verified") {
+      throw new EditError("Upload and verify the complete Episode revision before approval.");
+    }
+    if (current.get("fingerprint") !== args.fingerprint) {
+      throw new EditError("The Working revision changed after preview; compare it again.");
+    }
+    if (current.get("approval.fingerprint") === args.fingerprint) return;
+    tx.set(revision, {
+      status: "approved",
+      approval: {
+        fingerprint: args.fingerprint,
+        approvedBy: args.approvedBy,
+        approvedAt: FieldValue.serverTimestamp(),
+      },
+    }, { merge: true });
+  });
+}
+
+export async function promotePreparedPublication(args: {
+  bookId: string;
+  episodeId: string;
+  revisionId: string;
+  expectedPriorVersion: number | null;
+  expectedCatalogVersion: number;
+  publishedBy: string;
+}): Promise<PublishedPointer> {
+  const book = adminDb().collection("books").doc(args.bookId);
+  const pointer = publishedPointerRef(args.bookId, args.episodeId);
+  const revision = publicationRevisionRef(args.bookId, args.episodeId, args.revisionId);
+  return adminDb().runTransaction(async (tx) => {
+    const [bookSnapshot, pointerSnapshot, revisionSnapshot] = await Promise.all([
+      tx.get(book),
+      tx.get(pointer),
+      tx.get(revision),
+    ]);
+    if (!bookSnapshot.exists || !revisionSnapshot.exists) {
+      throw new EditError("The prepared publication revision no longer exists.");
+    }
+    const currentVersion = pointerSnapshot.exists ? Number(pointerSnapshot.get("version")) : null;
+    const currentCatalogVersion = Number(bookSnapshot.get("publishing.latestVersion") ?? 0);
+    if (currentVersion !== args.expectedPriorVersion || currentCatalogVersion !== args.expectedCatalogVersion) {
+      throw new EditError("PublishedPointer or BookCatalog changed; refresh and compare again.");
+    }
+    if (
+      revisionSnapshot.get("uploadStatus") !== "verified" ||
+      revisionSnapshot.get("status") !== "approved" ||
+      revisionSnapshot.get("approval.fingerprint") !== revisionSnapshot.get("fingerprint")
+    ) {
+      throw new EditError("This revision is not uploaded, verified and explicitly approved.");
+    }
+    const catalogVersion = Number(revisionSnapshot.get("preparedCatalogVersion") ?? 0);
+    const catalogKey = String(revisionSnapshot.get("preparedCatalogKey") ?? "");
+    if (catalogVersion !== currentCatalogVersion + 1 || !catalogKey) {
+      throw new EditError("The versioned BookCatalog candidate is missing or stale.");
+    }
+    const nextPointer = PublishedPointerSchema.parse({
+      version: Number(revisionSnapshot.get("version")),
+      revisionId: args.revisionId,
+      bundleUrl: String(revisionSnapshot.get("bundleUrl")),
+      manifestUrl: String(revisionSnapshot.get("manifestUrl")),
+      sizeBytes: Number(revisionSnapshot.get("sizeBytes")),
+      publishedAt: new Date().toISOString(),
+      publishedBy: args.publishedBy,
+    });
+    tx.set(pointer, nextPointer);
+    tx.set(book, {
+      publishing: {
+        catalogKey,
+        latestVersion: catalogVersion,
+        publishedEpisodeIds: FieldValue.arrayUnion(args.episodeId),
+        publishedAt: FieldValue.serverTimestamp(),
+      },
+    }, { merge: true });
+    tx.set(revision, {
+      status: "published",
+      promotedAt: FieldValue.serverTimestamp(),
+      promotedBy: args.publishedBy,
+    }, { merge: true });
+    return nextPointer;
+  });
+}
+
+export async function withdrawPreparedPublication(args: {
+  bookId: string;
+  episodeId: string;
+  expectedPriorVersion: number;
+  expectedCatalogVersion: number;
+  catalogKey: string;
+  catalogVersion: number;
+  withdrawnBy: string;
+}): Promise<void> {
+  const book = adminDb().collection("books").doc(args.bookId);
+  const pointer = publishedPointerRef(args.bookId, args.episodeId);
+  await adminDb().runTransaction(async (tx) => {
+    const [bookSnapshot, pointerSnapshot] = await Promise.all([tx.get(book), tx.get(pointer)]);
+    if (
+      !bookSnapshot.exists ||
+      !pointerSnapshot.exists ||
+      Number(pointerSnapshot.get("version")) !== args.expectedPriorVersion ||
+      Number(bookSnapshot.get("publishing.latestVersion") ?? 0) !== args.expectedCatalogVersion
+    ) {
+      throw new EditError("PublishedPointer or BookCatalog changed; refresh before withdrawal.");
+    }
+    if (args.catalogVersion !== args.expectedCatalogVersion + 1 || !args.catalogKey) {
+      throw new EditError("A verified versioned BookCatalog without this Episode is required.");
+    }
+    tx.delete(pointer);
+    tx.set(book, {
+      publishing: {
+        catalogKey: args.catalogKey,
+        latestVersion: args.catalogVersion,
+        publishedEpisodeIds: FieldValue.arrayRemove(args.episodeId),
+        publishedAt: FieldValue.serverTimestamp(),
+      },
+      lastWithdrawal: {
+        episodeId: args.episodeId,
+        version: args.expectedPriorVersion,
+        withdrawnBy: args.withdrawnBy,
+        withdrawnAt: FieldValue.serverTimestamp(),
+      },
+    }, { merge: true });
+  });
+}
diff --git a/tests/smoke/publishing-fixture.mts b/tests/smoke/publishing-fixture.mts
new file mode 100644
index 0000000000000000000000000000000000000000..92e8dcc87d35a2f2ed947dbee76aad920920682d
--- /dev/null
+++ b/tests/smoke/publishing-fixture.mts
@@ -0,0 +1,293 @@
+import type { CompileEpisodeBundleInput } from "../../src/features/book-experience/publishing/bundle.ts";
+import type { Beat } from "../../src/features/book-experience/schemas/beat.ts";
+import type { Composition } from "../../src/features/book-experience/schemas/composition.ts";
+import type { Entity } from "../../src/features/book-experience/schemas/model.ts";
+import type { Paragraph } from "../../src/features/book-experience/schemas/paragraph.ts";
+import type { Episode } from "../../src/features/book-experience/schemas/planning.ts";
+import { sha256Hex } from "../../src/features/book-experience/storage/hash.ts";
+import type { FakePublishedStorage } from "../../src/features/book-experience/publishing/storage.ts";
+
+export const BOOK_ID = "book_publish";
+export const EPISODE_ID = "ep_01";
+export const OWNER = "owner@studio.local";
+export const CDN = "https://cdn.example.test";
+
+export function publishingFixture(args: {
+  version: number;
+  revisionId: string;
+  assetVersionId: string;
+  firstBeatId?: string;
+  firstCompositionId?: string;
+}): { input: CompileEpisodeBundleInput; assetBytes: Buffer; composition: Composition } {
+  const firstBeatId = args.firstBeatId ?? "ep_01_m01_b01";
+  const firstCompositionId = args.firstCompositionId ?? `cmp_harbor_${args.assetVersionId}`;
+  const secondCompositionId = "cmp_harbor_shared_b02";
+  const assetBytes = Buffer.from(`immutable-${args.assetVersionId}`);
+  const checksum = sha256Hex(assetBytes.toString("utf8"));
+  const sharedBytes = Buffer.from("immutable-shared-b02");
+  const sharedChecksum = sha256Hex(sharedBytes.toString("utf8"));
+  const paragraphs: Paragraph[] = [
+    {
+      id: "p000000",
+      seq: 0,
+      page: 1,
+      chapterId: "ch_01",
+      text: "Mara crossed the empty quay before sunrise.",
+      hash: "hash-p000000",
+      kind: "body",
+      isStory: true,
+    },
+    {
+      id: "p000001",
+      seq: 1,
+      page: 1,
+      chapterId: "ch_01",
+      text: "The sealed order named Mara as the missing heir.",
+      hash: "hash-p000001",
+      kind: "body",
+      isStory: true,
+    },
+  ];
+  const beats: Beat[] = [
+    beat({
+      id: firstBeatId,
+      order: 1,
+      seq: 0,
+      paragraph: paragraphs[0],
+      compositionId: firstCompositionId,
+    }),
+    beat({
+      id: "ep_01_m01_b02",
+      order: 2,
+      seq: 1,
+      paragraph: paragraphs[1],
+      compositionId: secondCompositionId,
+    }),
+  ];
+  const episode: Episode = {
+    schemaVersion: 1,
+    sourceId: "src_publish",
+    canonicalHash: "canonical-publish-v1",
+    episodeId: EPISODE_ID,
+    revisionId: args.revisionId,
+    order: 1,
+    title: "The Harbor Bell",
+    seqStart: 0,
+    seqEnd: 1,
+    chapterIds: ["ch_01"],
+    summary: "Mara crosses the quay carrying a sealed order.",
+    storyPlan: {
+      arc: "Mara commits to the crossing.",
+      momentOutline: [{ title: "The quay", seqStart: 0, seqEnd: 1 }],
+      visualStrategy: "A fogbound quay advances with the source.",
+      reuseCandidates: ["harbor-quay"],
+    },
+    stageStatus: {
+      planned: "approved",
+      moments: "approved",
+      beats: "approved",
+      visuals: "approved",
+      composed: "approved",
+      previewed: "approved",
+    },
+    ...(args.version > 1 ? { publishedVersion: args.version - 1 } : {}),
+  };
+  const composition = makeComposition({
+    compositionId: firstCompositionId,
+    revisionId: args.revisionId,
+    assetVersionId: args.assetVersionId,
+    checksum,
+    sizeBytes: assetBytes.length,
+    beatId: firstBeatId,
+  });
+  const sharedComposition = makeComposition({
+    compositionId: secondCompositionId,
+    revisionId: args.revisionId,
+    assetVersionId: "av_shared_b02",
+    checksum: sharedChecksum,
+    sizeBytes: sharedBytes.length,
+    beatId: "ep_01_m01_b02",
+  });
+  const entity: Entity = {
+    schemaVersion: 1,
+    sourceId: episode.sourceId,
+    canonicalHash: episode.canonicalHash,
+    entityId: "ch_mara",
+    type: "character",
+    canonicalName: "Mara",
+    aliases: [{ name: "Mara", firstSeq: 0, paragraphIds: ["p000000"] }],
+    importance: "major",
+    firstSeq: 0,
+    lastSeq: 1,
+    facts: [
+      { key: "role", value: "A traveler on the quay", quote: "Mara crossed", firstSeq: 0, paragraphIds: ["p000000"] },
+      { key: "identity", value: "The missing heir", quote: "missing heir", firstSeq: 1, paragraphIds: ["p000001"] },
+    ],
+    fills: [],
+    states: [{
+      stateId: "state_quay",
+      label: "On the quay",
+      validFromStoryTime: 1,
+      validToStoryTime: null,
+      validFromSeq: 0,
+      changes: {},
+      paragraphIds: ["p000000"],
+    }],
+    reveals: [{ what: "Mara is the missing heir", seq: 1, paragraphIds: ["p000001"] }],
+    relationships: [],
+    visual: { spec: "A traveler in a dark coat.", stateVariants: {} },
+    status: "locked",
+  };
+  return {
+    assetBytes,
+    composition,
+    input: {
+      bookId: BOOK_ID,
+      episode,
+      version: args.version,
+      beats,
+      compositions: [composition, sharedComposition],
+      paragraphs,
+      entities: [entity],
+      firstSeenEpisodeByEntity: { ch_mara: EPISODE_ID },
+      approvedReferencePins: composition.referenceVersions,
+      assetsBaseUrl: CDN,
+      progressAnchors: args.version > 1 && firstBeatId !== "ep_01_m01_b01"
+        ? [{ fromVersion: 1, fromBeatId: "ep_01_m01_b01", toBeatId: firstBeatId, seq: 0 }]
+        : [],
+      spoilerReviewApproved: true,
+    },
+  };
+}
+
+export function seedPublishingAssets(storage: FakePublishedStorage, fixture: ReturnType<typeof publishingFixture>): void {
+  const assets = fixture.input.compositions.flatMap((composition) => [composition.master]);
+  for (const asset of assets) {
+    const bytes = asset.assetVersionId === fixture.composition.master.assetVersionId
+      ? fixture.assetBytes
+      : Buffer.from("immutable-shared-b02");
+    storage.seed({ key: asset.key, bytes, contentType: asset.contentType, checksum: asset.checksum });
+  }
+}
+
+function beat(args: {
+  id: string;
+  order: number;
+  seq: number;
+  paragraph: Paragraph;
+  compositionId: string;
+}): Beat {
+  return {
+    id: args.id,
+    order: args.order,
+    seq: args.seq,
+    type: "quote",
+    text: {
+      quote: {
+        paragraphId: args.paragraph.id,
+        start: 0,
+        end: args.paragraph.text.length,
+        text: args.paragraph.text,
+      },
+    },
+    compositionId: args.compositionId,
+    camera: {
+      from: { x: 0, y: 0, zoom: 1, rotate: 0 },
+      to: { x: 0.04, y: 0, zoom: 1.04, rotate: 0 },
+      durationMs: 3000,
+      easing: "easeInOut",
+      focusEntityId: "ch_mara",
+      rationale: "The AI-planned push follows the reading beat.",
+    },
+    transitionIn: { type: args.order === 1 ? "cut" : "fade", durationMs: args.order === 1 ? 0 : 500 },
+    inspectables: [{ entityId: "ch_mara", hotspot: { x: 0.4, y: 0.25, w: 0.2, h: 0.4 } }],
+    representations: [{ paragraphId: args.paragraph.id, modality: "text", description: "Exact source text is shown." }],
+  };
+}
+
+function makeComposition(args: {
+  compositionId: string;
+  revisionId: string;
+  assetVersionId: string;
+  checksum: string;
+  sizeBytes: number;
+  beatId: string;
+}): Composition {
+  const image = {
+    key: `books/${BOOK_ID}/assets/${args.assetVersionId}/master.png`,
+    w: 1600,
+    h: 2000,
+    contentType: "image/png",
+    sizeBytes: args.sizeBytes,
+    checksum: args.checksum,
+    assetVersionId: args.assetVersionId,
+  };
+  return {
+    schemaVersion: 1,
+    sourceId: "src_publish",
+    canonicalHash: "canonical-publish-v1",
+    compositionId: args.compositionId,
+    revisionId: args.revisionId,
+    reuseKey: "harbor-quay",
+    originEpisodeId: EPISODE_ID,
+    usedIn: [
+      { episodeId: EPISODE_ID, momentId: "ep_01_m01", beatId: args.beatId, revisionId: args.revisionId },
+      { episodeId: "ep_02", momentId: "ep_02_m01", beatId: "ep_02_m01_b01", revisionId: "rev_ep02_working" },
+    ],
+    shotSnapshot: {
+      shotId: `shot_${args.beatId}`,
+      description: "Mara crosses a fogbound quay.",
+      entityStates: [{ entityId: "ch_mara", stateId: "state_quay" }],
+      framing: "wide",
+      mood: "resolute",
+      timeOfDay: "sunrise",
+      reuseKey: "harbor-quay",
+    },
+    entityStatesUsed: [{ entityId: "ch_mara", stateId: "state_quay" }],
+    continuityRefs: ["harbor-quay"],
+    referenceVersions: [{
+      entityId: "ch_mara",
+      stateId: "state_quay",
+      version: 1,
+      s3Keys: [`books/${BOOK_ID}/assets/ref_mara_v1/reference.png`],
+      checksum: "ref-mara-v1",
+    }],
+    visualProfileVersion: 1,
+    master: image,
+    layers: [{
+      layerId: "L0-background",
+      role: "background",
+      image,
+      zOrder: 0,
+      depthRange: [0, 1],
+      transform: { x: 0, y: 0, z: 0, scaleX: 1, scaleY: 1, rotate: 0 },
+      renderMode: "plane",
+    }],
+    safeCamera: { maxPanX: 0.1, maxPanY: 0.1, maxZoom: 1.1, maxTilt: 0.05 },
+    responsive: {
+      focalPoint: [0.5, 0.45],
+      portraitCrop: { x: 0.2, y: 0, w: 0.6, h: 1 },
+      landscapeCrop: { x: 0, y: 0.2, w: 1, h: 0.6 },
+    },
+    qa: {
+      textDetected: false,
+      agreementScore: 1,
+      identityScores: { ch_mara: 1 },
+      issues: [],
+      continuityStatus: "approved",
+      approvedBy: OWNER,
+      approvedAt: "2026-09-19T00:00:00.000Z",
+    },
+    generation: {
+      provider: "fake",
+      model: "fake-model",
+      prompt: "private generation prompt",
+      negativePrompt: "private negative prompt",
+      referenceKeys: [`books/${BOOK_ID}/assets/ref_mara_v1/reference.png`],
+      costUsd: 0,
+    },
+    status: "approved",
+    createdAt: "2026-09-19T00:00:00.000Z",
+    updatedAt: "2026-09-19T00:00:00.000Z",
+  };
+}
diff --git a/tests/smoke/smoke-bundles.mts b/tests/smoke/smoke-bundles.mts
new file mode 100644
index 0000000000000000000000000000000000000000..bf632552bce4efe15d00c75274257499aece6239
--- /dev/null
+++ b/tests/smoke/smoke-bundles.mts
@@ -0,0 +1,129 @@
+import { readFileSync } from "node:fs";
+
+import { compileEpisodeBundle } from "../../src/features/book-experience/publishing/bundle.ts";
+import { resolveProgressAnchor } from "../../src/features/book-experience/publishing/reader.ts";
+import {
+  buildRevisionPreview,
+  localizedRegenerationInvalidation,
+} from "../../src/features/book-experience/publishing/revisions.ts";
+import { publicationReadinessProblems } from "../../src/features/completion/publishing.ts";
+import { publishingFixture } from "./publishing-fixture.mts";
+
+const checks: Array<[string, boolean]> = [];
+const check = (name: string, pass: boolean) => checks.push([name, pass]);
+
+const versionOneFixture = publishingFixture({
+  version: 1,
+  revisionId: "rev_publish_v1",
+  assetVersionId: "av_scene_v1",
+});
+const versionOne = compileEpisodeBundle(versionOneFixture.input);
+check("compileEpisodeBundle emits the canonical EpisodeBundle and EpisodeManifest",
+  versionOne.bundle.schemaVersion === 1 && versionOne.manifest.bundleKey.endsWith("/ep_01/v1/bundle.json"));
+check("Manifest assets are checksummed, immutable and deduplicated",
+  versionOne.manifest.assets.length === 2 &&
+    versionOne.manifest.assets.every((asset) => asset.key.startsWith("books/book_publish/assets/") && asset.checksum.length > 0));
+check("Bundle preserves source and private revision lineage without leaking generation records",
+  versionOne.bundle.sourceId === "src_publish" &&
+    versionOne.bundle.canonicalHash === "canonical-publish-v1" &&
+    versionOne.referencePins[0].checksum === "ref-mara-v1" &&
+    !versionOne.bundleBytes.toString("utf8").includes("private generation prompt") &&
+    !versionOne.bundleBytes.toString("utf8").includes("costUsd"));
+check("Episode-start entities exclude the later reveal",
+  versionOne.bundle.entities.ch_mara.card.knownFacts.length === 1 &&
+    !versionOne.bundle.entities.ch_mara.card.knownFacts.join(" ").includes("missing heir"));
+check("Per-Beat entityViews reveal facts only at that Beat seq",
+  versionOne.bundle.entityViews.ep_01_m01_b01.ch_mara.card.knownFacts.length === 1 &&
+    versionOne.bundle.entityViews.ep_01_m01_b02.ch_mara.card.knownFacts.includes("The missing heir"));
+check("Publication readiness accepts a completed independently publishable Episode",
+  publicationReadinessProblems({
+    episodeId: "ep_01",
+    stageStatus: versionOneFixture.input.episode.stageStatus,
+    coverageProblems: [],
+    compositionProblems: [],
+    spoilerReviewApproved: true,
+  }).length === 0);
+
+let mismatchedLineageRejected = false;
+try {
+  compileEpisodeBundle({
+    ...versionOneFixture.input,
+    compositions: [{ ...versionOneFixture.input.compositions[0], sourceId: "src_other" }, versionOneFixture.input.compositions[1]],
+  });
+} catch (error) {
+  mismatchedLineageRejected = String(error).includes("mismatched source lineage");
+}
+check("Compiler rejects mismatched source lineage", mismatchedLineageRejected);
+
+let unapprovedReferenceRejected = false;
+try {
+  compileEpisodeBundle({ ...versionOneFixture.input, approvedReferencePins: [] });
+} catch (error) {
+  unapprovedReferenceRejected = String(error).includes("approved immutable version");
+}
+check("Compiler rejects an unapproved reference pin", unapprovedReferenceRejected);
+
+const versionTwoFixture = publishingFixture({
+  version: 2,
+  revisionId: "rev_publish_v2",
+  assetVersionId: "av_scene_v2",
+  firstBeatId: "ep_01_m01_b01_split",
+  firstCompositionId: "cmp_harbor_av_scene_v2",
+});
+const versionTwo = compileEpisodeBundle(versionTwoFixture.input);
+check("resolveProgressAnchor follows an explicit old-to-new Beat anchor",
+  resolveProgressAnchor({
+    from: { sourceId: "src_publish", version: 1, beatId: "ep_01_m01_b01", seq: 0 },
+    targetBundle: versionTwo.bundle,
+    targetManifest: versionTwo.manifest,
+  }).status === "anchored");
+check("resolveProgressAnchor preserves stable Beat IDs before seq fallback",
+  resolveProgressAnchor({
+    from: { sourceId: "src_publish", version: 1, beatId: "ep_01_m01_b02", seq: 1 },
+    targetBundle: versionTwo.bundle,
+    targetManifest: versionTwo.manifest,
+  }).status === "stable");
+check("resolveProgressAnchor refuses silent cross-source mapping",
+  resolveProgressAnchor({
+    from: { sourceId: "src_other", version: 1, beatId: "ep_01_m01_b01", seq: 0 },
+    targetBundle: versionTwo.bundle,
+    targetManifest: versionTwo.manifest,
+  }).status === "unresolved");
+
+const invalidation = localizedRegenerationInvalidation({
+  workingBundle: versionOne.bundle,
+  compositions: versionOneFixture.input.compositions,
+  changedAssetVersionIds: ["av_scene_v1"],
+});
+check("Regeneration invalidates only Beats using the changed Composition",
+  invalidation.affectedBeatIds.length === 1 && invalidation.affectedBeatIds[0] === "ep_01_m01_b01");
+const preview = buildRevisionPreview({
+  mode: "Compare",
+  published: { bundle: versionOne.bundle, referencePins: versionOne.referencePins, invalidatedApprovals: [] },
+  working: { bundle: versionTwo.bundle, referencePins: versionTwo.referencePins, invalidatedApprovals: invalidation.invalidatedApprovals },
+});
+check("Published, Working revision and Compare expose changed Beats, visuals and invalidated approvals",
+  preview.mode === "Compare" &&
+    preview.comparison.changedBeatIds.includes("ep_01_m01_b01") &&
+    preview.comparison.changedVisualKeys.some((key) => key.includes("av_scene_v2")) &&
+    preview.comparison.invalidatedApprovals.length === 1);
+const revisionPreviewSource = readFileSync(
+  "src/features/book-experience/publishing/components/RevisionPreview.tsx",
+  "utf8",
+);
+check("Revision preview UI exposes Published, Working revision and Compare without authoring inputs",
+  revisionPreviewSource.includes('"Published"') &&
+    revisionPreviewSource.includes('"Working revision"') &&
+    revisionPreviewSource.includes('"Compare"') &&
+    !/<textarea|type="text"|type="number"/i.test(revisionPreviewSource));
+
+const packageJson = readFileSync("package.json", "utf8");
+check("smoke:bundles script is declared", packageJson.includes('"smoke:bundles"'));
+
+let failed = 0;
+for (const [name, pass] of checks) {
+  console.log(`${pass ? "PASS" : "FAIL"}  ${name}`);
+  if (!pass) failed += 1;
+}
+console.log(`\n${checks.length - failed}/${checks.length} checks passed`);
+process.exit(failed ? 1 : 0);
diff --git a/tests/smoke/smoke-publishing.mts b/tests/smoke/smoke-publishing.mts
new file mode 100644
index 0000000000000000000000000000000000000000..1f7945d92b46480f15487780f5175d5d30906057
--- /dev/null
+++ b/tests/smoke/smoke-publishing.mts
@@ -0,0 +1,199 @@
+import { compileEpisodeBundle } from "../../src/features/book-experience/publishing/bundle.ts";
+import { pinReaderSession } from "../../src/features/book-experience/publishing/reader.ts";
+import {
+  FakePublishingRepository,
+  PublicationConflict,
+} from "../../src/features/book-experience/publishing/repository.ts";
+import { buildRevisionPreview } from "../../src/features/book-experience/publishing/revisions.ts";
+import {
+  approveReplacement,
+  promoteRevision,
+  publishEpisode,
+  rollbackPublishedEpisode,
+  withdrawPublishedEpisode,
+} from "../../src/features/book-experience/publishing/service.ts";
+import { FakePublishedStorage } from "../../src/features/book-experience/publishing/storage.ts";
+import {
+  BOOK_ID,
+  EPISODE_ID,
+  OWNER,
+  publishingFixture,
+  seedPublishingAssets,
+} from "./publishing-fixture.mts";
+
+const checks: Array<[string, boolean]> = [];
+const check = (name: string, pass: boolean) => checks.push([name, pass]);
+const NOW = "2026-09-19T12:00:00.000Z";
+const repository = new FakePublishingRepository();
+const storage = new FakePublishedStorage();
+
+const v1Fixture = publishingFixture({ version: 1, revisionId: "rev_publish_v1", assetVersionId: "av_scene_v1" });
+seedPublishingAssets(storage, v1Fixture);
+const v1 = compileEpisodeBundle(v1Fixture.input);
+const v1Snapshot = v1.bundleBytes.toString("utf8");
+const sharedCompositionSnapshot = JSON.stringify(v1Fixture.input.compositions[0]);
+const readyV1 = await publishEpisode({ compiled: v1, storage, repository, expectedPriorVersion: null });
+check("publishEpisode uploads and verifies before making a ready revision",
+  readyV1.status === "ready" && (await repository.state(BOOK_ID, EPISODE_ID)).pointer === null);
+await approveReplacement({
+  repository,
+  bookId: BOOK_ID,
+  episodeId: EPISODE_ID,
+  version: 1,
+  fingerprint: readyV1.fingerprint,
+  approvedBy: OWNER,
+  approvedAt: NOW,
+});
+const promotedV1 = await promoteRevision({
+  storage,
+  repository,
+  bookId: BOOK_ID,
+  episodeId: EPISODE_ID,
+  version: 1,
+  expectedPriorVersion: null,
+  expectedCatalogVersion: 0,
+  publishedBy: OWNER,
+  publishedAt: NOW,
+});
+check("Episode 1 becomes independently available while Episode 2 is incomplete",
+  promotedV1.catalog.episodes.length === 1 &&
+    promotedV1.catalog.episodes[0].episodeId === EPISODE_ID &&
+    !promotedV1.catalog.episodes.some((episode) => episode.episodeId === "ep_02"));
+check("Reader sessions pin the Episode version discovered from BookCatalog",
+  pinReaderSession(promotedV1.catalog, EPISODE_ID).episodeVersion === 1);
+
+let raceRejected = false;
+try {
+  await promoteRevision({
+    storage,
+    repository,
+    bookId: BOOK_ID,
+    episodeId: EPISODE_ID,
+    version: 1,
+    expectedPriorVersion: null,
+    expectedCatalogVersion: 0,
+    publishedBy: OWNER,
+    publishedAt: NOW,
+  });
+} catch (error) {
+  raceRejected = error instanceof PublicationConflict;
+}
+check("A stale concurrent publisher cannot clobber PublishedPointer or BookCatalog", raceRejected);
+
+const v2Fixture = publishingFixture({
+  version: 2,
+  revisionId: "rev_publish_v2",
+  assetVersionId: "av_scene_v2",
+  firstCompositionId: "cmp_harbor_av_scene_v2",
+});
+seedPublishingAssets(storage, v2Fixture);
+const v2 = compileEpisodeBundle(v2Fixture.input);
+const readyV2 = await publishEpisode({ compiled: v2, storage, repository, expectedPriorVersion: 1 });
+const beforeApproval = await repository.state(BOOK_ID, EPISODE_ID);
+check("Regenerating a shared visual leaves Published version 1 and the other Episode use unchanged",
+  beforeApproval.pointer?.version === 1 &&
+    v1.bundleBytes.toString("utf8") === v1Snapshot &&
+    JSON.stringify(v1Fixture.input.compositions[0]) === sharedCompositionSnapshot &&
+    v2.bundle.compositions.cmp_harbor_av_scene_v2.master.key !==
+      v1.bundle.compositions.cmp_harbor_av_scene_v1.master.key);
+const compare = buildRevisionPreview({
+  mode: "Compare",
+  published: { bundle: v1.bundle, referencePins: v1.referencePins, invalidatedApprovals: [] },
+  working: { bundle: v2.bundle, referencePins: v2.referencePins, invalidatedApprovals: ["composition:cmp_harbor_av_scene_v1"] },
+});
+check("Compare previews the replacement before explicit approval",
+  compare.mode === "Compare" && compare.comparison.changedVisualKeys.length === 2 && readyV2.status === "ready");
+
+const failingRepository = new FakePublishingRepository();
+const failingStorage = new FakePublishedStorage();
+seedPublishingAssets(failingStorage, v1Fixture);
+failingStorage.failPutKey = v1.manifest.bundleKey;
+let uploadFailed = false;
+try {
+  await publishEpisode({ compiled: v1, storage: failingStorage, repository: failingRepository, expectedPriorVersion: null });
+} catch (error) {
+  uploadFailed = String(error).includes("Injected upload failure");
+}
+check("A failed upload leaves the PublishedPointer unchanged",
+  uploadFailed && (await failingRepository.state(BOOK_ID, EPISODE_ID)).pointer === null);
+
+await approveReplacement({
+  repository,
+  bookId: BOOK_ID,
+  episodeId: EPISODE_ID,
+  version: 2,
+  fingerprint: readyV2.fingerprint,
+  approvedBy: OWNER,
+  approvedAt: NOW,
+});
+storage.failPutKey = `books/${BOOK_ID}/catalog/v2.json`;
+let catalogUploadFailed = false;
+try {
+  await promoteRevision({
+    storage,
+    repository,
+    bookId: BOOK_ID,
+    episodeId: EPISODE_ID,
+    version: 2,
+    expectedPriorVersion: 1,
+    expectedCatalogVersion: 1,
+    publishedBy: OWNER,
+    publishedAt: NOW,
+  });
+} catch (error) {
+  catalogUploadFailed = String(error).includes("Injected upload failure");
+}
+check("A failed catalog upload leaves approved version 1 active",
+  catalogUploadFailed && (await repository.state(BOOK_ID, EPISODE_ID)).pointer?.version === 1);
+storage.failPutKey = null;
+const promotedV2 = await promoteRevision({
+  storage,
+  repository,
+  bookId: BOOK_ID,
+  episodeId: EPISODE_ID,
+  version: 2,
+  expectedPriorVersion: 1,
+  expectedCatalogVersion: 1,
+  publishedBy: OWNER,
+  publishedAt: NOW,
+});
+check("Approved version 2 atomically promotes pointer and versioned catalog",
+  promotedV2.pointer.version === 2 && promotedV2.catalog.version === 2 && promotedV2.catalog.episodes[0].version === 2);
+check("Old bundles and assets remain immutable after promotion",
+  storage.objects.has(v1.manifest.bundleKey) &&
+    storage.objects.has(v1.manifest.assets[0].key) &&
+    storage.objects.get(v1.manifest.bundleKey)?.bytes.toString("utf8") === v1Snapshot);
+
+const rollback = await rollbackPublishedEpisode({
+  storage,
+  repository,
+  bookId: BOOK_ID,
+  episodeId: EPISODE_ID,
+  targetVersion: 1,
+  expectedPriorVersion: 2,
+  expectedCatalogVersion: 2,
+  publishedBy: OWNER,
+  publishedAt: NOW,
+});
+check("Rollback points to existing version 1 without deleting version 2",
+  rollback.pointer.version === 1 && storage.objects.has(v2.manifest.bundleKey));
+const withdrawal = await withdrawPublishedEpisode({
+  storage,
+  repository,
+  bookId: BOOK_ID,
+  episodeId: EPISODE_ID,
+  expectedPriorVersion: 1,
+  expectedCatalogVersion: 3,
+});
+check("Withdrawal removes catalog discovery and pointer but preserves history",
+  withdrawal.catalog.episodes.length === 0 &&
+    (await repository.state(BOOK_ID, EPISODE_ID)).pointer === null &&
+    storage.objects.has(v1.manifest.bundleKey) && storage.objects.has(v2.manifest.bundleKey));
+
+let failed = 0;
+for (const [name, pass] of checks) {
+  console.log(`${pass ? "PASS" : "FAIL"}  ${name}`);
+  if (!pass) failed += 1;
+}
+console.log(`\n${checks.length - failed}/${checks.length} checks passed`);
+process.exit(failed ? 1 : 0);
