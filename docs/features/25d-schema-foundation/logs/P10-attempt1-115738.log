import { describePreviewState } from "../../src/features/book-experience/preview/states.ts";
import { assembleComposition } from "../../src/features/book-experience/compositions/assemble.ts";
import { computeSafeCamera } from "../../src/features/book-experience/compositions/safeCamera.ts";
import { getNextAction } from "../../src/features/book-experience/compositions/actions.ts";

// test:preview gate (P2). Deterministic local proof without a server or a
// browser: the fixture compiles through canonical schemas, every Beat
// resolves finite frames, the endpoint performs no cloud writes, and the
// player exposes exactly the approved controls with no camera authoring.
// Browser interaction itself lives in preview.spec.ts (Playwright prior
// art) and is reported separately; this script only asserts its presence.
const checks: Array<[string, boolean]> = [];
const check = (name: string, pass: boolean) => checks.push([name, pass]);

const fixture = JSON.parse(
  readFileSync("fixtures/book-experience/room-entry.json", "utf8"),
) as unknown;
const bundle = compileFixtureBundle(fixture);
check("Fixture compiles to an EpisodeBundle with 3 Beats", bundle.beats.length === 3);

let framesFinite = true;
for (const beat of bundle.beats) {
  for (const progress of [0, 0.5, 1]) {
    const frame = resolveFrame(bundle, beat.id, progress);
    const numbers = [frame.pose.x, frame.pose.y, frame.pose.zoom, frame.pose.rotate];
    if (!numbers.every(Number.isFinite) || frame.subtitleHtml.length === 0) framesFinite = false;
  }
}
check("Every Beat resolves finite frames with HTML subtitles", framesFinite);

const routeSource = readFileSync("src/app/api/studio/preview/route.ts", "utf8");
check("Preview endpoint is fixture-scoped", routeSource.includes("room-entry"));
check(
  "Preview endpoint performs no cloud writes",
  !/firebase-admin|adminAuth|client-s3|PutObjectCommand|fetch\(["']https:\/\/(?!.*localhost)/i.test(
    routeSource,
  ) && !routeSource.includes("PutObject"),
);

const playerSource = readFileSync(
  "src/features/book-experience/preview/PreviewPlayer.tsx",
  "utf8",
);
for (const testId of [
  "scope-episode",
  "scope-moment",
  "scope-beat",
  "play",
  "pause",
  "scrub",
  "next",
  "previous",
  "fallback-toggle",
  "subtitle",
  "provenance",
]) {
  check(`Player exposes control "${testId}"`, playerSource.includes(testId));
}
check(
  "Player has no camera authoring input",
  !/set camera|Set camera|camera-author|focusLayerId"|prompt\(/i.test(playerSource),
);

const depthSource = readFileSync(
  "src/features/book-experience/preview/DepthScene.tsx",
  "utf8",
);
