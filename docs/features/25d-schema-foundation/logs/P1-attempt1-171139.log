+export type AuthModeState = {
+  bypassed: boolean | null;
+  error: string | null;
+};
+
+let cachedModePromise: Promise<AuthModeState> | null = null;
+
+function fetchAuthMode(): Promise<AuthModeState> {
+  if (!cachedModePromise) {
+    cachedModePromise = fetch("/api/auth/mode")
+      .then(async (response) => {
+        if (!response.ok) throw new Error(`mode request failed: ${response.status}`);
+        const body = (await response.json()) as { bypass?: boolean };
+        return { bypassed: body.bypass === true, error: null };
+      })
+      .catch(
+        (): AuthModeState => ({
+          bypassed: null,
+          error:
+            "Studio could not reach the local development server. " +
+            "Start it with “npm.cmd run dev”, then reload.",
+        }),
+      );
+  }
+  return cachedModePromise;
+}
+
+/**
+ * Trusted server auth-mode decision for browser readiness (ADR-005).
+ * Resolves once per page load; null while unknown.
+ */
+export function useAuthMode(): AuthModeState {
+  const [state, setState] = useState<AuthModeState>({ bypassed: null, error: null });
+  useEffect(() => {
+    let cancelled = false;
+    fetchAuthMode().then((next) => {
+      if (!cancelled) setState(next);
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+  return state;
+}
+
+export type StudioReadiness = {
+  /** True when Firestore subscriptions are expected to work. */
+  ready: boolean;
+  /** True when the server runs in development-bypass mode. */
+  bypassed: boolean;
+  /** Actionable connection failure, or null while loading/healthy. */
+  error: string | null;
+};
+
+/**
+ * Browser data readiness (ADR-005).
+ *
+ * In development-bypass mode the hook signs the browser in automatically
+ * with the server-minted development identity, so Studio opens without an
+ * interactive login. In production it waits for the editor's Firebase user.
+ * Failures carry the exact owner-configured step that unblocks them.
+ */
+export function useStudioReadiness(): StudioReadiness {
+  const { bypassed, error: modeError } = useAuthMode();
+  const signedIn = useFirebaseUser();
+  const [identityError, setIdentityError] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (bypassed !== true || signedIn !== false) return;
+    let cancelled = false;
+    setIdentityError(null);
+    ensureDevelopmentIdentity().then((result) => {
+      if (!cancelled && !result.ok) setIdentityError(result.error);
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [bypassed, signedIn]);
+
+  if (modeError) return { ready: false, bypassed: false, error: modeError };
+  if (identityError) {
+    return { ready: false, bypassed: bypassed === true, error: identityError };
+  }
+  if (signedIn !== true) {
+    // Production without a Firebase user: interactive sign-in is required.
+    // Development-bypass: the automatic identity is still being issued.
+    const waiting =
+      bypassed === false
+        ? "Your browser session with Firebase expired. Sign out and sign in again to reload live data."
+        : null;
+    return { ready: false, bypassed: bypassed === true, error: waiting };
+  }
+  return { ready: true, bypassed: bypassed === true, error: null };
+}
+
+/**
+ * Wraps a Firestore subscription failure with the step that unblocks it.
+ * Development-bypass failures almost always mean the owner-configured
+ * development identity cannot read yet; production failures mean sign-in.
+ */
+export function describeDataError(bypassed: boolean, message: string): string {
+  if (bypassed) {
+    return (
+      `Live data is unreachable: ${message} ` +
+      "Development bypass is on, so confirm the owner-configured development " +
+      "Firebase project and STUDIO_ALLOWED_EMAILS, then reload."
+    );
+  }
+  return (
+    `Live data is unreachable: ${message} ` +
+    "Sign out and sign in again with the allowlisted editor account."
+  );
+}
