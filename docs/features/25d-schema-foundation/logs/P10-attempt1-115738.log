// Fake-backed composition repository (P9, ADR-012).
// Firestore layout follows plan section 4:
// books/{bookId}/compositions/{compositionId} holds Composition metadata
// and the canonical usedIn reuse relationships. Local tests use this fake;
// no live writes here. Regeneration creates a new revision; published
// snapshots keep their exact asset keys (ADR-011).

import type { Composition } from "../schemas/composition.ts";

/** Deterministic approval fingerprint binding content, source and pins. */
export function compositionFingerprint(composition: Composition): string {
  const layers = [...composition.layers]
    .sort((a, b) => (a.layerId < b.layerId ? -1 : 1))
    .map((layer) => `${layer.layerId}:${layer.image.checksum}:${layer.renderMode}`)
    .join("|");
  return [
    composition.compositionId,
    composition.revisionId,
    composition.sourceId,
    composition.canonicalHash,
    `profile-v${composition.visualProfileVersion}`,
    `safe-${composition.safeCamera.maxPanX},${composition.safeCamera.maxPanY},${composition.safeCamera.maxZoom},${composition.safeCamera.maxTilt}`,
    layers,
  ].join("#");
}

export type CompositionApproval = {
  compositionId: string;
  revisionId: string;
  fingerprint: string;
  approvedBy: string;
  approvedAt: string;
};

export class FakeCompositionStore {
  proposals = new Map<string, Composition>();
  approvals = new Map<string, CompositionApproval>();
  outdated = new Set<string>();

  compositionPath(bookId: string, compositionId: string): string {
    return `books/${bookId}/compositions/${compositionId}`;
  }

  private key(compositionId: string, revisionId: string): string {
    return `${compositionId}:${revisionId}`;
  }

  proposeComposition(composition: Composition): void {
    const key = this.key(composition.compositionId, composition.revisionId);
    if (this.proposals.has(key)) {
      throw new Error(`Composition ${key} is immutable and already exists.`);
    }
    this.proposals.set(key, composition);
  }

  composition(compositionId: string, revisionId: string): Composition {
    const found = this.proposals.get(this.key(compositionId, revisionId));
    if (!found) throw new Error(`Composition ${compositionId} revision ${revisionId} not found.`);
    return found;
  }

  approveComposition(args: {
    compositionId: string;
    revisionId: string;
    fingerprint: string;
    approvedBy: string;
    blockingIssues: string[];
  }): CompositionApproval {
    if (this.outdated.has(args.compositionId)) {
      throw new Error(
        `Composition ${args.compositionId} is outdated; regenerate from the current source.`,
      );
    }
    if (args.blockingIssues.length > 0) {
      throw new Error(`Composition ${args.compositionId} is blocked: ${args.blockingIssues[0]}`);
    }
    const existing = this.approvals.get(args.compositionId);
    if (existing && existing.fingerprint === args.fingerprint) return existing;
    const approval: CompositionApproval = {
      compositionId: args.compositionId,
      revisionId: args.revisionId,
      fingerprint: args.fingerprint,
      approvedBy: args.approvedBy,
      approvedAt: new Date(0).toISOString(),
    };
    this.approvals.set(args.compositionId, approval);
    return approval;
  }

  /** A rejected layer blocks only its composition; siblings stay approved. */
  rejectComposition(compositionId: string, reason: string): void {
    if (![...this.proposals.keys()].some((key) => key.startsWith(`${compositionId}:`))) {
      throw new Error(`Composition ${compositionId} was never assembled.`);
    }
    void reason;
    this.approvals.delete(compositionId);
  }

  /** Source corrections and reference changes flag dependent drafts. */
  markOutdated(compositionId: string): void {
    this.outdated.add(compositionId);
    this.approvals.delete(compositionId);
  }

  isOutdated(compositionId: string): boolean {
    return this.outdated.has(compositionId);
  }

  usedInFor(compositionId: string): { episodeId: string; momentId: string; beatId: string; revisionId: string }[] {
    for (const proposal of this.proposals.values()) {
      if (proposal.compositionId === compositionId) return proposal.usedIn;
    }
    return [];
  }
}


