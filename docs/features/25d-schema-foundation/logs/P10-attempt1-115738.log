import { postingChecks, type PostingCheckInput } from "../../src/features/posting/types.ts";

const base: PostingCheckInput = {
  paragraphCount: 20,
  paragraphIds: ["p000010"],
  sourceParagraphs: [{ id: "p000010", text: "â€œCome with me,â€ Mara said." }],
  textType: "dialogue",
  textStatus: "approved",
  primaryText: {
    type: "dialogue",
    entries: [{
      text: "â€œCome with me,â€",
      span: {
        start: { paragraphId: "p000010", offset: 0 },
        end: { paragraphId: "p000010", offset: 15 },
      },
    }],
  },
  activeImage: { status: "ready", deliveryUrl: "https://images.example/moment.png", accessible: true },
  continuityConflicts: [],
  reveals: [],
  revealFacts: [],
  visualType: "object",
  hotspots: [{ label: "Seal", target: "Royal seal", x: 0.4, y: 0.5 }],
  hotspotTargets: ["Royal seal"],
};

function problems(patch: Partial<PostingCheckInput>) {
  return postingChecks({ ...base, ...patch }).problems;
}

const exactEntry = base.primaryText?.type === "dialogue" ? base.primaryText.entries[0] : null;
if (!exactEntry) throw new Error("Fixture needs an exact dialogue entry.");

const checks = [
  ["A complete Story Moment passes", problems({}).length === 0],
  ["Invalid source mapping blocks", problems({ paragraphIds: ["bad-id"] }).some((value) => value.includes("source mapping"))],
  ["Exact mismatch blocks", problems({ primaryText: { type: "dialogue", entries: [{ ...exactEntry, text: "Come with me" }] } }).some((value) => value.includes("character-for-character"))],
  ["Missing primary text blocks", problems({ primaryText: null }).some((value) => value.includes("primary text"))],
  ["Inaccessible image blocks", problems({ activeImage: { status: "ready", deliveryUrl: "https://broken.example", accessible: false } }).some((value) => value.includes("inaccessible"))],
  ["Stale image blocks", problems({ activeImage: { status: "ready", deliveryUrl: "https://images.example/moment.png", accessible: true, stale: true } }).some((value) => value.includes("inaccessible"))],
  ["Continuity conflict blocks", problems({ continuityConflicts: ["Two active Mara states overlap."] }).some((value) => value.includes("Continuity"))],
  ["Early reveal blocks", problems({ reveals: ["Mara is the queen"], revealFacts: [{ entryName: "Mara", fieldName: "identity", value: "the queen", revealAt: "p000020" }] }).some((value) => value.includes("before"))],
  ["Invalid hotspot target blocks", problems({ hotspots: [{ label: "Door", target: "Unknown", x: 0.5, y: 0.5 }] }).some((value) => value.includes("invalid target"))],
  ["Invalid hotspot coordinates block", problems({ hotspots: [{ label: "Seal", target: "Royal seal", x: 2, y: 0.5 }] }).some((value) => value.includes("coordinates"))],
  ["Warnings do not become blockers", postingChecks(base).warnings.length === 0 && postingChecks(base).problems.length === 0],
] as const;

let failed = 0;
for (const [name, pass] of checks) {
  console.log(`${pass ? "PASS" : "FAIL"}  ${name}`);
  if (!pass) failed += 1;
}
console.log(`\n${checks.length - failed}/${checks.length} checks passed`);
process.exit(failed ? 1 : 0);

