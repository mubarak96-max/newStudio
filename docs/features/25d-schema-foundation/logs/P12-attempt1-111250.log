// Temporary adapters between the legacy `allJobs` map path and the
// canonical one-document-per-job path (plan section 4, transition strategy).
// New code uses `books/{bookId}/jobs/{jobId}` individual documents with
// transactional leases; existing callers keep the map until P12 contracts
// these adapters. No behavior of src/features/jobs/store.ts changes here.

import type { Job as LegacyJob, JobStatus as LegacyStatus } from "./types";

export const CANONICAL_JOBS_COLLECTION = "jobs";

export function canonicalJobDocPath(bookId: string, jobId: string): string {
  return `books/${bookId}/jobs/${jobId}`;
}

export type CanonicalJobPatch = {
  jobId: string;
  bookId: string;
  sourceId: string;
  canonicalHash: string;
  type: string;
  stage: string;
  status:
    | "queued"
    | "running"
    | "waiting_confirmation"
    | "completed"
    | "failed"
    | "cancelled";
  progress: { done: number; total: number };
  checkpoint: { storagePath: string; unit: number } | null;
  attempts: number;
  maxAttempts: number;
  error: { code: string; message: string } | null;
  estimatedCostUsd: number;
  costUsd: number;
  idempotencyKey: string;
};

function legacyProgress(value: LegacyJob["progress"]): { done: number; total: number } {
  if (!value) return { done: 0, total: 0 };
  return { done: Number(value.done ?? 0), total: Number(value.total ?? 0) };
}

function legacyCheckpoint(value: LegacyJob["checkpoint"]): CanonicalJobPatch["checkpoint"] {
  if (!value) return null;
  return { storagePath: `legacy:${value.stage}`, unit: Number(value.done ?? 0) };
}

/** Lossless-enough projection of a legacy map entry onto the canonical shape. */
export function legacyToCanonicalJob(
  job: LegacyJob,
  input: { sourceId: string; canonicalHash: string },
): CanonicalJobPatch {
  const status = job.status as CanonicalJobPatch["status"];
  const known: LegacyStatus[] = [
    "queued",
    "waiting_confirmation",
    "running",
    "completed",
    "failed",
    "cancelled",
  ];
  if (!known.includes(job.status)) {
    throw new Error(`Unsupported legacy job status: ${job.status}.`);
  }
  return {
    jobId: job.id,
    bookId: job.bookId,
    sourceId: input.sourceId,
    canonicalHash: input.canonicalHash,
    type: job.type,
    stage: job.stage,
    status,
    progress: legacyProgress(job.progress),
    checkpoint: legacyCheckpoint(job.checkpoint),
    attempts: job.attempts,
    maxAttempts: job.maxAttempts,
    error: job.lastError ? { code: "legacy", message: job.lastError } : null,
    estimatedCostUsd: job.estimatedCostUsd,
    costUsd: job.actualCostUsd,
    idempotencyKey: job.idempotencyKey,
  };
}

/** Patch a legacy map entry may apply to its canonical twin (status/cost only). */
export function canonicalToLegacyPatch(job: CanonicalJobPatch): Pick<LegacyJob, "status" | "stage"> {
  return { status: job.status, stage: job.stage };
}

