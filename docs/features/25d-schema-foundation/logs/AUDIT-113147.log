  81:     x: clamp(pose.x, -safe.maxPanX, safe.maxPanX),
  82:     y: clamp(pose.y, -safe.maxPanY, safe.maxPanY),
  83:     zoom: clamp(pose.zoom, 1, safe.maxZoom),
  84:     rotate: clamp(pose.rotate, -safe.maxTilt, safe.maxTilt),
  85:   };
  86: }
  87: 
  88: /**
  89:  * AI replan for an unsafe shot: clamp into the safe bounds and report
  90:  * whether the plan changed. The owner never edits camera values directly.
