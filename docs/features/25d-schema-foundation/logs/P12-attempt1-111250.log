import type { AssetRef } from "@/features/book-experience/schemas/primitives";
import type { ImageCandidate } from "@/features/images/types";

export function imageCandidateToAssetRef(args: {
  candidate: ImageCandidate;
  w: number;
  h: number;
  assetVersionId: string;
}): AssetRef {
  if (!args.candidate.storageKey || !args.candidate.contentType) {
    throw new Error(`Candidate ${args.candidate.id} is not ready; only ready assets map to AssetRef.`);
  }
  return {
    key: args.candidate.storageKey,
    w: args.w,
    h: args.h,
    contentType: args.candidate.contentType,
    sizeBytes: 0,
    checksum: `legacy-${args.candidate.id}`,
    assetVersionId: args.assetVersionId,
  };
}

/** Only ready candidates may back canonical layers; failed/generating ones block. */
export function candidateReadinessProblem(candidate: ImageCandidate): string | null {
  if (candidate.status !== "ready") return `Candidate ${candidate.id} is ${candidate.status}; regenerate the failed asset.`;
  if (!candidate.storageKey) return `Candidate ${candidate.id} has no immutable storage key.`;
  return null;
}


