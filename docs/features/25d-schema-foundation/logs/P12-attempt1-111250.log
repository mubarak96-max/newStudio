    { order: 1, seqStart: 0, seqEnd: 5 },
    { order: 2, seqStart: 4, seqEnd: 9 },
  ],
  STORY,
);
check("An overlap is blocked with no manual-edit escape", overlap.some((problem) => problem.kind === "overlap"));
check(
  "Non-contiguous order positions are blocked",
  validateStoryCoverage(
    [
      { order: 1, seqStart: 0, seqEnd: 4 },
      { order: 3, seqStart: 5, seqEnd: 9 },
    ],
    STORY,
  ).some((problem) => problem.kind === "order"),
);
check(
  "A range ending after the story is blocked",
  validateStoryCoverage(VALID_EPISODES, { seqStart: 0, seqEnd: 7 }).some((problem) => problem.kind === "range"),
);
check("An empty proposal is blocked", validateStoryCoverage([], STORY).some((problem) => problem.kind === "gap"));

// 7-9: moment tiling inside one episode.
const EPISODE = { seqStart: 4, seqEnd: 6 };
check(
  "Contiguous Moment ranges approve",
  validateMomentCoverage(
    [
      { order: 1, seqStart: 4, seqEnd: 5 },
      { order: 2, seqStart: 6, seqEnd: 6 },
    ],
    EPISODE,
  ).length === 0,
);
check(
  "A Moment gap is blocked and named",
  validateMomentCoverage(
    [
      { order: 1, seqStart: 4, seqEnd: 4 },
      { order: 2, seqStart: 6, seqEnd: 6 },
    ],
    EPISODE,
  ).some((problem) => problem.kind === "gap" && problem.message.includes("p000005")),
);
check(
  "A Moment overlap is blocked",
  validateMomentCoverage(
    [
      { order: 1, seqStart: 4, seqEnd: 5 },
      { order: 2, seqStart: 5, seqEnd: 6 },
    ],
    EPISODE,
  ).some((problem) => problem.kind === "overlap"),
);

// 10-11: AI StoryMap proposal through the canonical contract.
const storyMap = planStoryMap(
  storyMapInput([
    { order: 1, title: "Dock Light", rationale: "Arrival scenes.", seqStart: 0, seqEnd: 3 },
    { order: 2, title: "The Order", rationale: "The turn.", seqStart: 4, seqEnd: 6 },
    { order: 3, title: "Departure", rationale: "The sail.", seqStart: 7, seqEnd: 9 },
  ]),
);
check("AI StoryMap parses with acts, arcs, chronology and Episode ranges", storyMap.episodeProposals.length === 3);
check(
  "AI StoryMap without a rationale is rejected",
  fails(() =>
    planStoryMap(
      storyMapInput([{ order: 1, title: "Dock Light", rationale: "", seqStart: 0, seqEnd: 9 }]),
    ),
  ),
);

// 12-13: per-episode planning with canonical IDs.
const episode = planEpisode({
  sourceId: SOURCE_ID,
  canonicalHash: HASH,
  revisionId: "rev_1",
  order: 2,
  title: "The Order",
  chapterIds: ["ch_1"],
  summary: "Mara receives the order.",
  seqStart: 4,
  seqEnd: 6,
  arc: "Command passes to Mara.",
  momentOutline: [
    { title: "The bell", seqStart: 4, seqEnd: 5 },
    { title: "The order", seqStart: 6, seqEnd: 6 },
  ],
  visualStrategy: "Harbour greys, lantern warm.",
  reuseCandidates: ["harbour-wide"],
});
check("AI Episode plans with canonical ep_02 identity", episode.episodeId === "ep_02" && episodeIdFor(2) === "ep_02");
check(
  "AI Episode ending before it starts is rejected",
  fails(() =>
    planEpisode({
      sourceId: SOURCE_ID,
      canonicalHash: HASH,
      revisionId: "rev_1",
      order: 1,
      title: "Bad",
      chapterIds: [],
      summary: "Bad range.",
      seqStart: 6,
      seqEnd: 4,
      arc: "Arc.",
      momentOutline: [],
      visualStrategy: "Strategy.",
      reuseCandidates: [],
    }),
  ),
);

// 14-16: contiguous Moment scene containers in book order.
const moments = planMoments({
  sourceId: SOURCE_ID,
  canonicalHash: HASH,
  episodeOrder: 2,
  episode: EPISODE,
  outlines: [
    { title: "The bell", summary: "The bell rings.", seqStart: 4, seqEnd: 5, storyTime: 2 },
    { title: "The order", summary: "Orders given.", seqStart: 6, seqEnd: 6, storyTime: 3 },
  ],
});
check(
  "AI Moments become ep_02_m01 scene containers",
  moments.length === 2 && moments[0].momentId === "ep_02_m01" && momentIdFor(2, 1) === "ep_02_m01",
);
check(
  "Moment outlines with a gap are rejected, not coerced",
  fails(() =>
    planMoments({
      sourceId: SOURCE_ID,
      canonicalHash: HASH,
      episodeOrder: 2,
      episode: EPISODE,
      outlines: [
        { title: "A", summary: "A.", seqStart: 4, seqEnd: 4, storyTime: 2 },
        { title: "B", summary: "B.", seqStart: 6, seqEnd: 6, storyTime: 3 },
      ],
    }),
  ),
);
check(
  "Moment outlines with an overlap are rejected",
  fails(() =>
    planMoments({
      sourceId: SOURCE_ID,
      canonicalHash: HASH,
      episodeOrder: 2,
      episode: EPISODE,
      outlines: [
        { title: "A", summary: "A.", seqStart: 4, seqEnd: 5, storyTime: 2 },
        { title: "B", summary: "B.", seqStart: 5, seqEnd: 6, storyTime: 3 },
      ],
    }),
  ),
);

// 17-18: bounded AI repair, never a blank form.
const repaired = await repairStoryCoverage({
  ranges: [
    { order: 1, seqStart: 0, seqEnd: 3 },
    { order: 2, seqStart: 6, seqEnd: 9 },
  ],
  story: STORY,
  maxRepairs: 2,
  proposeRepair: () => VALID_EPISODES,
});
check("Invalid gaps trigger bounded AI repair", repaired.attempts === 1 && repaired.ranges[1].seqStart === 4);
let exhausted = false;
try {
  await repairStoryCoverage({
    ranges: [{ order: 1, seqStart: 0, seqEnd: 3 }],
    story: STORY,
    maxRepairs: 1,
    proposeRepair: () => [{ order: 1, seqStart: 0, seqEnd: 3 }],
  });
} catch (error) {
  exhausted = String((error as Error).message).includes("STORY_REPAIR_BUDGET_EXHAUSTED");
}
check("Repair budget exhaustion is explicit and blocking", exhausted);

// 19-20: fake repository approvals are idempotent.
const store = new FakeStoryPlanningStore();
store.proposeStoryMap("book_1", storyMap);
const approval = store.approveStoryMap("book_1", SOURCE_ID, "storymap-r1", "owner@example.com");
check(
  "StoryMap approval is idempotent for the same fingerprint",
  store.approveStoryMap("book_1", SOURCE_ID, "storymap-r1", "owner@example.com") === approval,
);
store.proposeEpisode("book_1", episode);
store.proposeMoments("book_1", "ep_02", moments);
const momentApproval = store.approveMoments("book_1", "ep_02", "moments-ep_02-r1", "owner@example.com");
check(
  "Moment approval is idempotent for the same fingerprint",
  store.approveMoments("book_1", "ep_02", "moments-ep_02-r1", "owner@example.com") === momentApproval &&
    store.getMoments("book_1", "ep_02").length === 2,
);

// 21: later-episode production continues after an earlier Episode is published.
store.publishEpisode("book_1", "ep_01");
check(
  "Publishing ep_01 never blocks ep_02 production",
  store.isPublished("ep_01") &&
    canProduceEpisode(
      { storyMapStatus: "approved", episodeStatuses: { ep_02: "approved" }, momentStatuses: { ep_02: "review" }, publishedEpisodeIds: ["ep_01"], coverageProblems: [] },
      "ep_02",
    ),
);

// 22-23: approval-driven progression with named blockers.
const blockedActions = getStoryPlanningActions({
  bookId: "book_1",
  state: { storyMapStatus: "review", episodeStatuses: {}, momentStatuses: {}, publishedEpisodeIds: [], coverageProblems: gap },
  episodeIds: ["ep_01", "ep_02"],
});
const blockedApprove = blockedActions.find((action) => action.id === "story-map.approve")!;
check(
  "Coverage gaps block approval and name the AI-repair action",
  !blockedApprove.enabled && blockedApprove.blockers.some((blocker) => blocker.targetActionId === "story-map.regenerate"),
);
const readyActions = getStoryPlanningActions({
  bookId: "book_1",
  state: { storyMapStatus: "approved", episodeStatuses: { ep_02: "approved" }, momentStatuses: { ep_02: "review" }, publishedEpisodeIds: ["ep_01"], coverageProblems: [] },
  episodeIds: ["ep_02"],
});
check(
  "Valid proposal approves without changing boundaries manually",
  readyActions.find((action) => action.id === "ep_02.moments.approve")?.enabled === true,
);
check(
  "Moments approval waits for the StoryMap",
  getStoryPlanningActions({
    bookId: "book_1",
    state: { storyMapStatus: "review", episodeStatuses: {}, momentStatuses: { ep_02: "review" }, publishedEpisodeIds: [], coverageProblems: [] },
    episodeIds: ["ep_02"],
  })
    .find((action) => action.id === "ep_02.moments.approve")
    ?.blockers.some((blocker) => blocker.targetActionId === "story-map.approve") === true,
);

// 24-25: legacy adapters keep boundary internals, map to canonical seq.
check(
  "Legacy EpisodePlan maps p000001 to canonical seq 0",
  toCanonicalEpisodeRange({ order: 1, start: "p000001", end: "p000004" }).seqStart === 0 &&
    canonicalEpisodeId(1) === "ep_01",
);
check(
  "Legacy contiguous moment maps; non-contiguous needs AI replanning",
  toMomentRange({ order: 1, paragraphIds: ["p000005", "p000006"] })?.seqStart === 4 &&
    toMomentRange({ order: 2, paragraphIds: ["p000005", "p000007"] }) === null &&
    canonicalMomentId(2, 1) === "ep_02_m01",
);

// 26-28: worker passes with fake AI output.
const workerStore = new FakeStoryPlanningStore();
const pass = await runStoryMapPass({
  bookId: "book_w",
  proposal: storyMapInput([{ order: 1, title: "All", rationale: "Whole story.", seqStart: 0, seqEnd: 5 }]),
  story: { seqStart: 0, seqEnd: 9 },
  store: workerStore,
  proposeRepair: () =>
    storyMapInput([
      { order: 1, title: "Dock Light", rationale: "Arrival.", seqStart: 0, seqEnd: 4 },
      { order: 2, title: "Departure", rationale: "Sail.", seqStart: 5, seqEnd: 9 },
    ]),
});
check("Worker StoryMap pass repairs then proposes", pass.repairs === 1 && workerStore.getStoryMap("book_w", SOURCE_ID) !== null);
let episodeGated = false;
try {
  await runEpisodePlanning({ bookId: "book_w", plan: { sourceId: SOURCE_ID, canonicalHash: HASH, revisionId: "rev_1", order: 1, title: "T", chapterIds: [], summary: "S.", seqStart: 0, seqEnd: 4, arc: "A.", momentOutline: [], visualStrategy: "V.", reuseCandidates: [] }, store: workerStore, approvedStoryMap: false });
} catch {
  episodeGated = true;
}
check("Worker Episode planning waits for StoryMap approval", episodeGated);
const momentRun = await runMomentPlanning({
  bookId: "book_w",
  episodeId: "ep_01",
  sourceId: SOURCE_ID,
  canonicalHash: HASH,
  episodeOrder: 1,
  episode: { seqStart: 0, seqEnd: 4 },
  outlines: [
    { title: "A", summary: "A.", seqStart: 0, seqEnd: 2, storyTime: 1 },
    { title: "B", summary: "B.", seqStart: 3, seqEnd: 4, storyTime: 2 },
  ],
  store: workerStore,
  approvedStoryMap: true,
});
check("Worker Moment planning stores contiguous scene containers", momentRun.moments.length === 2);

// 29-30: identifiers and schema contracts.
check("Paragraph zero is p000000", paragraphId(0) === "p000000" && paragraphId(11) === "p000011");
check(
  "Canonical StoryMap and Episode parse through Zod",
  StoryMapSchema.safeParse(storyMap).success && EpisodeSchema.safeParse(episode).success,
);

let failed = 0;
for (const [name, pass] of checks) {
  console.log(`${pass ? "PASS" : "FAIL"}  ${name}`);
  if (!pass) failed += 1;
}
console.log(`\n${checks.length - failed}/${checks.length} checks passed`);
process.exit(failed ? 1 : 0);

===== JOB ENGINE TEST =====
import fs from 'node:fs';

import {
  cancelJob,
  claimJob,
  completeJob,
  completeUnit,
  createJob,
  FakeClock,
  FakeJobStore,
  failJob,
  heartbeatJob,
  JobError,
  recoverExpiredLeases,
  runWithBoundedConcurrency,
} from '../../src/features/book-experience/jobs/engine.ts';
import { FakeCostLedger } from '../../src/features/book-experience/jobs/costs.ts';
import {
  approvePlanningCheckpoint,
  ApprovalError,
  nextPlanningStep,
  repairPlanningJob,
  selectVisualTargets,
  type PipelineCursor,
} from '../../src/features/book-experience/jobs/pipeline.ts';
import {
  FakeImageProvider,
  FakeLlmProvider,
  isVisualJobType,
} from '../../src/features/book-experience/jobs/providers.ts';
import {
  canonicalJobDocPath,
  legacyToCanonicalJob,
} from '../../src/features/jobs/adapters.ts';
import {
  isAutomaticSuccessor,
  nextEligiblePlanningStep,
} from '../../worker/jobs/orchestrate.mts';
import { LEASE_MS, leaseExpiredAt } from '../../worker/jobs/leases.mts';
import { FakeImageProvider as WorkerFakeImage } from '../../worker/providers/images.mts';
import { FakeLlmProvider as WorkerFakeLlm } from '../../worker/providers/llm.mts';

// Durable job-engine seam through fake clock, provider and repository
// boundaries (P4). No live worker, paid providers or budget authority.
// Prior art: tests/smoke/smoke-operations.mts; tests/smoke/smoke-image-batch.mts.
const checks: [string, boolean][] = [];
function check(name: string, pass: boolean): void {
  checks.push([name, pass]);
  console.log(`${pass ? 'PASS' : 'FAIL'}  ${name}`);
}
function throwsCode(fn: () => unknown, code: string): boolean {
  try {
    fn();
  } catch (error) {
    return error instanceof JobError || error instanceof ApprovalError
      ? (error as { code: string }).code === code
      : false;
  }
  return false;
}

const clock = new FakeClock();
const store = new FakeJobStore();
const ledger = new FakeCostLedger();
const recordCharge = (chargeKey: string, amountUsd: number) => {
  ledger.recordCharge({ bookId: 'book_p4', chargeKey, amountUsd, atIso: clock.nowIso() });
};

const BOOK = 'book_p4';
const SOURCE = 'src_1';
const HASH = 'hash_abc';
const pins = { sourceId: SOURCE, canonicalHash: HASH, planRevision: 7, contentFingerprint: 'fp-1' };
const cursor: PipelineCursor = { bookId: BOOK, currentType: 'source.ingest', planRevision: 7 };

// A fake multi-step planning job with three billable provider-call units.
const job = createJob(store, {
  bookId: BOOK, sourceId: SOURCE, canonicalHash: HASH,
  type: 'source.ingest', total: 3, estimatedCostUsd: 0.06,
});
const claimed = claimJob(store, clock, { workerId: 'worker-a' });
check('Claim assigns the lease to worker-a', claimed?.jobId === job.jobId && claimed?.workerId === 'worker-a');

completeUnit(store, clock, { jobId: job.jobId, workerId: 'worker-a', unit: 0, storagePath: 'ledger/u0.json', chargeUsd: 0.02, recordCharge });
completeUnit(store, clock, { jobId: job.jobId, workerId: 'worker-a', unit: 1, storagePath: 'ledger/u1.json', chargeUsd: 0.02, recordCharge });

// The worker is killed: the lease expires without a heartbeat.
clock.advance(180_001);
const recovered = recoverExpiredLeases(store, clock);
const afterKill = store.jobs.get(job.jobId)!;
check('Lease recovery requeues the killed job', recovered.length === 1 && recovered[0] === job.jobId);
check('Recovery retains checkpoints and completed units', afterKill.checkpoint?.unit === 1 && afterKill.completedUnits.join(',') === '0,1');

const resumed = claimJob(store, clock, { workerId: 'worker-b' });
check('Resume keeps completed units and increments attempts', resumed?.workerId === 'worker-b' && resumed?.attempts === 2 && resumed?.completedUnits.join(',') === '0,1');

const sizeBefore = store.jobs.size;
const chargesBefore = ledger.chargeCount;
const repeat = completeUnit(store, clock, { jobId: job.jobId, workerId: 'worker-b', unit: 1, storagePath: 'ledger/u1.json', chargeUsd: 0.02, recordCharge });
check('Repeating a completed unit charges nothing twice', repeat.duplicate && ledger.chargeCount === chargesBefore && store.jobs.size === sizeBefore);

// Only the remaining unit runs a new provider call.
const llm = new FakeLlmProvider([{ content: '{"ok":true}', usage: { calls: 1, costUsd: 0.02 } }]);
const reply = await llm.complete({ model: 'fixture-model', messages: [{ role: 'user', content: 'unit 2' }], idempotencyKey: `${job.idempotencyKey}:unit:2`, unit: 2 });
completeUnit(store, clock, { jobId: job.jobId, workerId: 'worker-b', unit: 2, storagePath: 'ledger/u2.json', chargeUsd: reply.usage.costUsd, recordCharge });
check('Resume runs only the remaining provider call', llm.callCount === 1 && llm.calls[0].unit === 2);
check('Cost ledger holds one charge per completed unit', ledger.chargeCount === 3 && ledger.totalFor(BOOK) === 0.06);

const done = completeJob(store, clock, { jobId: job.jobId, workerId: 'worker-b' });
const redone = completeJob(store, clock, { jobId: job.jobId, workerId: 'worker-b' });
check('Completion is idempotent against duplicate clicks', !done.duplicate && redone.duplicate && store.jobs.get(job.jobId)!.status === 'completed');

// Approving the fixture checkpoint advances exactly one successor.
const jobsBeforeApproval = store.jobs.size;
const first = approvePlanningCheckpoint(store, clock, cursor, {
  checkpointJobId: job.jobId, approvalFingerprint: 'appr-1', approvedBy: 'owner@studio.local', expectedRevision: 7, pins,
});
const second = approvePlanningCheckpoint(store, clock, cursor, {
  checkpointJobId: job.jobId, approvalFingerprint: 'appr-1', approvedBy: 'owner@studio.local', expectedRevision: 7, pins,
});
const successor = first.successorJobId ? store.jobs.get(first.successorJobId) : undefined;
check('Approve twice yields one successor job', first.successorJobId !== null && second.duplicate && second.successorJobId === first.successorJobId && store.jobs.size === jobsBeforeApproval + 1);
check('Successor is the next eligible planning step', successor?.type === 'source.ai.resolve' && nextPlanningStep('source.ingest') === 'source.ai.resolve');

check('Stale revision cannot advance the pipeline', throwsCode(() => approvePlanningCheckpoint(store, clock, cursor, {
  checkpointJobId: job.jobId, approvalFingerprint: 'appr-stale', approvedBy: 'owner', expectedRevision: 6, pins,
}), 'STALE_REVISION'));
const pending = createJob(store, { bookId: BOOK, sourceId: SOURCE, canonicalHash: HASH, type: 'bible.analyze' });
check('Failed prerequisites block advancement', throwsCode(() => approvePlanningCheckpoint(store, clock, cursor, {
  checkpointJobId: pending.jobId, approvalFingerprint: 'appr-pending', approvedBy: 'owner', expectedRevision: 7, pins,
}), 'FAILED_PREREQUISITE'));
check('Stale pins block advancement', throwsCode(() => approvePlanningCheckpoint(store, clock, cursor, {
  checkpointJobId: job.jobId, approvalFingerprint: 'appr-pins', approvedBy: 'owner', expectedRevision: 7,
  pins: { ...pins, canonicalHash: 'hash_other' },
}), 'STALE_PINS'));

// Heartbeats, cancellation and bounded retries. These run in an isolated
// store: claimJob takes the earliest queued job, and the shared store still
// holds earlier queued successors from the approval section above.
const leaseStore = new FakeJobStore();
const leaseClock = new FakeClock();
const leased = createJob(leaseStore, { bookId: BOOK, sourceId: SOURCE, canonicalHash: HASH, type: 'episodes.plan' });
claimJob(leaseStore, leaseClock, { workerId: 'worker-a' });
heartbeatJob(leaseStore, leaseClock, { jobId: leased.jobId, workerId: 'worker-a' });
const foreignHeld = (() => {
  try {
    heartbeatJob(leaseStore, leaseClock, { jobId: leased.jobId, workerId: 'worker-b' });
    return false;
  } catch (error) {
    return error instanceof JobError && error.code === 'LEASE_HELD';
  }
})();
leaseClock.advance(180_001);
heartbeatJob(leaseStore, leaseClock, { jobId: leased.jobId, workerId: 'worker-b' });
check('Heartbeat extends the lease and rejects a foreign holder', foreignHeld && leaseStore.jobs.get(leased.jobId)!.workerId === 'worker-b');

const cancellable = createJob(leaseStore, { bookId: BOOK, sourceId: SOURCE, canonicalHash: HASH, type: 'moments.plan' });
cancelJob(leaseStore, leaseClock, { jobId: cancellable.jobId, cancelledBy: 'owner@studio.local' });
check('Only a queued job can be cancelled', leaseStore.jobs.get(cancellable.jobId)!.status === 'cancelled'
  && throwsCode(() => cancelJob(leaseStore, leaseClock, { jobId: leased.jobId, cancelledBy: 'owner' }), 'NOT_CANCELLABLE'));

const flaky = createJob(leaseStore, { bookId: BOOK, sourceId: SOURCE, canonicalHash: HASH, type: 'moments.commentary', maxAttempts: 1 });
claimJob(leaseStore, leaseClock, { workerId: 'worker-a' });
failJob(leaseStore, leaseClock, { jobId: flaky.jobId, workerId: 'worker-a', code: 'PROVIDER', message: 'boom' });
const repairExhausted = throwsCode(() => repairPlanningJob(leaseStore, { jobId: flaky.jobId, pins }), 'REPAIR_BUDGET_EXHAUSTED');
const repaired = repairPlanningJob(leaseStore, { jobId: flaky.jobId, pins, maxRepairs: 2 });
check('Retries exhaust to failed, then a pinned repair requeues', repairExhausted && leaseStore.jobs.get(flaky.jobId)!.status === 'queued' && repaired.stage === 'queued for repair');

// Bounded concurrency across batch children.
let active = 0;
let peak = 0;
const results = await runWithBoundedConcurrency([1, 2, 3, 4, 5], 10, async (input) => {
  active += 1;
  peak = Math.max(peak, active);
  await new Promise((resolve) => setTimeout(resolve, 5));
  active -= 1;
  return { input };
});
check('Batch children share bounded concurrency', results.every((r) => r.status === 'fulfilled') && peak <= 3);

// Visual generation never starts without an explicit selection.
const visualsBefore = [...store.jobs.values()].filter((j) => isVisualJobType(j.type)).length;
const selected = selectVisualTargets(store, clock, cursor, {
  bookId: BOOK, sourceId: SOURCE, canonicalHash: HASH, selectedBy: 'owner@studio.local',
  targets: [{ targetId: 'ref_ch_mara', kind: 'reference' }, { targetId: 'm_ep1', kind: 'moment' }],
});
const keys = new Set(selected.map((j) => j.idempotencyKey));
check('Explicit selection enqueues visual jobs with distinct keys', visualsBefore === 0 && selected.length === 2 && keys.size === 2);
const images = new FakeImageProvider(BOOK);
const generated = await images.generate({ prompt: 'Mara reference', referenceKeys: [], idempotencyKey: selected[0].idempotencyKey, unit: 0 });
check('Fake image keys use immutable S3 shapes', generated.key.startsWith(`books/${BOOK}/assets/`) && images.callCount === 1);

// Worker seam mirrors the canonical decisions.
const workerLlm = new WorkerFakeLlm([{ content: '{}', usage: { calls: 1, costUsd: 0 } }]);
await workerLlm.complete({ model: 'm', messages: [], idempotencyKey: 'k', unit: 0 });
const workerImages = new WorkerFakeImage();
await workerImages.generate({ prompt: 'p', aspectRatio: '16:9', referenceUrls: [], idempotencyKey: 'k', unit: 0 });
const llmSource = fs.readFileSync(new URL('../../worker/providers/llm.mts', import.meta.url), 'utf8');
const imageSource = fs.readFileSync(new URL('../../worker/providers/images.mts', import.meta.url), 'utf8');
check('Worker transports sit behind provider boundaries', workerLlm.name === 'fake-llm' && workerImages.name === 'fake-image'
  && /callOpenRouter/.test(llmSource) && /generateOneImage/.test(imageSource));
check('Worker never auto-enqueues visual generation', nextEligiblePlanningStep('moments.plan') === 'moments.commentary'
  && !isAutomaticSuccessor('images.moment.generate') && isAutomaticSuccessor('moments.plan'));
check('Firestore leases expire on the same 180s bound', LEASE_MS === 180_000
  && leaseExpiredAt({ status: 'running', leaseExpiresAt: new Date(clock.now() - 1).toISOString() }, clock.now()));

// Legacy adapters keep the migration incremental until P12.
const canonical = legacyToCanonicalJob({
  id: 'legacy_1', bookId: BOOK, type: 'episodes.plan', status: 'queued', attempts: 0, maxAttempts: 3,
  payload: {}, result: null, lastError: null, workerId: null, createdAt: null, claimedAt: null,
  heartbeatAt: null, finishedAt: null, stage: 'queued', progress: null, checkpoint: null,
  estimatedCostUsd: 0.1, actualCostUsd: 0, model: null, idempotencyKey: 'legacy:key',
  billableRegeneration: false, failureDetail: null,
}, { sourceId: SOURCE, canonicalHash: HASH });
check('Legacy map entries project onto canonical job documents', canonical.jobId === 'legacy_1' && canonical.costUsd === 0
  && canonicalJobDocPath(BOOK, 'legacy_1') === `books/${BOOK}/jobs/legacy_1`);

const failed = checks.filter(([, pass]) => !pass).length;
console.log(`\n${checks.length - failed}/${checks.length} checks passed`);
process.exit(failed ? 1 : 0);


