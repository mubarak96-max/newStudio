);
for (const testId of [
  "episode-preview",
  "scope-episode",
  "scope-moment",
  "scope-beat",
  "layer-inspector",
  "fallback-toggle",
  "context-loss-note",
  "subtitle",
]) {
  check(`EpisodePreview exposes "${testId}"`, episodePreviewSource.includes(testId));
}
check(
  "EpisodePreview handles WebGL context loss with deterministic fallback",
  episodePreviewSource.includes("webglcontextlost"),
);
check(
  "EpisodePreview has no camera authoring input",
  !/set camera|Set camera|camera-author|focusLayerId"|prompt\(/i.test(episodePreviewSource),
);
const compositionReviewSource = readFileSync(
  "src/features/book-experience/compositions/components/CompositionReview.tsx",
  "utf8",
);
check(
  "CompositionReview inspects layers with approve-and-continue and no camera input",
  compositionReviewSource.includes("layer-inspector") &&
    compositionReviewSource.includes("Approve and continue") &&
    !/set camera|Set camera|<textarea|type="text"|type="number"/i.test(compositionReviewSource),
);

// P9: assembly seam smoke (full matrix lives in smoke:compose).
const probeSafe = computeSafeCamera({
  frame: { w: 1600, h: 2000, overscan: 160 },
  coverages: [{ layerId: "L0", role: "background", overscanPresentPx: 160 }],
});
check("Assembly seam computes safeCamera from real coverage", probeSafe.maxPanX === 0.1);
const probeActions = getNextAction({
  bookId: "book_harbor",
  episodeId: "ep_01",
  momentId: "ep_01_m01",
  compositionId: "cmp_harbor_v1",
  compositionStatus: "review",
  issues: [],
  preview: { loaded: true, scopeExists: true, missingCompositionIds: [], missingLayerIds: [] },
  selectedTargetIds: [],
  failedLayerIds: [],
});
check(
  "Assembly seam exposes approve-and-continue with no manual entry",
  probeActions.some((action) => action.id === "cmp_harbor_v1.approve-and-continue" && action.enabled),
);
void assembleComposition;
const packageScripts = readFileSync("package.json", "utf8");
check("smoke:compose script is declared", packageScripts.includes("smoke:compose"));

const roots = [
  "src/features/book-experience/schemas",
  "src/features/book-experience/functions",
  "src/features/book-experience/preview",
  "src/features/book-experience/compositions",
  "worker/compositions",
];
const oversized: string[] = [];
for (const root of roots) {
  for (const entry of readdirSync(root)) {
    const full = join(root, entry);
    if (!statSync(full).isFile()) continue;
    const lines = readFileSync(full, "utf8").split("\n").length;
    if (lines >= 1000) oversized.push(`${full} (${lines} lines)`);
  }
}
check("Every new feature file stays below 1000 lines", oversized.length === 0);
if (oversized.length > 0) console.log(`Oversized: ${oversized.join(", ")}`);

