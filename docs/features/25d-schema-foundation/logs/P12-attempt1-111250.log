import { z } from "zod";

import { HotspotSchema, IdSchema, LineageSchema } from "./primitives.ts";
import {
  CommentarySchema,
  DialogueSchema,
  TextSelectionSchema,
  BeatSchema,
} from "./beat.ts";

// Planning contracts (plan 3.1): StoryMap, Episode and the full Moment
// scene container. Moment/Episode ranges tile story paragraphs exactly once;
// non-story paragraphs remain stored and explicitly classified (ADR-002).

export const StoryMapSchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  revision: z.number().int().min(1),
  status: z.enum(["draft", "reviewed", "locked"]),
  acts: z.array(z.object({ title: z.string().min(1), eventIds: z.array(IdSchema) })),
  arcs: z.array(
    z.object({ entityId: IdSchema, summary: z.string().min(1), eventIds: z.array(IdSchema) }),
  ),
  episodeProposals: z.array(
    z.object({
      order: z.number().int().min(1),
      title: z.string().min(1),
      rationale: z.string().min(1),
      seqStart: z.number().int().min(0),
      seqEnd: z.number().int().min(0),
    }),
  ),
  chronology: z.array(
    z.object({
      storyTime: z.number().refine(Number.isFinite, {
        message: "storyTime is a finite chronology ordinal",
      }),
      eventIds: z.array(IdSchema),
    }),
  ),
});

export const EntityStateRefSchema = z.object({
  entityId: IdSchema,
  stateId: IdSchema,
});

export const ShotSchema = z.object({
  shotId: IdSchema,
  description: z.string().min(1),
  entityStates: z.array(EntityStateRefSchema),
  framing: z.string().min(1),
  mood: z.string().min(1),
  timeOfDay: z.string().min(1),
  reuseKey: z.string().min(1),
});

export const FullMomentSchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  momentId: z.string().min(1),
  order: z.number().int().min(1),
  seqStart: z.number().int().min(0),
  seqEnd: z.number().int().min(0),
  sourceParagraphIds: z.array(z.string().regex(/^p\d{6}$/)).min(1),
  summary: z.string().min(1),
  startState: z.string().min(1),
  endState: z.string().min(1),
  storyTime: z.number().refine(Number.isFinite, {
    message: "storyTime is a finite chronology ordinal",
  }),
  characters: z.array(EntityStateRefSchema),
  locationId: IdSchema.optional(),
  locationStateId: IdSchema.optional(),
  objectIds: z.array(IdSchema),
  exactTextSelections: z.array(TextSelectionSchema),
  dialogue: z.array(DialogueSchema),
  commentary: z.array(CommentarySchema),
  visualPlan: z.object({ shots: z.array(ShotSchema).min(1) }),
  compositionIds: z.array(IdSchema),
  readingBeats: z.array(BeatSchema).min(1),
  inspectableEntities: z.array(
    z.object({ entityId: IdSchema, beatId: IdSchema, hotspot: HotspotSchema }),
  ),
  status: z.enum(["pending", "running", "review", "approved", "outdated", "failed"]),
}).refine((moment) => moment.seqEnd >= moment.seqStart, {
  message: "Moment ranges tile story paragraphs; seqEnd is inclusive",
});

const EpisodeStageSchema = z.enum([
  "planned",
  "moments",
  "beats",
  "visuals",
  "composed",
  "previewed",
  "published",
]);

const StageStateSchema = z.enum([
  "pending",
  "running",
  "review",
  "approved",
  "outdated",
  "failed",
]);

export const EpisodeSchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  episodeId: z.string().min(1),
  revisionId: IdSchema,
  order: z.number().int().min(1),
  title: z.string().min(1),
  seqStart: z.number().int().min(0),
  seqEnd: z.number().int().min(0),
  chapterIds: z.array(IdSchema),
  summary: z.string().min(1),
  storyPlan: z.object({
    arc: z.string().min(1),
    momentOutline: z.array(
      z.object({
        title: z.string().min(1),
        seqStart: z.number().int().min(0),
        seqEnd: z.number().int().min(0),
      }),
    ),
    visualStrategy: z.string().min(1),
    reuseCandidates: z.array(z.string().min(1)),
  }),
  stageStatus: z.partialRecord(EpisodeStageSchema, StageStateSchema),
  publishedVersion: z.number().int().min(1).optional(),
}).refine((episode) => episode.seqEnd >= episode.seqStart, {
  message: "Episode seqEnd is inclusive and must be >= seqStart",
});

export type StoryMap = z.infer<typeof StoryMapSchema>;
export type Shot = z.infer<typeof ShotSchema>;
export type FullMoment = z.infer<typeof FullMomentSchema>;
export type Episode = z.infer<typeof EpisodeSchema>;

===== STORY REPOSITORY =====
// Fake-backed story-planning repository (P6, ADR-012).
// Firestore layout follows plan section 4:
// books/{bookId}/derived/storyMap plus books/{bookId}/episodes/{episodeId}
// working documents and moments/{momentId} children. Local tests use this
// fake; no live writes here. Approvals are idempotent per fingerprint.

import type { MomentRange } from "./planning.ts";
import type { Episode, StoryMap } from "../schemas/planning.ts";

export type StoryApproval = {
  scope: "storyMap" | "episode" | "moments";
  episodeId?: string;
  status: "review" | "approved" | "rejected";
  fingerprint: string;
  approvedBy?: string;
  approvedAt?: string;
};

export class FakeStoryPlanningStore {
  storyMaps = new Map<string, StoryMap>();
  episodes = new Map<string, Episode>();
  moments = new Map<string, MomentRange[]>();
  approvals = new Map<string, StoryApproval>();
  publishedEpisodeIds = new Set<string>();

  storyMapKey(bookId: string, sourceId: string): string {
    return `books/${bookId}/derived/storyMap#${sourceId}`;
  }

  episodeKey(bookId: string, episodeId: string): string {
    return `books/${bookId}/episodes/${episodeId}`;
  }

  proposeStoryMap(bookId: string, storyMap: StoryMap): void {
    const key = this.storyMapKey(bookId, storyMap.sourceId);
    if (this.storyMaps.has(key)) throw new Error(`StoryMap ${key} already proposed.`);
    this.storyMaps.set(key, storyMap);
    this.approvals.set(`${key}/approval`, {
      scope: "storyMap",
      status: "review",
      fingerprint: `storymap-r${storyMap.revision}`,
    });
  }

  getStoryMap(bookId: string, sourceId: string): StoryMap | null {
    return this.storyMaps.get(this.storyMapKey(bookId, sourceId)) ?? null;
  }

  approveStoryMap(bookId: string, sourceId: string, fingerprint: string, approvedBy: string): StoryApproval {
    const key = `${this.storyMapKey(bookId, sourceId)}/approval`;
    const existing = this.approvals.get(key);
    if (existing?.status === "approved" && existing.fingerprint === fingerprint) return existing;
    const approval: StoryApproval = {
      scope: "storyMap",
      status: "approved",
      fingerprint,
      approvedBy,
      approvedAt: new Date(0).toISOString(),
    };
    this.approvals.set(key, approval);
    const storyMap = this.storyMaps.get(this.storyMapKey(bookId, sourceId));
    if (storyMap) this.storyMaps.set(this.storyMapKey(bookId, sourceId), { ...storyMap, status: "locked" });
    return approval;
  }

  proposeEpisode(bookId: string, episode: Episode): void {
    const key = this.episodeKey(bookId, episode.episodeId);
    if (this.episodes.has(key)) throw new Error(`Episode ${key} already proposed.`);
    this.episodes.set(key, episode);
  }

  proposeMoments(bookId: string, episodeId: string, moments: MomentRange[]): void {
    this.moments.set(`${this.episodeKey(bookId, episodeId)}/moments`, moments);
    this.approvals.set(`${this.episodeKey(bookId, episodeId)}/moments/approval`, {
      scope: "moments",
      episodeId,
      status: "review",
      fingerprint: `moments-${episodeId}-r1`,
    });
  }

  getMoments(bookId: string, episodeId: string): MomentRange[] {
    return this.moments.get(`${this.episodeKey(bookId, episodeId)}/moments`) ?? [];
  }

  approveMoments(bookId: string, episodeId: string, fingerprint: string, approvedBy: string): StoryApproval {
    const key = `${this.episodeKey(bookId, episodeId)}/moments/approval`;
    const existing = this.approvals.get(key);
    if (existing?.status === "approved" && existing.fingerprint === fingerprint) return existing;
    const approval: StoryApproval = {
      scope: "moments",
      episodeId,
      status: "approved",
      fingerprint,
      approvedBy,
      approvedAt: new Date(0).toISOString(),
    };
    this.approvals.set(key, approval);
    return approval;
  }

  /** Independent publication: publishing one Episode never blocks a sibling. */
  publishEpisode(bookId: string, episodeId: string): void {
    void bookId;
    this.publishedEpisodeIds.add(episodeId);
  }

  isPublished(episodeId: string): boolean {
    return this.publishedEpisodeIds.has(episodeId);
  }
}

===== BEAT REPOSITORY =====
// Fake-backed Beat repository (P7, ADR-012).
// Firestore layout follows plan section 4:
// books/{bookId}/episodes/{episodeId}/moments/{momentId} holds working
// readingBeats with source/revision pins. Local tests use this fake; no live
// writes here. Approvals are idempotent per content fingerprint.

import type { Beat } from "../schemas/beat.ts";

export type BeatApproval = {
  momentId: string;
  status: "review" | "approved" | "rejected";
  fingerprint: string;
  approvedBy?: string;
  approvedAt?: string;
};

export class FakeBeatStore {
  proposals = new Map<string, Beat[]>();
  approvals = new Map<string, BeatApproval>();
  outdatedMoments = new Set<string>();

  momentKey(bookId: string, episodeId: string, momentId: string): string {
    return `books/${bookId}/episodes/${episodeId}/moments/${momentId}`;
  }

  proposeBeats(bookId: string, episodeId: string, momentId: string, beats: Beat[]): void {
    const key = this.momentKey(bookId, episodeId, momentId);
    if (this.proposals.has(key)) throw new Error(`Beats for ${key} already proposed.`);
    this.proposals.set(key, beats);
    this.approvals.set(`${key}/approval`, {
      momentId,
      status: "review",
      fingerprint: `beats-${momentId}-r1`,
    });
  }

  getBeats(bookId: string, episodeId: string, momentId: string): Beat[] {
    return this.proposals.get(this.momentKey(bookId, episodeId, momentId)) ?? [];
  }

  approveBeats(
    bookId: string,
    episodeId: string,
    momentId: string,
    fingerprint: string,
    approvedBy: string,
  ): BeatApproval {
    const key = `${this.momentKey(bookId, episodeId, momentId)}/approval`;
    if (this.outdatedMoments.has(this.momentKey(bookId, episodeId, momentId))) {
      throw new Error(`Moment ${momentId} is outdated; regenerate Beats from the current source.`);
    }
    const existing = this.approvals.get(key);
    if (existing?.status === "approved" && existing.fingerprint === fingerprint) return existing;
    const approval: BeatApproval = {
      momentId,
      status: "approved",
      fingerprint,
      approvedBy,
      approvedAt: new Date(0).toISOString(),
    };
    this.approvals.set(key, approval);
    return approval;
  }

  /** Correction revisions invalidate dependent drafts; published stays intact. */
  markOutdated(bookId: string, episodeId: string, momentId: string): void {
    this.outdatedMoments.add(this.momentKey(bookId, episodeId, momentId));
  }

  isOutdated(bookId: string, episodeId: string, momentId: string): boolean {
    return this.outdatedMoments.has(this.momentKey(bookId, episodeId, momentId));
  }
}


