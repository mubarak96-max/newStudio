// Explicit preview conditions (P9, plan 7).
// Loading, empty, failed, partial, outdated, ready-for-review and approved
// states are distinct. Draft preview may show explicit missing-layer/asset
// placeholders; those placeholders can never count as approved or
// publishable assets (ADR-009).

export type PreviewState =
  | "empty"
  | "loading"
  | "error"
  | "outdated"
  | "partial"
  | "ready";

export type PreviewCondition = {
  /** False while the bundle request is still in flight. */
  loaded: boolean;
  /** True when the requested scope intentionally holds no episodes. */
  scopeExists: boolean;
  error?: string;
  /** Source/reference correction invalidated this draft. */
  outdatedReason?: string;
  /** Composition IDs referenced by Beats but missing from the bundle. */
  missingCompositionIds?: string[];
  /** Layer IDs referenced but without generated assets. */
  missingLayerIds?: string[];
};

export function describePreviewState(condition: PreviewCondition): {
  state: PreviewState;
  message: string;
  placeholders: ("missing-layer" | "missing-asset" | "outdated-plan")[];
} {
  if (condition.error) {
    return { state: "error", message: condition.error, placeholders: [] };
  }
  if (!condition.loaded) {
    return { state: "loading", message: "Loading preview bundleâ€¦", placeholders: [] };
  }
  if (!condition.scopeExists) {
    return {
      state: "empty",
      message: "No Beats are planned for this scope yet. Approve Beat planning first.",
      placeholders: [],
    };
  }
  if (condition.outdatedReason) {
    return {
      state: "outdated",
      message: condition.outdatedReason,
      placeholders: ["outdated-plan"],
    };
  }
  const missingCompositions = condition.missingCompositionIds ?? [];
  const missingLayers = condition.missingLayerIds ?? [];
  if (missingCompositions.length > 0 || missingLayers.length > 0) {
    const named = [...missingCompositions, ...missingLayers].join(", ");
    return {
      state: "partial",
      message:
        `Draft preview with explicit placeholders for: ${named}. ` +
        `Placeholders are inspectable but never approved or publishable.`,
      placeholders: [
        ...(missingCompositions.length > 0 ? ["missing-asset" as const] : []),
        ...(missingLayers.length > 0 ? ["missing-layer" as const] : []),
      ],
    };
  }
  return { state: "ready", message: "Assembled Episode preview.", placeholders: [] };
}

/** Missing references block approval but stay inspectable as placeholders. */
export function previewApprovalProblem(condition: PreviewCondition): string | null {
  const described = describePreviewState(condition);
  if (described.state === "ready") return null;
  return `Preview is ${described.state}: ${described.message}`;
}

