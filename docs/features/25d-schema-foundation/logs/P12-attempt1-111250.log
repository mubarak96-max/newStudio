+});
+check("Draft regeneration creates a new immutable key without mutating the version-one preview snapshot",
+  visualStore.generations.get(`${targets[0].targetId}:attempt-2`)?.s3Key !==
+    visualStore.generations.get(`${targets[0].targetId}:attempt-1`)?.s3Key &&
+    JSON.stringify(bundle) === versionOneSnapshot);
+
+const retiredAdapters = [
+  "src/features/bible/adapters.ts",
+  "src/features/episodes/adapters.ts",
+  "src/features/images/adapters.ts",
+  "src/features/jobs/adapters.ts",
+  "src/features/moments/adapters.ts",
+  "src/features/visual/adapters.ts",
+];
+check("Temporary schema adapters are contracted after canonical callers and tests moved",
+  retiredAdapters.every((file) => !existsSync(file)));
+
+const publicationGap = {
+  blockedBy: ["P10", "P11"],
+  missing: ["publishEpisode", "promoteRevision", "sanitized published-pointer rules"],
+};
+console.log(
+  `GAP  Publication/replacement is not simulated: ${publicationGap.blockedBy.join(" + ")} are missing (${publicationGap.missing.join(", ")}).`,
+);
+
+let failed = 0;
+for (const [name, pass] of checks) {
+  console.log(`${pass ? "PASS" : "FAIL"}  ${name}`);
+  if (!pass) failed += 1;
+}
+console.log(`\n${checks.length - failed}/${checks.length} checks passed; 1 explicit degraded-dependency gap`);
+process.exit(failed ? 1 : 0);

