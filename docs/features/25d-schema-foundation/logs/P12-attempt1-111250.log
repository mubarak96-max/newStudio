// AI Beat planning constructors (P7, ADR-002/ADR-003).
// AI supplies every camera target, pose, timing and transition; the owner
// reviews/approves only. Beats preserve source order, split ~60-word quote
// screens into ordered Beats without dropping content, and gate entities by
// each Beat's seq. Explicit/internal meaning that visuals cannot preserve
// stays in HTML subtitles (commentary/quote/dialogue text forms).

import { BeatSchema, type Beat } from "../schemas/beat.ts";

export type CanonicalParagraph = {
  id: string;
  seq: number;
  text: string;
  isStory: boolean;
  kind: string;
};

export type BeatSegmentKind = "quote" | "dialogue" | "commentary" | "internal";

export type BeatProposalSegment = {
  paragraphId: string;
  kind: BeatSegmentKind;
  /** UTF-16 code-unit offsets, start inclusive/end exclusive. */
  start: number;
  end: number;
  speakerEntityId?: string;
  speakerDisplayName?: string;
  addresseeEntityId?: string;
  commentaryKind?: "scene" | "context" | "clarify";
  commentaryText?: string;
  /** Semantic camera target: character, object, location or reveal. */
  cameraTarget?: string;
  framing?: string;
  entities?: string[];
};

export type BuildBeatsArgs = {
  sourceId: string;
  canonicalHash: string;
  episodeOrder: number;
  momentOrder: number;
  momentId: string;
  seqStart: number;
  seqEnd: number;
  paragraphs: CanonicalParagraph[];
  segments: BeatProposalSegment[];
  /** entityId -> first seq where the entity may be shown. */
  entityFirstSeq?: Record<string, number>;
  compositionPrefix?: string;
};

const MAX_QUOTE_WORDS = 60;

export function beatIdFor(episodeOrder: number, momentOrder: number, beatOrder: number): string {
  const episode = `ep_${String(episodeOrder).padStart(2, "0")}`;
  return `${episode}_m${String(momentOrder).padStart(2, "0")}_b${String(beatOrder).padStart(2, "0")}`;
}

function wordCount(value: string): number {
  const words = value.split(/\s+/).filter(Boolean);
  return words.length;
}

/** Split long text into ~60-word ordered chunks at word boundaries. */
export function splitLongText(text: string, maxWords: number = MAX_QUOTE_WORDS): string[] {
  const words = text.split(/\s+/).filter(Boolean);
  if (words.length <= maxWords) return [text];
  const chunks: string[] = [];
  for (let index = 0; index < words.length; index += maxWords) {
    chunks.push(words.slice(index, index + maxWords).join(" "));
  }
  return chunks;
}

/** Word spans inside [start, end) so long selections split with exact offsets. */
export function splitWordsWithOffsets(
  canonical: string,
  start: number,
  end: number,
): { word: string; start: number; end: number }[] {
  const spans: { word: string; start: number; end: number }[] = [];
  const pattern = /\S+/g;
  pattern.lastIndex = start;
  let match: RegExpExecArray | null;
  while ((match = pattern.exec(canonical)) !== null && match.index < end) {
    const wordEnd = Math.min(match.index + match[0].length, end);
    spans.push({ word: canonical.slice(match.index, wordEnd), start: match.index, end: wordEnd });
    if (pattern.lastIndex >= end) break;
  }
  return spans;
}

function hashChoice(seed: string, count: number): number {
  let hash = 0;
  for (let index = 0; index < seed.length; index += 1) {
    hash = (hash * 31 + seed.charCodeAt(index)) % 100003;
  }
  return hash % count;
}

const TRANSITIONS = ["cut", "fade", "slide", "zoomThrough", "parallaxShift"] as const;
const FRAMINGS = ["wide", "medium", "close", "over-shoulder", "detail"] as const;

/**
 * Build ordered Beats from fake-AI proposal segments against the canonical
 * source. Throws actionable errors for unknown paragraphs, invalid offsets,
 * out-of-range segments or empty proposals. Pure: no cloud, no paid calls.
 */
export function buildBeats(args: BuildBeatsArgs): Beat[] {
  const {
    sourceId,
    canonicalHash,
    episodeOrder,
    momentOrder,
    momentId,
    seqStart,
    seqEnd,
    paragraphs,
    segments,
    entityFirstSeq = {},
    compositionPrefix,
  } = args;
  void sourceId;
  void canonicalHash;
  if (segments.length === 0) throw new Error(`Moment ${momentId} needs at least one Beat segment.`);
  const byId = new Map(paragraphs.map((paragraph) => [paragraph.id, paragraph]));
  const inRange = paragraphs
    .filter((paragraph) => paragraph.seq >= seqStart && paragraph.seq <= seqEnd)
    .sort((a, b) => a.seq - b.seq);
  if (inRange.length === 0) {
    throw new Error(`Moment ${momentId} cites an empty source range.`);
  }

  const orderedSegments = [...segments].sort((a, b) => {
    const seqA = byId.get(a.paragraphId)?.seq ?? Number.MAX_SAFE_INTEGER;
    const seqB = byId.get(b.paragraphId)?.seq ?? Number.MAX_SAFE_INTEGER;
    if (seqA !== seqB) return seqA - seqB;
    return a.start - b.start;
  });

  const beats: Beat[] = [];
  let order = 0;

  for (const segment of orderedSegments) {
    const paragraph = byId.get(segment.paragraphId);
    if (!paragraph) throw new Error(`Beat segment cites unknown paragraph ${segment.paragraphId}.`);
    if (paragraph.seq < seqStart || paragraph.seq > seqEnd) {
      throw new Error(
        `Beat segment for ${segment.paragraphId} falls outside Moment ${momentId} [${seqStart}, ${seqEnd}].`,
      );
    }
    if (
      !Number.isInteger(segment.start) ||
      !Number.isInteger(segment.end) ||
      segment.start < 0 ||
      segment.end > paragraph.text.length ||
      segment.start >= segment.end
    ) {
      throw new Error(`Beat segment offsets for ${segment.paragraphId} are invalid.`);
    }
    const selected = paragraph.text.slice(segment.start, segment.end);
    if (selected.length === 0) throw new Error(`Beat segment for ${segment.paragraphId} selects no text.`);

    const chunks = splitWordsWithOffsets(paragraph.text, segment.start, segment.end);
    // Group words into ~60-word ordered chunks so long passages split without
    // dropping content; offsets stay exact against the canonical string.
    const grouped: { start: number; end: number }[] = [];
    for (let index = 0; index < chunks.length; index += MAX_QUOTE_WORDS) {
      const slice = chunks.slice(index, index + MAX_QUOTE_WORDS);
      grouped.push({ start: slice[0].start, end: slice[slice.length - 1].end });
    }
    for (let chunkIndex = 0; chunkIndex < grouped.length; chunkIndex += 1) {
      const { start: resolvedStart, end: resolvedEnd } = grouped[chunkIndex];
      const chunk = paragraph.text.slice(resolvedStart, resolvedEnd);
      order += 1;

      const gatedEntities = (segment.entities ?? []).filter(
        (entityId) => (entityFirstSeq[entityId] ?? 0) <= paragraph.seq,
      );
      const focusEntityId = gatedEntities[0];
      const target = segment.cameraTarget ?? paragraph.id;
      const framing = segment.framing ?? FRAMINGS[hashChoice(`${target}:${order}`, FRAMINGS.length)];
      const transition = TRANSITIONS[hashChoice(`${target}#${order}`, TRANSITIONS.length)];
      const beatId = beatIdFor(episodeOrder, momentOrder, order);
      const compositionId = `${compositionPrefix ?? `cmp_${momentId}_v1`}_${beatId}`;
      const beatType =
        segment.kind === "dialogue" ? "dialogue" : segment.kind === "internal" ? "commentary" : "quote";

      const text: Beat["text"] = {};
      if (segment.kind === "dialogue") {
        if (!segment.speakerEntityId || !segment.speakerDisplayName) {
          throw new Error(`Dialogue segment for ${segment.paragraphId} needs a speaker.`);
        }
        text.dialogue = [
          {
            paragraphId: segment.paragraphId,
            start: resolvedStart,
            end: Math.min(resolvedEnd, paragraph.text.length),
            text: paragraph.text.slice(resolvedStart, Math.min(resolvedEnd, paragraph.text.length)),
            speakerEntityId: segment.speakerEntityId,
            addresseeEntityId: segment.addresseeEntityId,
            speakerDisplayName: segment.speakerDisplayName,
          },
        ];
      } else if (segment.kind === "internal" || segment.kind === "commentary") {
        const commentaryText =
          segment.kind === "internal"
            ? (segment.commentaryText ?? selected)
            : (segment.commentaryText ?? selected);
        if (!commentaryText.trim()) {
          throw new Error(`Commentary segment for ${segment.paragraphId} needs text.`);
        }
        text.commentary = [
          {
            id: `${beatId}_c01`,
            text: commentaryText,
            kind: segment.commentaryKind ?? "scene",
            groundedIn: [segment.paragraphId],
            verified: false,
          },
        ];
        if (segment.kind !== "internal") {
          text.quote = {
            paragraphId: segment.paragraphId,
            start: resolvedStart,
            end: Math.min(resolvedEnd, paragraph.text.length),
            text: paragraph.text.slice(resolvedStart, Math.min(resolvedEnd, paragraph.text.length)),
          };
        }
      } else {
        text.quote = {
          paragraphId: segment.paragraphId,
          start: resolvedStart,
          end: Math.min(resolvedEnd, paragraph.text.length),
          text: paragraph.text.slice(resolvedStart, Math.min(resolvedEnd, paragraph.text.length)),
        };
      }

      const cameraSeed = hashChoice(`${target}:${beatId}`, 1000) / 1000;
      const candidate = {
        id: beatId,
        order,
        seq: paragraph.seq,
        type: beatType,
        text,
        compositionId,
        camera: {
          from: { x: -0.08 + cameraSeed * 0.08, y: -0.05, zoom: 1, rotate: 0 },
          to: { x: 0.08 - cameraSeed * 0.08, y: 0.05, zoom: 1 + cameraSeed * 0.25, rotate: 0 },
          durationMs: 2400 + Math.round(cameraSeed * 1600),
          easing: "easeInOut" as const,
          ...(focusEntityId ? { focusEntityId } : {}),
          rationale: `AI-planned ${framing} framing on ${target} for ${segment.paragraphId}.`,
        },
        transitionIn: {
          type: order === 1 ? ("cut" as const) : transition,
          durationMs: order === 1 ? 0 : 350,
        },
        inspectables: [],
        representations: [
          {
            paragraphId: segment.paragraphId,
            modality: "text" as const,
            description:
              segment.kind === "internal"
                ? `Internal meaning of ${segment.paragraphId} preserved in subtitles: ${chunk.slice(0, 80)}.`
                : `Subtitle carries ${segment.paragraphId} (${segment.kind}) in source order${grouped.length > 1 ? `, part ${chunkIndex + 1} of ${grouped.length}` : ""}.`,
          },
          {
            paragraphId: segment.paragraphId,
            modality: "camera" as const,
            description: `AI ${framing} camera move settles on ${target} across ${chunkIndex + 1}/${grouped.length}.`,
          },
        ],
      };
      const parsed = BeatSchema.safeParse(candidate);
      if (!parsed.success) {
        throw new Error(`Beat ${beatId} failed validation: ${parsed.error.message}`);
      }
      beats.push(parsed.data);
    }
  }

  void wordCount;
  return beats;
}

===== VISUAL GENERATE =====
// Visual generation worker pass (P8, worker side).
// Generation is owner-triggered for one or multiple selected targets and
// runs directly through the configured ImageProvider using the same
// coordinate frame and pinned reference versions. No segmentation, depth,
// inpaint or manual upload/edit services exist here. Local fakes/fixtures;
// no paid calls, no live bucket writes (ADR-012).

import {
  validateAsset,
  type AssetIssue,
  type GeneratedAssetDescriptor,
} from "../../src/features/book-experience/visuals/assets.ts";
import {
  pinReferences,
  referenceApprovalProblem,
} from "../../src/features/book-experience/visuals/references.ts";
import {
  assembleVisualRequest,
  VISUAL_CANVAS,
  type CoordinateFrame,
  type VisualRequestTarget,
} from "../../src/features/book-experience/visuals/requests.ts";
import { FakeVisualStore } from "../../src/features/book-experience/visuals/repository.ts";
import { visualAssetKeyFor, type VisualAssetRole } from "../image-api.mts";
import type { ImageProvider } from "../providers/images.mts";

export type VisualGenerationInput = {
  bookId: string;
  sourceId: string;
  canonicalHash: string;
  visualProfileVersion: number;
  artStyle: string;
  palette: string[];
  lens: string;
  lighting: string;
  negativeRules: string[];
  target: VisualRequestTarget;
  attempt?: number;
  frame?: CoordinateFrame;
  seed?: number;
};

/** Deterministic fake S3 boundary: immutable keys, in-memory bytes, no bucket. */
export class FakeS3Store {
  objects = new Map<string, { bytes: Buffer; contentType: string }>();

  put(key: string, bytes: Buffer, contentType: string): void {
    if (this.objects.has(key)) throw new Error(`S3 key ${key} is immutable and already exists.`);
    this.objects.set(key, { bytes, contentType });
  }

  get(key: string): { bytes: Buffer; contentType: string } {
    const object = this.objects.get(key);
    if (!object) throw new Error(`S3 key ${key} not found.`);
    return object;
  }
}

function roleFor(kind: VisualRequestTarget["kind"]): VisualAssetRole {
  if (kind === "scene-background") return "background";
  if (kind === "scene-foreground") return "foreground";
  if (kind === "scene-depth") return "depth";
  return "reference";
}

export async function runVisualGeneration(args: VisualGenerationInput & {
  provider: ImageProvider;
  store: FakeVisualStore;
  s3: FakeS3Store;
}): Promise<{ s3Key: string; issues: AssetIssue[]; model: string; costUsd: number }> {
  const frame = args.frame ?? VISUAL_CANVAS;
  const attempt = args.attempt ?? 1;
  const blocked = referenceApprovalProblem({
    needed: args.target.needed,
    approvals: args.store.approvals,
    versions: args.store.versions,
  });
  if (blocked) throw new Error(blocked);
  const pins = pinReferences({ needed: args.target.needed, versions: args.store.versions });
  const assembled = assembleVisualRequest({
    target: args.target,
    artStyle: args.artStyle,
    palette: args.palette,
    lens: args.lens,
    lighting: args.lighting,
    negativeRules: args.negativeRules,
    referenceVersions: pins,
    referenceKeys: pins.flatMap((pin) => pin.s3Keys),
    frame,
    attempt,
    seed: args.seed,
  });
  const image = await args.provider.generate({
    prompt: assembled.prompt,
    aspectRatio: assembled.aspectRatio,
    referenceUrls: assembled.referenceKeys,
    idempotencyKey: assembled.idempotencyKey,
    unit: assembled.unit,
  });
  const s3Key = visualAssetKeyFor({
    bookId: args.bookId,
    assetVersionId: `${args.target.targetId}-attempt-${attempt}`,
    role: roleFor(args.target.kind),
    contentType: image.contentType,
  });
  args.s3.put(s3Key, image.bytes, image.contentType);
  const descriptor: GeneratedAssetDescriptor = {
    key: s3Key,
    targetId: args.target.targetId,
    kind: args.target.kind,
    w: frame.w,
    h: frame.h,
    contentType: image.contentType,
    sizeBytes: image.bytes.length,
    checksum: `fake-${assembled.idempotencyKey}`,
    hasAlpha: args.target.kind === "scene-foreground",
    ...(args.target.kind === "scene-depth"
      ? { bitDepth: 8 as const, sourceBitDepth: 8 as const, depthConvention: "near-white" as const }
      : {}),
    ...(args.target.kind === "scene-background" ? { overscanPresent: frame.overscan } : {}),
    textDetected: false,
  };
  const issues = validateAsset(descriptor, frame);
  args.store.recordGeneration({
    targetId: args.target.targetId,
    kind: args.target.kind,
    compositionId: args.target.compositionId,
    ...(args.target.layerId ? { layerId: args.target.layerId } : {}),
    s3Key,
    checksum: descriptor.checksum,
    contentType: image.contentType,
    sourceId: args.sourceId,
    canonicalHash: args.canonicalHash,
    visualProfileVersion: args.visualProfileVersion,
    referenceVersions: pins.map((pin) => ({
      entityId: pin.entityId,
      ...(pin.stateId ? { stateId: pin.stateId } : {}),
      version: pin.version,
      checksum: pin.checksum,
    })),
    ...(args.target.kind === "scene-depth" ? { bitDepth: 8 as const, sourceBitDepth: 8 as const } : {}),
    prompt: assembled.prompt,
    negativePrompt: assembled.negativePrompt,
    model: image.model,
    costUsd: image.costUsd,
    attempt,
    idempotencyKey: assembled.idempotencyKey,
    continuity: { agreementScore: null, identityScores: {}, status: "pending" },
    status: "generated",
    createdAt: new Date(0).toISOString(),
  });
  return { s3Key, issues, model: image.model, costUsd: image.costUsd };
}

/** Approving a generated asset requires zero validation issues. */
export function approveVisualGeneration(args: {
  store: FakeVisualStore;
  targetId: string;
  attempt: number;
  frame?: CoordinateFrame;
}) {
  const record = args.store.generations.get(`${args.targetId}:attempt-${args.attempt}`);
  if (!record) throw new Error(`Generation ${args.targetId} attempt ${args.attempt} not found.`);
  const descriptor = args.store.descriptorFor(args.targetId, args.attempt, args.frame ?? VISUAL_CANVAS);
  const issues = validateAsset(descriptor, args.frame ?? VISUAL_CANVAS);
  if (issues.length > 0) throw new Error(`Asset rejected: ${issues[0].message}`);
  return args.store.approveGeneration(args.targetId, args.attempt);
}

===== VISUAL REFS =====
// Visual reference proposals and approvals (P8, ADR-007/ADR-003).
// AI proposes the book visualProfile plus entity/state reference sets; the
// owner approves and versions them before any dependent scene generates.
// Scene generation is blocked until every pinned reference is approved.
// Local fakes/fixtures only; no paid calls here.

import type { ReferencePin, VisualReferenceVersion } from "../schemas/model.ts";
import type { VisualProfile } from "../schemas/source.ts";

export type VisualTargetKind = "reference-sheet" | "scene-background" | "scene-foreground" | "scene-depth";

export type ReferenceProposal = {
  entityId: string;
  stateId?: string;
  spec: string;
  fills: { key: string; value: string; reason: string }[];
};

export type ReferenceApproval = {
  entityId: string;
  stateId?: string;
  version: number;
  fingerprint: string;
  status: "review" | "approved" | "rejected";
  approvedBy?: string;
  approvedAt?: string;
};

/** Immutable approved reference version record (plan 3.1/4, ADR-007). */
export type StoredReferenceVersion = {
  entityId: string;
  stateId?: string;
  reference: VisualReferenceVersion;
};

export function referenceKey(entityId: string, stateId?: string): string {
  return stateId ? `${entityId}::${stateId}` : entityId;
}

export function referenceApprovalFingerprint(args: {
  sourceId: string;
  canonicalHash: string;
  visualProfileVersion: number;
  entityId: string;
  stateId?: string;
}): string {
  return [
    args.sourceId,
    args.canonicalHash,
    `vp${args.visualProfileVersion}`,
    referenceKey(args.entityId, args.stateId),
  ].join("|");
}

/** Every entity/state a scene names must carry an approved reference version. */
export function referenceApprovalProblem(args: {
  needed: { entityId: string; stateId?: string }[];
  approvals: Map<string, ReferenceApproval>;
  versions: Map<string, StoredReferenceVersion>;
}): string | null {
  for (const target of args.needed) {
    const key = referenceKey(target.entityId, target.stateId);
    const approval = args.approvals.get(key);
    const stored = args.versions.get(key);
    if (!approval || !stored) {
      return `${key} has no approved reference version yet. Approve references before generating scenes.`;
    }
    if (approval.status !== "approved" || !stored.reference.approved) {
      return `${key} needs an approved reference version. Approve references before generating scenes.`;
    }
  }
  return null;
}

/** Pin the exact approved reference versions/keys/hash used for generation. */
export function pinReferences(args: {
  needed: { entityId: string; stateId?: string }[];
  versions: Map<string, StoredReferenceVersion>;
}): ReferencePin[] {
  return args.needed.map((target) => {
    const stored = args.versions.get(referenceKey(target.entityId, target.stateId));
    if (!stored) throw new Error(`No approved reference version for ${referenceKey(target.entityId, target.stateId)}.`);
    return {
      entityId: target.entityId,
      ...(target.stateId ? { stateId: target.stateId } : {}),
      version: stored.reference.version,
      s3Keys: [...stored.reference.s3Keys],
      checksum: stored.reference.checksum,
    };
  });
}

export function visualProfileProblem(profile: VisualProfile): string | null {
  if (!profile.artStyle.trim()) return "The visualProfile is missing artStyle.";
  if (profile.palette.length === 0) return "The visualProfile needs at least one palette entry.";
  if (!profile.lens.trim()) return "The visualProfile is missing lens.";
  if (!profile.lighting.trim()) return "The visualProfile is missing lighting.";
  if (!profile.negativeRules.some((rule) => rule.trim())) {
    return "The visualProfile needs at least one negative rule.";
  }
  return null;
}

===== VISUAL BATCH =====
// Bounded visual batch generation (P8, worker side).
// One independent child per selected target through the existing bounded
// batch pool (worker/image-batch-pool.mts): a failed child never discards
// successful siblings, and retry targets contain only failed children.
// Single and batch generation share the same prompt/validation/approval
// path (plan 6).

import { runWithConcurrency } from "../image-batch-pool.mts";
import type { ImageProvider } from "../providers/images.mts";
import { FakeVisualStore } from "../../src/features/book-experience/visuals/repository.ts";
import type { VisualRequestTarget } from "../../src/features/book-experience/visuals/requests.ts";
import { FakeS3Store, runVisualGeneration, type VisualGenerationInput } from "./generate.mts";

export type VisualBatchResult = {
  targetId: string;
  s3Key: string;
  model: string;
  costUsd: number;
};

export async function runVisualBatch(args: {
  targets: VisualRequestTarget[];
  common: Omit<VisualGenerationInput, "target">;
  provider: ImageProvider;
  store: FakeVisualStore;
  s3: FakeS3Store;
  concurrency?: number;
}): Promise<ReturnType<typeof runWithConcurrency<VisualRequestTarget>>> {
  return runWithConcurrency(args.targets, args.concurrency ?? 3, async (target) => {
    const result: VisualBatchResult = await runVisualGeneration({
      ...args.common,
      target,
      provider: args.provider,
      store: args.store,
      s3: args.s3,
    }).then((generated) => ({
      targetId: target.targetId,
      s3Key: generated.s3Key,
      model: generated.model,
      costUsd: generated.costUsd,
    }));
    return { targetId: result.targetId, s3Key: result.s3Key, model: result.model, actualCostUsd: result.costUsd };
  });
}

===== FAKE PROVIDER =====
import { generateOneImage } from "../image-api.mts";

/**
 * ImageProvider boundary for the worker (plan section 4, ADR-008). Wraps the
 * existing configurable image-generation route; no separate depth, segment
 * or inpaint provider is introduced. The canonical contract lives in
 * `src/features/book-experience/jobs/providers.ts`; the worker restates it
 * because it runs outside the Next.js module graph.
 */
export type ImageRequest = {
  prompt: string;
  aspectRatio: string;
  referenceUrls: string[];
  idempotencyKey: string;
  unit: number;
};

export type ImageResult = {
  bytes: Buffer;
  contentType: string;
  model: string;
  costUsd: number;
};

export type ImageProvider = {
  readonly name: string;
  generate(request: ImageRequest): Promise<ImageResult>;
};

export class OpenRouterImageProvider implements ImageProvider {
  readonly name = "openrouter-image";
  private readonly apiKey: string;
  private readonly modelOverride: string | undefined;
  constructor(apiKey: string, modelOverride?: string) {
    this.apiKey = apiKey;
    this.modelOverride = modelOverride;
  }
  async generate(request: ImageRequest): Promise<ImageResult> {
    const generated = await generateOneImage(
      this.apiKey,
      request.prompt,
      request.aspectRatio,
      request.referenceUrls,
      this.modelOverride,
    );
    return {
      bytes: generated.bytes,
      contentType: generated.contentType,
      model: generated.model,
      costUsd: Number(generated.usage.actualCostUsd ?? 0),
    };
  }
}

/** Deterministic fake for local tests; never touches paid transport. */
export class FakeImageProvider implements ImageProvider {
  readonly name = "fake-image";
  readonly calls: ImageRequest[] = [];
  async generate(request: ImageRequest): Promise<ImageResult> {
    this.calls.push(request);
    return {
      bytes: Buffer.from(`fake-image:${request.idempotencyKey}:u${request.unit}`),
      contentType: "image/png",
      model: "fake-image-model",
      costUsd: 0.04,
    };
  }
}


