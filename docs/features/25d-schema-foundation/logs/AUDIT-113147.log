 105: /** Blocking camera issues for the poses planned against one composition. */
 106: export function safeCameraApprovalProblem(args: {
 107:   compositionId: string;
 108:   poses: { beatId: string; from: CameraPose; to: CameraPose }[];
 109:   safe: SafeCamera;
 110: }): string | null {
