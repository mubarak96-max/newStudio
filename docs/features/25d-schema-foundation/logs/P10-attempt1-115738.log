"use client";

// 2.5D assembly review (P9, plan 7): read-only layer/depth inspector with
// parallax scrub, AI cameras shown with their source-backed purpose, and
// the exact action that resolves each blocker. Actions are
// approve-and-continue, generate selected and regenerate only â€” the owner
// never sets camera directions, layer coordinates or text (ADR-003).

import { useState } from "react";

import type { Composition } from "@/features/book-experience/schemas/composition.ts";
import type { WorkflowAction } from "@/features/book-experience/schemas/publishing.ts";
import type { CompositionIssue } from "@/features/book-experience/compositions/assemble.ts";
import type { PreviewState } from "@/features/book-experience/preview/states.ts";

export default function CompositionReview({
  composition,
  beatCameras,
  previewState,
  previewMessage,
  selectedTargetIds,
  failedLayerIds,
  actions,
  issues,
  onApproveAndContinue,
  onGenerateSelected,
  onRegenerateLayer,
  onPreview,
  onAction,
}: {
  composition: Composition | null;
  beatCameras: { beatId: string; rationale: string; fromZoom: number; toZoom: number }[];
  previewState: PreviewState;
  previewMessage: string;
  selectedTargetIds: string[];
  failedLayerIds: string[];
  actions: WorkflowAction[];
  issues: CompositionIssue[];
  onApproveAndContinue: () => void;
  onGenerateSelected: () => void;
  onRegenerateLayer: (layerId: string) => void;
  onPreview: () => void;
  onAction: (actionId: string) => void;
}) {
  const [scrub, setScrub] = useState(0);
  const approveAction = actions.find((action) => action.kind === "approve");
  const generateAction = actions.find((action) => action.kind === "generate");
  const previewAction = actions.find((action) => action.kind === "preview");
  const orderedLayers = composition
    ? [...composition.layers].sort((a, b) => a.zOrder - b.zOrder)
    : [];

  return (
    <section className="flex flex-col gap-4" aria-label="2.5D assembly review">
      <div className="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p className="eyebrow">AI assembly Â· automatic 2.5D composition</p>
          <h2 className="mt-1 text-2xl font-semibold tracking-tight">
            {composition ? composition.compositionId : "Composition pending"}
          </h2>
          <p className="text-sm text-zinc-500">
            safeCamera [{composition?.safeCamera.maxPanX ?? 0},{" "}
            {composition?.safeCamera.maxPanY ?? 0}] zoom Ã—
            {composition?.safeCamera.maxZoom ?? 1} Â· preview {previewState}: {previewMessage}
          </p>
        </div>
        <div className="flex flex-wrap gap-2">
          <button
            type="button"
            onClick={onApproveAndContinue}
            disabled={!approveAction?.enabled}
            className="h-10 rounded-lg bg-accent px-4 text-sm font-medium text-white hover:bg-accent-hover disabled:opacity-50"
          >
            Approve and continue
          </button>
          <button
            type="button"
            onClick={onGenerateSelected}
            disabled={!generateAction?.enabled}
            className="h-10 rounded-lg border border-black/[.08] px-4 text-sm dark:border-white/[.145]"
          >
            Generate selected ({selectedTargetIds.length})
          </button>
          <button
            type="button"
            onClick={onPreview}
            disabled={!previewAction?.enabled}
            className="h-10 rounded-lg border border-black/[.08] px-4 text-sm dark:border-white/[.145]"
          >
            Preview Episode
          </button>
        </div>
      </div>

      {issues.length > 0 ? (
        <ul aria-label="Assembly blockers">
          {issues.map((issue) => (
            <li key={issue.code} className="text-sm text-amber-700">
              {issue.message}{" "}
              {failedLayerIds.length > 0 ? (
                <button
                  type="button"
                  onClick={() => onRegenerateLayer(failedLayerIds[0])}
                  className="ml-2 rounded border border-black/[.08] px-2 py-1 text-xs dark:border-white/[.145]"
                >
                  Regenerate {failedLayerIds[0]}
                </button>
              ) : null}
            </li>
          ))}
        </ul>
      ) : null}

      <div className="grid gap-3 md:grid-cols-2">
        <div aria-label="Layer and depth inspector" data-testid="layer-inspector">
          <h3 className="text-sm font-semibold">Layer/depth inspector (read-only)</h3>
          {orderedLayers.length === 0 ? (
            <p className="text-sm text-zinc-500">Missing-layer placeholder: no assembled layers yet.</p>
          ) : (
            <ul>
              {orderedLayers.map((layer) => (
                <li key={layer.layerId} className="text-sm">
                  {layer.layerId} Â· {layer.role} Â· {layer.renderMode} Â· z{layer.zOrder} Â· depth [
                  {layer.depthRange[0]}, {layer.depthRange[1]}]
                  {layer.depth
                    ? ` Â· depth ${layer.depth.bitDepth}-bit (source ${layer.depth.sourceBitDepth}-bit, ${layer.depth.convention})`
                    : " Â· no depth (plane)"}
                  {layer.mesh
                    ? ` Â· mesh ${layer.mesh.segmentsX}x${layer.mesh.segmentsY} Ã—${layer.mesh.displacementScale}`
                    : null}
                </li>
              ))}
            </ul>
          )}
          <label className="mt-2 block text-sm">
            Parallax scrub
            <input
              type="range"
              data-testid="inspector-scrub"
              min={0}
              max={100}
              value={scrub}
              onChange={(event) => setScrub(Number(event.target.value))}
              className="block w-full"
            />
          </label>
          <p className="text-xs text-zinc-500">Scrub position: {scrub}% (inspection only).</p>
        </div>

        <div aria-label="AI camera plans">
          <h3 className="text-sm font-semibold">AI cameras (planned, not editable)</h3>
          {beatCameras.length === 0 ? (
            <p className="text-sm text-zinc-500">No Beat cameras reference this composition yet.</p>
          ) : (
            <ul>
              {beatCameras.map((camera) => (
                <li key={camera.beatId} className="text-sm">
                  {camera.beatId}: zoom {camera.fromZoom} â†’ {camera.toZoom} Â· {camera.rationale}
                </li>
              ))}
            </ul>
          )}
          <h3 className="mt-3 text-sm font-semibold">Next actions</h3>
          <ul>
            {actions.map((action) => (
              <li key={action.id} className="text-sm">
                <button
                  type="button"
                  data-testid={`action-${action.id}`}
                  disabled={!action.enabled}
                  onClick={() => onAction(action.id)}
                  className="rounded border border-black/[.08] px-2 py-1 text-xs disabled:opacity-50 dark:border-white/[.145]"
                >
                  {action.label}
                </button>{" "}
                {action.enabled ? "ready" : action.blockers[0]?.message ?? "blocked"}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  );
}


