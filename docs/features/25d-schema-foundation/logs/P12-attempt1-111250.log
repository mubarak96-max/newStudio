import type { TextChunk } from "../schemas/source.ts";
import { canonicalJsonPath, textChunkDocId } from "./paths.ts";
import {
  CanonicalError,
  canonicalizeSource,
  type CanonicalizedSource,
  type StagingChapter,
} from "./canonical.ts";
import { paragraphHash } from "./hash.ts";

// Local in-memory repositories for the source review/approval slice. The
// test seam is canonicalizeSource/promoteSource against these fakes â€” no
// paid or live writes (ADR-012). Production Firebase adapters stay in
// src/services/firebase and the thin app routes; this is the explicit
// placement exception for the canonical flow.

export type StagedSource = {
  sourceId: string;
  bookId: string;
  baseSourceId?: string;
  status: "uploaded" | "extracting" | "review" | "approved" | "failed";
  storagePath: string;
  canonicalPath?: string;
  canonicalHash?: string;
  idsFrozen: boolean;
  chapters: StagingChapter[];
  openBlockingCount: number;
};

export type PromotedSource = {
  sourceId: string;
  bookId: string;
  canonicalPath: string;
  canonicalHash: string;
  canonicalJson: { sourceId: string; bookId: string; hash: string; paragraphs: CanonicalizedSource["paragraphs"] };
  chunks: Map<string, TextChunk>;
  approvedAt: string;
};

export type DependentDraft = {
  draftId: string;
  sourceId: string;
  canonicalHash: string;
  status: "current" | "outdated";
};

export type FakePublishedBundle = {
  episodeId: string;
  version: number;
  revisionId: string;
  sourceId: string;
  canonicalHash: string;
  bundle: Record<string, unknown>;
};

export class FakeSourceStore {
  staged = new Map<string, StagedSource>();
  promoted = new Map<string, PromotedSource>();
  drafts = new Map<string, DependentDraft>();
  published: FakePublishedBundle[] = [];
  activeSourceId: string | null = null;
  activeCanonical: { storagePath: string; hash: string } | null = null;
  // Interruption hook for the promotion-interruption test: when set, the
  // next promoteSource throws after staging chunks but before moving the
  // active pointer, proving the old pointer survives a failed promotion.
  interruptAfterStage = false;

  stage(source: StagedSource): void {
    this.staged.set(source.sourceId, source);
  }

  trackDraft(draft: DependentDraft): void {
    this.drafts.set(draft.draftId, draft);
  }

  publish(bundle: FakePublishedBundle): void {
    this.published.push(bundle);
  }
}

function chunkDocKey(sourceId: string, chunkId: string): string {
  return textChunkDocId(sourceId, chunkId);
}

// Validate staged chapters, freeze paragraph IDs and stage the versioned
// canonical.json plus source-versioned chunk projections. The active book
// pointer moves only after every chunk validates (compare-and-swap on the
// expected prior pointer); a failed promotion leaves prior state intact.
export function promoteSource(
  store: FakeSourceStore,
  input: {
    sourceId: string;
    bookId: string;
    approvedBy: string;
    approvedAt?: string;
    now?: string;
    expectedActiveSourceId?: string | null;
  },
): PromotedSource {
  const staged = store.staged.get(input.sourceId);
  if (!staged) throw new CanonicalError(`Source ${input.sourceId} is not staged.`);
  if (staged.bookId !== input.bookId) {
    throw new CanonicalError(`Source ${input.sourceId} does not belong to book ${input.bookId}.`);
  }
  if (staged.status !== "review") {
    throw new CanonicalError(
      `Source ${input.sourceId} is ${staged.status} and cannot be approved.`,
    );
  }
  if (staged.openBlockingCount > 0) {
    throw new CanonicalError(
      `${staged.openBlockingCount} serious uncertainties must be resolved before approval.`,
    );
  }
  if (input.expectedActiveSourceId !== undefined &&
    store.activeSourceId !== input.expectedActiveSourceId) {
    throw new CanonicalError(
      `Active source changed during review: expected ${input.expectedActiveSourceId ?? "none"}, found ${store.activeSourceId ?? "none"}.`,
    );
  }

  const canonical = canonicalizeSource({
    sourceId: staged.sourceId,
    chapters: staged.chapters,
    paragraphHash,
  });
  const canonicalPath = canonicalJsonPath(staged.bookId, staged.sourceId);
  const approvedAt = input.approvedAt ?? input.now ?? new Date().toISOString();

  const chunks = new Map<string, TextChunk>();
  for (const chunk of canonical.chunks) {
    if (chunk.sourceId !== staged.sourceId || chunk.canonicalHash !== canonical.canonicalHash) {
      throw new CanonicalError(`Chunk ${chunk.id} carries mismatched lineage.`);
    }
    chunks.set(chunkDocKey(staged.sourceId, chunk.id), chunk);
  }

  if (store.interruptAfterStage) {
    store.interruptAfterStage = false;
    throw new CanonicalError("Promotion interrupted after staging chunks; active pointer unchanged.");
  }

  const promoted: PromotedSource = {
    sourceId: staged.sourceId,
    bookId: staged.bookId,
    canonicalPath,
    canonicalHash: canonical.canonicalHash,
    canonicalJson: {
      sourceId: staged.sourceId,
      bookId: staged.bookId,
      hash: canonical.canonicalHash,
      paragraphs: canonical.paragraphs,
    },
    chunks,
    approvedAt,
  };
  store.promoted.set(staged.sourceId, promoted);
  staged.status = "approved";
  staged.idsFrozen = true;
  staged.canonicalPath = canonicalPath;
  staged.canonicalHash = canonical.canonicalHash;
  store.activeSourceId = staged.sourceId;
  store.activeCanonical = { storagePath: canonicalPath, hash: canonical.canonicalHash };

  // A correction revision keeps history and marks dependent drafts outdated;
  // published snapshots remain intact (ADR-001/ADR-010).
  if (staged.baseSourceId) {
    const base = store.staged.get(staged.baseSourceId);
    if (base) {
      (base as { supersededBy?: string }).supersededBy = staged.sourceId;
    }
    for (const draft of store.drafts.values()) {
      if (draft.sourceId === staged.baseSourceId && draft.canonicalHash !== canonical.canonicalHash) {
        draft.status = "outdated";
      }
    }
  }
  void input.approvedBy;
  return promoted;
}

===== src/features/book-experience/storage/review.ts =====
import type { Paragraph } from "../schemas/paragraph.ts";
import { CanonicalError } from "./canonical.ts";
import { FakeSourceStore, promoteSource, type StagedSource } from "./repository.ts";

// Source review/approval slice against local repositories and fakes (P3).
// The owner only reviews/approves; AI supplies plans (ADR-003). Approval
// validates the canonical hash and chunk count, then atomically advances the
// active source pointer. Corrections retain history and explicitly invalidate
// downstream drafts; published bundles are never rewritten here.

export type ReviewSummary = {
  sourceId: string;
  bookId: string;
  status: StagedSource["status"];
  paragraphCount: number;
  storyParagraphCount: number;
  nonStory: { id: string; seq: number; kind: Paragraph["kind"] }[];
  openBlockingCount: number;
  canonicalHash?: string;
  activeSourceId: string | null;
};

export function reviewSource(store: FakeSourceStore, sourceId: string): ReviewSummary {
  const staged = store.staged.get(sourceId);
  if (!staged) throw new CanonicalError(`Source ${sourceId} is not staged.`);
  let seq = 0;
  const nonStory: ReviewSummary["nonStory"] = [];
  for (const chapter of staged.chapters) {
    for (const paragraph of chapter.paragraphs) {
      if (!paragraph.isStory) {
        nonStory.push({ id: `p${String(seq).padStart(6, "0")}`, seq, kind: paragraph.kind });
      }
      seq += 1;
    }
  }
  return {
    sourceId: staged.sourceId,
    bookId: staged.bookId,
    status: staged.status,
    paragraphCount: seq,
    storyParagraphCount: seq - nonStory.length,
    nonStory,
    openBlockingCount: staged.openBlockingCount,
    canonicalHash: staged.canonicalHash,
    activeSourceId: store.activeSourceId,
  };
}

export function approveSource(
  store: FakeSourceStore,
  input: { sourceId: string; bookId: string; approvedBy: string; now?: string },
): ReviewSummary {
  const promoted = promoteSource(store, {
    sourceId: input.sourceId,
    bookId: input.bookId,
    approvedBy: input.approvedBy,
    now: input.now,
    expectedActiveSourceId: store.activeSourceId,
  });
  void promoted;
  return reviewSource(store, input.sourceId);
}

// Correction flow: a new staging revision based on an approved source keeps
// the base history and, once approved, marks drafts pinned to the old hash
// outdated while published bundles stay byte-identical.
export function stageCorrection(
  store: FakeSourceStore,
  input: { sourceId: string; bookId: string; baseSourceId: string; storagePath: string },
): StagedSource {
  const base = store.staged.get(input.baseSourceId);
  if (!base || base.status !== "approved") {
    throw new CanonicalError("Only an approved source can be corrected.");
  }
  const staged: StagedSource = {
    sourceId: input.sourceId,
    bookId: input.bookId,
    baseSourceId: input.baseSourceId,
    status: "review",
    storagePath: input.storagePath,
    idsFrozen: false,
    chapters: base.chapters.map((chapter) => ({
      ...chapter,
      paragraphs: chapter.paragraphs.map((p) => ({ ...p })),
    })),
    openBlockingCount: 0,
  };
  store.stage(staged);
  return staged;
}

