  26: // errors for coverage gaps, unresolved compositionIds, verbatim mismatches
  27: // or depthMesh layers missing aligned depth.
  28: export function compileFixtureBundle(fixture: unknown): EpisodeBundle {
  29:   const parsed = FixtureSchema.parse(fixture);
  30:   const byId = new Map(parsed.source.paragraphs.map((p) => [p.id, p]));
  31: 
  32:   for (const paragraphId of parsed.moment.sourceParagraphIds) {
  33:     if (!byId.has(paragraphId)) {
  34:       throw new Error(`Moment ${parsed.moment.momentId} cites unknown paragraph ${paragraphId}.`);
  35:     }
  36:   }
  37:   const covered = new Set<string>();
  38:   for (const beat of parsed.moment.readingBeats) {
  39:     for (const representation of beat.representations) {
  40:       covered.add(representation.paragraphId);
  41:     }
  42:   }
  43:   const storyIds = parsed.source.paragraphs.filter((p) => p.isStory).map((p) => p.id);
  44:   const missing = storyIds.filter(
  45:     (id) => parsed.moment.sourceParagraphIds.includes(id) && !covered.has(id),
  46:   );
  47:   if (missing.length > 0) {
  48:     throw new Error(
  49:       `Coverage gap: story paragraphs without a Representation: ${missing.join(", ")}. ` +
  50:         `Every story paragraph needs a meaningful Representation (ADR-002).`,
  51:     );
  52:   }
  53:   for (const beat of parsed.moment.readingBeats) {
  54:     if (parsed.compositions[beat.compositionId] === undefined) {
  55:       throw new Error(
  56:         `Beat ${beat.id} references missing composition ${beat.compositionId}. ` +
  57:           `Draft IDs must resolve before preview.`,
  58:       );
  59:     }
  60:     const quote = beat.text.quote;
  61:     if (quote) {
  62:       const canonical = byId.get(quote.paragraphId);
  63:       if (!canonical) throw new Error(`Beat ${beat.id} quotes unknown paragraph ${quote.paragraphId}.`);
  64:       const actual = canonical.text.slice(quote.start, quote.end);
  65:       if (actual !== quote.text) {
  66:         throw new Error(
  67:           `Beat ${beat.id} quote mismatch at ${quote.paragraphId}[${quote.start}:${quote.end}]: ` +
  68:             `expected exactly the canonical string.`,
  69:         );
  70:       }
  71:     }
  72:     for (const line of beat.text.dialogue ?? []) {
