+
+export type StagingParagraphKind =
+  | "body"
+  | "heading"
+  | "frontmatter"
+  | "backmatter"
+  | "note"
+  | "caption";
+
+export type StagingParagraph = {
+  text: string;
+  page: number | null;
+  kind: StagingParagraphKind;
+  isStory: boolean;
+};
+
+export type StagingChapterInput = {
+  chapterId: string;
+  title: string;
+  paragraphs: StagingParagraph[];
+};
+
+/**
+ * Default canonical classification for an extracted paragraph (ADR-002).
+ * Extraction preserves every paragraph from PDF text/OCR/EPUB; the canonical
+ * flow classifies non-story material instead of deleting it. Explicit
+ * editor classification (paragraph.classify) always wins over this default.
+ */
+export function classifyStagingParagraph(input: {
+  text: string;
+  flags?: string[];
+  kind?: StagingParagraphKind;
+  isStory?: boolean;
+}): { kind: StagingParagraphKind; isStory: boolean } {
+  if (input.kind !== undefined && input.isStory !== undefined) {
+    return { kind: input.kind, isStory: input.isStory };
+  }
+  const flags = input.flags ?? [];
+  if (flags.includes("non-story") || flags.includes("frontmatter")) {
+    return { kind: (input.kind ?? "frontmatter") as StagingParagraphKind, isStory: false };
+  }
+  if (flags.includes("backmatter")) {
+    return { kind: "backmatter", isStory: false };
+  }
+  if (flags.includes("caption") || flags.includes("note")) {
+    const kind = (flags.includes("caption") ? "caption" : "note") as StagingParagraphKind;
+    return { kind: input.kind ?? kind, isStory: false };
+  }
+  return { kind: input.kind ?? "body", isStory: input.isStory ?? true };
+}
+
+/**
+ * Maps a format-agnostic Extraction (EPUB, PDF text layer or OCR scan) to
+ * canonical staging chapters. IDs are assigned at approval (p000000-based
+ * seq scoped to a sourceId), never here, so retries stay idempotent.
+ */
+export function toStagingChapters(extraction: Extraction): StagingChapterInput[] {
+  return extraction.chapters.map((chapter, order) => ({
+    chapterId: `ch_${order}`,
+    title: chapter.title,
+    paragraphs: chapter.paragraphs.map((entry) => ({
+      text: entry.text,
+      page: entry.page,
+      ...classifyStagingParagraph({ text: entry.text, flags: entry.flags }),
+    })),
+  }));
+}

