import type { EpisodeBundle } from "../schemas/bundle.ts";
import { EpisodeBundleSchema } from "../schemas/bundle.ts";
import { FixtureSourceSchema, MomentSchema } from "../schemas/moment.ts";
import { BundleCompositionSchema } from "../schemas/composition.ts";
import { z } from "zod";

const FixtureSchema = z.object({
  provenance: z.string().min(1),
  bookId: z.string().min(1),
  episodeId: z.string().min(1),
  episode: z.object({
    order: z.number().int().min(1),
    title: z.string().min(1),
    summary: z.string().min(1),
    version: z.number().int().min(1),
    revisionId: z.string().min(1),
  }),
  source: FixtureSourceSchema,
  moment: MomentSchema,
  compositions: z.record(z.string(), BundleCompositionSchema),
  assetsBaseUrl: z.string().min(1),
});

// Assemble the draft EpisodeBundle served by the local preview endpoint.
// Pure and local: no cloud writes, no paid generation. Throws actionable
// errors for coverage gaps, unresolved compositionIds, verbatim mismatches
// or depthMesh layers missing aligned depth.
export function compileFixtureBundle(fixture: unknown): EpisodeBundle {
  const parsed = FixtureSchema.parse(fixture);
  const byId = new Map(parsed.source.paragraphs.map((p) => [p.id, p]));

  for (const paragraphId of parsed.moment.sourceParagraphIds) {
    if (!byId.has(paragraphId)) {
      throw new Error(`Moment ${parsed.moment.momentId} cites unknown paragraph ${paragraphId}.`);
    }
  }
  const covered = new Set<string>();
  for (const beat of parsed.moment.readingBeats) {
    for (const representation of beat.representations) {
      covered.add(representation.paragraphId);
    }
  }
  const storyIds = parsed.source.paragraphs.filter((p) => p.isStory).map((p) => p.id);
  const missing = storyIds.filter(
    (id) => parsed.moment.sourceParagraphIds.includes(id) && !covered.has(id),
  );
  if (missing.length > 0) {
    throw new Error(
      `Coverage gap: story paragraphs without a Representation: ${missing.join(", ")}. ` +
        `Every story paragraph needs a meaningful Representation (ADR-002).`,
    );
  }
  for (const beat of parsed.moment.readingBeats) {
    if (parsed.compositions[beat.compositionId] === undefined) {
      throw new Error(
        `Beat ${beat.id} references missing composition ${beat.compositionId}. ` +
          `Draft IDs must resolve before preview.`,
      );
    }
    const quote = beat.text.quote;
    if (quote) {
      const canonical = byId.get(quote.paragraphId);
      if (!canonical) throw new Error(`Beat ${beat.id} quotes unknown paragraph ${quote.paragraphId}.`);
      const actual = canonical.text.slice(quote.start, quote.end);
      if (actual !== quote.text) {
        throw new Error(
          `Beat ${beat.id} quote mismatch at ${quote.paragraphId}[${quote.start}:${quote.end}]: ` +
            `expected exactly the canonical string.`,
        );
      }
    }
    for (const line of beat.text.dialogue ?? []) {
      const canonical = byId.get(line.paragraphId);
      if (!canonical) throw new Error(`Beat ${beat.id} dialogue cites unknown ${line.paragraphId}.`);
      const actual = canonical.text.slice(line.start, line.end);
      if (actual !== line.text) {
        throw new Error(`Beat ${beat.id} dialogue mismatch at ${line.paragraphId}.`);
      }
    }
  }
  const bundle = EpisodeBundleSchema.parse({
    schemaVersion: 1,
    sourceId: parsed.source.sourceId,
    canonicalHash: parsed.source.canonicalHash,
    bookId: parsed.bookId,
    episodeId: parsed.episodeId,
    version: parsed.episode.version,
    revisionId: parsed.episode.revisionId,
    order: parsed.episode.order,
    title: parsed.episode.title,
    summary: parsed.episode.summary,
    beats: parsed.moment.readingBeats,
    compositions: parsed.compositions,
    entities: {},
    entityViews: {},
    assetsBaseUrl: parsed.assetsBaseUrl,
  });
  return bundle;
}


