export type CompletionMomentResult = {
  id: string;
  order: number;
  posted: boolean;
  validationProblems: string[];
};

export function episodeCompletionProblems(input: {
  coverageProblems: string[];
  moments: CompletionMomentResult[];
}): string[] {
  const problems = [...input.coverageProblems];
  const ordered = [...input.moments].sort((a, b) => a.order - b.order);
  if (!ordered.length) problems.push('The episode has no Story Moments.');
  for (const moment of ordered) {
    if (!moment.posted) {
      problems.push(`Story Moment ${moment.order} is not live.`);
    }
    problems.push(
      ...moment.validationProblems.map(
        (problem) => `Story Moment ${moment.order}: ${problem}`,
      ),
    );
  }
  return [...new Set(problems)];
}

--- src/features/completion/store.ts ---
import { FieldValue } from 'firebase-admin/firestore';

import { episodesRef } from '@/features/episodes/store';
import type { EpisodeExclusion } from '@/features/episodes/types';
import { adminDb } from '@/services/firebase/admin';
import { momentsRef } from '@/features/moments/store';
import type { HotspotPlan, StoryMomentPlan } from '@/features/moments/types';
import { episodeRange, momentCoverageProblems } from '@/features/moments/types';
import {
  postedMomentRef,
  publicContent,
  publicEpisodeRef,
  reviewStoryMoment,
} from '@/features/posting/store';
import type { CompletionMomentResult } from '@/features/completion/types';
import { episodeCompletionProblems } from '@/features/completion/types';
import { EditError } from '@/features/sources/edit-ops';
import { sourceRef } from '@/features/sources/store';
import type { PrimaryText, TextStatus } from '@/features/moment-text/types';

export type EpisodeCompletionReview = {
  problems: string[];
  warnings: string[];
};

type ReviewedVersion = { momentId: string; postedVersionId: string; fingerprint: string };

export async function reviewEpisodeCompletion(
  bookId: string,
  sourceId: string,
  episodeId: string,
): Promise<EpisodeCompletionReview & { reviewedVersions: ReviewedVersion[] }> {
  const source = await sourceRef(bookId, sourceId).get();
  if (!source.exists || source.get('dependentWorkStatus') === 'outdated') {
    throw new EditError('This source revision is not current.');
  }
  const episode = await episodesRef(bookId, sourceId).doc(episodeId).get();
  if (!episode.exists || episode.get('momentPlanStatus') !== 'approved') {
    throw new EditError('Approve the Story Moment plan before completing the episode.');
  }
  const range = episodeRange(
    { start: String(episode.get('start') ?? ''), end: String(episode.get('end') ?? '') },
    Number(source.get('paragraphCount') ?? 0),
  );
  if (!range) throw new EditError("This episode's paragraph range is not readable.");

  const snapshot = await momentsRef(bookId, sourceId, episodeId).orderBy('order', 'asc').get();
  const moments = snapshot.docs.map(storyMomentFromDocument);
  const coverage = momentCoverageProblems(
    moments,
    (episode.get('momentExclusions') ?? []) as EpisodeExclusion[],
    range,
  ).map((problem) => problem.message);
  const results: CompletionMomentResult[] = [];
  const warnings: string[] = [];
  const reviewedVersions: ReviewedVersion[] = [];
  const fingerprints = new Map(snapshot.docs.map((doc) => [doc.id, documentFingerprint(doc)]));

  for (const moment of moments) {
    const validationProblems: string[] = [];
    if (moment.posted && moment.postedVersionId) {
      const [review, canonical] = await Promise.all([
        reviewStoryMoment(bookId, sourceId, episodeId, moment.id),
        postedMomentRef(bookId, episodeId, moment.id).get(),
      ]);
      validationProblems.push(...review.problems);
      warnings.push(...review.warnings.map((warning) => `Story Moment ${moment.order}: ${warning}`));
      if (
        !review.preview ||
        !canonical.exists ||
        canonical.get('live') !== true ||
        canonical.get('activeVersionId') !== moment.postedVersionId ||
        !sameContent(canonical.get('content'), publicContent(review.preview))
      ) {
        validationProblems.push('The live version does not match the currently reviewed content. Prepare and promote a replacement.');
      } else {
        reviewedVersions.push({
          momentId: moment.id,
          postedVersionId: moment.postedVersionId,
          fingerprint: fingerprints.get(moment.id) ?? '',
        });
      }
    }
    results.push({
      id: moment.id,
      order: moment.order,
      posted: moment.posted && Boolean(moment.postedVersionId),
      validationProblems,
    });
  }
  return {
    problems: episodeCompletionProblems({ coverageProblems: coverage, moments: results }),
    warnings: [...new Set(warnings)],
    reviewedVersions,
  };
}

export async function completeEpisode(
  bookId: string,
  sourceId: string,
  episodeId: string,
  email: string,
): Promise<void> {
  const review = await reviewEpisodeCompletion(bookId, sourceId, episodeId);
  if (review.problems.length) throw new EditError(review.problems.join(' '));
  const internalEpisode = episodesRef(bookId, sourceId).doc(episodeId);
  const publicEpisode = publicEpisodeRef(bookId, episodeId);
  await adminDb().runTransaction(async (tx) => {
    const source = sourceRef(bookId, sourceId);
    const refs = review.reviewedVersions.flatMap(({ momentId }) => [
      momentsRef(bookId, sourceId, episodeId).doc(momentId),
      postedMomentRef(bookId, episodeId, momentId),
    ]);
    const [currentSource, currentEpisode, ...versions] = await Promise.all([
      tx.get(source),
      tx.get(internalEpisode),
      ...refs.map((ref) => tx.get(ref)),
    ]);
    if (
      !currentSource.exists ||
      currentSource.get('dependentWorkStatus') === 'outdated' ||
      !currentEpisode.exists ||
      currentEpisode.get('momentPlanStatus') !== 'approved'
    ) throw new EditError('The episode changed after validation. Check it again.');
    for (let index = 0; index < review.reviewedVersions.length; index += 1) {
      const expected = review.reviewedVersions[index];
      const internal = versions[index * 2];
      const canonical = versions[index * 2 + 1];
      if (
        !internal.exists ||
        internal.get('postedVersionId') !== expected.postedVersionId ||
        documentFingerprint(internal) !== expected.fingerprint ||
        !canonical.exists ||
        canonical.get('activeVersionId') !== expected.postedVersionId
      ) throw new EditError('A Story Moment changed after validation. Check the episode again.');
    }
    tx.set(publicEpisode, {
      live: true,
      complete: true,
      completedAt: FieldValue.serverTimestamp(),
      updatedAt: FieldValue.serverTimestamp(),
    }, { merge: true });
    tx.update(internalEpisode, {
      completed: true,
      completedAt: FieldValue.serverTimestamp(),
      completedBy: email,
    });
  });
}

export async function prepareReplacement(
  bookId: string,
  sourceId: string,
  episodeId: string,
  momentId: string,
  email: string,
): Promise<{ versionId: string }> {
  const review = await reviewStoryMoment(bookId, sourceId, episodeId, momentId);
  if (review.problems.length || !review.preview) {
    throw new EditError(review.problems.join(' ') || 'The replacement preview is incomplete.');
  }
  const preview = review.preview;
  const canonical = postedMomentRef(bookId, episodeId, momentId);
  const version = canonical.collection('versions').doc();
  const internal = momentsRef(bookId, sourceId, episodeId).doc(momentId);
  const previousReplacement = await adminDb().runTransaction(async (tx) => {
    const source = sourceRef(bookId, sourceId);
    const [currentCanonical, currentInternal, currentSource] = await Promise.all([
      tx.get(canonical),
      tx.get(internal),
      tx.get(source),
    ]);
    if (!currentCanonical.exists || currentCanonical.get('live') !== true) {
      throw new EditError('Post this Story Moment before preparing a replacement.');
    }
    if (
      !currentInternal.exists ||
      currentInternal.get('activeImageCandidateId') !== preview.image.candidateId ||
      !currentSource.exists ||
      currentSource.get('dependentWorkStatus') === 'outdated'
    ) throw new EditError('The Story Moment changed after review. Review it again.');
    const previous = currentInternal.get('replacementVersionId') as string | null;
    tx.set(version, {
      content: publicContent(preview),
      sourceId,
      sourceRevision: Number(currentSource.get('revision') ?? 1),
      reviewWarnings: review.warnings,
      status: 'replacement',
      createdAt: FieldValue.serverTimestamp(),
      createdBy: email,
    });
    tx.update(internal, {
      replacementVersionId: version.id,
      replacementPreparedAt: FieldValue.serverTimestamp(),
      replacementPreparedBy: email,
    });
    return previous;
  });
  if (previousReplacement) {
    await canonical.collection('versions').doc(previousReplacement).delete();
  }
  return { versionId: version.id };
}

export async function promoteReplacement(
  bookId: string,
  sourceId: string,
  episodeId: string,
  momentId: string,
  email: string,
): Promise<{ versionId: string; cleanupPending: boolean }> {
  const canonical = postedMomentRef(bookId, episodeId, momentId);
  const internal = momentsRef(bookId, sourceId, episodeId).doc(momentId);
  const review = await reviewStoryMoment(bookId, sourceId, episodeId, momentId);
  if (review.problems.length || !review.preview) {
    throw new EditError(review.problems.join(' ') || 'The replacement preview is incomplete.');
  }
  const expectedContent = publicContent(review.preview);
  const reviewedInternal = await internal.get();
  const expectedFingerprint = documentFingerprint(reviewedInternal);
  const result = await adminDb().runTransaction(async (tx) => {
    const currentSourceRef = sourceRef(bookId, sourceId);
    const [currentCanonical, currentInternal, currentSource] = await Promise.all([
      tx.get(canonical),
      tx.get(internal),
      tx.get(currentSourceRef),
    ]);
    const replacementId = String(currentInternal.get('replacementVersionId') ?? '');
    if (
      !currentCanonical.exists ||
      !currentInternal.exists ||
      !currentSource.exists ||
      currentSource.get('dependentWorkStatus') === 'outdated' ||
      documentFingerprint(currentInternal) !== expectedFingerprint ||
      !replacementId
    ) {
      throw new EditError('There is no prepared replacement to promote.');
    }
    const replacement = canonical.collection('versions').doc(replacementId);
    const replacementSnapshot = await tx.get(replacement);
    if (
      !replacementSnapshot.exists ||
      replacementSnapshot.get('status') !== 'replacement' ||
      Number(replacementSnapshot.get('sourceRevision') ?? 0) !== Number(currentSource.get('revision') ?? 1) ||
      !sameContent(replacementSnapshot.get('content'), expectedContent)
    ) {
      throw new EditError('The prepared replacement no longer exists.');
    }
    const oldVersionId = String(currentCanonical.get('activeVersionId') ?? '');
    tx.update(canonical, {
      content: replacementSnapshot.get('content'),
      activeVersionId: replacementId,
      updatedAt: FieldValue.serverTimestamp(),
    });
    tx.update(replacement, {
      status: 'active',
      promotedAt: FieldValue.serverTimestamp(),
      promotedBy: email,
    });
    tx.update(internal, {
      posted: true,
      postedVersionId: replacementId,
      replacementVersionId: null,
      postedAt: FieldValue.serverTimestamp(),
      postedBy: email,
    });
    tx.set(publicEpisodeRef(bookId, episodeId), {
      complete: false,
      completedAt: null,
      updatedAt: FieldValue.serverTimestamp(),
    }, { merge: true });
    tx.update(episodesRef(bookId, sourceId).doc(episodeId), {
      completed: false,
      completedAt: null,
    });
    return { replacementId, oldVersionId };
  });

  let cleanupPending = false;
  if (result.oldVersionId && result.oldVersionId !== result.replacementId) {
    try {
      await canonical.collection('versions').doc(result.oldVersionId).delete();
    } catch {
      cleanupPending = true;
    }
  }
  return { versionId: result.replacementId, cleanupPending };
}

function storyMomentFromDocument(doc: FirebaseFirestore.QueryDocumentSnapshot): StoryMomentPlan {
  return {
    id: doc.id,
    order: Number(doc.get('order') ?? 0),
    purpose: String(doc.get('purpose') ?? ''),
    paragraphIds: (doc.get('paragraphIds') ?? []) as string[],
    characters: (doc.get('characters') ?? []) as string[],
    location: String(doc.get('location') ?? ''),
    objects: (doc.get('objects') ?? []) as string[],
    characterStates: (doc.get('characterStates') ?? []) as string[],
    reveals: (doc.get('reveals') ?? []) as string[],
    spoilers: (doc.get('spoilers') ?? []) as string[],
    textType: doc.get('textType') ?? 'commentary',
    visualType: doc.get('visualType') ?? 'scene',
    visualIntention: String(doc.get('visualIntention') ?? ''),
    framing: String(doc.get('framing') ?? ''),
    hotspots: (doc.get('hotspots') ?? []) as HotspotPlan[],
    primaryText: (doc.get('primaryText') ?? null) as PrimaryText | null,
    textStatus: (doc.get('textStatus') ?? 'none') as TextStatus,
    textError: doc.get('textError') ?? null,
    textLocked: Boolean(doc.get('textLocked')),
    imageGenerationStatus: doc.get('imageGenerationStatus') ?? 'none',
    imageCandidateCount: Number(doc.get('imageCandidateCount') ?? 0),
    activeImageCandidateId: doc.get('activeImageCandidateId') ?? null,
    imageError: doc.get('imageError') ?? null,
    posted: Boolean(doc.get('posted')),
    postedVersionId: doc.get('postedVersionId') ?? null,
    replacementVersionId: doc.get('replacementVersionId') ?? null,
    locked: Boolean(doc.get('locked')),
    source: doc.get('source') ?? 'ai',
    createdAt: null,
    updatedAt: null,
  };
}

function sameContent(left: unknown, right: unknown): boolean {
  return JSON.stringify(sortValue(left)) === JSON.stringify(sortValue(right));
}

function documentFingerprint(doc: FirebaseFirestore.DocumentSnapshot): string {
  if (!doc.exists) return '';
  return JSON.stringify(sortValue({
    order: doc.get('order'),
    purpose: doc.get('purpose'),
    paragraphIds: doc.get('paragraphIds'),
    reveals: doc.get('reveals'),
    textType: doc.get('textType'),
    primaryText: doc.get('primaryText'),
    textStatus: doc.get('textStatus'),
    visualType: doc.get('visualType'),
    hotspots: doc.get('hotspots'),
    activeImageCandidateId: doc.get('activeImageCandidateId'),
    postedVersionId: doc.get('postedVersionId'),
    replacementVersionId: doc.get('replacementVersionId'),
  }));
}

function sortValue(value: unknown): unknown {
  if (Array.isArray(value)) return value.map(sortValue);
  if (value && typeof value === 'object') {
    return Object.fromEntries(
      Object.entries(value as Record<string, unknown>)
        .sort(([left], [right]) => left.localeCompare(right))
        .map(([key, child]) => [key, sortValue(child)]),
    );
  }
  return value;
}

