 148: export function useLiveDoc<T>(
 149:   ready: boolean,
 150:   ref: () => DocumentReference,
 151:   map: (id: string, data: DocumentData) => T,
 152: ): { value: T | null; error: string | null } {
 153:   const [value, setValue] = useState<T | null>(null);
 154:   const [error, setError] = useState<string | null>(null);
 155: 
 156:   useEffect(() => {
 157:     if (!ready) return;
 158:     return onSnapshot(
 159:       ref(),
 160:       (snapshot) => {
 161:         const data = snapshot.data();
 162:         setValue(data ? map(snapshot.id, data) : null);
 163:       },
 164:       (failure) => setError(failure.message),
 165:     );
 166:     // eslint-disable-next-line react-hooks/exhaustive-deps
 167:   }, [ready]);
 168: 
 169:   return { value, error };
 170: }
 171: 
 172: export function useLiveCollection<T>(
 173:   ready: boolean,
 174:   query: () => Query,
 175:   map: (id: string, data: DocumentData) => T,
 176: ): { values: T[]; error: string | null } {
 177:   const [values, setValues] = useState<T[]>([]);
 178:   const [error, setError] = useState<string | null>(null);
 179: 
 180:   useEffect(() => {
 181:     if (!ready) return;
 182:     return onSnapshot(
 183:       query(),
 184:       (snapshot) => setValues(snapshot.docs.map((doc) => map(doc.id, doc.data()))),
 185:       (failure) => setError(failure.message),
 186:     );
 187:     // eslint-disable-next-line react-hooks/exhaustive-deps
 188:   }, [ready]);
 189: 
 190:   return { values, error };
 191: }

