import { NextResponse } from "next/server";

import { getSession } from "@/features/auth/session";
import { adminDb } from "@/services/firebase/admin";
import { applyEdit, EditError, type EditOp } from "@/features/sources/edit-ops";
import {
  chaptersRef,
  countParagraphs,
  MAX_CHAPTERS_PER_TRANSACTION,
  readChapters,
  sourceRef,
  writeChapterDiff,
} from "@/features/sources/store";
import { isEditable, tempParagraphId, type SourceStatus } from "@/features/sources/types";

export async function POST(
  request: Request,
  context: RouteContext<"/api/books/[bookId]/sources/[sourceId]/edit">,
) {
  const session = await getSession();
  if (!session) {
    return NextResponse.json({ error: "Not signed in." }, { status: 401 });
  }

  const { bookId, sourceId } = await context.params;
  const op = (await request.json()) as EditOp;
  if (!op?.op) {
    return NextResponse.json({ error: "Missing operation." }, { status: 400 });
  }

  const source = sourceRef(bookId, sourceId);
  const chapters = chaptersRef(bookId, sourceId);

  try {
    await adminDb().runTransaction(async (tx) => {
      const snapshot = await tx.get(source);
      if (!snapshot.exists) throw new EditError("Source not found.");

      const status = snapshot.get("status") as SourceStatus;
      if (!isEditable(status)) {
        throw new EditError(
          status === "approved"
            ? "This extraction is approved and can no longer be edited."
            : `The extraction is ${status} and cannot be edited yet.`,
        );
      }

      const before = await readChapters(tx, chapters);
      if (before.length > MAX_CHAPTERS_PER_TRANSACTION) {
        throw new EditError("This source has too many chapters to edit safely.");
      }

      let counter = Number(snapshot.get("nextTempId") ?? 1);
      const after = applyEdit(before, op, () => tempParagraphId(counter++));

      writeChapterDiff(tx, chapters, before, after);
      tx.update(source, {
        nextTempId: counter,
        chapterCount: after.length,
        paragraphCount: countParagraphs(after),
      });
    });
  } catch (error) {
    if (error instanceof EditError) {
      return NextResponse.json({ error: error.message }, { status: 409 });
    }
    throw error;
  }

  return new NextResponse(null, { status: 204 });
}
