+/** Word spans inside [start, end) so long selections split with exact offsets. */
+export function splitWordsWithOffsets(
+  canonical: string,
+  start: number,
+  end: number,
+): { word: string; start: number; end: number }[] {
+  const spans: { word: string; start: number; end: number }[] = [];
+  const pattern = /\S+/g;
+  pattern.lastIndex = start;
+  let match: RegExpExecArray | null;
+  while ((match = pattern.exec(canonical)) !== null && match.index < end) {
+    const wordEnd = Math.min(match.index + match[0].length, end);
+    spans.push({ word: canonical.slice(match.index, wordEnd), start: match.index, end: wordEnd });
+    if (pattern.lastIndex >= end) break;
+  }
+  return spans;
+}
