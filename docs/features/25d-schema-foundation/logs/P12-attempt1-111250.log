// Legacy visual â†’ canonical adapters (P8, plan 10).
// The legacy StyleCanon/VisualReference model keeps serving existing
// callers; canonical visualProfile/ReferencePin generation lives in
// book-experience/visuals. These adapters map, never duplicate, the
// editorial meaning: approved canon fields become a visualProfile draft,
// approved references become ReferencePins. Intentional-overlap style
// leftovers are not carried; CONTEXT.md legacy vocabulary applies.

import type { ReferencePin } from "@/features/book-experience/schemas/model";
import type { VisualProfile } from "@/features/book-experience/schemas/source";
import type { StyleCanon, VisualReference } from "@/features/visual/types";

export function styleCanonToVisualProfile(canon: StyleCanon, version: number): VisualProfile {
  return {
    version,
    artStyle: canon.medium,
    palette: canon.palette.split(/[,;]/).map((entry) => entry.trim()).filter(Boolean),
    lens: canon.composition,
    lighting: canon.lighting,
    negativeRules: canon.prohibitedTendencies.filter((rule) => rule.trim()),
  };
}

export function visualReferenceToPin(args: {
  entityId: string;
  stateId?: string;
  version: number;
  reference: VisualReference;
  s3Keys: string[];
  checksum: string;
}): ReferencePin {
  if (!args.reference.activeCandidateId) {
    throw new Error(`${args.reference.name} has no approved reference candidate to pin.`);
  }
  return {
    entityId: args.entityId,
    ...(args.stateId ? { stateId: args.stateId } : {}),
    version: args.version,
    s3Keys: args.s3Keys,
    checksum: args.checksum,
  };
}

/** Approved legacy references gate canonical scene generation. */
export function legacyReferenceProblem(
  needed: string[],
  references: Pick<VisualReference, "name" | "activeCandidateId">[],
): string | null {
  for (const name of needed) {
    const match = references.find(
      (reference) => reference.name.trim().toLocaleLowerCase() === name.trim().toLocaleLowerCase(),
    );
    if (!match?.activeCandidateId) return `${name} needs an approved reference before scene generation.`;
  }
  return null;
}


