   1: // Deterministic safe-camera computation (P9, plan 3.2, ADR-008).
   2: // safeCamera is computed from actual opaque/background coverage, crop and
   3: // aspect, all layer movement, rotation and displacement limits. Metadata
   4: // claims alone are not proof of hole-free motion: a background without the
   5: // required overscan yields zero pan/zoom headroom and blocks approval.
   6: // AI replans or regeneration resolves unsafe shots; the owner never fixes
   7: // camera directions (ADR-003).
   8: 
   9: import type { CameraPose, SafeCamera } from "../schemas/primitives.ts";
  10: import { SafeCameraSchema } from "../schemas/primitives.ts";
  11: 
  12: export type CameraFrame = {
  13:   /** Explicit composition canvas all layers share (plan 3.2). */
  14:   w: number;
  15:   h: number;
  16:   /** Required background overscan beyond the viewport (px). */
  17:   overscan: number;
  18: };
  19: 
  20: export type LayerCoverage = {
  21:   layerId: string;
  22:   role: "background" | "midground" | "foreground";
  23:   /** Background overscan actually present beyond the viewport (px). */
  24:   overscanPresentPx?: number;
  25:   /** True when the delivered bytes carry a real alpha channel. */
  26:   hasAlpha?: boolean;
  27:   /** depthMesh displacement scale; planes omit it. */
  28:   displacementScale?: number;
  29: };
  30: 
  31: function round4(value: number): number {
  32:   return Math.round(value * 10000) / 10000;
  33: }
  34: 
  35: /**
  36:  * Compute motion limits from actual layer/background coverage and depth
  37:  * displacement. Pan headroom is the scarcest background overscan expressed
  38:  * as a fraction of the canvas; zoom headroom scales with overscan over the
  39:  * shorter canvas side; tilt shrinks when depth displacement grows.
  40:  */
  41: export function computeSafeCamera(args: {
  42:   frame: CameraFrame;
  43:   coverages: LayerCoverage[];
  44: }): SafeCamera {
  45:   const backgrounds = args.coverages.filter((coverage) => coverage.role === "background");
  46:   const minOverscan =
  47:     backgrounds.length === 0
  48:       ? 0
  49:       : Math.min(...backgrounds.map((coverage) => coverage.overscanPresentPx ?? 0));
  50:   const holeFree = backgrounds.length > 0 && minOverscan >= args.frame.overscan;
  51:   const displacements = args.coverages.map((coverage) => coverage.displacementScale ?? 0);
  52:   const maxDisplacement = displacements.length === 0 ? 0 : Math.max(...displacements);
  53:   return SafeCameraSchema.parse({
  54:     maxPanX: holeFree ? round4(minOverscan / args.frame.w) : 0,
  55:     maxPanY: holeFree ? round4(minOverscan / args.frame.h) : 0,
  56:     maxZoom: holeFree
  57:       ? round4(1 + Math.min(0.5, minOverscan / Math.min(args.frame.w, args.frame.h)))
  58:       : 1,
  59:     maxTilt: maxDisplacement > 0.25 ? 0.02 : 0.08,
  60:   });
  61: }
  62: 
  63: /** True when every planned pose component sits inside the safe bounds. */
  64: export function isCameraSafe(pose: CameraPose, safe: SafeCamera): boolean {
  65:   return (
  66:     Math.abs(pose.x) <= safe.maxPanX &&
  67:     Math.abs(pose.y) <= safe.maxPanY &&
  68:     pose.zoom >= 1 &&
  69:     pose.zoom <= safe.maxZoom &&
  70:     Math.abs(pose.rotate) <= safe.maxTilt
  71:   );
  72: }
  73: 
  74: function clamp(value: number, min: number, max: number): number {
  75:   return Math.min(max, Math.max(min, value));
