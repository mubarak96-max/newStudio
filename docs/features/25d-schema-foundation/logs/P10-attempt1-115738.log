import { existsSync, readFileSync, readdirSync, statSync } from "node:fs";
import { join } from "node:path";

import { compileFixtureBundle } from "../../src/features/book-experience/functions/compileBundle.ts";
import { resolveFrame } from "../../src/features/book-experience/functions/resolveFrame.ts";
import { executeTransition } from "../../src/features/book-experience/preview/transitions.ts";
import { focalVisible, isCropContained, selectResponsiveCrop } from "../../src/features/book-experience/preview/responsive.ts";
import { describePreviewState } from "../../src/features/book-experience/preview/states.ts";
import { assembleComposition } from "../../src/features/book-experience/compositions/assemble.ts";
import { computeSafeCamera } from "../../src/features/book-experience/compositions/safeCamera.ts";
import { getNextAction } from "../../src/features/book-experience/compositions/actions.ts";

// test:preview gate (P2). Deterministic local proof without a server or a
// browser: the fixture compiles through canonical schemas, every Beat
// resolves finite frames, the endpoint performs no cloud writes, and the
// player exposes exactly the approved controls with no camera authoring.
// Browser interaction itself lives in preview.spec.ts (Playwright prior
// art) and is reported separately; this script only asserts its presence.
const checks: Array<[string, boolean]> = [];
const check = (name: string, pass: boolean) => checks.push([name, pass]);

const fixture = JSON.parse(
  readFileSync("fixtures/book-experience/room-entry.json", "utf8"),
) as unknown;
const bundle = compileFixtureBundle(fixture);
check("Fixture compiles to an EpisodeBundle with 3 Beats", bundle.beats.length === 3);

let framesFinite = true;
for (const beat of bundle.beats) {
  for (const progress of [0, 0.5, 1]) {
    const frame = resolveFrame(bundle, beat.id, progress);
    const numbers = [frame.pose.x, frame.pose.y, frame.pose.zoom, frame.pose.rotate];
    if (!numbers.every(Number.isFinite) || frame.subtitleHtml.length === 0) framesFinite = false;
  }
}
check("Every Beat resolves finite frames with HTML subtitles", framesFinite);

const routeSource = readFileSync("src/app/api/studio/preview/route.ts", "utf8");
check("Preview endpoint is fixture-scoped", routeSource.includes("room-entry"));
check(
  "Preview endpoint performs no cloud writes",
  !/firebase-admin|adminAuth|client-s3|PutObjectCommand|fetch\(["']https:\/\/(?!.*localhost)/i.test(
    routeSource,
  ) && !routeSource.includes("PutObject"),
);

const playerSource = readFileSync(
  "src/features/book-experience/preview/PreviewPlayer.tsx",
  "utf8",
);
for (const testId of [
  "scope-episode",
  "scope-moment",
  "scope-beat",
  "play",
  "pause",
  "scrub",
  "next",
  "previous",
  "fallback-toggle",
  "subtitle",
  "provenance",
]) {
  check(`Player exposes control "${testId}"`, playerSource.includes(testId));
}
check(
  "Player has no camera authoring input",
  !/set camera|Set camera|camera-author|focusLayerId"|prompt\(/i.test(playerSource),
);

const depthSource = readFileSync(
  "src/features/book-experience/preview/DepthScene.tsx",
  "utf8",
);
check("WebGL stage renders one runtime depthMesh", depthSource.includes("depthMesh"));
const cssSource = readFileSync("src/features/book-experience/preview/CssFallback.tsx", "utf8");
check("CSS fallback renders flat parallax layers", cssSource.includes("css-stage"));

for (const required of [
  "src/app/studio/preview/page.tsx",
  "src/app/api/studio/preview/route.ts",
  "tests/book-experience/preview.spec.ts",
  "playwright.config.ts",
  "fixtures/book-experience/harbor-composed.json",
  "src/features/book-experience/compositions/assemble.ts",
  "src/features/book-experience/preview/EpisodePreview.tsx",
  "src/app/studio/books/[bookId]/compose/page.tsx",
  "src/app/api/books/[bookId]/compositions/route.ts",
  "tests/smoke/smoke-compose.mts",
]) {
  check(`Required file exists: ${required}`, existsSync(required));
}

check(
  "Preview endpoint serves the assembled harbor fixture",
  routeSource.includes("harbor-composed"),
);

// P9: source-to-episode progression through the assembled harbor fixture.
const harbor = JSON.parse(
  readFileSync("fixtures/book-experience/harbor-composed.json", "utf8"),
) as unknown;
const harborBundle = compileFixtureBundle(harbor);
check("Harbor Episode compiles to a bundle with 2 Beats", harborBundle.beats.length === 2);
let harborFinite = true;
for (const beat of harborBundle.beats) {
  for (const progress of [0, 0.5, 1]) {
    const frame = resolveFrame(harborBundle, beat.id, progress);
    const numbers = [frame.pose.x, frame.pose.y, frame.pose.zoom, frame.pose.rotate];
    const transition = executeTransition(beat.transitionIn.type, progress);
    const transitionNumbers = [
      transition.opacity,
      transition.translateX,
      transition.translateY,
      transition.scale,
    ];
    if (
      !numbers.every(Number.isFinite) ||
      !transitionNumbers.every(Number.isFinite) ||
      frame.subtitleHtml.length === 0
    ) {
      harborFinite = false;
    }
  }
}
check("Harbor Beats resolve finite frames, transitions and subtitles", harborFinite);
check(
  "Harbor cameras sit inside the fixture safeCamera",
  harborBundle.beats.every((beat) => {
    const composition = harborBundle.compositions[beat.compositionId];
    const safe = composition.safeCamera;
    return (
      Math.abs(beat.camera.from.x) <= safe.maxPanX &&
      Math.abs(beat.camera.to.x) <= safe.maxPanX &&
      beat.camera.to.zoom <= safe.maxZoom
    );
  }),
);

// P9: deterministic transitions, responsive crops and explicit states.
let transitionsFinite = true;
for (const type of ["cut", "fade", "slide", "zoomThrough", "parallaxShift"] as const) {
  for (const progress of [0, 0.5, 1]) {
    const executed = executeTransition(type, progress);
    if (![executed.opacity, executed.translateX, executed.translateY, executed.scale].every(Number.isFinite)) {
      transitionsFinite = false;
    }
  }
}
check("Every transition type executes finite stage values", transitionsFinite);
check(
  "Reduced motion degrades transitions to static frames",
  executeTransition("slide", 0.5, { reducedMotion: true }).translateX === 0,
);
const harborResponsive = harborBundle.compositions["cmp_harbor_v1"].responsive;
check(
  "Portrait and landscape viewports select matching crops with a visible focal point",
  selectResponsiveCrop(harborResponsive, { w: 390, h: 844 }).aspect === "portrait" &&
    selectResponsiveCrop(harborResponsive, { w: 1280, h: 800 }).aspect === "landscape" &&
    isCropContained(harborResponsive.portraitCrop) &&
    isCropContained(harborResponsive.landscapeCrop) &&
    focalVisible(harborResponsive, harborResponsive.portraitCrop),
);
check(
  "Preview states stay explicit (loading/empty/error/outdated/partial/ready)",
  describePreviewState({ loaded: false, scopeExists: true }).state === "loading" &&
    describePreviewState({ loaded: true, scopeExists: false }).state === "empty" &&
    describePreviewState({ loaded: true, scopeExists: true, error: "x" }).state === "error" &&
    describePreviewState({ loaded: true, scopeExists: true, outdatedReason: "x" }).state === "outdated" &&
    describePreviewState({ loaded: true, scopeExists: true, missingLayerIds: ["L1"] }).state === "partial" &&
