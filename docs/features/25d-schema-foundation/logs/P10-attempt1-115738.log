import { FieldValue } from "firebase-admin/firestore";

import { episodesRef } from "@/features/episodes/store";
import { adminDb } from "@/services/firebase/admin";
import { momentCandidatesRef } from "@/features/images/store";
import type { NormalizedPoint, NormalizedRect } from "@/features/images/types";
import type { PrimaryText } from "@/features/moment-text/types";
import { momentsRef } from "@/features/moments/store";
import type { HotspotPlan, MomentTextType } from "@/features/moments/types";
import {
  postingChecks,
  type PostingCheckResult,
  type RevealFact,
} from "@/features/posting/types";
import { EditError } from "@/features/sources/edit-ops";
import { sourceRef } from "@/features/sources/store";

export type StoryMomentPreview = {
  episodeTitle: string;
  episodeOrder: number;
  momentOrder: number;
  purpose: string;
  paragraphIds: string[];
  primaryText: PrimaryText;
  image: {
    candidateId: string;
    url: string;
    aspectRatio: string;
    focalPoint: NormalizedPoint;
    safeTextArea: NormalizedRect;
  };
  hotspots: HotspotPlan[];
};

export type StoryMomentReview = PostingCheckResult & {
  preview: StoryMomentPreview | null;
};

export function publicEpisodeRef(bookId: string, episodeId: string) {
  return adminDb().collection("books").doc(bookId).collection("episodes").doc(episodeId);
}

export function postedMomentRef(bookId: string, episodeId: string, momentId: string) {
  return publicEpisodeRef(bookId, episodeId).collection("storyMoments").doc(momentId);
}

export async function reviewStoryMoment(
  bookId: string,
  sourceId: string,
  episodeId: string,
  momentId: string,
): Promise<StoryMomentReview> {
  const source = sourceRef(bookId, sourceId);
  const episode = episodesRef(bookId, sourceId).doc(episodeId);
  const moment = momentsRef(bookId, sourceId, episodeId).doc(momentId);
  const [sourceSnapshot, episodeSnapshot, momentSnapshot] = await Promise.all([
    source.get(),
    episode.get(),
    moment.get(),
  ]);
  if (!sourceSnapshot.exists || sourceSnapshot.get("dependentWorkStatus") === "outdated") {
    throw new EditError("This source revision is not current.");
  }
  if (!episodeSnapshot.exists || episodeSnapshot.get("momentPlanStatus") !== "approved") {
    throw new EditError("The Story Moment plan is not approved.");
  }
  if (!momentSnapshot.exists) throw new EditError("Story Moment not found.");

  const paragraphDocs = await source.collection("chapters").orderBy("order", "asc").get();
  const sourceParagraphs = paragraphDocs.docs.flatMap((chapter) =>
    ((chapter.get("paragraphs") ?? []) as { id: string; text: string }[]).map(({ id, text }) => ({ id, text })),
  );
  const bible = await source.collection("bible").get();
  const revealFacts: RevealFact[] = [];
  const hotspotTargets: string[] = [];
  for (const entry of bible.docs) {
    hotspotTargets.push(String(entry.get("name") ?? ""));
    const fields = (entry.get("fields") ?? {}) as Record<
      string,
      { value?: string; revealAt?: string | null }
    >;
    for (const [fieldName, field] of Object.entries(fields)) {
      if (!field.revealAt) continue;
      revealFacts.push({
        entryName: String(entry.get("name") ?? ""),
        fieldName,
        value: String(field.value ?? ""),
        revealAt: field.revealAt,
      });
    }
  }

  const paragraphIds = (momentSnapshot.get("paragraphIds") ?? []) as string[];
  const characters = (momentSnapshot.get("characters") ?? []) as string[];
  const location = String(momentSnapshot.get("location") ?? "");
  const objects = (momentSnapshot.get("objects") ?? []) as string[];
  hotspotTargets.push(location, ...objects);
  const continuity = await continuityConflicts(
    bookId,
    sourceId,
    paragraphIds,
    characters,
    location,
  );

  const activeId = String(momentSnapshot.get("activeImageCandidateId") ?? "");
  const activeCandidate = activeId
    ? await momentCandidatesRef(bookId, sourceId, episodeId, momentId).doc(activeId).get()
    : null;
  const deliveryUrl = activeCandidate?.exists
    ? String(activeCandidate.get("deliveryUrl") ?? "")
    : "";
  const accessible = deliveryUrl ? await deliveryAccessible(deliveryUrl) : false;
  const candidate = activeCandidate?.exists
    ? {
        status: String(activeCandidate.get("status") ?? ""),
        deliveryUrl: deliveryUrl || null,
        accessible,
        stale: Boolean(activeCandidate.get("stale")),
      }
    : null;
  const warnings = activeCandidate?.exists
    ? ((activeCandidate.get("warnings") ?? []) as string[])
    : [];
  const primaryText = (momentSnapshot.get("primaryText") ?? null) as PrimaryText | null;
  const hotspots = (momentSnapshot.get("hotspots") ?? []) as HotspotPlan[];
  const checks = postingChecks({
    paragraphCount: Number(sourceSnapshot.get("paragraphCount") ?? 0),
    paragraphIds,
    sourceParagraphs,
    textType: momentSnapshot.get("textType") as MomentTextType,
    textStatus: String(momentSnapshot.get("textStatus") ?? "none"),
    primaryText,
    activeImage: candidate,
    continuityConflicts: continuity,
    reveals: (momentSnapshot.get("reveals") ?? []) as string[],
    revealFacts,
    visualType: String(momentSnapshot.get("visualType") ?? "scene"),
    hotspots,
    hotspotTargets,
  });

  const preview =
    primaryText && activeCandidate?.exists && deliveryUrl
      ? {
          episodeTitle: String(episodeSnapshot.get("title") ?? ""),
          episodeOrder: Number(episodeSnapshot.get("order") ?? 0),
          momentOrder: Number(momentSnapshot.get("order") ?? 0),
          purpose: String(momentSnapshot.get("purpose") ?? ""),
          paragraphIds,
          primaryText,
          image: {
            candidateId: activeCandidate.id,
            url: deliveryUrl,
            aspectRatio: String(activeCandidate.get("aspectRatio") ?? "4:5"),
            focalPoint: (activeCandidate.get("focalPoint") ?? { x: 0.5, y: 0.4 }) as NormalizedPoint,
            safeTextArea: (activeCandidate.get("safeTextArea") ?? {
              x: 0.08,
              y: 0.68,
              width: 0.84,
              height: 0.24,
            }) as NormalizedRect,
          },
          hotspots,
        }
      : null;
  return { problems: checks.problems, warnings: [...new Set([...checks.warnings, ...warnings])], preview };
}

export async function postStoryMoment(
  bookId: string,
  sourceId: string,
  episodeId: string,
  momentId: string,
  email: string,
): Promise<{ versionId: string }> {
  const review = await reviewStoryMoment(bookId, sourceId, episodeId, momentId);
  if (review.problems.length || !review.preview) {
    throw new EditError(review.problems.join(" ") || "The Story Moment preview is incomplete.");
  }
  const preview = review.preview;
  const canonical = postedMomentRef(bookId, episodeId, momentId);
  const version = canonical.collection("versions").doc();
  const publicEpisode = publicEpisodeRef(bookId, episodeId);
  const internalMoment = momentsRef(bookId, sourceId, episodeId).doc(momentId);
  await adminDb().runTransaction(async (tx) => {
    const source = sourceRef(bookId, sourceId);
    const [existing, internal, currentSource] = await Promise.all([
      tx.get(canonical),
      tx.get(internalMoment),
      tx.get(source),
    ]);
    if (existing.exists) {
      throw new EditError("This Story Moment is already live. Prepare a replacement version instead.");
    }
    if (
      !internal.exists ||
      internal.get("activeImageCandidateId") !== preview.image.candidateId ||
      !currentSource.exists ||
      currentSource.get("dependentWorkStatus") === "outdated"
    ) {
      throw new EditError("The Story Moment changed after its checks ran. Review it again.");
    }
    const content = publicContent(preview);
    tx.set(version, {
      content,
      sourceId,
      sourceRevision: Number(currentSource.get("revision") ?? 1),
      reviewWarnings: review.warnings,
      status: "active",
      createdAt: FieldValue.serverTimestamp(),
      createdBy: email,
    });
    tx.set(canonical, {
      live: true,
      activeVersionId: version.id,
      content,
      order: preview.momentOrder,
      postedAt: FieldValue.serverTimestamp(),
      updatedAt: FieldValue.serverTimestamp(),
    });
    tx.set(
      publicEpisode,
      {
        live: true,
        title: preview.episodeTitle,
        order: preview.episodeOrder,
        updatedAt: FieldValue.serverTimestamp(),
      },
      { merge: true },
    );
    tx.update(internalMoment, {
      posted: true,
      postedVersionId: version.id,
      postedAt: FieldValue.serverTimestamp(),
      postedBy: email,
    });
  });
  return { versionId: version.id };
}

export function publicContent(preview: StoryMomentPreview) {
  const primaryText =
    preview.primaryText.type === "commentary"
      ? { type: "commentary" as const, text: preview.primaryText.text }
      : {
          type: preview.primaryText.type,
          entries: preview.primaryText.entries.map((entry) => ({ text: entry.text })),
        };
  return {
    episodeTitle: preview.episodeTitle,
    episodeOrder: preview.episodeOrder,
    momentOrder: preview.momentOrder,
    purpose: preview.purpose,
    primaryText,
    image: {
      url: preview.image.url,
      aspectRatio: preview.image.aspectRatio,
      focalPoint: preview.image.focalPoint,
      safeTextArea: preview.image.safeTextArea,
    },
    hotspots: preview.hotspots.map(({ label, target, note, x, y }) => ({
      label,
      target,
      note,
      x,
      y,
    })),
  };
}

export async function setReviewHotspots(
  bookId: string,
  sourceId: string,
  episodeId: string,
  momentId: string,
  hotspots: HotspotPlan[],
): Promise<void> {
  const moment = momentsRef(bookId, sourceId, episodeId).doc(momentId);
  const snapshot = await moment.get();
  if (!snapshot.exists) throw new EditError("Story Moment not found.");
  if (!(["object", "illustration", "map"] as string[]).includes(String(snapshot.get("visualType")))) {
    throw new EditError("Only objects, illustrations, and maps can contain hotspots.");
  }
  const original = (snapshot.get("hotspots") ?? []) as HotspotPlan[];
  const cleaned = hotspots.map((hotspot) => {
    const plan = original.find(
      (entry) => entry.label === hotspot.label && entry.target === hotspot.target,
    );
    if (!plan) throw new EditError("Hotspot coordinates must belong to an approved hotspot plan.");
    const x = Number(hotspot.x);
    const y = Number(hotspot.y);
    if (!Number.isFinite(x) || !Number.isFinite(y) || x < 0 || x > 1 || y < 0 || y > 1) {
      throw new EditError(`Hotspot "${hotspot.label}" needs coordinates from 0 to 1.`);
    }
    return { ...plan, x, y };
  });
  await moment.update({ hotspots: cleaned, hotspotUpdatedAt: FieldValue.serverTimestamp() });
}

async function continuityConflicts(
  bookId: string,
  sourceId: string,
  paragraphIds: string[],
  characters: string[],
  location: string,
): Promise<string[]> {
  const at = paragraphIds
    .filter((id) => /^p\d{6}$/.test(id))
    .map((id) => Number(id.slice(1)))
    .sort((a, b) => a - b)[0];
  if (!at) return [];
  const references = await adminDb()
    .collection("books")
    .doc(bookId)
    .collection("visualReferences")
    .get();
  const conflicts: string[] = [];
  for (const name of characters) {
    const valid = references.docs.filter((reference) => {
      if (
        reference.get("sourceId") !== sourceId ||
        reference.get("kind") !== "character" ||
        String(reference.get("name")).toLocaleLowerCase() !== name.toLocaleLowerCase() ||
        !reference.get("activeCandidateId")
      ) return false;
      const state = reference.get("appearanceState") as {
        fromParagraphId?: string;
        toParagraphId?: string | null;
      } | null;
      if (!state) return true;
      const from = Number(String(state.fromParagraphId ?? "p000001").slice(1));
      const to = state.toParagraphId ? Number(state.toParagraphId.slice(1)) : null;
      return at >= from && (to === null || at <= to);
    });
    if (valid.length > 1) conflicts.push(`${name} has overlapping active appearance references.`);
  }
  if (location) {
    const active = references.docs.filter(
      (reference) =>
        reference.get("sourceId") === sourceId &&
        reference.get("kind") === "location" &&
        String(reference.get("name")).toLocaleLowerCase() === location.toLocaleLowerCase() &&
        reference.get("activeCandidateId"),
    );
    if (active.length > 1) conflicts.push(`${location} has more than one active location reference.`);
  }
  return conflicts;
}

async function deliveryAccessible(url: string): Promise<boolean> {
  try {
    const head = await fetch(url, { method: "HEAD", signal: AbortSignal.timeout(8_000) });
    if (head.ok) return true;
    if (head.status !== 405) return false;
    const get = await fetch(url, {
      headers: { Range: "bytes=0-0" },
      signal: AbortSignal.timeout(8_000),
    });
    return get.ok;
  } catch {
    return false;
  }
}

