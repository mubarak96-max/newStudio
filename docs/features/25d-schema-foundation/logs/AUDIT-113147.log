  46:     const entry = links.get(paragraph.id);
  47:     return {
  48:       paragraphId: paragraph.id,
  49:       seq: paragraph.seq,
  50:       beatIds: entry?.beatIds ?? [],
  51:       modalities: entry?.modalities ?? [],
