===== MOMENT SCHEMA =====
import { z } from "zod";

import { IdSchema, LineageSchema } from "./primitives.ts";
import { BeatSchema } from "./beat.ts";
import { ParagraphSchema } from "./paragraph.ts";

// Slim Moment slice for the P2 deterministic fixture (plan 3.1): one scene
// unit with a contiguous source range owning its Beats in source order.
export const MomentSchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  momentId: z.string().min(1),
  order: z.number().int().min(1),
  seqStart: z.number().int().min(0),
  seqEnd: z.number().int().min(0),
  sourceParagraphIds: z.array(z.string().regex(/^p\d{6}$/)).min(1),
  summary: z.string().min(1),
  storyTime: z.number().refine(Number.isFinite, { message: "storyTime is finite" }),
  readingBeats: z.array(BeatSchema).min(1),
  status: z.enum(["pending", "running", "review", "approved", "outdated", "failed"]),
}).refine((moment) => moment.seqEnd >= moment.seqStart, {
  message: "Moment ranges tile story paragraphs; seqEnd is inclusive",
});

export const FixtureSourceSchema = z.object({
  sourceId: IdSchema,
  bookId: IdSchema,
  canonicalHash: z.string().min(1),
  chapterId: z.string().min(1),
  paragraphs: z.array(ParagraphSchema).min(1),
});

export type Moment = z.infer<typeof MomentSchema>;
export type FixtureSource = z.infer<typeof FixtureSourceSchema>;

===== COMPOSITION SCHEMA =====
import { z } from "zod";

import {
  AssetRefSchema,
  DepthAssetSchema,
  IdSchema,
  LineageSchema,
  ResponsiveSchema,
  SafeCameraSchema,
  TransformSchema,
} from "./primitives.ts";
import { ReferencePinSchema } from "./model.ts";

// Layer and Composition slice needed for preview/bundle work (plan 3.2).
// depthRange is [far, near] in [0, 1]; larger zOrder/z/depth is closer.
export const LayerSchema = z.object({
  layerId: IdSchema,
  role: z.enum(["background", "midground", "foreground"]),
  entityId: IdSchema.optional(),
  image: AssetRefSchema,
  mask: AssetRefSchema.optional(),
  depth: DepthAssetSchema.optional(),
  hiddenAreaImage: AssetRefSchema.optional(),
  zOrder: z.number().int().min(0),
  depthRange: z.tuple([
    z.number().min(0).max(1),
    z.number().min(0).max(1),
  ]),
  transform: TransformSchema,
  renderMode: z.enum(["plane", "depthMesh"]),
  mesh: z
    .object({
      segmentsX: z.number().int().min(1).max(256),
      segmentsY: z.number().int().min(1).max(256),
      displacementScale: z.number().finite(),
    })
    .optional(),
}).refine(
  (layer) => {
    if (layer.renderMode !== "depthMesh") return true;
    return (
      layer.depth !== undefined &&
      layer.mesh !== undefined &&
      Number.isFinite(layer.mesh.displacementScale)
    );
  },
  { message: "depthMesh requires aligned depth plus bounded mesh subdivisions" },
);

// Bundle-safe Composition subset: exactly the fields EpisodeBundle carries
// (Pick<Composition, "master" | "depth" | "layers" | "safeCamera" |
// "responsive">, plan 3.3).
export const BundleCompositionSchema = z.object({
  master: AssetRefSchema,
  depth: DepthAssetSchema.optional(),
  layers: z.array(LayerSchema).min(1),
  safeCamera: SafeCameraSchema,
  responsive: ResponsiveSchema,
});

export type Layer = z.infer<typeof LayerSchema>;
export type BundleComposition = z.infer<typeof BundleCompositionSchema>;

// Full editorial Composition (plan 3.2, ADR-007/ADR-011): source/reference
// pinned, reusable across episodes. usedIn owns the reuse relationship;
// Moment.compositionIds is derived. Regeneration creates a new revision;
// published snapshots keep their exact asset keys.
export const CompositionSchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  compositionId: IdSchema,
  revisionId: IdSchema,
  reuseKey: z.string().min(1),
  originEpisodeId: z.string().min(1),
  usedIn: z.array(
    z.object({
      episodeId: z.string().min(1),
      momentId: z.string().min(1),
      beatId: IdSchema,
      revisionId: IdSchema,
    }),
  ),
  shotSnapshot: z.object({
    shotId: IdSchema,
    description: z.string().min(1),
    entityStates: z.array(
      z.object({ entityId: IdSchema, stateId: IdSchema }),
    ),
    framing: z.string().min(1),
    mood: z.string().min(1),
    timeOfDay: z.string().min(1),
    reuseKey: z.string().min(1),
  }),
  entityStatesUsed: z.array(z.object({ entityId: IdSchema, stateId: IdSchema })),
  continuityRefs: z.array(z.string().min(1)),
  referenceVersions: z.array(ReferencePinSchema),
  visualProfileVersion: z.number().int().min(1),
  master: AssetRefSchema,
  depth: DepthAssetSchema.optional(),
  layers: z.array(LayerSchema).min(1),
  safeCamera: SafeCameraSchema,
  responsive: ResponsiveSchema,
  qa: z.object({
    textDetected: z.boolean(),
    agreementScore: z.number().nullable(),
    identityScores: z.record(z.string(), z.number()),
    issues: z.array(z.string().min(1)),
    continuityStatus: z.enum(["pending", "approved", "rejected"]),
    approvedBy: z.string().min(1).optional(),
    approvedAt: z.string().min(1).optional(),
  }),
  generation: z.object({
    provider: z.string().min(1),
    model: z.string().min(1),
    prompt: z.string().min(1),
    negativePrompt: z.string().min(1),
    seed: z.number().int().optional(),
    referenceKeys: z.array(z.string().min(1)),
    costUsd: z.number().nonnegative(),
  }),
  status: z.enum(["generated", "approved", "rejected", "composed", "published"]),
  createdAt: z.string().min(1),
  updatedAt: z.string().min(1),
});

export type Composition = z.infer<typeof CompositionSchema>;

===== BUNDLE SCHEMA =====
import { z } from "zod";

import { AssetRefSchema, IdSchema, LineageSchema } from "./primitives.ts";
import { BeatSchema } from "./beat.ts";
import { BundleCompositionSchema } from "./composition.ts";

// EpisodeBundle (plan 3.3): immutable, schema-versioned resolved playback
// data for one Episode. entities is safe at episode start; entityViews
// carries the resolved safe view per Beat seq. Summaries must not leak
// future revelations; only allowlisted public fields are published.
export const PublishedEntitySchema = z.object({
  displayName: z.string().min(1),
  card: z.object({
    line: z.string().min(1),
    knownFacts: z.array(z.string()),
    firstSeenEpisode: z.string().min(1),
  }),
  image: AssetRefSchema.optional(),
});

export const EpisodeBundleSchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  bookId: IdSchema,
  episodeId: z.string().min(1),
  version: z.number().int().min(1),
  revisionId: IdSchema,
  order: z.number().int().min(1),
  title: z.string().min(1),
  summary: z.string().min(1),
  beats: z.array(BeatSchema).min(1),
  compositions: z.record(z.string(), BundleCompositionSchema),
  entities: z.record(z.string(), PublishedEntitySchema),
  entityViews: z.record(z.string(), z.record(z.string(), PublishedEntitySchema)),
  assetsBaseUrl: z.string().min(1),
}).refine(
  (bundle) =>
    bundle.beats.every((beat) => bundle.compositions[beat.compositionId] !== undefined),
  { message: "every Beat compositionId must resolve to a bundle composition" },
);

export type PublishedEntity = z.infer<typeof PublishedEntitySchema>;
export type EpisodeBundle = z.infer<typeof EpisodeBundleSchema>;

===== VISUAL REPOSITORY =====
// Fake-backed visual generation repository (P8, ADR-012).
// Firestore layout follows plan section 4:
// books/{bookId}/entities/{entityId}/visualVersions/{versionId} holds
// immutable approved reference metadata (S3 holds the assets);
// books/{bookId}/compositions/{compositionId} holds Composition metadata.
// Local tests use this fake; no live writes here. Every generation records
// its immutable S3 key, source/reference versions, actual bit depth,
// prompt, model, cost and continuity result.

import type { GeneratedAssetDescriptor } from "./assets.ts";
import type { ReferenceApproval, StoredReferenceVersion } from "./references.ts";
import { referenceKey } from "./references.ts";
import type { CoordinateFrame } from "./requests.ts";

export type VisualGenerationRecord = {
  targetId: string;
  kind: string;
  compositionId: string;
  layerId?: string;
  s3Key: string;
  checksum: string;
  contentType: string;
  sourceId: string;
  canonicalHash: string;
  visualProfileVersion: number;
  referenceVersions: { entityId: string; stateId?: string; version: number; checksum: string }[];
  bitDepth?: 8 | 16;
  sourceBitDepth?: 8 | 16;
  prompt: string;
  negativePrompt: string;
  model: string;
  costUsd: number;
  attempt: number;
  idempotencyKey: string;
  continuity: { agreementScore: number | null; identityScores: Record<string, number>; status: "pending" | "approved" | "rejected" };
  status: "generated" | "approved" | "rejected";
  createdAt: string;
};

export class FakeVisualStore {
  approvals = new Map<string, ReferenceApproval>();
  versions = new Map<string, StoredReferenceVersion>();
  generations = new Map<string, VisualGenerationRecord>();
  charges = new Map<string, number>();
  outdatedTargets = new Set<string>();

  visualVersionPath(bookId: string, entityId: string, versionId: string): string {
    return `books/${bookId}/entities/${entityId}/visualVersions/${versionId}`;
  }

  compositionPath(bookId: string, compositionId: string): string {
    return `books/${bookId}/compositions/${compositionId}`;
  }

  proposeApproval(approval: ReferenceApproval): void {
    const key = referenceKey(approval.entityId, approval.stateId);
    if (this.approvals.has(key)) throw new Error(`Reference ${key} already proposed.`);
    this.approvals.set(key, approval);
  }

  approveReference(key: string, fingerprint: string, approvedBy: string): ReferenceApproval {
    if (this.outdated(key)) throw new Error(`Reference ${key} is outdated; regenerate from the current source.`);
    const existing = this.approvals.get(key);
    if (!existing) throw new Error(`Reference ${key} not found.`);
    if (existing.status === "approved" && existing.fingerprint === fingerprint) return existing;
    const next: ReferenceApproval = { ...existing, status: "approved", fingerprint, approvedBy, approvedAt: new Date(0).toISOString() };
    this.approvals.set(key, next);
    const stored = this.versions.get(key);
    if (stored) this.versions.set(key, { ...stored, reference: { ...stored.reference, approved: true, approvedBy, approvedAt: next.approvedAt } });
    return next;
  }

  publishReferenceVersion(version: StoredReferenceVersion): void {
    const key = referenceKey(version.entityId, version.stateId);
    if (this.versions.has(key)) throw new Error(`Reference version ${key} is immutable and already exists.`);
    this.versions.set(key, version);
  }

  /** Reference changes flag dependent drafts but never mutate published assets. */
  markOutdated(entityId: string, stateId?: string): void {
    this.outdatedTargets.add(referenceKey(entityId, stateId));
  }

  outdated(key: string): boolean {
    return this.outdatedTargets.has(key);
  }

  recordGeneration(record: VisualGenerationRecord): void {
    const key = `${record.targetId}:attempt-${record.attempt}`;
    if (this.generations.has(key)) throw new Error(`Generation ${key} is immutable and already exists.`);
    this.generations.set(key, record);
    // Idempotent cost: one charge per completed unit (plan 6).
    const chargeKey = `${record.idempotencyKey}:unit:1`;
    if (!this.charges.has(chargeKey)) this.charges.set(chargeKey, record.costUsd);
  }

  approveGeneration(targetId: string, attempt: number): VisualGenerationRecord {
    const record = this.generations.get(`${targetId}:attempt-${attempt}`);
    if (!record) throw new Error(`Generation ${targetId} attempt ${attempt} not found.`);
    const next: VisualGenerationRecord = { ...record, status: "approved", continuity: { ...record.continuity, status: "approved" } };
    this.generations.set(`${targetId}:attempt-${attempt}`, next);
    return next;
  }

  rejectGeneration(targetId: string, attempt: number): VisualGenerationRecord {
    const record = this.generations.get(`${targetId}:attempt-${attempt}`);
    if (!record) throw new Error(`Generation ${targetId} attempt ${attempt} not found.`);
    const next: VisualGenerationRecord = { ...record, status: "rejected", continuity: { ...record.continuity, status: "rejected" } };
    this.generations.set(`${targetId}:attempt-${attempt}`, next);
    return next;
  }

  approvedSiblingKeys(compositionId: string, exceptTargetId: string): string[] {
    return [...this.generations.values()]
      .filter((record) => record.compositionId === compositionId && record.targetId !== exceptTargetId && record.status === "approved")
      .map((record) => record.s3Key);
  }

  descriptorFor(targetId: string, attempt: number, frame: CoordinateFrame): GeneratedAssetDescriptor {
    const record = this.generations.get(`${targetId}:attempt-${attempt}`);
    if (!record) throw new Error(`Generation ${targetId} attempt ${attempt} not found.`);
    return {
      key: record.s3Key,
      targetId: record.targetId,
      kind: record.kind as GeneratedAssetDescriptor["kind"],
      w: frame.w,
      h: frame.h,
      contentType: record.contentType,
      sizeBytes: 1024,
      checksum: record.checksum,
      hasAlpha: record.kind === "scene-foreground",
      ...(record.bitDepth !== undefined ? { bitDepth: record.bitDepth, sourceBitDepth: record.sourceBitDepth, depthConvention: "near-white" as const } : {}),
      ...(record.kind === "scene-background" ? { overscanPresent: frame.overscan } : {}),
      textDetected: false,
    };
  }
}

