 328: 
 329: function CorrectedRevisionUpload({
 330:   bookId,
 331:   baseSourceId,
 332: }: {
 333:   bookId: string;
 334:   baseSourceId: string;
 335: }) {
 336:   const router = useRouter();
 337:   const input = useRef<HTMLInputElement>(null);
 338:   const [open, setOpen] = useState(false);
 339:   const [busy, setBusy] = useState(false);
 340:   const [error, setError] = useState<string | null>(null);
 341: 
 342:   async function upload() {
 343:     const file = input.current?.files?.[0];
 344:     if (!file) return;
 345: 
 346:     setBusy(true);
 347:     setError(null);
 348:     try {
 349:       const form = new FormData();
 350:       form.append('file', file);
 351:       form.append('baseSourceId', baseSourceId);
 352:       const response = await fetch(`/api/books/${bookId}/sources`, {
 353:         method: 'POST',
 354:         body: form,
 355:       });
 356:       if (!response.ok) {
 357:         const body = (await response.json()) as { error?: string };
 358:         setError(body.error ?? 'The corrected revision could not be uploaded.');
 359:         return;
 360:       }
 361:       const created = (await response.json()) as { sourceId: string };
 362:       router.push(`/studio/books/${bookId}/sources/${created.sourceId}`);
 363:     } finally {
 364:       setBusy(false);
 365:     }
 366:   }
 367: 
 368:   if (!open) {
 369:     return (
 370:       <button
 371:         type="button"
 372:         onClick={() => setOpen(true)}
 373:         className="mt-3 rounded-full border border-black/[.08] px-3 py-1 text-xs dark:border-white/[.145]"
 374:       >
 375:         Correct source
 376:       </button>
 377:     );
 378:   }
 379: 
 380:   return (
 381:     <div className="mt-3 flex flex-col gap-2 rounded-lg bg-zinc-50 p-3 dark:bg-black">
 382:       <p className="text-xs text-zinc-500">
 383:         Upload a corrected EPUB or PDF. This creates a separate revision; the current revision
 384:         remains active until the correction is approved.
 385:       </p>
 386:       <div className="flex flex-wrap items-center gap-2">
 387:         <input ref={input} type="file" accept=".epub,.pdf" className="text-xs" />
 388:         <button
 389:           type="button"
 390:           disabled={busy}
 391:           onClick={upload}
 392:           className="rounded-full bg-accent px-3 py-1 text-xs text-white disabled:opacity-50"
 393:         >
 394:           {busy ? 'Uploading...' : 'Create revision'}
 395:         </button>
 396:         <button
 397:           type="button"
 398:           disabled={busy}
 399:           onClick={() => setOpen(false)}
 400:           className="rounded-full border border-black/[.08] px-3 py-1 text-xs disabled:opacity-50 dark:border-white/[.145]"
 401:         >
 402:           Cancel
 403:         </button>
 404:       </div>
 405:       {error && <p className="text-xs text-red-600 dark:text-red-400">{error}</p>}
 406:     </div>
 407:   );
 408: }

