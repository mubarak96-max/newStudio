import { z } from "zod";

import { AssetRefSchema, IdSchema, LineageSchema } from "./primitives.ts";
import { BeatSchema } from "./beat.ts";
import { BundleCompositionSchema } from "./composition.ts";

// EpisodeBundle (plan 3.3): immutable, schema-versioned resolved playback
// data for one Episode. entities is safe at episode start; entityViews
// carries the resolved safe view per Beat seq. Summaries must not leak
// future revelations; only allowlisted public fields are published.
export const PublishedEntitySchema = z.object({
  displayName: z.string().min(1),
  card: z.object({
    line: z.string().min(1),
    knownFacts: z.array(z.string()),
    firstSeenEpisode: z.string().min(1),
  }),
  image: AssetRefSchema.optional(),
});

export const EpisodeBundleSchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  bookId: IdSchema,
  episodeId: z.string().min(1),
  version: z.number().int().min(1),
  revisionId: IdSchema,
  order: z.number().int().min(1),
  title: z.string().min(1),
  summary: z.string().min(1),
  beats: z.array(BeatSchema).min(1),
  compositions: z.record(z.string(), BundleCompositionSchema),
  entities: z.record(z.string(), PublishedEntitySchema),
  entityViews: z.record(z.string(), z.record(z.string(), PublishedEntitySchema)),
  assetsBaseUrl: z.string().min(1),
}).refine(
  (bundle) =>
    bundle.beats.every((beat) => bundle.compositions[beat.compositionId] !== undefined),
  { message: "every Beat compositionId must resolve to a bundle composition" },
);

export type PublishedEntity = z.infer<typeof PublishedEntitySchema>;
export type EpisodeBundle = z.infer<typeof EpisodeBundleSchema>;

