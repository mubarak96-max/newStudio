import { expect, test } from "@playwright/test";

// First browser-test prior art (P2): editorial interaction against the
// local deterministic bundle at /studio/preview?fixture=room-entry.
// No cloud writes, no paid generation; the fixture is labelled fake in
// the UI. Requires the dev server (playwright config starts it).
test.describe("Studio preview over the room-entry fixture", () => {
  test.beforeEach(async ({ page }) => {
    await page.goto("/studio/preview?fixture=room-entry");
    await expect(page.getByTestId("preview-player")).toBeVisible();
  });

  test("labels fixture provenance and reads HTML subtitles", async ({ page }) => {
    await expect(page.getByTestId("provenance")).toContainText("no paid generation");
    const subtitle = page.getByTestId("subtitle");
    await expect(subtitle).toBeVisible();
    await expect(subtitle).toContainText("Mara pushed the door open");
  });

  test("plays every Beat with WebGL depth meshes or CSS layers", async ({ page }) => {
    await expect(page.getByTestId("beat-counter")).toContainText("Beat 1 of 3");
    await page.getByTestId("play").click();
    await page.getByTestId("pause").click();
    await page.getByTestId("next").click();
    await expect(page.getByTestId("beat-counter")).toContainText("Beat 2 of 3");
    await expect(page.getByTestId("subtitle")).toContainText("Come with me");
    await page.getByTestId("next").click();
    await expect(page.getByTestId("beat-counter")).toContainText("Beat 3 of 3");
    await page.getByTestId("previous").click();
    await expect(page.getByTestId("beat-counter")).toContainText("Beat 2 of 3");
    const webgl = page.getByTestId("webgl-stage");
    const css = page.getByTestId("css-stage");
    // The WebGL chunk (three.js) compiles on first dev load; allow time.
    await expect(webgl.or(css)).toBeVisible({ timeout: 90000 });
    await expect(page.getByTestId("layer-list").or(css)).toBeAttached({ timeout: 90000 });
  });

  test("scrubs within a Beat", async ({ page }) => {
    const scrub = page.getByTestId("scrub");
    await scrub.fill("50");
    await expect(page.getByTestId("subtitle")).toContainText("Mara pushed the door open");
  });

  test("switches Moment and Episode scopes", async ({ page }) => {
    await page.getByTestId("scope-moment").click();
    await expect(page.getByTestId("beat-counter")).toContainText("of 3");
    await page.getByTestId("scope-beat").click();
    await expect(page.getByTestId("beat-counter")).toContainText("Beat 1 of 1");
    await page.getByTestId("scope-episode").click();
    await expect(page.getByTestId("beat-counter")).toContainText("of 3");
    await expect(page.getByTestId("moment-label")).toContainText("ep_01_m01");
  });

  test("forces the CSS fallback with the same text and controls", async ({ page }) => {
    await page.getByTestId("fallback-toggle").click();
    await expect(page.getByTestId("css-stage")).toBeVisible();
    await expect(page.getByTestId("css-layer-L2-foreground")).toBeVisible();
    await expect(page.getByTestId("subtitle")).toContainText("Mara pushed the door open");
    await page.getByTestId("next").click();
    await expect(page.getByTestId("css-stage")).toBeVisible();
  });

  test("keeps subtitles readable in portrait and landscape", async ({ page }) => {
    await page.setViewportSize({ width: 390, height: 844 });
    const portrait = await page.getByTestId("subtitle").boundingBox();
    expect(portrait?.width).toBeGreaterThan(0);
    await page.setViewportSize({ width: 1280, height: 800 });
    const landscape = await page.getByTestId("subtitle").boundingBox();
    expect(landscape?.width).toBeGreaterThan(0);
    await expect(page.getByTestId("subtitle")).toBeVisible();
  });

  test("requires no manual camera input", async ({ page }) => {
    await expect(page.locator('[data-testid^="camera"]')).toHaveCount(0);
    await expect(page.locator('input[type="number"]')).toHaveCount(0);
  });
});

