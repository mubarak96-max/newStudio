 261: ### 3.3 Jobs, publication and actionable workflow types
 262: 
 263: ```ts
 264: type Job = Lineage & {
 265:   schemaVersion: 1; jobId: Id; type: string; stage: string;
 266:   status: "queued" | "running" | "waiting_confirmation" | "completed" | "failed" | "cancelled";
 267:   progress: { done: number; total: number }; checkpoint: { storagePath: string; unit: number } | null;
 268:   attempts: number; maxAttempts: number; error: { code: string; message: string } | null;
 269:   estimatedCostUsd: number; costUsd: number; idempotencyKey: string;
 270:   workerId?: Id; leaseExpiresAt?: IsoDate; startedAt?: IsoDate; finishedAt?: IsoDate;
 271: };
 272: type PublishedEntity = {
 273:   displayName: string; card: { line: string; knownFacts: string[]; firstSeenEpisode: Id };
 274:   image?: AssetRef;
 275: };
 276: type EpisodeBundle = Lineage & {
 277:   schemaVersion: 1; bookId: Id; episodeId: Id; version: number; revisionId: Id;
 278:   order: number; title: string; summary: string; beats: Beat[];
 279:   compositions: Record<Id, Pick<Composition, "master" | "depth" | "layers" | "safeCamera" | "responsive">>;
 280:   entities: Record<Id, PublishedEntity>;
 281:   entityViews: Record<Id, Record<Id, PublishedEntity>>;
 282:   assetsBaseUrl: string;
 283: };
 284: type EpisodeManifest = {
 285:   schemaVersion: 1; bookId: Id; episodeId: Id; version: number;
 286:   bundleKey: string; bundleChecksum: string; sizeBytes: number;
 287:   assets: { key: string; checksum: string; sizeBytes: number; contentType: string }[];
 288:   progressAnchors: { fromVersion: number; fromBeatId: Id; toBeatId: Id; seq: number }[];
 289: };
 290: type PublishedPointer = {
 291:   version: number; revisionId: Id; bundleUrl: string; manifestUrl: string;
 292:   sizeBytes: number; publishedAt: IsoDate; publishedBy: string;
 293: };
 294: type BookCatalog = {
 295:   schemaVersion: 1; bookId: Id; version: number;
 296:   episodes: { episodeId: Id; order: number; title: string; version: number; bundleUrl: string; manifestUrl: string }[];
 297: };
 298: type WorkflowAction = {
 299:   id: string; label: string; kind: "approve" | "generate" | "regenerate" | "preview" | "retry" | "publish" | "compare";
 300:   target: { bookId: Id; episodeId?: Id; momentId?: Id; beatId?: Id; entityId?: Id; compositionId?: Id; layerId?: Id };
 301:   enabled: boolean; blockers: { code: string; message: string; targetActionId?: string }[];
