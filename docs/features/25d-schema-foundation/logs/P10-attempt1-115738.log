import { expect, test } from "@playwright/test";

// First browser-test prior art (P2): editorial interaction against the
// local deterministic bundle at /studio/preview?fixture=room-entry.
// No cloud writes, no paid generation; the fixture is labelled fake in
// the UI. Requires the dev server (playwright config starts it).
test.describe("Studio preview over the room-entry fixture", () => {
  test.beforeEach(async ({ page }) => {
    await page.goto("/studio/preview?fixture=room-entry");
    await expect(page.getByTestId("preview-player")).toBeVisible();
  });

  test("labels fixture provenance and reads HTML subtitles", async ({ page }) => {
    await expect(page.getByTestId("provenance")).toContainText("no paid generation");
    const subtitle = page.getByTestId("subtitle");
    await expect(subtitle).toBeVisible();
    await expect(subtitle).toContainText("Mara pushed the door open");
  });

  test("plays every Beat with WebGL depth meshes or CSS layers", async ({ page }) => {
    await expect(page.getByTestId("beat-counter")).toContainText("Beat 1 of 3");
    await page.getByTestId("play").click();
    await page.getByTestId("pause").click();
    await page.getByTestId("next").click();
    await expect(page.getByTestId("beat-counter")).toContainText("Beat 2 of 3");
    await expect(page.getByTestId("subtitle")).toContainText("Come with me");
    await page.getByTestId("next").click();
    await expect(page.getByTestId("beat-counter")).toContainText("Beat 3 of 3");
    await page.getByTestId("previous").click();
    await expect(page.getByTestId("beat-counter")).toContainText("Beat 2 of 3");
    const webgl = page.getByTestId("webgl-stage");
    const css = page.getByTestId("css-stage");
    // The WebGL chunk (three.js) compiles on first dev load; allow time.
    await expect(webgl.or(css)).toBeVisible({ timeout: 90000 });
    await expect(page.getByTestId("layer-list").or(css)).toBeAttached({ timeout: 90000 });
  });

  test("scrubs within a Beat", async ({ page }) => {
    const scrub = page.getByTestId("scrub");
    await scrub.fill("50");
    await expect(page.getByTestId("subtitle")).toContainText("Mara pushed the door open");
  });

  test("switches Moment and Episode scopes", async ({ page }) => {
    await page.getByTestId("scope-moment").click();
    await expect(page.getByTestId("beat-counter")).toContainText("of 3");
    await page.getByTestId("scope-beat").click();
    await expect(page.getByTestId("beat-counter")).toContainText("Beat 1 of 1");
    await page.getByTestId("scope-episode").click();
    await expect(page.getByTestId("beat-counter")).toContainText("of 3");
    await expect(page.getByTestId("moment-label")).toContainText("ep_01_m01");
  });

  test("forces the CSS fallback with the same text and controls", async ({ page }) => {
    await page.getByTestId("fallback-toggle").click();
    await expect(page.getByTestId("css-stage")).toBeVisible();
    await expect(page.getByTestId("css-layer-L2-foreground")).toBeVisible();
    await expect(page.getByTestId("subtitle")).toContainText("Mara pushed the door open");
    await page.getByTestId("next").click();
    await expect(page.getByTestId("css-stage")).toBeVisible();
  });

  test("keeps subtitles readable in portrait and landscape", async ({ page }) => {
    await page.setViewportSize({ width: 390, height: 844 });
    const portrait = await page.getByTestId("subtitle").boundingBox();
    expect(portrait?.width).toBeGreaterThan(0);
    await page.setViewportSize({ width: 1280, height: 800 });
    const landscape = await page.getByTestId("subtitle").boundingBox();
    expect(landscape?.width).toBeGreaterThan(0);
    await expect(page.getByTestId("subtitle")).toBeVisible();
  });

  test("requires no manual camera input", async ({ page }) => {
    await expect(page.locator('[data-testid^="camera"]')).toHaveCount(0);
    await expect(page.locator('input[type="number"]')).toHaveCount(0);
  });
});

test.describe("Studio preview with reduced motion", () => {
  test.use({ reducedMotion: "reduce" });

  test("announces static frames instead of animating", async ({ page }) => {
    await page.goto("/studio/preview?fixture=room-entry");
    await expect(page.getByTestId("reduced-motion-note")).toBeVisible();
    await expect(page.getByTestId("subtitle")).toContainText("Mara pushed the door open");
  });
});

--- src/features/book-experience/visuals/regeneration.ts ---
// Targeted regeneration planning (P8, ADR-007/ADR-011).
// A failed layer regenerates at asset/layer/composition scope without
// discarding approved siblings: approved assets are reused by immutable
// key, and explicit regeneration is a new attempt with a distinct
// idempotency key. Published bundles keep their exact asset keys.

import { idempotencyKeyFor } from "./requests.ts";
import type { VisualTargetKind } from "./references.ts";

export type RegenerationScope = "asset" | "layer" | "composition";

export type RegenerationPlan = {
  targetId: string;
  kind: VisualTargetKind;
  scope: RegenerationScope;
  /** New billable attempt; retries of this attempt reuse the same key. */
  idempotencyKey: string;
  attempt: number;
  /** Immutable keys of approved siblings that must not change. */
  reuseKeys: string[];
  reason: string;
};

export function planRegeneration(args: {
  targetId: string;
  kind: VisualTargetKind;
  scope: RegenerationScope;
  previousAttempt: number;
  approvedSiblingKeys: string[];
  reason: string;
}): RegenerationPlan {
  if (!args.reason.trim()) throw new Error("A regeneration reason is required.");
  const attempt = args.previousAttempt + 1;
  return {
    targetId: args.targetId,
    kind: args.kind,
    scope: args.scope,
    idempotencyKey: idempotencyKeyFor(args.targetId, args.kind, attempt),
    attempt,
    reuseKeys: [...args.approvedSiblingKeys],
    reason: args.reason,
  };
}

/** Regenerating one target must never rewrite an approved sibling's key. */
export function regenerationPreservesSiblings(plan: RegenerationPlan, approvedKeys: string[]): string | null {
  const dropped = approvedKeys.filter((key) => !plan.reuseKeys.includes(key));
  if (dropped.length > 0) {
    return `Regeneration must reuse approved sibling ${dropped[0]} by immutable key.`;
  }
  return null;
}

--- src/features/book-experience/compositions/repository.ts ---
// Fake-backed composition repository (P9, ADR-012).
// Firestore layout follows plan section 4:
// books/{bookId}/compositions/{compositionId} holds Composition metadata
// and the canonical usedIn reuse relationships. Local tests use this fake;
// no live writes here. Regeneration creates a new revision; published
// snapshots keep their exact asset keys (ADR-011).

import type { Composition } from "../schemas/composition.ts";

/** Deterministic approval fingerprint binding content, source and pins. */
export function compositionFingerprint(composition: Composition): string {
  const layers = [...composition.layers]
    .sort((a, b) => (a.layerId < b.layerId ? -1 : 1))
    .map((layer) => `${layer.layerId}:${layer.image.checksum}:${layer.renderMode}`)
    .join("|");
  return [
    composition.compositionId,
    composition.revisionId,
    composition.sourceId,
    composition.canonicalHash,
    `profile-v${composition.visualProfileVersion}`,
    `safe-${composition.safeCamera.maxPanX},${composition.safeCamera.maxPanY},${composition.safeCamera.maxZoom},${composition.safeCamera.maxTilt}`,
    layers,
  ].join("#");
}

export type CompositionApproval = {
  compositionId: string;
  revisionId: string;
  fingerprint: string;
  approvedBy: string;
  approvedAt: string;
};

export class FakeCompositionStore {
  proposals = new Map<string, Composition>();
  approvals = new Map<string, CompositionApproval>();
  outdated = new Set<string>();

  compositionPath(bookId: string, compositionId: string): string {
    return `books/${bookId}/compositions/${compositionId}`;
  }

  private key(compositionId: string, revisionId: string): string {
    return `${compositionId}:${revisionId}`;
  }

  proposeComposition(composition: Composition): void {
    const key = this.key(composition.compositionId, composition.revisionId);
    if (this.proposals.has(key)) {
      throw new Error(`Composition ${key} is immutable and already exists.`);
    }
    this.proposals.set(key, composition);
  }

  composition(compositionId: string, revisionId: string): Composition {
    const found = this.proposals.get(this.key(compositionId, revisionId));
    if (!found) throw new Error(`Composition ${compositionId} revision ${revisionId} not found.`);
    return found;
  }

  approveComposition(args: {
    compositionId: string;
    revisionId: string;
    fingerprint: string;
    approvedBy: string;
    blockingIssues: string[];
  }): CompositionApproval {
    if (this.outdated.has(args.compositionId)) {
      throw new Error(
        `Composition ${args.compositionId} is outdated; regenerate from the current source.`,
      );
    }
    if (args.blockingIssues.length > 0) {
      throw new Error(`Composition ${args.compositionId} is blocked: ${args.blockingIssues[0]}`);
    }
    const existing = this.approvals.get(args.compositionId);
    if (existing && existing.fingerprint === args.fingerprint) return existing;
    const approval: CompositionApproval = {
      compositionId: args.compositionId,
      revisionId: args.revisionId,
      fingerprint: args.fingerprint,
      approvedBy: args.approvedBy,
      approvedAt: new Date(0).toISOString(),
    };
    this.approvals.set(args.compositionId, approval);
    return approval;
  }

  /** A rejected layer blocks only its composition; siblings stay approved. */
  rejectComposition(compositionId: string, reason: string): void {
    if (![...this.proposals.keys()].some((key) => key.startsWith(`${compositionId}:`))) {
      throw new Error(`Composition ${compositionId} was never assembled.`);
    }
    void reason;
    this.approvals.delete(compositionId);
  }

  /** Source corrections and reference changes flag dependent drafts. */
  markOutdated(compositionId: string): void {
    this.outdated.add(compositionId);
    this.approvals.delete(compositionId);
  }

  isOutdated(compositionId: string): boolean {
    return this.outdated.has(compositionId);
  }

  usedInFor(compositionId: string): { episodeId: string; momentId: string; beatId: string; revisionId: string }[] {
    for (const proposal of this.proposals.values()) {
      if (proposal.compositionId === compositionId) return proposal.usedIn;
    }
    return [];
  }
}


