  38:       const entry = links.get(representation.paragraphId) ?? { beatIds: [], modalities: [], meaningful: false };
  39:       if (!entry.beatIds.includes(beat.id)) entry.beatIds.push(beat.id);
  40:       if (!entry.modalities.includes(representation.modality)) entry.modalities.push(representation.modality);
  41:       if (representation.description.trim().length >= 12) entry.meaningful = true;
  42:       links.set(representation.paragraphId, entry);
  43:     }
  44:   }
