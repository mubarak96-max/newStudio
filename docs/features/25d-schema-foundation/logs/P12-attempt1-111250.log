+  `GAP  Publication/replacement is not simulated: ${publicationGap.blockedBy.join(" + ")} are missing (${publicationGap.missing.join(", ")}).`,
+);
+
+let failed = 0;
+for (const [name, pass] of checks) {
+  console.log(`${pass ? "PASS" : "FAIL"}  ${name}`);
+  if (!pass) failed += 1;
+}
+console.log(`\n${checks.length - failed}/${checks.length} checks passed; 1 explicit degraded-dependency gap`);
+process.exit(failed ? 1 : 0);

