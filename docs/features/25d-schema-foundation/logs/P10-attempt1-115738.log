});
const beatStore = new FakeBeatStore();
beatStore.proposeBeats(BOOK_ID, episode.episodeId, moment.momentId, beats);
beatStore.approveBeats(BOOK_ID, episode.episodeId, moment.momentId, `beats-${moment.momentId}-r1`, OWNER);
const coverage = buildCoverageReview({ momentId: moment.momentId, paragraphs, beats });
check("Every story paragraph has a meaningful canonical Beat representation",
