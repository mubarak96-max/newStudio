// Legacy StoryMomentPlan â†’ canonical Moment scene-container bridge (P6).
// New Moments are scene containers with contiguous seq ranges in book order;
// the old primary-text/one-image StoryMomentPlan (plus many-to-many paragraph
// mapping) is retired to Beat scope in P7. Moment boundary internals
// (momentCoverageProblems/momentRejection) are retained via re-export for
// existing callers; the primary P6 UI approves AI ranges without manual edits.

export { momentCoverageProblems, momentRejection } from "./types.ts";
export type { StoryMomentPlan, MomentProblem } from "./types.ts";

import type { StoryMomentPlan } from "./types.ts";

function seqOf(paragraphId: string): number {
  return Number(paragraphId.slice(1));
}

/**
 * Derive a contiguous canonical seq range from a legacy moment's paragraph
 * IDs. Returns null when the mapping is many-to-many or non-contiguous: such
 * moments need AI replanning into scene containers, not a silent coercion.
 */
export function toMomentRange(moment: Pick<StoryMomentPlan, "order" | "paragraphIds">): {
  order: number;
  seqStart: number;
  seqEnd: number;
} | null {
  if (!moment.paragraphIds.length) return null;
  const seqs = [...new Set(moment.paragraphIds.map(seqOf))].sort((a, b) => a - b);
  for (let index = 1; index < seqs.length; index += 1) {
    if (seqs[index] !== seqs[index - 1] + 1) return null;
  }
  return { order: moment.order, seqStart: seqs[0] - 1, seqEnd: seqs[seqs.length - 1] - 1 };
}

/** Canonical Moment id inside its Episode order (CONTEXT.md identifiers). */
export function canonicalMomentId(episodeOrder: number, momentOrder: number): string {
  return `ep_${String(episodeOrder).padStart(2, "0")}_m${String(momentOrder).padStart(2, "0")}`;
}

