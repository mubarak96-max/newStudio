+import { FakeImageProvider } from "../../worker/providers/images.mts";
+import { runVisualBatch } from "../../worker/visuals/batch.mts";
+import { approveVisualGeneration, FakeS3Store, runVisualGeneration } from "../../worker/visuals/generate.mts";
+
+const checks: Array<[string, boolean]> = [];
+const check = (name: string, pass: boolean) => checks.push([name, pass]);
+const BOOK_ID = "book_p12_fixture";
+const SOURCE_ID = "src_p12_fixture";
+const OWNER = "owner@studio.local";
+const REVISION_ID = "rev_p12_working_1";
+const FRAME: CoordinateFrame = { w: 1600, h: 2000, overscan: 400 };
+
+const sourceStore = new FakeSourceStore();
+sourceStore.stage({
+  sourceId: SOURCE_ID,
+  bookId: BOOK_ID,
+  status: "review",
+  storagePath: `books/${BOOK_ID}/sources/${SOURCE_ID}/original.txt`,
+  idsFrozen: false,
+  openBlockingCount: 0,
+  chapters: [{
+    chapterId: "ch_1",
+    title: "The Harbor Bell",
+    paragraphs: [
+      { text: "Mara crossed the empty quay before sunrise.", page: 1, kind: "body", isStory: true },
+      { text: "The harbor bell answered from beyond the fog.", page: 1, kind: "body", isStory: true },
+      { text: "She kept the captain's sealed order inside her coat.", page: 2, kind: "body", isStory: true },
+      { text: "Editor's note: retain spelling from the source.", page: 2, kind: "note", isStory: false },
+    ],
+  }],
+});
+const sourceReview = approveSource(sourceStore, {
+  sourceId: SOURCE_ID,
+  bookId: BOOK_ID,
+  approvedBy: OWNER,
+  now: "2026-09-19T00:00:00.000Z",
+});
+const promoted = sourceStore.promoted.get(SOURCE_ID)!;
+const paragraphs = promoted.canonicalJson.paragraphs;
+const storyParagraphs = paragraphs.filter((paragraph) => paragraph.isStory);
+check("Approval produces immutable canonical text and retains classified non-story material",
+  sourceReview.status === "approved" && paragraphs.length === 4 && storyParagraphs.length === 3);
+
+const storyMap = planStoryMap({
+  sourceId: SOURCE_ID,
+  canonicalHash: promoted.canonicalHash,
+  acts: [{ title: "Departure", eventIds: [] }],
+  arcs: [],
+  chronology: [{ storyTime: 1, eventIds: [] }],
+  episodeProposals: [{ order: 1, title: "The Harbor Bell", rationale: "One continuous departure scene.", seqStart: 0, seqEnd: 2 }],
+});
+const episode = planEpisode({
+  sourceId: SOURCE_ID,
+  canonicalHash: promoted.canonicalHash,
+  revisionId: REVISION_ID,
+  order: 1,
+  title: "The Harbor Bell",
+  chapterIds: ["ch_1"],
+  summary: "Mara carries a sealed order across the fogbound quay.",
+  seqStart: 0,
+  seqEnd: 2,
+  arc: "Mara commits to the captain's order.",
+  momentOutline: [{ title: "The quay", seqStart: 0, seqEnd: 2 }],
+  visualStrategy: "One fogbound quay composition per reading Beat.",
+  reuseCandidates: [],
+});
+const moments = planMoments({
+  sourceId: SOURCE_ID,
+  canonicalHash: promoted.canonicalHash,
+  episodeOrder: 1,
+  episode,
+  outlines: [{ title: "The quay", summary: "Mara crosses the quay while the bell sounds.", seqStart: 0, seqEnd: 2, storyTime: 1 }],
+});
+const planningStore = new FakeStoryPlanningStore();
+planningStore.proposeStoryMap(BOOK_ID, storyMap);
+planningStore.approveStoryMap(BOOK_ID, SOURCE_ID, "storymap-r1", OWNER);
+planningStore.proposeEpisode(BOOK_ID, episode);
+planningStore.proposeMoments(BOOK_ID, episode.episodeId, moments);
+planningStore.approveMoments(BOOK_ID, episode.episodeId, `moments-${episode.episodeId}-r1`, OWNER);
+check("AI StoryMap, Episode and Moment plans advance through approvals without owner-authored fields",
+  planningStore.getStoryMap(BOOK_ID, SOURCE_ID)?.status === "locked" && planningStore.getMoments(BOOK_ID, episode.episodeId).length === 1);
+
+const moment = moments[0];
+const beats = buildBeats({
+  sourceId: SOURCE_ID,
+  canonicalHash: promoted.canonicalHash,
+  episodeOrder: episode.order,
+  momentOrder: moment.order,
+  momentId: moment.momentId,
+  seqStart: moment.seqStart,
+  seqEnd: moment.seqEnd,
+  paragraphs,
+  segments: storyParagraphs.map((paragraph) => ({
+    paragraphId: paragraph.id,
+    kind: "quote" as const,
+    start: 0,
+    end: paragraph.text.length,
+    cameraTarget: paragraph.id,
+  })),
+});
+const beatStore = new FakeBeatStore();
+beatStore.proposeBeats(BOOK_ID, episode.episodeId, moment.momentId, beats);
+beatStore.approveBeats(BOOK_ID, episode.episodeId, moment.momentId, `beats-${moment.momentId}-r1`, OWNER);
+const coverage = buildCoverageReview({ momentId: moment.momentId, paragraphs, beats });
+check("Every story paragraph has a meaningful canonical Beat representation",
+  validateRepresentations({ beats, storyParagraphIds: storyParagraphs.map((paragraph) => paragraph.id) }).length === 0 &&
+    coverageApprovalProblem(coverage) === null && coverage.rows.length === 3);
+
+const targets: VisualRequestTarget[] = beats.map((beat) => ({
+  targetId: `bg_${beat.id}`,
+  kind: "scene-background",
+  compositionId: beat.compositionId,
+  layerId: `L0_${beat.id}`,
+  needed: [],
+  sceneDescription: `Fogbound quay for ${beat.id}; no baked text.`,
+  fills: [],
+}));
+const visualStore = new FakeVisualStore();
+const s3 = new FakeS3Store();
+const provider = new FakeImageProvider();
+const visualCommon = {
+  bookId: BOOK_ID,
+  sourceId: SOURCE_ID,
+  canonicalHash: promoted.canonicalHash,
+  visualProfileVersion: 1,
+  artStyle: "Painterly maritime illustration",
+  palette: ["slate", "amber"],
+  lens: "Readable portrait framing",
+  lighting: "Fog-diffused sunrise",
+  negativeRules: ["No text in images"],
+  frame: FRAME,
+};
+await runVisualGeneration({ ...visualCommon, target: targets[0], provider, store: visualStore, s3 });
+const batchResults = await runVisualBatch({
+  targets: targets.slice(1),
+  common: visualCommon,
+  provider,
+  store: visualStore,
+  s3,
+});
+for (const target of targets) {
+  approveVisualGeneration({ store: visualStore, targetId: target.targetId, attempt: 1, frame: FRAME });
+}
+check("Owner-selected single and batch visual generation share fake provider/repository boundaries",
+  provider.calls.length === 3 && batchResults.every((result) => result.status === "fulfilled") &&
+    [...visualStore.generations.values()].every((record) => record.status === "approved"));
+
+const compositions: Record<string, Composition> = {};
+for (let index = 0; index < beats.length; index += 1) {
+  const beat = beats[index];
+  const target = targets[index];
+  const record = visualStore.generations.get(`${target.targetId}:attempt-1`)!;
+  const bytes = s3.get(record.s3Key).bytes;
+  const assembled = assembleComposition({
+    bookId: BOOK_ID,
+    sourceId: SOURCE_ID,
+    canonicalHash: promoted.canonicalHash,
+    compositionId: beat.compositionId,
+    revisionId: REVISION_ID,
+    reuseKey: `quay-${beat.seq}`,
+    originEpisodeId: episode.episodeId,
+    usedIn: [{ episodeId: episode.episodeId, momentId: moment.momentId, beatId: beat.id, revisionId: REVISION_ID }],
+    shotSnapshot: {
+      shotId: `shot_${beat.id}`,
+      description: `AI-planned quay shot for ${beat.id}.`,
+      entityStates: [],
+      framing: "wide",
+      mood: "resolute",
+      timeOfDay: "sunrise",
+      reuseKey: `quay-${beat.seq}`,
+    },
+    entityStatesUsed: [],
+    continuityRefs: [],
+    referenceVersions: [],
+    visualProfileVersion: 1,
+    master: {
+      key: record.s3Key,
+      w: FRAME.w,
+      h: FRAME.h,
+      contentType: record.contentType,
+      sizeBytes: bytes.length,
+      checksum: record.checksum,
+      assetVersionId: `${target.targetId}-attempt-1`,
+    },
+    responsive: {
+      focalPoint: [0.5, 0.5],
+      portraitCrop: { x: 0.1, y: 0, w: 0.8, h: 1 },
+      landscapeCrop: { x: 0, y: 0.1, w: 1, h: 0.8 },
+    },
+    generation: {
+      provider: provider.name,
+      model: record.model,
+      prompt: record.prompt,
+      negativePrompt: record.negativePrompt,
+      referenceKeys: [],
+      costUsd: record.costUsd,
+    },
+    frame: FRAME,
+    layers: [{
+      layerId: target.layerId!,
+      role: "background",
+      key: record.s3Key,
+      assetVersionId: `${target.targetId}-attempt-1`,
+      w: FRAME.w,
+      h: FRAME.h,
+      contentType: record.contentType,
+      sizeBytes: bytes.length,
+      checksum: record.checksum,
+      hasAlpha: false,
+      overscanPresentPx: FRAME.overscan,
+      zOrder: 0,
+      depthRange: [0, 1],
+      transform: { x: 0, y: 0, z: 0, scaleX: 1, scaleY: 1, rotate: 0 },
+      renderMode: "plane",
+    }],
+    cameraPoses: [{ beatId: beat.id, from: beat.camera.from, to: beat.camera.to }],
+  });
+  check(`Composition ${beat.compositionId} assembles without blockers`,
+    assembled.composition !== null && assembled.issues.length === 0);
+  compositions[beat.compositionId] = assembled.composition!;
+}
+
+const bundle = compileFixtureBundle({
+  provenance: "P12 deterministic complete-workflow fixture; local fakes only; publication boundary unavailable.",
+  bookId: BOOK_ID,
+  episodeId: episode.episodeId,
+  episode: {
+    order: episode.order,
+    title: episode.title,
+    summary: episode.summary,
+    version: 1,
+    revisionId: REVISION_ID,
+  },
+  source: {
+    sourceId: SOURCE_ID,
+    bookId: BOOK_ID,
+    canonicalHash: promoted.canonicalHash,
+    chapterId: "ch_1",
+    paragraphs,
+  },
+  moment: {
+    sourceId: SOURCE_ID,
+    canonicalHash: promoted.canonicalHash,
+    schemaVersion: 1,
+    momentId: moment.momentId,
+    order: moment.order,
+    seqStart: moment.seqStart,
+    seqEnd: moment.seqEnd,
+    sourceParagraphIds: storyParagraphs.map((paragraph) => paragraph.id),
+    summary: moment.summary,
+    storyTime: moment.storyTime,
+    readingBeats: beats,
+    status: "review",
+  },
+  compositions,
+  assetsBaseUrl: "local-fixture://p12-complete-workflow",
+});
+const scopes = {
+  episode: bundle.beats,
+  moment: bundle.beats.filter((beat) => beat.seq >= moment.seqStart && beat.seq <= moment.seqEnd),
+  beat: bundle.beats.slice(0, 1),
+};
+check("The exact canonical bundle supports Episode, Moment and Beat preview scopes",
+  Object.values(scopes).every((scope) => scope.length > 0) &&
+    bundle.beats.every((beat) => resolveFrame(bundle, beat.id, 0.5).subtitleHtml.length > 0));
+
+const versionOneSnapshot = JSON.stringify(bundle);
+const regeneration = planRegeneration({
+  targetId: targets[0].targetId,
+  kind: targets[0].kind,
+  scope: "layer",
+  previousAttempt: 1,
+  approvedSiblingKeys: [],
+  reason: "Fixture replacement candidate for the first Beat.",
+});
+await runVisualGeneration({
