 141: // Explicit owner selection for visual generation: one job per selected
 142: // target (single or batch), each with a distinct idempotency key so explicit
 143: // regeneration is billable while retries are not (plan 6).
 144: export function selectVisualTargets(
 145:   store: FakeJobStore,
 146:   clock: FakeClock,
 147:   cursor: PipelineCursor,
 148:   input: {
 149:     bookId: string;
 150:     sourceId: string;
 151:     canonicalHash: string;
 152:     targets: { targetId: string; kind: "reference" | "moment" }[];
 153:     selectedBy: string;
 154:   },
 155: ): CanonicalJob[] {
 156:   if (input.targets.length === 0) {
 157:     throw new ApprovalError("NO_TARGETS", "Select at least one visual target to generate.");
 158:   }
 159:   if (input.targets.length > 25) {
 160:     throw new ApprovalError("BATCH_TOO_LARGE", "Visual batches are bounded to 25 targets.");
 161:   }
 162:   void clock;
 163:   void cursor;
 164:   void input.selectedBy;
 165:   return input.targets.map((target) =>
 166:     createJob(store, {
 167:       bookId: input.bookId,
 168:       sourceId: input.sourceId,
 169:       canonicalHash: input.canonicalHash,
 170:       type: target.kind === "reference" ? "images.reference.generate" : "images.moment.generate",
 171:       stage: "queued",
 172:       idempotencyKey: `visual:${target.kind}:${target.targetId}:${input.canonicalHash}`,
 173:     }),
 174:   );
 175: }
 176: 
 177: // Guard for plan repairs: a repair may only requeue a failed planning job
 178: // whose pins still match; anything else is a stale or out-of-scope repair.
 179: export function repairPlanningJob(
 180:   store: FakeJobStore,
 181:   input: { jobId: string; pins: ApprovalPins; maxRepairs?: number },
 182: ): CanonicalJob {
 183:   const job = store.jobs.get(input.jobId);
 184:   if (!job) throw new JobError("NOT_FOUND", `Job ${input.jobId} not found.`);
 185:   if (job.status !== "failed") {
 186:     throw new JobError("NOT_FAILED", `Only a failed job can be repaired; ${input.jobId} is ${job.status}.`);
 187:   }
 188:   if (isVisualJobType(job.type)) {
 189:     throw new JobError("NOT_PLANNING", "Visual jobs regenerate through explicit selection, not plan repair.");
 190:   }
 191:   if (!pinsMatch(job, input.pins)) {
 192:     throw new JobError("STALE_PINS", "Repair pins no longer match; replan from the current source instead.");
 193:   }
 194:   const repairs = job.attempts;
 195:   if (repairs >= (input.maxRepairs ?? job.maxAttempts)) {
 196:     throw new JobError("REPAIR_BUDGET_EXHAUSTED", "Bounded plan-repair attempts are exhausted; inspect the failure.");
 197:   }
 198:   job.status = "queued";
 199:   job.stage = "queued for repair";
 200:   job.error = null;
 201:   job.workerId = undefined;
 202:   job.leaseExpiresAt = undefined;
 203:   return job;
 204: }

