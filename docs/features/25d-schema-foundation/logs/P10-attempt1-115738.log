import { z } from "zod";

import { HotspotSchema, IdSchema, LineageSchema } from "./primitives.ts";
import {
  CommentarySchema,
  DialogueSchema,
  TextSelectionSchema,
  BeatSchema,
} from "./beat.ts";

// Planning contracts (plan 3.1): StoryMap, Episode and the full Moment
// scene container. Moment/Episode ranges tile story paragraphs exactly once;
// non-story paragraphs remain stored and explicitly classified (ADR-002).

export const StoryMapSchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  revision: z.number().int().min(1),
  status: z.enum(["draft", "reviewed", "locked"]),
  acts: z.array(z.object({ title: z.string().min(1), eventIds: z.array(IdSchema) })),
  arcs: z.array(
    z.object({ entityId: IdSchema, summary: z.string().min(1), eventIds: z.array(IdSchema) }),
  ),
  episodeProposals: z.array(
    z.object({
      order: z.number().int().min(1),
      title: z.string().min(1),
      rationale: z.string().min(1),
      seqStart: z.number().int().min(0),
      seqEnd: z.number().int().min(0),
    }),
  ),
  chronology: z.array(
    z.object({
      storyTime: z.number().refine(Number.isFinite, {
        message: "storyTime is a finite chronology ordinal",
      }),
      eventIds: z.array(IdSchema),
    }),
  ),
});

export const EntityStateRefSchema = z.object({
  entityId: IdSchema,
  stateId: IdSchema,
});

export const ShotSchema = z.object({
  shotId: IdSchema,
  description: z.string().min(1),
  entityStates: z.array(EntityStateRefSchema),
  framing: z.string().min(1),
  mood: z.string().min(1),
  timeOfDay: z.string().min(1),
  reuseKey: z.string().min(1),
});

export const FullMomentSchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  momentId: z.string().min(1),
  order: z.number().int().min(1),
  seqStart: z.number().int().min(0),
  seqEnd: z.number().int().min(0),
  sourceParagraphIds: z.array(z.string().regex(/^p\d{6}$/)).min(1),
  summary: z.string().min(1),
  startState: z.string().min(1),
  endState: z.string().min(1),
  storyTime: z.number().refine(Number.isFinite, {
    message: "storyTime is a finite chronology ordinal",
  }),
  characters: z.array(EntityStateRefSchema),
  locationId: IdSchema.optional(),
  locationStateId: IdSchema.optional(),
  objectIds: z.array(IdSchema),
  exactTextSelections: z.array(TextSelectionSchema),
  dialogue: z.array(DialogueSchema),
  commentary: z.array(CommentarySchema),
  visualPlan: z.object({ shots: z.array(ShotSchema).min(1) }),
  compositionIds: z.array(IdSchema),
  readingBeats: z.array(BeatSchema).min(1),
  inspectableEntities: z.array(
    z.object({ entityId: IdSchema, beatId: IdSchema, hotspot: HotspotSchema }),
  ),
  status: z.enum(["pending", "running", "review", "approved", "outdated", "failed"]),
}).refine((moment) => moment.seqEnd >= moment.seqStart, {
  message: "Moment ranges tile story paragraphs; seqEnd is inclusive",
});

const EpisodeStageSchema = z.enum([
  "planned",
  "moments",
  "beats",
  "visuals",
  "composed",
  "previewed",
  "published",
]);

const StageStateSchema = z.enum([
  "pending",
  "running",
  "review",
  "approved",
  "outdated",
  "failed",
]);

export const EpisodeSchema = LineageSchema.extend({
  schemaVersion: z.literal(1),
  episodeId: z.string().min(1),
  revisionId: IdSchema,
  order: z.number().int().min(1),
  title: z.string().min(1),
  seqStart: z.number().int().min(0),
  seqEnd: z.number().int().min(0),
  chapterIds: z.array(IdSchema),
  summary: z.string().min(1),
  storyPlan: z.object({
    arc: z.string().min(1),
    momentOutline: z.array(
      z.object({
        title: z.string().min(1),
        seqStart: z.number().int().min(0),
        seqEnd: z.number().int().min(0),
      }),
    ),
    visualStrategy: z.string().min(1),
    reuseCandidates: z.array(z.string().min(1)),
  }),
  stageStatus: z.partialRecord(EpisodeStageSchema, StageStateSchema),
  publishedVersion: z.number().int().min(1).optional(),
}).refine((episode) => episode.seqEnd >= episode.seqStart, {
  message: "Episode seqEnd is inclusive and must be >= seqStart",
});

export type StoryMap = z.infer<typeof StoryMapSchema>;
export type Shot = z.infer<typeof ShotSchema>;
export type FullMoment = z.infer<typeof FullMomentSchema>;
export type Episode = z.infer<typeof EpisodeSchema>;

