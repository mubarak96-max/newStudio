  idsFrozen: false,
  openBlockingCount: 0,
  chapters: [{
    chapterId: "ch_1",
    title: "The Harbor Bell",
    paragraphs: [
      { text: "Mara crossed the empty quay before sunrise.", page: 1, kind: "body", isStory: true },
      { text: "The harbor bell answered from beyond the fog.", page: 1, kind: "body", isStory: true },
      { text: "She kept the captain's sealed order inside her coat.", page: 2, kind: "body", isStory: true },
      { text: "Editor's note: retain spelling from the source.", page: 2, kind: "note", isStory: false },
    ],
  }],
});
const sourceReview = approveSource(sourceStore, {
  sourceId: SOURCE_ID,
  bookId: BOOK_ID,
  approvedBy: OWNER,
  now: "2026-09-19T00:00:00.000Z",
});
const promoted = sourceStore.promoted.get(SOURCE_ID)!;
const paragraphs = promoted.canonicalJson.paragraphs;
const storyParagraphs = paragraphs.filter((paragraph) => paragraph.isStory);
check("Approval produces immutable canonical text and retains classified non-story material",
  sourceReview.status === "approved" && paragraphs.length === 4 && storyParagraphs.length === 3);

const storyMap = planStoryMap({
  sourceId: SOURCE_ID,
  canonicalHash: promoted.canonicalHash,
  acts: [{ title: "Departure", eventIds: [] }],
  arcs: [],
  chronology: [{ storyTime: 1, eventIds: [] }],
  episodeProposals: [{ order: 1, title: "The Harbor Bell", rationale: "One continuous departure scene.", seqStart: 0, seqEnd: 2 }],
});
const episode = planEpisode({
  sourceId: SOURCE_ID,
  canonicalHash: promoted.canonicalHash,
  revisionId: REVISION_ID,
  order: 1,
  title: "The Harbor Bell",
  chapterIds: ["ch_1"],
  summary: "Mara carries a sealed order across the fogbound quay.",
  seqStart: 0,
  seqEnd: 2,
  arc: "Mara commits to the captain's order.",
  momentOutline: [{ title: "The quay", seqStart: 0, seqEnd: 2 }],
  visualStrategy: "One fogbound quay composition per reading Beat.",
  reuseCandidates: [],
});
const moments = planMoments({
