// AI story planning constructors (P6, ADR-003).
// AI proposes StoryMap acts/arcs/chronology plus strict Episode ranges, then
// per-episode storyPlan moment outlines and contiguous Moment ranges in book
// order. The owner approves; the owner never types boundaries. IDs follow
// CONTEXT.md: ep_01, ep_01_m01. Display order is 1-based; seq is zero-based
// with inclusive ends.

import { EpisodeSchema, StoryMapSchema } from "../schemas/planning.ts";

export type EpisodeProposalInput = {
  order: number;
  title: string;
  rationale: string;
  seqStart: number;
  seqEnd: number;
};

export type MomentOutlineInput = {
  title: string;
  seqStart: number;
  seqEnd: number;
};

export type StoryMapProposalInput = {
  sourceId: string;
  canonicalHash: string;
  revision?: number;
  acts: { title: string; eventIds: string[] }[];
  arcs: { entityId: string; summary: string; eventIds: string[] }[];
  chronology: { storyTime: number; eventIds: string[] }[];
  episodeProposals: EpisodeProposalInput[];
};

export type EpisodePlanInput = {
  sourceId: string;
  canonicalHash: string;
  revisionId: string;
  order: number;
  title: string;
  chapterIds: string[];
  summary: string;
  seqStart: number;
  seqEnd: number;
  arc: string;
  momentOutline: MomentOutlineInput[];
  visualStrategy: string;
  reuseCandidates: string[];
};

export type MomentRangeInput = {
  title: string;
  summary: string;
  seqStart: number;
  seqEnd: number;
  storyTime: number;
};

export function episodeIdFor(order: number): string {
  return `ep_${String(order).padStart(2, "0")}`;
}

export function momentIdFor(episodeOrder: number, momentOrder: number): string {
  return `${episodeIdFor(episodeOrder)}_m${String(momentOrder).padStart(2, "0")}`;
}

/** Validate fake AI StoryMap output through the canonical Zod contract. */
export function planStoryMap(input: StoryMapProposalInput) {
  const parsed = StoryMapSchema.safeParse({
    sourceId: input.sourceId,
    canonicalHash: input.canonicalHash,
    schemaVersion: 1,
    revision: input.revision ?? 1,
    status: "draft",
    acts: input.acts,
    arcs: input.arcs,
    episodeProposals: input.episodeProposals,
    chronology: input.chronology,
  });
  if (!parsed.success) {
    throw new Error(`StoryMap proposal failed validation: ${parsed.error.message}`);
  }
  return parsed.data;
}

/** Validate fake AI per-episode output through the canonical Episode contract. */
export function planEpisode(input: EpisodePlanInput) {
  const parsed = EpisodeSchema.safeParse({
    sourceId: input.sourceId,
    canonicalHash: input.canonicalHash,
    schemaVersion: 1,
    episodeId: episodeIdFor(input.order),
    revisionId: input.revisionId,
    order: input.order,
    title: input.title,
    seqStart: input.seqStart,
    seqEnd: input.seqEnd,
    chapterIds: input.chapterIds,
    summary: input.summary,
    storyPlan: {
      arc: input.arc,
      momentOutline: input.momentOutline,
      visualStrategy: input.visualStrategy,
      reuseCandidates: input.reuseCandidates,
    },
    stageStatus: { planned: "review" },
  });
  if (!parsed.success) {
    throw new Error(`Episode proposal failed validation: ${parsed.error.message}`);
  }
  return parsed.data;
}

export type MomentRange = {
  momentId: string;
  order: number;
  seqStart: number;
  seqEnd: number;
  title: string;
  summary: string;
  storyTime: number;
  sourceId: string;
  canonicalHash: string;
};

/**
 * Build contiguous Moment scene-container ranges inside one Episode, in book
 * order. Moments are scene containers (P6); Beat text/compositions arrive in
 * P7. Throws on non-contiguous or out-of-episode outlines.
 */
export function planMoments(args: {
  sourceId: string;
  canonicalHash: string;
  episodeOrder: number;
  episode: { seqStart: number; seqEnd: number };
  outlines: MomentRangeInput[];
}): MomentRange[] {
  const { sourceId, canonicalHash, episodeOrder, episode, outlines } = args;
  if (outlines.length === 0) throw new Error("The episode needs at least one Moment outline.");
  const moments = outlines.map((outline, index) => ({
    momentId: momentIdFor(episodeOrder, index + 1),
    order: index + 1,
    seqStart: outline.seqStart,
    seqEnd: outline.seqEnd,
    title: outline.title,
    summary: outline.summary,
    storyTime: outline.storyTime,
    sourceId,
    canonicalHash,
  }));
  for (const moment of moments) {
    if (!Number.isInteger(moment.seqStart) || !Number.isInteger(moment.seqEnd) || moment.seqEnd < moment.seqStart) {
      throw new Error(`Moment ${moment.order} ends before it starts; seqEnd is inclusive.`);
    }
    if (!Number.isFinite(moment.storyTime)) {
      throw new Error(`Moment ${moment.order} needs a finite storyTime chronology ordinal.`);
    }
    if (!moment.title.trim() || !moment.summary.trim()) {
      throw new Error(`Moment ${moment.order} needs a title and summary.`);
    }
  }
  if (moments[0].seqStart !== episode.seqStart) {
    throw new Error("First Moment must start at the Episode seqStart.");
  }
  const last = moments[moments.length - 1];
  if (last.seqEnd !== episode.seqEnd) {
    throw new Error("Last Moment must end at the Episode seqEnd.");
  }
  for (let index = 1; index < moments.length; index += 1) {
    if (moments[index].seqStart !== moments[index - 1].seqEnd + 1) {
      throw new Error(`Moments ${index} and ${index + 1} must be contiguous with no gap or overlap.`);
    }
  }
  return moments;
}

===== src/features/book-experience/story-map/repository.ts =====
// Fake-backed story-planning repository (P6, ADR-012).
// Firestore layout follows plan section 4:
// books/{bookId}/derived/storyMap plus books/{bookId}/episodes/{episodeId}
// working documents and moments/{momentId} children. Local tests use this
// fake; no live writes here. Approvals are idempotent per fingerprint.

import type { MomentRange } from "./planning.ts";
import type { Episode, StoryMap } from "../schemas/planning.ts";

export type StoryApproval = {
  scope: "storyMap" | "episode" | "moments";
  episodeId?: string;
  status: "review" | "approved" | "rejected";
  fingerprint: string;
  approvedBy?: string;
  approvedAt?: string;
};

export class FakeStoryPlanningStore {
  storyMaps = new Map<string, StoryMap>();
  episodes = new Map<string, Episode>();
  moments = new Map<string, MomentRange[]>();
  approvals = new Map<string, StoryApproval>();
  publishedEpisodeIds = new Set<string>();

  storyMapKey(bookId: string, sourceId: string): string {
    return `books/${bookId}/derived/storyMap#${sourceId}`;
  }

  episodeKey(bookId: string, episodeId: string): string {
    return `books/${bookId}/episodes/${episodeId}`;
  }

  proposeStoryMap(bookId: string, storyMap: StoryMap): void {
    const key = this.storyMapKey(bookId, storyMap.sourceId);
    if (this.storyMaps.has(key)) throw new Error(`StoryMap ${key} already proposed.`);
    this.storyMaps.set(key, storyMap);
    this.approvals.set(`${key}/approval`, {
      scope: "storyMap",
      status: "review",
      fingerprint: `storymap-r${storyMap.revision}`,
    });
  }

  getStoryMap(bookId: string, sourceId: string): StoryMap | null {
    return this.storyMaps.get(this.storyMapKey(bookId, sourceId)) ?? null;
  }

  approveStoryMap(bookId: string, sourceId: string, fingerprint: string, approvedBy: string): StoryApproval {
    const key = `${this.storyMapKey(bookId, sourceId)}/approval`;
    const existing = this.approvals.get(key);
    if (existing?.status === "approved" && existing.fingerprint === fingerprint) return existing;
    const approval: StoryApproval = {
      scope: "storyMap",
      status: "approved",
      fingerprint,
      approvedBy,
      approvedAt: new Date(0).toISOString(),
    };
    this.approvals.set(key, approval);
    const storyMap = this.storyMaps.get(this.storyMapKey(bookId, sourceId));
    if (storyMap) this.storyMaps.set(this.storyMapKey(bookId, sourceId), { ...storyMap, status: "locked" });
    return approval;
  }

  proposeEpisode(bookId: string, episode: Episode): void {
    const key = this.episodeKey(bookId, episode.episodeId);
    if (this.episodes.has(key)) throw new Error(`Episode ${key} already proposed.`);
    this.episodes.set(key, episode);
  }

  proposeMoments(bookId: string, episodeId: string, moments: MomentRange[]): void {
    this.moments.set(`${this.episodeKey(bookId, episodeId)}/moments`, moments);
    this.approvals.set(`${this.episodeKey(bookId, episodeId)}/moments/approval`, {
      scope: "moments",
      episodeId,
      status: "review",
      fingerprint: `moments-${episodeId}-r1`,
    });
  }

  getMoments(bookId: string, episodeId: string): MomentRange[] {
    return this.moments.get(`${this.episodeKey(bookId, episodeId)}/moments`) ?? [];
  }

  approveMoments(bookId: string, episodeId: string, fingerprint: string, approvedBy: string): StoryApproval {
    const key = `${this.episodeKey(bookId, episodeId)}/moments/approval`;
    const existing = this.approvals.get(key);
    if (existing?.status === "approved" && existing.fingerprint === fingerprint) return existing;
    const approval: StoryApproval = {
      scope: "moments",
      episodeId,
      status: "approved",
      fingerprint,
      approvedBy,
      approvedAt: new Date(0).toISOString(),
    };
    this.approvals.set(key, approval);
    return approval;
  }

  /** Independent publication: publishing one Episode never blocks a sibling. */
  publishEpisode(bookId: string, episodeId: string): void {
    void bookId;
    this.publishedEpisodeIds.add(episodeId);
  }

  isPublished(episodeId: string): boolean {
    return this.publishedEpisodeIds.has(episodeId);
  }
}

===== src/features/book-experience/beats/build.ts =====
// AI Beat planning constructors (P7, ADR-002/ADR-003).
// AI supplies every camera target, pose, timing and transition; the owner
// reviews/approves only. Beats preserve source order, split ~60-word quote
// screens into ordered Beats without dropping content, and gate entities by
// each Beat's seq. Explicit/internal meaning that visuals cannot preserve
// stays in HTML subtitles (commentary/quote/dialogue text forms).

import { BeatSchema, type Beat } from "../schemas/beat.ts";

export type CanonicalParagraph = {
  id: string;
  seq: number;
  text: string;
  isStory: boolean;
  kind: string;
};

export type BeatSegmentKind = "quote" | "dialogue" | "commentary" | "internal";

export type BeatProposalSegment = {
  paragraphId: string;
  kind: BeatSegmentKind;
  /** UTF-16 code-unit offsets, start inclusive/end exclusive. */
  start: number;
  end: number;
  speakerEntityId?: string;
  speakerDisplayName?: string;
  addresseeEntityId?: string;
  commentaryKind?: "scene" | "context" | "clarify";
  commentaryText?: string;
  /** Semantic camera target: character, object, location or reveal. */
  cameraTarget?: string;
  framing?: string;
  entities?: string[];
};

export type BuildBeatsArgs = {
  sourceId: string;
  canonicalHash: string;
  episodeOrder: number;
  momentOrder: number;
  momentId: string;
  seqStart: number;
  seqEnd: number;
  paragraphs: CanonicalParagraph[];
  segments: BeatProposalSegment[];
  /** entityId -> first seq where the entity may be shown. */
  entityFirstSeq?: Record<string, number>;
  compositionPrefix?: string;
};

const MAX_QUOTE_WORDS = 60;

export function beatIdFor(episodeOrder: number, momentOrder: number, beatOrder: number): string {
  const episode = `ep_${String(episodeOrder).padStart(2, "0")}`;
  return `${episode}_m${String(momentOrder).padStart(2, "0")}_b${String(beatOrder).padStart(2, "0")}`;
}

function wordCount(value: string): number {
  const words = value.split(/\s+/).filter(Boolean);
  return words.length;
}

/** Split long text into ~60-word ordered chunks at word boundaries. */
export function splitLongText(text: string, maxWords: number = MAX_QUOTE_WORDS): string[] {
  const words = text.split(/\s+/).filter(Boolean);
  if (words.length <= maxWords) return [text];
  const chunks: string[] = [];
  for (let index = 0; index < words.length; index += maxWords) {
    chunks.push(words.slice(index, index + maxWords).join(" "));
  }
  return chunks;
}

/** Word spans inside [start, end) so long selections split with exact offsets. */
export function splitWordsWithOffsets(
  canonical: string,
  start: number,
  end: number,
): { word: string; start: number; end: number }[] {
  const spans: { word: string; start: number; end: number }[] = [];
  const pattern = /\S+/g;
  pattern.lastIndex = start;
  let match: RegExpExecArray | null;
  while ((match = pattern.exec(canonical)) !== null && match.index < end) {
    const wordEnd = Math.min(match.index + match[0].length, end);
    spans.push({ word: canonical.slice(match.index, wordEnd), start: match.index, end: wordEnd });
    if (pattern.lastIndex >= end) break;
  }
  return spans;
}

function hashChoice(seed: string, count: number): number {
  let hash = 0;
  for (let index = 0; index < seed.length; index += 1) {
    hash = (hash * 31 + seed.charCodeAt(index)) % 100003;
  }
  return hash % count;
}

const TRANSITIONS = ["cut", "fade", "slide", "zoomThrough", "parallaxShift"] as const;
const FRAMINGS = ["wide", "medium", "close", "over-shoulder", "detail"] as const;

/**
 * Build ordered Beats from fake-AI proposal segments against the canonical
 * source. Throws actionable errors for unknown paragraphs, invalid offsets,
 * out-of-range segments or empty proposals. Pure: no cloud, no paid calls.
 */
export function buildBeats(args: BuildBeatsArgs): Beat[] {
  const {
    sourceId,
    canonicalHash,
    episodeOrder,
    momentOrder,
    momentId,
    seqStart,
    seqEnd,
    paragraphs,
    segments,
    entityFirstSeq = {},
    compositionPrefix,
  } = args;
  void sourceId;
  void canonicalHash;
  if (segments.length === 0) throw new Error(`Moment ${momentId} needs at least one Beat segment.`);
  const byId = new Map(paragraphs.map((paragraph) => [paragraph.id, paragraph]));
  const inRange = paragraphs
    .filter((paragraph) => paragraph.seq >= seqStart && paragraph.seq <= seqEnd)
    .sort((a, b) => a.seq - b.seq);
  if (inRange.length === 0) {
    throw new Error(`Moment ${momentId} cites an empty source range.`);
  }

  const orderedSegments = [...segments].sort((a, b) => {
    const seqA = byId.get(a.paragraphId)?.seq ?? Number.MAX_SAFE_INTEGER;
    const seqB = byId.get(b.paragraphId)?.seq ?? Number.MAX_SAFE_INTEGER;
    if (seqA !== seqB) return seqA - seqB;
    return a.start - b.start;
  });

  const beats: Beat[] = [];
  let order = 0;

  for (const segment of orderedSegments) {
    const paragraph = byId.get(segment.paragraphId);
    if (!paragraph) throw new Error(`Beat segment cites unknown paragraph ${segment.paragraphId}.`);
    if (paragraph.seq < seqStart || paragraph.seq > seqEnd) {
      throw new Error(
        `Beat segment for ${segment.paragraphId} falls outside Moment ${momentId} [${seqStart}, ${seqEnd}].`,
      );
    }
    if (
      !Number.isInteger(segment.start) ||
      !Number.isInteger(segment.end) ||
      segment.start < 0 ||
      segment.end > paragraph.text.length ||
      segment.start >= segment.end
    ) {
      throw new Error(`Beat segment offsets for ${segment.paragraphId} are invalid.`);
    }
    const selected = paragraph.text.slice(segment.start, segment.end);
    if (selected.length === 0) throw new Error(`Beat segment for ${segment.paragraphId} selects no text.`);

    const chunks = splitWordsWithOffsets(paragraph.text, segment.start, segment.end);
    // Group words into ~60-word ordered chunks so long passages split without
    // dropping content; offsets stay exact against the canonical string.
    const grouped: { start: number; end: number }[] = [];
    for (let index = 0; index < chunks.length; index += MAX_QUOTE_WORDS) {
      const slice = chunks.slice(index, index + MAX_QUOTE_WORDS);
      grouped.push({ start: slice[0].start, end: slice[slice.length - 1].end });
    }
    for (let chunkIndex = 0; chunkIndex < grouped.length; chunkIndex += 1) {
      const { start: resolvedStart, end: resolvedEnd } = grouped[chunkIndex];
      const chunk = paragraph.text.slice(resolvedStart, resolvedEnd);
      order += 1;

      const gatedEntities = (segment.entities ?? []).filter(
        (entityId) => (entityFirstSeq[entityId] ?? 0) <= paragraph.seq,
      );
      const focusEntityId = gatedEntities[0];
      const target = segment.cameraTarget ?? paragraph.id;
      const framing = segment.framing ?? FRAMINGS[hashChoice(`${target}:${order}`, FRAMINGS.length)];
      const transition = TRANSITIONS[hashChoice(`${target}#${order}`, TRANSITIONS.length)];
      const beatId = beatIdFor(episodeOrder, momentOrder, order);
      const compositionId = `${compositionPrefix ?? `cmp_${momentId}_v1`}_${beatId}`;
      const beatType =
        segment.kind === "dialogue" ? "dialogue" : segment.kind === "internal" ? "commentary" : "quote";

      const text: Beat["text"] = {};
      if (segment.kind === "dialogue") {
        if (!segment.speakerEntityId || !segment.speakerDisplayName) {
          throw new Error(`Dialogue segment for ${segment.paragraphId} needs a speaker.`);
        }
        text.dialogue = [
          {
            paragraphId: segment.paragraphId,
            start: resolvedStart,
            end: Math.min(resolvedEnd, paragraph.text.length),
            text: paragraph.text.slice(resolvedStart, Math.min(resolvedEnd, paragraph.text.length)),
            speakerEntityId: segment.speakerEntityId,
            addresseeEntityId: segment.addresseeEntityId,
            speakerDisplayName: segment.speakerDisplayName,
          },
        ];
      } else if (segment.kind === "internal" || segment.kind === "commentary") {
        const commentaryText =
          segment.kind === "internal"
            ? (segment.commentaryText ?? selected)
            : (segment.commentaryText ?? selected);
        if (!commentaryText.trim()) {
          throw new Error(`Commentary segment for ${segment.paragraphId} needs text.`);
        }
        text.commentary = [
          {
            id: `${beatId}_c01`,
            text: commentaryText,
            kind: segment.commentaryKind ?? "scene",
            groundedIn: [segment.paragraphId],
            verified: false,
          },
        ];
        if (segment.kind !== "internal") {
          text.quote = {
            paragraphId: segment.paragraphId,
            start: resolvedStart,
            end: Math.min(resolvedEnd, paragraph.text.length),
            text: paragraph.text.slice(resolvedStart, Math.min(resolvedEnd, paragraph.text.length)),
          };
        }
      } else {
        text.quote = {
          paragraphId: segment.paragraphId,
          start: resolvedStart,
          end: Math.min(resolvedEnd, paragraph.text.length),
          text: paragraph.text.slice(resolvedStart, Math.min(resolvedEnd, paragraph.text.length)),
        };
      }

      const cameraSeed = hashChoice(`${target}:${beatId}`, 1000) / 1000;
      const candidate = {
        id: beatId,
        order,
        seq: paragraph.seq,
        type: beatType,
        text,
        compositionId,
        camera: {
          from: { x: -0.08 + cameraSeed * 0.08, y: -0.05, zoom: 1, rotate: 0 },
          to: { x: 0.08 - cameraSeed * 0.08, y: 0.05, zoom: 1 + cameraSeed * 0.25, rotate: 0 },
          durationMs: 2400 + Math.round(cameraSeed * 1600),
          easing: "easeInOut" as const,
          ...(focusEntityId ? { focusEntityId } : {}),
          rationale: `AI-planned ${framing} framing on ${target} for ${segment.paragraphId}.`,
        },
        transitionIn: {
          type: order === 1 ? ("cut" as const) : transition,
          durationMs: order === 1 ? 0 : 350,
        },
        inspectables: [],
        representations: [
          {
            paragraphId: segment.paragraphId,
            modality: "text" as const,
            description:
              segment.kind === "internal"
                ? `Internal meaning of ${segment.paragraphId} preserved in subtitles: ${chunk.slice(0, 80)}.`
                : `Subtitle carries ${segment.paragraphId} (${segment.kind}) in source order${grouped.length > 1 ? `, part ${chunkIndex + 1} of ${grouped.length}` : ""}.`,
          },
          {
            paragraphId: segment.paragraphId,
            modality: "camera" as const,
            description: `AI ${framing} camera move settles on ${target} across ${chunkIndex + 1}/${grouped.length}.`,
          },
        ],
      };
      const parsed = BeatSchema.safeParse(candidate);
      if (!parsed.success) {
        throw new Error(`Beat ${beatId} failed validation: ${parsed.error.message}`);
      }
      beats.push(parsed.data);
    }
  }

  void wordCount;
  return beats;
}

===== src/features/book-experience/beats/repository.ts =====
// Fake-backed Beat repository (P7, ADR-012).
// Firestore layout follows plan section 4:
// books/{bookId}/episodes/{episodeId}/moments/{momentId} holds working
// readingBeats with source/revision pins. Local tests use this fake; no live
// writes here. Approvals are idempotent per content fingerprint.

import type { Beat } from "../schemas/beat.ts";

export type BeatApproval = {
  momentId: string;
  status: "review" | "approved" | "rejected";
  fingerprint: string;
  approvedBy?: string;
  approvedAt?: string;
};

export class FakeBeatStore {
  proposals = new Map<string, Beat[]>();
  approvals = new Map<string, BeatApproval>();
  outdatedMoments = new Set<string>();

  momentKey(bookId: string, episodeId: string, momentId: string): string {
    return `books/${bookId}/episodes/${episodeId}/moments/${momentId}`;
  }

  proposeBeats(bookId: string, episodeId: string, momentId: string, beats: Beat[]): void {
    const key = this.momentKey(bookId, episodeId, momentId);
    if (this.proposals.has(key)) throw new Error(`Beats for ${key} already proposed.`);
    this.proposals.set(key, beats);
    this.approvals.set(`${key}/approval`, {
      momentId,
      status: "review",
      fingerprint: `beats-${momentId}-r1`,
    });
  }

  getBeats(bookId: string, episodeId: string, momentId: string): Beat[] {
    return this.proposals.get(this.momentKey(bookId, episodeId, momentId)) ?? [];
  }

  approveBeats(
    bookId: string,
    episodeId: string,
    momentId: string,
    fingerprint: string,
    approvedBy: string,
  ): BeatApproval {
    const key = `${this.momentKey(bookId, episodeId, momentId)}/approval`;
    if (this.outdatedMoments.has(this.momentKey(bookId, episodeId, momentId))) {
      throw new Error(`Moment ${momentId} is outdated; regenerate Beats from the current source.`);
    }
    const existing = this.approvals.get(key);
    if (existing?.status === "approved" && existing.fingerprint === fingerprint) return existing;
    const approval: BeatApproval = {
      momentId,
      status: "approved",
      fingerprint,
      approvedBy,
      approvedAt: new Date(0).toISOString(),
    };
    this.approvals.set(key, approval);
    return approval;
  }

  /** Correction revisions invalidate dependent drafts; published stays intact. */
  markOutdated(bookId: string, episodeId: string, momentId: string): void {
    this.outdatedMoments.add(this.momentKey(bookId, episodeId, momentId));
  }

  isOutdated(bookId: string, episodeId: string, momentId: string): boolean {
    return this.outdatedMoments.has(this.momentKey(bookId, episodeId, momentId));
  }
}

===== src/features/book-experience/visuals/requests.ts =====
// Visual generation request assembly (P8, ADR-007/ADR-008).
// One request per target: clean scene backgrounds carry the parts hidden
// behind foreground layers; RGBA foreground layers keep transparent
// padding/placement; optional depth aligns to the exact same frame.
// Every layer of one composition shares one coordinate frame (canvas w/h)
// and one set of pinned reference versions. No segmentation, depth,
// inpaint or manual upload/edit services exist here â€” generation goes
// directly through the configured ImageProvider.

import type { ReferencePin } from "../schemas/model.ts";
import type { VisualTargetKind } from "./references.ts";

export type CoordinateFrame = {
  /** Explicit composition canvas all layers share (plan 3.2). */
  w: number;
  h: number;
  /** Background overscan beyond the viewport so hidden areas exist. */
  overscan: number;
};

export type VisualRequestTarget = {
  targetId: string;
  kind: VisualTargetKind;
  compositionId: string;
  layerId?: string;
  /** Entity/state identities this target must stay consistent with. */
  needed: { entityId: string; stateId?: string }[];
  sceneDescription: string;
  fills: { key: string; value: string; reason: string }[];
};

export type AssembledVisualRequest = {
  targetId: string;
  kind: VisualTargetKind;
  prompt: string;
  negativePrompt: string;
  aspectRatio: string;
  referenceKeys: string[];
  referenceVersions: ReferencePin[];
  frame: CoordinateFrame;
  /** Distinct billable regeneration carries a new key; retries reuse it. */
  idempotencyKey: string;
  unit: number;
};

export const VISUAL_CANVAS: CoordinateFrame = { w: 1600, h: 2000, overscan: 160 };

export function aspectRatioFor(frame: CoordinateFrame): string {
  if (frame.w * 5 === frame.h * 4) return "4:5";
  return `${frame.w}:${frame.h}`;
}

export function idempotencyKeyFor(targetId: string, kind: VisualTargetKind, attempt: number): string {
  return `visual:${kind}:${targetId}:attempt-${attempt}`;
}

export function assembleVisualRequest(args: {
  target: VisualRequestTarget;
  artStyle: string;
  palette: string[];
  lens: string;
  lighting: string;
  negativeRules: string[];
  referenceVersions: ReferencePin[];
  referenceKeys: string[];
  frame?: CoordinateFrame;
  attempt?: number;
  unit?: number;
  seed?: number;
}): AssembledVisualRequest {
  const frame = args.frame ?? VISUAL_CANVAS;
  const attempt = args.attempt ?? 1;
  const kindLine: Record<VisualTargetKind, string> = {
    "reference-sheet": `Reference sheet for ${args.target.needed.map((need) => need.entityId).join(", ")}. Make identity, proportions, clothing, materials and repeatable visual details unambiguous.`,
    "scene-background": `Clean scene background with complete hidden coverage behind every foreground placement (overscan ${frame.overscan}px on a ${frame.w}x${frame.h} canvas). No characters, no text, no captions.`,
    "scene-foreground": `Transparent RGBA foreground layer on a ${frame.w}x${frame.h} canvas with transparent padding preserved (no drawn checkerboard, no baked backdrop).`,
    "scene-depth": `Grayscale depth map aligned pixel-for-pixel to the ${frame.w}x${frame.h} scene frame, near-white convention. No color photograph content.`,
  };
  const fills = args.target.fills.length
    ? `Explicitly invented visual fills (never source facts):\n${args.target.fills.map((fill) => `- ${fill.key}: ${fill.value} (${fill.reason})`).join("\n")}`
    : "";
  const prompt = [
    `${args.target.kind} for composition ${args.target.compositionId}${args.target.layerId ? ` layer ${args.target.layerId}` : ""}.`,
    `Scene: ${args.target.sceneDescription}`,
    kindLine[args.target.kind],
    `Art direction: ${args.artStyle}; palette ${args.palette.join(", ")}; lens ${args.lens}; lighting ${args.lighting}.`,
    fills,
    args.seed !== undefined ? `Deterministic seed ${args.seed}.` : "",
  ]
    .filter(Boolean)
    .join("\n\n");
  const negativePrompt = [
    ...args.negativeRules,
    "No text, captions, labels or watermarks baked into the image.",
    args.target.kind === "scene-foreground" ? "No opaque backdrop behind the subject." : "",
    args.target.kind === "scene-depth" ? "No color content; depth values only." : "",
  ]
    .filter(Boolean)
    .join("; ");
  return {
    targetId: args.target.targetId,
    kind: args.target.kind,
    prompt,
    negativePrompt,
    aspectRatio: aspectRatioFor(frame),
    referenceKeys: [...args.referenceKeys],
    referenceVersions: args.referenceVersions.map((pin) => ({ ...pin, s3Keys: [...pin.s3Keys] })),
    frame: { ...frame },
    idempotencyKey: idempotencyKeyFor(args.target.targetId, args.target.kind, attempt),
    unit: args.unit ?? 1,
  };
}

/** Prompt/validation path is shared by single and batch generation (plan 6). */
export function assembleVisualBatch(
  args: Parameters<typeof assembleVisualRequest>[0] & { targets: VisualRequestTarget[] },
): AssembledVisualRequest[] {
  const { targets, ...shared } = args;
  if (targets.length === 0) throw new Error("Select at least one visual target to generate.");
  if (targets.length > 25) throw new Error("Visual batches are bounded to 25 targets.");
  return targets.map((target) => assembleVisualRequest({ ...shared, target }));
}

===== src/features/book-experience/visuals/repository.ts =====
// Fake-backed visual generation repository (P8, ADR-012).
// Firestore layout follows plan section 4:
// books/{bookId}/entities/{entityId}/visualVersions/{versionId} holds
// immutable approved reference metadata (S3 holds the assets);
// books/{bookId}/compositions/{compositionId} holds Composition metadata.
// Local tests use this fake; no live writes here. Every generation records
// its immutable S3 key, source/reference versions, actual bit depth,
// prompt, model, cost and continuity result.

import type { GeneratedAssetDescriptor } from "./assets.ts";
import type { ReferenceApproval, StoredReferenceVersion } from "./references.ts";
import { referenceKey } from "./references.ts";
import type { CoordinateFrame } from "./requests.ts";

export type VisualGenerationRecord = {
  targetId: string;
  kind: string;
  compositionId: string;
  layerId?: string;
  s3Key: string;
  checksum: string;
  contentType: string;
  sourceId: string;
  canonicalHash: string;
  visualProfileVersion: number;
  referenceVersions: { entityId: string; stateId?: string; version: number; checksum: string }[];
  bitDepth?: 8 | 16;
  sourceBitDepth?: 8 | 16;
  prompt: string;
  negativePrompt: string;
  model: string;
  costUsd: number;
  attempt: number;
  idempotencyKey: string;
  continuity: { agreementScore: number | null; identityScores: Record<string, number>; status: "pending" | "approved" | "rejected" };
  status: "generated" | "approved" | "rejected";
  createdAt: string;
};

export class FakeVisualStore {
  approvals = new Map<string, ReferenceApproval>();
  versions = new Map<string, StoredReferenceVersion>();
  generations = new Map<string, VisualGenerationRecord>();
  charges = new Map<string, number>();
  outdatedTargets = new Set<string>();

  visualVersionPath(bookId: string, entityId: string, versionId: string): string {
    return `books/${bookId}/entities/${entityId}/visualVersions/${versionId}`;
  }

  compositionPath(bookId: string, compositionId: string): string {
    return `books/${bookId}/compositions/${compositionId}`;
  }

  proposeApproval(approval: ReferenceApproval): void {
    const key = referenceKey(approval.entityId, approval.stateId);
    if (this.approvals.has(key)) throw new Error(`Reference ${key} already proposed.`);
    this.approvals.set(key, approval);
  }

  approveReference(key: string, fingerprint: string, approvedBy: string): ReferenceApproval {
    if (this.outdated(key)) throw new Error(`Reference ${key} is outdated; regenerate from the current source.`);
    const existing = this.approvals.get(key);
    if (!existing) throw new Error(`Reference ${key} not found.`);
    if (existing.status === "approved" && existing.fingerprint === fingerprint) return existing;
    const next: ReferenceApproval = { ...existing, status: "approved", fingerprint, approvedBy, approvedAt: new Date(0).toISOString() };
    this.approvals.set(key, next);
    const stored = this.versions.get(key);
    if (stored) this.versions.set(key, { ...stored, reference: { ...stored.reference, approved: true, approvedBy, approvedAt: next.approvedAt } });
    return next;
  }

  publishReferenceVersion(version: StoredReferenceVersion): void {
    const key = referenceKey(version.entityId, version.stateId);
    if (this.versions.has(key)) throw new Error(`Reference version ${key} is immutable and already exists.`);
    this.versions.set(key, version);
  }

  /** Reference changes flag dependent drafts but never mutate published assets. */
  markOutdated(entityId: string, stateId?: string): void {
    this.outdatedTargets.add(referenceKey(entityId, stateId));
  }

  outdated(key: string): boolean {
    return this.outdatedTargets.has(key);
  }

  recordGeneration(record: VisualGenerationRecord): void {
    const key = `${record.targetId}:attempt-${record.attempt}`;
    if (this.generations.has(key)) throw new Error(`Generation ${key} is immutable and already exists.`);
    this.generations.set(key, record);
    // Idempotent cost: one charge per completed unit (plan 6).
    const chargeKey = `${record.idempotencyKey}:unit:1`;
    if (!this.charges.has(chargeKey)) this.charges.set(chargeKey, record.costUsd);
  }

  approveGeneration(targetId: string, attempt: number): VisualGenerationRecord {
    const record = this.generations.get(`${targetId}:attempt-${attempt}`);
    if (!record) throw new Error(`Generation ${targetId} attempt ${attempt} not found.`);
    const next: VisualGenerationRecord = { ...record, status: "approved", continuity: { ...record.continuity, status: "approved" } };
    this.generations.set(`${targetId}:attempt-${attempt}`, next);
    return next;
  }

  rejectGeneration(targetId: string, attempt: number): VisualGenerationRecord {
    const record = this.generations.get(`${targetId}:attempt-${attempt}`);
    if (!record) throw new Error(`Generation ${targetId} attempt ${attempt} not found.`);
    const next: VisualGenerationRecord = { ...record, status: "rejected", continuity: { ...record.continuity, status: "rejected" } };
    this.generations.set(`${targetId}:attempt-${attempt}`, next);
    return next;
  }

  approvedSiblingKeys(compositionId: string, exceptTargetId: string): string[] {
    return [...this.generations.values()]
      .filter((record) => record.compositionId === compositionId && record.targetId !== exceptTargetId && record.status === "approved")
      .map((record) => record.s3Key);
  }

  descriptorFor(targetId: string, attempt: number, frame: CoordinateFrame): GeneratedAssetDescriptor {
    const record = this.generations.get(`${targetId}:attempt-${attempt}`);
    if (!record) throw new Error(`Generation ${targetId} attempt ${attempt} not found.`);
    return {
      key: record.s3Key,
      targetId: record.targetId,
      kind: record.kind as GeneratedAssetDescriptor["kind"],
      w: frame.w,
      h: frame.h,
      contentType: record.contentType,
      sizeBytes: 1024,
      checksum: record.checksum,
      hasAlpha: record.kind === "scene-foreground",
      ...(record.bitDepth !== undefined ? { bitDepth: record.bitDepth, sourceBitDepth: record.sourceBitDepth, depthConvention: "near-white" as const } : {}),
      ...(record.kind === "scene-background" ? { overscanPresent: frame.overscan } : {}),
      textDetected: false,
    };
  }
}

===== src/features/book-experience/visuals/regeneration.ts =====
// Targeted regeneration planning (P8, ADR-007/ADR-011).
// A failed layer regenerates at asset/layer/composition scope without
// discarding approved siblings: approved assets are reused by immutable
// key, and explicit regeneration is a new attempt with a distinct
// idempotency key. Published bundles keep their exact asset keys.

import { idempotencyKeyFor } from "./requests.ts";
import type { VisualTargetKind } from "./references.ts";

export type RegenerationScope = "asset" | "layer" | "composition";

export type RegenerationPlan = {
  targetId: string;
  kind: VisualTargetKind;
  scope: RegenerationScope;
  /** New billable attempt; retries of this attempt reuse the same key. */
  idempotencyKey: string;
  attempt: number;
  /** Immutable keys of approved siblings that must not change. */
  reuseKeys: string[];
  reason: string;
};

export function planRegeneration(args: {
  targetId: string;
  kind: VisualTargetKind;
  scope: RegenerationScope;
  previousAttempt: number;
  approvedSiblingKeys: string[];
  reason: string;
}): RegenerationPlan {
  if (!args.reason.trim()) throw new Error("A regeneration reason is required.");
  const attempt = args.previousAttempt + 1;
  return {
    targetId: args.targetId,
    kind: args.kind,
    scope: args.scope,
    idempotencyKey: idempotencyKeyFor(args.targetId, args.kind, attempt),
    attempt,
    reuseKeys: [...args.approvedSiblingKeys],
    reason: args.reason,
  };
}

/** Regenerating one target must never rewrite an approved sibling's key. */
export function regenerationPreservesSiblings(plan: RegenerationPlan, approvedKeys: string[]): string | null {
  const dropped = approvedKeys.filter((key) => !plan.reuseKeys.includes(key));
  if (dropped.length > 0) {
    return `Regeneration must reuse approved sibling ${dropped[0]} by immutable key.`;
  }
  return null;
}

===== src/features/book-experience/compositions/assemble.ts =====
// Canonical composition assembly (P9, plan 3.2, ADR-008/ADR-011).
// Generated layers assemble into source/reference-pinned compositions:
// every layer shares one explicit canvas, foregrounds keep real alpha,
// depthMesh layers need aligned depth plus bounded mesh subdivisions, and
// backgrounds carry the hidden coverage that safeCamera is computed from.
// Structural failures yield no composition; content failures yield a
// generated draft whose issues block approval but stay inspectable.

import type { Composition } from "../schemas/composition.ts";
import { CompositionSchema } from "../schemas/composition.ts";
import type { CameraPose, Responsive } from "../schemas/primitives.ts";
import type { ReferencePin } from "../schemas/model.ts";
import type { CameraFrame } from "./safeCamera.ts";
import { computeSafeCamera, safeCameraApprovalProblem } from "./safeCamera.ts";

export type CompositionIssue = { code: string; message: string };

export type LayerInput = {
  layerId: string;
  role: "background" | "midground" | "foreground";
  entityId?: string;
  key: string;
  assetVersionId: string;
  w: number;
  h: number;
  contentType: string;
  sizeBytes: number;
  checksum: string;
  hasAlpha: boolean;
  /** Background overscan actually present beyond the viewport (px). */
  overscanPresentPx?: number;
  depth?: {
    key: string;
    w: number;
    h: number;
    bitDepth: 8 | 16;
    sourceBitDepth: 8 | 16;
    convention: "near-white";
    checksum: string;
    sizeBytes: number;
    assetVersionId: string;
  } | null;
  hiddenAreaImageKey?: string;
  zOrder: number;
  depthRange: [number, number];
  transform: { x: number; y: number; z: number; scaleX: number; scaleY: number; rotate: number };
  renderMode: "plane" | "depthMesh";
  mesh?: { segmentsX: number; segmentsY: number; displacementScale: number };
  textDetected?: boolean;
};

export type AssembleCompositionArgs = {
  bookId: string;
  sourceId: string;
  canonicalHash: string;
  compositionId: string;
  revisionId: string;
  reuseKey: string;
  originEpisodeId: string;
  usedIn: { episodeId: string; momentId: string; beatId: string; revisionId: string }[];
  shotSnapshot: {
    shotId: string;
    description: string;
    entityStates: { entityId: string; stateId: string }[];
    framing: string;
    mood: string;
    timeOfDay: string;
    reuseKey: string;
  };
  entityStatesUsed: { entityId: string; stateId: string }[];
  continuityRefs: string[];
  referenceVersions: ReferencePin[];
  visualProfileVersion: number;
  master: {
    key: string;
    w: number;
    h: number;
    contentType: string;
    sizeBytes: number;
    checksum: string;
    assetVersionId: string;
  };
  responsive: Responsive;
  generation: {
    provider: string;
    model: string;
    prompt: string;
    negativePrompt: string;
    seed?: number;
    referenceKeys: string[];
    costUsd: number;
  };
  frame: CameraFrame;
  layers: LayerInput[];
  /** AI-planned Beat cameras that must fit the computed safe bounds. */
  cameraPoses?: { beatId: string; from: CameraPose; to: CameraPose }[];
};

const STRUCTURAL_CODES = new Set([
  "FRAME_MISMATCH",
  "DEPTH_MISSING",
  "MESH_MISSING",
  "MISSING_CHECKSUM",
]);

/** True when the issue prevents forming a valid canonical composition. */
export function isStructuralIssue(issue: CompositionIssue): boolean {
  return STRUCTURAL_CODES.has(issue.code);
}

/**
 * Assemble validated generations into a canonical Composition draft.
 * Returns a null composition with blocking issues when the layers cannot
 * form a schema-valid scene (mixed frames, depthMesh without aligned
 * depth, missing checksums); otherwise returns the draft plus the issues
 * that block its approval.
 */
export function assembleComposition(args: AssembleCompositionArgs): {
  composition: Composition | null;
  issues: CompositionIssue[];
} {
  const issues: CompositionIssue[] = [];
  if (args.layers.length === 0) {
    return { composition: null, issues: [{ code: "NO_LAYERS", message: `Composition ${args.compositionId} has no generated layers to assemble.` }] };
  }

  for (const layer of args.layers) {
    if (layer.w !== args.frame.w || layer.h !== args.frame.h) {
      issues.push({
        code: "FRAME_MISMATCH",
        message: `Layer ${layer.layerId} is ${layer.w}x${layer.h} but the shared canvas is ${args.frame.w}x${args.frame.h}.`,
      });
    }
    if (!layer.checksum) {
      issues.push({ code: "MISSING_CHECKSUM", message: `Layer ${layer.layerId} needs a checksum before it is immutable.` });
    }
    if (layer.role !== "background" && !layer.hasAlpha && layer.role === "foreground") {
      issues.push({
        code: "MISSING_ALPHA",
        message: `Foreground ${layer.layerId} needs real alpha, not a drawn checkerboard.`,
      });
    }
    if (layer.renderMode === "depthMesh") {
      if (!layer.depth) {
        issues.push({
          code: "DEPTH_MISSING",
          message: `Layer ${layer.layerId} renders as depthMesh but has no aligned depth; regenerate the depth target.`,
        });
      } else {
        if (layer.depth.w !== layer.w || layer.depth.h !== layer.h) {
          issues.push({
            code: "DEPTH_MISALIGNED",
            message: `Depth for ${layer.layerId} is ${layer.depth.w}x${layer.depth.h}; it must align pixel-for-pixel to ${layer.w}x${layer.h}.`,
          });
        }
        if (layer.depth.convention !== "near-white") {
          issues.push({
            code: "DEPTH_CONVENTION",
            message: `Depth for ${layer.layerId} must use the near-white convention.`,
          });
        }
      }
      if (!layer.mesh || !Number.isFinite(layer.mesh.displacementScale)) {
        issues.push({
          code: "MESH_MISSING",
          message: `Layer ${layer.layerId} renders as depthMesh but has no bounded mesh subdivisions.`,
        });
      }
    }
    if (layer.role === "background" && (layer.overscanPresentPx ?? 0) < args.frame.overscan) {
      issues.push({
        code: "HIDDEN_COVERAGE_GAP",
        message: `Background ${layer.layerId} covers ${layer.overscanPresentPx ?? 0}px overscan; ${args.frame.overscan}px required so camera motion never opens holes.`,
      });
    }
    if (layer.textDetected) {
      issues.push({
        code: "TEXT_DETECTED",
        message: `Layer ${layer.layerId} has baked-in text; subtitles stay HTML.`,
      });
    }
  }
  if (!args.layers.some((layer) => layer.role === "background")) {
    issues.push({
      code: "NO_BACKGROUND",
      message: `Composition ${args.compositionId} has no background layer; safeCamera cannot be computed.`,
    });
  }

  const safeCamera = computeSafeCamera({
    frame: args.frame,
    coverages: args.layers.map((layer) => ({
      layerId: layer.layerId,
      role: layer.role,
      ...(layer.overscanPresentPx !== undefined ? { overscanPresentPx: layer.overscanPresentPx } : {}),
      ...(layer.mesh ? { displacementScale: layer.mesh.displacementScale } : {}),
    })),
  });
  const cameraProblem = safeCameraApprovalProblem({
    compositionId: args.compositionId,
    poses: args.cameraPoses ?? [],
    safe: safeCamera,
  });
  if (cameraProblem) issues.push({ code: "UNSAFE_CAMERA", message: cameraProblem });

  if (issues.some(isStructuralIssue)) return { composition: null, issues };
  const composition = CompositionSchema.parse({
    sourceId: args.sourceId,
    canonicalHash: args.canonicalHash,
    schemaVersion: 1,
    compositionId: args.compositionId,
    revisionId: args.revisionId,
    reuseKey: args.reuseKey,
    originEpisodeId: args.originEpisodeId,
    usedIn: args.usedIn,
    shotSnapshot: args.shotSnapshot,
    entityStatesUsed: args.entityStatesUsed,
    continuityRefs: args.continuityRefs,
    referenceVersions: args.referenceVersions,
    visualProfileVersion: args.visualProfileVersion,
    master: {
      key: args.master.key,
      w: args.master.w,
      h: args.master.h,
      contentType: args.master.contentType,
      sizeBytes: args.master.sizeBytes,
      checksum: args.master.checksum,
      assetVersionId: args.master.assetVersionId,
    },
    depth: undefined,
    layers: args.layers.map((layer) => ({
      layerId: layer.layerId,
      role: layer.role,
      ...(layer.entityId ? { entityId: layer.entityId } : {}),
      image: {
        key: layer.key,
        w: layer.w,
        h: layer.h,
        contentType: layer.contentType,
        sizeBytes: layer.sizeBytes,
        checksum: layer.checksum,
        assetVersionId: layer.assetVersionId,
      },
      ...(layer.depth
        ? {
            depth: {
              key: layer.depth.key,
              w: layer.depth.w,
              h: layer.depth.h,
              contentType: "image/png",
              sizeBytes: layer.depth.sizeBytes,
              checksum: layer.depth.checksum,
              assetVersionId: layer.depth.assetVersionId,
              bitDepth: layer.depth.bitDepth,
              sourceBitDepth: layer.depth.sourceBitDepth,
              convention: layer.depth.convention,
              provenance: "generated" as const,
            },
          }
        : {}),
      zOrder: layer.zOrder,
      depthRange: layer.depthRange,
      transform: layer.transform,
      renderMode: layer.renderMode,
      ...(layer.mesh ? { mesh: layer.mesh } : {}),
    })),
    safeCamera,
    responsive: args.responsive,
    qa: {
      textDetected: args.layers.some((layer) => layer.textDetected === true),
      agreementScore: null,
      identityScores: {},
      issues: issues.map((issue) => `${issue.code}: ${issue.message}`),
      continuityStatus: "pending" as const,
    },
    generation: {
      provider: args.generation.provider,
      model: args.generation.model,
      prompt: args.generation.prompt,
      negativePrompt: args.generation.negativePrompt,
      ...(args.generation.seed !== undefined ? { seed: args.generation.seed } : {}),
      referenceKeys: args.generation.referenceKeys,
      costUsd: args.generation.costUsd,
    },
    status: "generated" as const,
    createdAt: new Date(0).toISOString(),
    updatedAt: new Date(0).toISOString(),
  });
  void args.bookId;
  return { composition, issues };
}

/** Approving an assembled composition requires zero blocking issues. */
export function compositionApprovalProblem(
  composition: Composition | null,
  issues: CompositionIssue[],
): string | null {
  if (!composition) {
    const first = issues[0];
    return first
      ? `Composition cannot assemble: ${first.message}`
      : "Composition cannot assemble: no layers.";
  }
  if (issues.length > 0) {
    return `Composition ${composition.compositionId} is blocked: ${issues[0].message}`;
  }
  return null;
}

