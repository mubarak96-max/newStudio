import { FieldValue } from "firebase-admin/firestore";
import { NextResponse } from "next/server";

import { getSession } from "@/features/auth/session";
import { EditError } from "@/features/sources/edit-ops";
import { adminDb } from "@/services/firebase/admin";

// Thin canonical Compositions adapter (P9): assembled-result approval plus
// targeted layer/composition regeneration. AI supplies every layer,
// camera, transition and assembly choice; the owner previews the Episode,
// clicks the exact resolving action and approves without setting camera
// directions or editing scene data (ADR-003). Scene regeneration reuses
// approved siblings by immutable key and never mutates published assets.

type CompositionsAction =
  | { action: "compositions.approve"; compositionId: string; revisionId: string; fingerprint: string }
  | { action: "compositions.regenerate"; compositionId: string; layerId?: string; reason: string };

export async function GET(_request: Request, context: RouteContext<"/api/books/[bookId]/compositions">) {
  const session = await getSession();
  if (!session) return NextResponse.json({ error: "Not signed in." }, { status: 401 });
  const { bookId } = await context.params;
  const compositions = await adminDb()
    .collection("books")
    .doc(bookId)
    .collection("compositions")
    .get();
  const byStatus: Record<string, number> = {};
  for (const doc of compositions.docs) {
    const status = String(doc.get("status") ?? "generated");
    byStatus[status] = (byStatus[status] ?? 0) + 1;
  }
  return NextResponse.json({
    bookId,
    total: compositions.docs.length,
    byStatus,
    blocked: (byStatus["generated"] ?? 0) + (byStatus["failed"] ?? 0) + (byStatus["rejected"] ?? 0),
  });
}

export async function POST(request: Request, context: RouteContext<"/api/books/[bookId]/compositions">) {
  const session = await getSession();
  if (!session) return NextResponse.json({ error: "Not signed in." }, { status: 401 });
  const { bookId } = await context.params;
  const body = (await request.json()) as CompositionsAction;
  try {
    const bookRef = adminDb().collection("books").doc(bookId);
    if (body.action === "compositions.approve") {
      if (!body.compositionId || !body.revisionId || !body.fingerprint) {
        throw new EditError("A compositionId, revisionId and fingerprint are required.");
      }
      const ref = bookRef.collection("compositions").doc(body.compositionId);
      await adminDb().runTransaction(async (tx) => {
        const snapshot = await tx.get(ref);
        if (!snapshot.exists) throw new EditError(`Composition ${body.compositionId} was never assembled.`);
        if (snapshot.get("revisionId") !== body.revisionId) {
          throw new EditError(`Composition ${body.compositionId} is outdated; preview the current revision.`);
        }
        const issues = (snapshot.get("qa.issues") as string[] | undefined) ?? [];
        if (issues.length > 0) {
          throw new EditError(`Composition ${body.compositionId} is blocked: ${issues[0]}`);
        }
        if (snapshot.get("approval.fingerprint") === body.fingerprint) return;
        tx.set(
          ref,
          {
            status: "approved",
            approval: {
              fingerprint: body.fingerprint,
              approvedBy: session.email,
              approvedAt: FieldValue.serverTimestamp(),
            },
          },
          { merge: true },
        );
      });
      return NextResponse.json({ ok: true });
    }

    if (body.action === "compositions.regenerate") {
      if (!body.compositionId) throw new EditError("A compositionId is required.");
      if (!body.reason?.trim()) throw new EditError("A regeneration reason is required.");
      const ref = bookRef.collection("compositions").doc(body.compositionId);
      await adminDb().runTransaction(async (tx) => {
        const snapshot = await tx.get(ref);
        if (!snapshot.exists) throw new EditError(`Composition ${body.compositionId} was never assembled.`);
        const status = String(snapshot.get("status") ?? "generated");
        if (status !== "failed" && status !== "rejected" && status !== "generated") {
          throw new EditError(
            `Only a failed, rejected or blocked composition regenerates; ${body.compositionId} is ${status}.`,
          );
        }
        const attempt = Number(snapshot.get("regenerationAttempt") ?? 0) + 1;
        tx.set(
          ref,
          {
            status: "generated",
            regenerationAttempt: attempt,
            idempotencyKey: `compose:${body.compositionId}:attempt-${attempt}`,
            ...(body.layerId ? { regenerateLayerId: body.layerId } : {}),
            regenerateReason: body.reason,
            regeneratedBy: session.email,
            regeneratedAt: FieldValue.serverTimestamp(),
          },
          { merge: true },
        );
      });
      return NextResponse.json({ ok: true });
    }

    throw new EditError("Unknown compositions action.");
  } catch (error) {
    if (error instanceof EditError) return NextResponse.json({ error: error.message }, { status: 409 });
    throw error;
  }
}

import { FieldValue } from "firebase-admin/firestore";
import { NextResponse } from "next/server";

import { getSession } from "@/features/auth/session";
import { EditError } from "@/features/sources/edit-ops";
import { adminDb } from "@/services/firebase/admin";

// Thin canonical Episodes adapter (P6): approve/reject/regenerate and review
// status for AI-proposed Episode and Moment ranges. The owner approves or
// requests an AI revision; no boundary/field editing lives here (ADR-003).
// Later-episode production may continue after an earlier Episode is
// published: publication never gates a sibling Episode's scope.

type EpisodesAction =
  | { action: "story-map.approve" }
  | { action: "story-map.regenerate"; reason?: string }
  | { action: "moments.approve"; episodeId: string }
  | { action: "moments.regenerate"; episodeId: string; reason?: string };

export async function GET(_request: Request, context: RouteContext<"/api/books/[bookId]/episodes">) {
  const session = await getSession();
  if (!session) return NextResponse.json({ error: "Not signed in." }, { status: 401 });
  const { bookId } = await context.params;
  const storyMap = await adminDb()
    .collection("books")
    .doc(bookId)
    .collection("derived")
    .doc("storyMap")
    .get();
  return NextResponse.json({
    bookId,
    storyMapStatus: storyMap.exists ? (storyMap.get("status") ?? "review") : "pending",
    revision: storyMap.exists ? (storyMap.get("revision") ?? null) : null,
    fingerprint: storyMap.exists ? (storyMap.get("fingerprint") ?? null) : null,
    updatedAt: storyMap.exists ? (storyMap.get("updatedAt") ?? null) : null,
  });
}

export async function POST(request: Request, context: RouteContext<"/api/books/[bookId]/episodes">) {
  const session = await getSession();
  if (!session) return NextResponse.json({ error: "Not signed in." }, { status: 401 });
  const { bookId } = await context.params;
  const body = (await request.json()) as EpisodesAction;
  try {
    if (body.action === "story-map.approve" || body.action === "story-map.regenerate") {
      const ref = adminDb().collection("books").doc(bookId).collection("derived").doc("storyMap");
      await adminDb().runTransaction(async (tx) => {
        const snapshot = await tx.get(ref);
        if (!snapshot.exists) throw new EditError("There is no proposed StoryMap to review.");
        if (body.action === "story-map.approve") {
          if (snapshot.get("status") === "approved") throw new EditError("This StoryMap is already approved.");
          tx.set(
            ref,
            { status: "approved", approvedBy: session.email, approvedAt: FieldValue.serverTimestamp() },
            { merge: true },
          );
        } else {
          if (snapshot.get("status") === "approved") {
            throw new EditError("Reopen before regenerating an approved StoryMap.");
          }
          tx.set(
            ref,
            {
              status: "pending",
              regenerateRequestedBy: session.email,
              regenerateRequestedAt: FieldValue.serverTimestamp(),
              regenerateReason: body.reason ?? null,
            },
            { merge: true },
          );
        }
      });
      return NextResponse.json({ ok: true });
    }

    if (body.action === "moments.approve" || body.action === "moments.regenerate") {
      if (!body.episodeId) throw new EditError("An episodeId is required.");
      const storyMap = await adminDb()
        .collection("books")
        .doc(bookId)
        .collection("derived")
        .doc("storyMap")
        .get();
      if (storyMap.get("status") !== "approved") {
        throw new EditError("Approve the StoryMap before approving Moments.");
      }
      const ref = adminDb().collection("books").doc(bookId).collection("episodes").doc(body.episodeId);
      await adminDb().runTransaction(async (tx) => {
        const snapshot = await tx.get(ref);
        if (!snapshot.exists) throw new EditError(`Episode ${body.episodeId} has no proposed Moments.`);
        if (body.action === "moments.approve") {
          if (snapshot.get("momentsStatus") === "approved") {
            throw new EditError(`Moments for ${body.episodeId} are already approved.`);
          }
          tx.set(
            ref,
            { momentsStatus: "approved", approvedBy: session.email, approvedAt: FieldValue.serverTimestamp() },
            { merge: true },
          );
        } else {
          if (snapshot.get("momentsStatus") === "approved") {
            throw new EditError(`Reopen before regenerating Moments for ${body.episodeId}.`);
          }
          tx.set(
            ref,
            {
              momentsStatus: "pending",
              regenerateRequestedBy: session.email,
              regenerateRequestedAt: FieldValue.serverTimestamp(),
              regenerateReason: body.reason ?? null,
            },
            { merge: true },
          );
        }
      });
      return NextResponse.json({ ok: true });
    }

    throw new EditError("Unknown episodes action.");
  } catch (error) {
    if (error instanceof EditError) return NextResponse.json({ error: error.message }, { status: 409 });
    throw error;
  }
}

